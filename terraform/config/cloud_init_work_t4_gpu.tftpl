#cloud-config
hostname: ${hostname}

users:
  - name: ubuntu
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    groups: users, admin
    shell: /bin/bash
    lock_passwd: ${VM_CONSOLE_LOCK_PASSWORD}
    ssh_authorized_keys:
      - ${ssh_keys}

chpasswd:
  expire: false
  list: |
    ubuntu:${VM_CONSOLE_PASSWORD}

bootcmd:
  - [ systemctl, stop, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, disable, apt-daily.timer, apt-daily-upgrade.timer ]
  - [ systemctl, mask, apt-daily.service, apt-daily-upgrade.service ]

ssh_pwauth: false

package_update: true
package_upgrade: true
apt:
  conf: |
    Acquire::Retries "10";
    Acquire::http::Timeout "15";
    Acquire::https::Timeout "15";
    Acquire::ForceIPv4 "true";
    DPkg::Lock::Timeout "600";

packages:
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg-agent
  - software-properties-common
  - zsh
  - nfs-common
  - gnupg
  - lsb-release
  - nftables
  - alsa-utils
  - ubuntu-drivers-common
  - dnsmasq
  - ethtool
  - xfsprogs

growpart:
  mode: auto
  devices: ["/"]

write_files:
  - path: /etc/systemd/system/initial-setup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post-bootstrap setup for Kubernetes node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/environment
      ExecStart=/usr/local/bin/initial-setup.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/host-root-rbind.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Bind mount host root at /host for NVIDIA runtime compatibility
      After=local-fs.target
      Before=containerd.service rke2-agent.service

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'mkdir -p /host; mountpoint -q /host || mount --rbind / /host'
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/initial-setup.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # export HTTP_PROXY=http://10.0.0.10:3128
      # export HTTPS_PROXY=http://10.0.0.10:3128
      # export NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12

      # Do not apply aggressive CPU isolation flags on GPU worker VMs.
      # Prior tuning here caused IRQ starvation and unstable GPU initialization.
      echo "Skipping CPU isolation kernel flags on GPU worker VM."

      # update-ca-certificates
      systemctl daemon-reload
      /usr/local/bin/performance-tuning.sh
      sysctl --system
      /usr/local/bin/disable-swap.sh
      
      systemctl enable setup-hosts-dns.service
      systemctl start setup-hosts-dns.service

      systemctl enable qemu-guest-agent
      systemctl start qemu-guest-agent

      /usr/local/bin/setup-nfs-modules.sh
      systemctl enable --now mount-shared-storage.service
      /usr/local/bin/setup-longhorn-disk.sh
      systemctl restart systemd-journald || true
      /usr/local/bin/setup-docker.sh
      systemctl enable host-root-rbind.service
      systemctl start host-root-rbind.service
      /usr/local/bin/setup-nvidia.sh
      /usr/local/bin/setup-fluentbit.sh
      /usr/local/bin/setup-rke2.sh

      systemctl enable rke2-preload-images.service
      systemctl start rke2-preload-images.service

      systemctl daemon-reload
      systemctl enable rke2-agent
      systemctl start rke2-agent
      /usr/local/bin/cleanup-install-services.sh

  - path: /usr/local/bin/cleanup-install-services.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      INSTALL_SERVICES=(
        initial-setup.service
        setup-hosts-dns.service
        rke2-preload-images.service
      )

      for svc in "$INSTALL_SERVICES[@]"; do
        if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
          systemctl disable "$svc" || true
          systemctl reset-failed "$svc" || true
        fi
      done

  - path: /usr/local/bin/performance-tuning.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Applying performance tuning..."
      
      # CPU Governor
      GOVERNOR_PATH="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
      if [ -f "$GOVERNOR_PATH" ]; then
        for CPU in /sys/devices/system/cpu/cpu[0-9]*; do
          echo performance > "$CPU/cpufreq/scaling_governor" 2>/dev/null || true
        done
        echo "✅ CPU governors set to performance"
      else
        echo "⚠️ CPU frequency scaling not available — skipping governor tuning"
      fi
      
      # Scheduler tuning for SSDs
      for dev in /sys/block/sd*/queue/scheduler; do
        echo mq-deadline > "$dev"
      done

      systemctl disable apt-daily.timer
      systemctl disable snapd
      systemctl disable motd-news.timer
      
      # Sysctl parameters
      cat <<EOF > /etc/sysctl.d/99-performance-tuning.conf
      fs.inotify.max_user_watches=524288
      vm.max_map_count=262144
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 65536 134217728
      net.ipv4.tcp_congestion_control=bbr
      vm.swappiness=10
      vm.dirty_ratio=15
      vm.dirty_background_ratio=5
      EOF
      
      sysctl --system

      # 2) Pick all “large-MTU” interfaces automatically
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        # bring MTU up before offloads
        ip link set dev $IF mtu 9000

        # enable big-packet offloads
        ethtool -K $IF gro on gso on tso on rx on tx on

        # increase the kernel TX queue length
        ip link set dev $IF txqueuelen 10000
      done

      # 3) Sysctls — bump backlog and buffers for all interfaces
      sysctl -w net.core.netdev_max_backlog=250000
      sysctl -w net.core.rmem_max=134217728
      sysctl -w net.core.wmem_max=134217728
      sysctl -w net.ipv4.tcp_rmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_wmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_mtu_probing=1

      # 4) Persist sysctls
      cat <<EOF >/etc/sysctl.d/99-network-opt.conf
      net.core.netdev_max_backlog=250000
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 87380 134217728
      net.ipv4.tcp_mtu_probing=1
      EOF

      # ⭐ NEW: System-wide FD ceilings + inotify room
      cat <<EOF >/etc/sysctl.d/99-fd-and-inotify.conf
      fs.file-max = 2000000
      fs.nr_open  = 2097152
      fs.inotify.max_user_instances = 4096
      fs.inotify.max_user_watches   = 1048576
      fs.inotify.max_queued_events  = 32768
      EOF

      sysctl --system

      # 5) Persist ethtool + txqueuelen via a systemd service
      cat <<'EOF' >/etc/systemd/system/network-tweaks.service
      [Unit]
      Description=Apply ethtool offloads + txqueuelen
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/network-tweaks.sh

      [Install]
      WantedBy=multi-user.target
      EOF

      # Install the same script to /usr/local/bin and make it executable
            cat <<'EOF' >/usr/local/bin/network-tweaks.sh
      #!/bin/bash
      set -e
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        CURRENT_MTU=$(ip -o link show "$IF" | awk '{print $4}')
        if [ "$CURRENT_MTU" != "9000" ]; then
          ip link set dev "$IF" mtu 9000
        fi
        ethtool -K $IF gro on gso on tso on rx on tx on
        ip link set dev $IF txqueuelen 10000
      done
      EOF

      chmod +x /usr/local/bin/network-tweaks.sh

      systemctl daemon-reload
      systemctl enable network-tweaks

      echo "✅ Network tweaks applied and will persist across reboots."
      
      # Limit nofile
      cat <<EOF > /etc/security/limits.d/99-nofile.conf
      * soft nofile 1048576
      * hard nofile 1048576
      EOF
      
      # Systemd service overrides
      mkdir -p /etc/systemd/system/containerd.service.d
      mkdir -p /etc/systemd/system/rke2-server.service.d
      mkdir -p /etc/systemd/system/rke2-agent.service.d
      
      cat <<EOF > /etc/systemd/system/containerd.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-server.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-agent.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF

      # Skip aggressive kernel/workqueue boot tuning in guests.
      # It can reduce VM stability and is better handled on the Proxmox host.
      
      systemctl daemon-reload

  - path: /etc/sysctl.d/99-disable-ipv6.conf
    permissions: '0644'
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1

  - path: /etc/default/grub.d/99-disable-ipv6.cfg
    permissions: '0644'
    content: |
      GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX ipv6.disable=1"

  - path: /etc/modprobe.d/blacklist-nouveau.conf
    permissions: '0644'
    content: |
      blacklist nouveau
      options nouveau modeset=0

  - path: /etc/modprobe.d/nvidia-passthrough.conf
    permissions: '0644'
    content: |
      options nvidia NVreg_EnableMSI=0

  - path: /usr/local/bin/disable-swap.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      swapoff -a
      cp /etc/fstab /etc/fstab.bak
      sed -i '/^[^#].*\bswap\b/s/^/#/' /etc/fstab
      echo fs.inotify.max_user_watches=524288 | sudo tee /etc/sysctl.d/99-inotify.conf

  - path: /etc/systemd/system/mount-shared-storage.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount NFS shared storage
      After=network-online.target nfs-common.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'mkdir -p /mnt/shared-storage && /bin/mount -t nfs -o rw,_netdev,hard,intr,noatime,nolock,bg,retry=10 ${proxmox_host_ip}:/mnt/shared-storage /mnt/shared-storage'
      RemainAfterExit=true
      TimeoutSec=60
      Restart=no

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/rke2-preload-images.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      IMAGE_DIR="/var/lib/rancher/rke2/agent/images"
      ARCH="amd64"

      mkdir -p "$IMAGE_DIR"

      RKE2_VERSION=$(/usr/local/bin/rke2 --version | awk '{print $3}' | head -n1)
      RKE2_VERSION_ENCODED=$(echo "${k8s_version}" | sed 's/+/%2B/g')
      IMAGE_NAME="rke2-images.linux-$ARCH.tar.zst"
      IMAGE_URL="https://github.com/rancher/rke2/releases/download/$RKE2_VERSION_ENCODED/$IMAGE_NAME"

      echo "📦 Downloading $IMAGE_URL..."
      curl -fSL "$IMAGE_URL" -o "/tmp/$IMAGE_NAME"

      echo "📦 Decompressing..."
      zstd -d "/tmp/$IMAGE_NAME" -o "/tmp/rke2-images.tar"

      echo "📂 Moving to $IMAGE_DIR..."
      mv /tmp/rke2-images.tar "$IMAGE_DIR/rke2-images.tar"

      echo "✅ Preload complete"

  - path: /etc/systemd/system/rke2-preload-images.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Preload RKE2 container images
      ConditionPathExists=/usr/local/bin/rke2
      After=network-online.target
      Before=rke2-server.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/rke2-preload-images.sh

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/setup-hosts-dns.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      echo "Hostname=$(hostname)" >> /run/systemd/network/10-netplan-eth0.network || true
      sudo systemctl restart systemd-networkd || true

      HOSTNAME=$(hostname)
      grep -q "127.0.1.1 $HOSTNAME" /etc/hosts || echo "127.0.1.1 $HOSTNAME" >> /etc/hosts

      # ---------------------------------------------
      # 🧹 Disable systemd-resolved to free port 53
      # ---------------------------------------------
      echo "🧹 Disabling systemd-resolved..."
      sudo systemctl stop systemd-resolved || true
      sudo systemctl disable systemd-resolved || true
      sudo rm -f /etc/resolv.conf
      echo "nameserver 127.0.0.1" | sudo tee /etc/resolv.conf > /dev/null

      # ---------------------------------------------
      # ⚙️ Configure dnsmasq split-DNS
      # ---------------------------------------------
      sudo tee /etc/dnsmasq.d/k8s-split-dns.conf > /dev/null <<EOF
      # Forward Kubernetes service lookups to CoreDNS
      server=/svc.cluster.local/10.43.0.10

      # Forward internal LAN lookups to LAN DNS
      server=/internal.lan/10.0.0.10

      # Forward everything else to LAN DNS
      server=10.0.0.10

      # Listen locally
      listen-address=127.0.0.1

      # Don't use /etc/resolv.conf
      no-resolv
      EOF

      # Ensure dnsmasq global config allows localhost
      sudo sed -i 's/^#\?listen-address=.*/listen-address=127.0.0.1/' /etc/dnsmasq.conf || echo 'listen-address=127.0.0.1' | sudo tee -a /etc/dnsmasq.conf

      sudo systemctl enable dnsmasq
      sudo systemctl restart dnsmasq

      # Confirm DNS server
      echo "✅ dnsmasq is resolving:"
      echo "  - *.svc.cluster.local → 10.43.0.10"
      echo "  - *.internal.lan      → 10.0.0.10"
      echo "  - all others          → 10.0.0.10"

      # ---------------------------------------------
      # 🛡 IPv6 Hard Disable (Optional)
      # ---------------------------------------------
      sudo modprobe -r ip6_tables || true
      sudo modprobe -r nf_defrag_ipv6 || true
      sudo modprobe -r nf_conntrack_ipv6 || true
      sudo modprobe -r ipv6 || true

      echo "install ipv6 /bin/true" | sudo tee /etc/modprobe.d/force-disable-ipv6.conf
      echo "install ip6_tables /bin/true" | sudo tee -a /etc/modprobe.d/force-disable-ipv6.conf

      if [ -e /usr/sbin/ip6tables ]; then
        sudo mv /usr/sbin/ip6tables /usr/sbin/ip6tables.disabled
      fi

      sudo tee /etc/modprobe.d/disable-ipv6.conf > /dev/null <<EOF
      blacklist ipv6
      blacklist nf_conntrack_ipv6
      blacklist nf_defrag_ipv6
      blacklist ip6_tables
      EOF

      sudo update-initramfs -u

      # ---------------------------------------------
      # 🔁 Force sysctl re-apply on boot
      # ---------------------------------------------
      sudo tee /etc/systemd/system/sysctl-ensure.service > /dev/null <<EOF
      [Unit]
      Description=Force re-apply sysctl settings
      After=network.target
      Wants=network.target

      [Service]
      Type=oneshot
      ExecStart=/sbin/sysctl --system

      [Install]
      WantedBy=multi-user.target
      EOF

      sudo systemctl daemon-reexec
      sudo systemctl enable sysctl-ensure.service

  - path: /etc/systemd/system/setup-hosts-dns.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Setup hosts and DNS configuration
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/setup-hosts-dns.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/setup-nfs-modules.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Load immediately
      modprobe nfs || true
      modprobe nfsd || true

      # Persist via /etc/modules if not already present
      grep -qxF nfs /etc/modules || echo nfs >> /etc/modules
      grep -qxF nfsd /etc/modules || echo nfsd >> /etc/modules

      # Create systemd service to load modules early
      cat <<EOF > /etc/systemd/system/load-nfs-modules.service
      [Unit]
      Description=Load NFS kernel modules
      DefaultDependencies=no
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/env modprobe nfs
      ExecStart=/usr/bin/env modprobe nfsd
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      systemctl enable load-nfs-modules.service

  - path: /usr/local/bin/setup-longhorn-disk.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # Prepare and mount the dedicated Longhorn data disk at /var/lib/longhorn
      set -euo pipefail

      TARGET="/var/lib/longhorn"
      mkdir -p "$TARGET"

      ROOT_SRC=$(readlink -f "$(findmnt -n -o SOURCE /)")
      ROOT_DISK=$(lsblk -no PKNAME "$ROOT_SRC" 2>/dev/null || true)

      DATA_DISK=$(lsblk -ndo NAME,TYPE | awk -v root="$ROOT_DISK" '$2=="disk" && $1!=root {print $1; exit}')
      if [ -z "$DATA_DISK" ]; then
        echo "⚠️  No secondary data disk found; skipping Longhorn disk setup."
        exit 0
      fi

      DEV="/dev/$DATA_DISK"
      MOUNTED=$(findmnt -rn -S "$DEV" -o TARGET 2>/dev/null || true)
      if [ "$MOUNTED" != "" ] && [ "$MOUNTED" != "$TARGET" ]; then
        echo "⚠️  $DEV already mounted on $MOUNTED; not remounting to $TARGET."
        exit 0
      fi

      FSTYPE=$(blkid -s TYPE -o value "$DEV" 2>/dev/null || true)
      if [ -z "$FSTYPE" ]; then
        echo "🧹 Creating xfs filesystem on $DEV for Longhorn data..."
        mkfs.xfs -f "$DEV"
        FSTYPE="xfs"
      fi

      UUID=$(blkid -s UUID -o value "$DEV")
      if ! grep -q "$TARGET" /etc/fstab; then
        echo "UUID=$UUID $TARGET $FSTYPE defaults,noatime 0 2" >> /etc/fstab
      fi

      echo "⏫ Mounting $DEV to $TARGET..."
      mount -a
      chown -R root:root "$TARGET"
      echo "✅ Longhorn data disk mounted at $TARGET"

  - path: /usr/local/bin/setup-docker.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      until curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -; do sleep 5; done
      sudo add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
      sudo apt-get update -y
      DEBIAN_FRONTEND=noninteractive sudo apt-get install -y docker-ce docker-ce-cli containerd.io

      # Generate containerd config and configure registry mirrors
      containerd config default > /etc/containerd/config.toml

      sudo apt install python3-pip -y
      sudo apt install python3-tomlkit
      sudo python3 /usr/local/bin/patch.py

      systemctl restart containerd
      systemctl enable containerd

  - path: /etc/systemd/journald.conf.d/99-retention.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=2G
      RuntimeMaxUse=500M
      MaxRetentionSec=259200
      SystemMaxFileSize=200M
      SystemKeepFree=2G
      RuntimeKeepFree=250M
      RuntimeMaxFileSize=100M

  - path: /etc/logrotate.d/rsyslog
    permissions: '0644'
    content: |
      /var/log/syslog
      /var/log/messages
      /var/log/kern.log
      /var/log/auth.log
      /var/log/mail.log
      /var/log/user.log
      /var/log/daemon.log
      /var/log/debug
      {
        daily
        rotate 7
        maxsize 50M
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
          systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
        endscript
      }

  - path: /etc/logrotate.d/nginx
    permissions: '0644'
    content: |
      /var/log/nginx/*.log {
        daily
        rotate 14
        maxsize 100M
        missingok
        notifempty
        compress
        delaycompress
        create 0640 root adm
        sharedscripts
        postrotate
          [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
        endscript
      }

  - path: /etc/logrotate.d/cloud-init
    permissions: '0644'
    content: |
      /var/log/cloud-init.log
      /var/log/cloud-init-output.log
      {
        daily
        rotate 7
        maxsize 25M
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
      }

  - path: /etc/rancher/rke2/registries.yaml
    permissions: '0755'
    content: |
      mirrors:
        docker.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/dockerhub"
        quay.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/quay"
        gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/gcr"
        k8s.gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/k8s-gcr"
        registry.k8s.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/registry-k8s"
        ghcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/ghcr"
        "nvidia":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "nvcr.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "cr.l5d.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/linkerd"
        "reg.kyverno.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/kyverno"

      configs:
        utility-node.internal.lan:
          tls:
            insecure_skip_verify: true

  - path: /usr/local/bin/patch.py
    permissions: '0755'
    content: |
      from pathlib import Path
      from tomlkit import parse, dumps, table
      import re

      TOML_PATH = "/etc/containerd/config.toml"

      # Load TOML and parse
      doc = parse(Path(TOML_PATH).read_text())

      # Ensure registry section exists (containerd defaults may omit it)
      plugins = doc.get("plugins", table())
      cri_plugin = plugins.get("io.containerd.grpc.v1.cri", table())
      cri_registry = cri_plugin.get("registry", table())

      # Configs
      configs = cri_registry.get("configs", table())
      if "utility-node.internal.lan" not in configs:
          configs["utility-node.internal.lan"] = table()
      configs["utility-node.internal.lan"]["tls"] = {"insecure_skip_verify": True}
      cri_registry["configs"] = configs

      # Mirrors
      mirrors = cri_registry.get("mirrors", table())
      mirror_map = {
          "docker.io": "dockerhub",
          "quay.io": "quay",
          "gcr.io": "gcr",
          "k8s.gcr.io": "k8s-gcr",
          "registry.k8s.io": "registry-k8s",
          "ghcr.io": "ghcr",
          "nvidia": "nvidia",
          "nvcr.io": "nvidia"
      }
      for registry, mirror_name in mirror_map.items():
          mirrors[registry] = {
              "endpoint": [f"http://utility-node.internal.lan/v2/{mirror_name}"]
          }

      cri_registry["mirrors"] = mirrors
      cri_plugin["registry"] = cri_registry
      plugins["io.containerd.grpc.v1.cri"] = cri_plugin
      doc["plugins"] = plugins

      # Dump raw TOML
      raw_toml = dumps(doc)

      # Fix indentation: match just the affected lines and re-indent
      def indent_cri_registry_values(toml_str: str) -> str:
          output = []
          indent = None
          in_target_section = False

          for line in toml_str.splitlines():
              # Detect target section
              if re.match(r'\s*\[plugins\."io\.containerd\.grpc\.v1\.cri"\.registry\..*]', line):
                  in_target_section = True
                  output.append(line)
                  continue
              # Stop when out of section
              elif re.match(r'\s*\[.*]', line):
                  in_target_section = False
                  output.append(line)
                  continue

              # Indent values under the target section
              if in_target_section and "=" in line.strip():
                  output.append("      " + line.strip())
              else:
                  output.append(line)

          return "\n".join(output)

      # Write patched file
      Path(TOML_PATH).write_text(indent_cri_registry_values(raw_toml))
      print("✅ containerd config patched with consistent indentation.")

  - path: /usr/local/bin/setup-nvidia.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      # Repair interrupted package state first.
      sudo dpkg --configure -a || true
      sudo apt-get -f install -y || true

      sudo apt-get update
      sudo apt-get install -y \
          linux-headers-$(uname -r) \
          linux-modules-extra-$(uname -r) \
          build-essential \
          dkms

      # Prevent nouveau from claiming the GPU before nvidia loads.
      sudo tee /etc/modprobe.d/blacklist-nouveau.conf >/dev/null <<EOF
      blacklist nouveau
      options nouveau modeset=0
      EOF

      install_nvidia_driver() {
        local driver_major="$1"
        echo "Installing NVIDIA $${driver_major}-server"
        local driver_pkg="nvidia-driver-$${driver_major}-server"
        local dkms_pkg="nvidia-dkms-$${driver_major}-server"
        local source_pkg="nvidia-kernel-source-$${driver_major}-server"
        local common_pkg="nvidia-kernel-common-$${driver_major}-server"
        local utils_pkg="nvidia-utils-$${driver_major}-server"
        local compute_pkg="libnvidia-compute-$${driver_major}-server"
        local cfg_pkg="libnvidia-cfg1-$${driver_major}-server"

        # Install exact driver branch; retry once after apt repair if needed.
        sudo apt-get install -y --reinstall \
          "$${driver_pkg}" \
          "$${dkms_pkg}" \
          "$${source_pkg}" \
          "$${common_pkg}" \
          "$${utils_pkg}" \
          "$${compute_pkg}" \
          "$${cfg_pkg}" \
          nvidia-modprobe || {
            sudo dpkg --configure -a || true
            sudo apt-get -f install -y
            sudo apt-get install -y --reinstall \
              "$${driver_pkg}" \
              "$${dkms_pkg}" \
              "$${source_pkg}" \
              "$${common_pkg}" \
              "$${utils_pkg}" \
              "$${compute_pkg}" \
              "$${cfg_pkg}" \
              nvidia-modprobe
          }

        # On older passthrough platforms, MSI can cause RmInitAdapter failures.
        # Force legacy interrupt mode for the NVIDIA kernel module.
        sudo tee /etc/modprobe.d/nvidia-passthrough.conf >/dev/null <<EOF
        options nvidia NVreg_EnableMSI=0
        EOF

        sudo dkms autoinstall
        sudo depmod -a
        for m in nvidia_drm nvidia_uvm nvidia_modeset nvidia; do
          sudo modprobe -r "$m" 2>/dev/null || true
        done
        for m in nvidia nvidia_modeset nvidia_uvm nvidia_drm; do
          sudo modprobe "$m" || true
        done
        sudo nvidia-modprobe -u -c=0 || true
        sudo systemctl enable --now nvidia-persistenced
        sudo modinfo -F version nvidia | grep -E "^$${driver_major}\\." >/dev/null || true
        sudo apt-mark hold \
          "$${driver_pkg}" \
          "$${dkms_pkg}" \
          "$${source_pkg}" \
          "$${common_pkg}" \
          "$${utils_pkg}" \
          "$${compute_pkg}" \
          "$${cfg_pkg}" || true
        sudo nvidia-smi -L >/dev/null 2>&1 || true
      }

      install_nvidia_driver "${NVIDIA_DRIVER}"

      sudo update-initramfs -u

      curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
      curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
        | sed "s#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#" \
        | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list
      CUDA_REPO_DISTRO="ubuntu$(lsb_release -rs | tr -d '.')"
      CUDA_KEYRING_URL="https://developer.download.nvidia.com/compute/cuda/repos/$${CUDA_REPO_DISTRO}/x86_64/cuda-keyring_1.1-1_all.deb"
      wget -qO cuda-keyring_1.1-1_all.deb "$${CUDA_KEYRING_URL}"
      sudo dpkg -i cuda-keyring_1.1-1_all.deb
      sudo apt-get update -y
      sudo apt-get install -y nvidia-container-toolkit nvidia-docker2

      sudo systemctl enable nvidia-persistenced
      sudo systemctl start  nvidia-persistenced

      nvidia-ctk runtime configure --runtime=containerd --set-as-default
      nvidia-ctk runtime configure --runtime=docker     --set-as-default

      # 7. Finally, check:
      nvidia-smi

      # Keep your cleanup; just remove disabled_plugins if present
      sed -i '/^disabled_plugins/d' /etc/containerd/config.toml

      # NOTE: removed the containerd runc_options/rlimits injection block on purpose.
      # Limits are inherited via systemd overrides for containerd/rke2.

      echo "🔁 Reloading containerd..."
      sudo systemctl daemon-reexec
      sudo systemctl daemon-reload
      sudo systemctl restart containerd

      echo "✅ NVIDIA setup complete"

      sudo systemctl restart docker
      sudo systemctl restart containerd

  - path: /usr/local/bin/setup-rke2.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      until which rke2 >/dev/null 2>&1; do curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION=${k8s_version} sh -; sleep 5; done
      until which helm >/dev/null 2>&1; do curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash; sleep 5; done
      mkdir -p /etc/rancher/rke2
      cp /mnt/shared-storage/config.yaml /etc/rancher/rke2/config.yaml
      until [ -f "/mnt/shared-storage/$(getent hosts srvr-node.internal.lan | cut -d' ' -f1).token" ]; do sleep 2; done
      TOKEN=$(cat "/mnt/shared-storage/$(getent hosts srvr-node.internal.lan | cut -d' ' -f1).token")
      echo "token: $TOKEN" >> /etc/rancher/rke2/config.yaml
      sed -i '/^server:/d' /etc/rancher/rke2/config.yaml
      echo "server: https://srvr-node.internal.lan:9345" >> /etc/rancher/rke2/config.yaml
      
      sudo tee -a /etc/rancher/rke2/config.yaml << 'EOF'
      # ────────────────────────────────────────────────────────────────────────
      # Enable the PodNodeSelector admission plugin on the kube-api-server
      # ────────────────────────────────────────────────────────────────────────
      kube-apiserver-arg:
        - "enable-admission-plugins=PodNodeSelector"
        - "feature-gates=InPlacePodVerticalScaling=true"

      kube-controller-manager-arg:
        - "feature-gates=InPlacePodVerticalScaling=true"

      kube-scheduler-arg:
        - "feature-gates=InPlacePodVerticalScaling=true"

      node-label:
        - "suncoast.systems/gpu=t4"

      kubelet-arg:
        - "--max-pods=${WORK_NODE_MAX_PODS}"
        - "--cpu-manager-policy=static"
        - "--topology-manager-policy=restricted"
        - "--kube-reserved=cpu=500m,memory=1Gi,ephemeral-storage=1Gi"
        - "--container-log-max-size=10Mi"
        - "--container-log-max-files=3"
        - "--system-reserved=cpu=500m,memory=2Gi,ephemeral-storage=2Gi"
        - "--feature-gates=InPlacePodVerticalScaling=true"
      EOF

      sudo systemctl enable rke2-server
      sudo systemctl start rke2-server

  - path: /etc/security/limits.d/99-nofile.conf
    permissions: '0644'
    content: |
      * soft nofile 1048576
      * hard nofile 1048576

  - path: /etc/systemd/system/containerd.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/system/rke2-server.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/system/rke2-agent.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /usr/local/bin/setup-fluentbit.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "📦 Configuring Fluent Bit for GCP logging..."

      mkdir -p /etc/google-cloud-ops-agent
      echo "${GCP_LOGGING_KEY}" | base64 -d > /etc/google-cloud-ops-agent/logging-key.json

      DISTRO=$(lsb_release -cs)
      if [ "$DISTRO" = "${UBUNTU_RELEASE_CODE_NAME}" ]; then
        echo "Detected codename $DISTRO unsupported, falling back to jammy"
        DISTRO="jammy"
      fi

      mkdir -p /usr/share/keyrings
      KEYRING_PATH="/usr/share/keyrings/fluent-bit-archive-keyring.gpg"
      FLUENTBIT_REPO_BASE=""
      FLUENTBIT_REPO_CANDIDATES=("https://packages.fluentbit.io" "https://s3.amazonaws.com/packages.fluentbit.io")

      # Clean up any broken or partial key
      rm -f "$KEYRING_PATH"

      for candidate in "$${FLUENTBIT_REPO_CANDIDATES[@]}"; do
        key_url="$candidate/fluentbit.key"
        release_url="$candidate/ubuntu/$DISTRO/dists/$DISTRO/Release"

        for i in $(seq 1 8); do
          if curl -fsSL "$key_url" | gpg --dearmor --no-tty --batch -o "$KEYRING_PATH" && curl -fsSI "$release_url" >/dev/null; then
            FLUENTBIT_REPO_BASE="$candidate"
            break 2
          fi
          echo "Waiting for Fluent Bit repo candidate $candidate ($i/8)..."
          sleep 5
          rm -f "$KEYRING_PATH"
        done
      done

      if [ -z "$FLUENTBIT_REPO_BASE" ]; then
        echo "❌ Fluent Bit repo and fallback are unreachable; failing provisioning."
        exit 1
      fi

      echo "Using Fluent Bit repo: $FLUENTBIT_REPO_BASE"
      echo "deb [signed-by=/usr/share/keyrings/fluent-bit-archive-keyring.gpg] $FLUENTBIT_REPO_BASE/ubuntu/$DISTRO $DISTRO main" > /etc/apt/sources.list.d/fluent-bit.list
      if ! command -v td-agent-bit >/dev/null 2>&1; then
        if ! sudo apt-get update; then
          echo "❌ apt-get update failed for Fluent Bit repo; failing provisioning."
          exit 1
        fi
        if ! sudo apt-get install -y td-agent-bit; then
          echo "❌ td-agent-bit install failed; failing provisioning."
          exit 1
        fi
      fi

      mkdir -p /etc/td-agent-bit/conf.d

      cat <<EOF > /etc/td-agent-bit/td-agent-bit.conf
      [SERVICE]
          flush         1
          daemon        Off
          log_level     info
          plugins_file  plugins.conf
          parsers_file  parsers.conf
          http_server   Off
          http_listen   0.0.0.0
          http_port     2020
          storage.metrics on

      @INCLUDE /etc/td-agent-bit/conf.d/*.conf
      EOF

      # cloud-init logs
      cat <<EOF > /etc/td-agent-bit/conf.d/cloudinit.conf
      [INPUT]
          Name               tail
          Mem_Buf_Limit     10MB
          Path               /var/log/cloud-init*.log
          Tag                cloudinit
          Read_from_Head     Off
          DB                 /var/log/flb_cloudinit.db
          DB.Sync            normal
          Skip_Long_Lines    On

      [FILTER]
          Name      parser
          Match     cloudinit
          Key_Name  log
          Parser    cloudinit_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match cloudinit
          Add logName cloudinit

      [FILTER]
          Name    nest
          Match   cloudinit
          Operation nest
          Wildcard process
          Wildcard pid
          Wildcard timestamp
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match cloudinit
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key cloudinit
      EOF

      # journal logs (systemd, rke2, etc.)
      cat <<EOF > /etc/td-agent-bit/conf.d/journald.conf
      [INPUT]
          Name    systemd
          Tag     journal.*
          Mem_Buf_Limit     10MB
          DB      /var/log/flb_journal.db
          Systemd_Filter  _SYSTEMD_UNIT=bootstrap-rke2.service
          Systemd_Filter  _SYSTEMD_UNIT=rke2-server.service
          Systemd_Filter  _SYSTEMD_UNIT=cloud-final.service
          Read_From_Tail  On

      [FILTER]
          Name      parser
          Match     journal.*
          Key_Name  MESSAGE
          Parser    journald_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match journal.*
          Add logName systemd-journal

      [FILTER]
          Name   modify
          Match  journal.*
          Rename message textPayload

      [FILTER]
          Name    nest
          Match   journal.*
          Operation nest
          Wildcard identifier
          Wildcard pid
          Wildcard hostname
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match journal.*
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key systemd-journal
      EOF

      # Optional: catch all syslog (if rsyslog is enabled)
      cat <<EOF > /etc/td-agent-bit/conf.d/syslog.conf
      [INPUT]
          Name              tail
          Mem_Buf_Limit     10MB
          Path              /var/log/syslog
          Tag               syslog
          Read_from_Head    Off
          DB                /var/log/flb_syslog.db
          Skip_Long_Lines   On

      [FILTER]
          Name   parser
          Match  syslog
          Key_Name log
          Parser syslog_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name   modify
          Match  syslog
          Rename message textPayload

      [FILTER]
          Name modify
          Match syslog
          Add logName syslog

      [FILTER]
          Name    nest
          Match   syslog
          Operation nest
          Wildcard hostname
          Wildcard identifier
          Wildcard pid
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match syslog
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key syslog
      EOF

      # cloudinit_parser
      cat <<EOF >> /etc/td-agent-bit/parsers.conf

      [PARSER]
          Name        cloudinit_parser
          Format      regex
          Regex       ^(?<timestamp>[^ ]+\s[^ ]+) (?<process>[^\[]+)\[(?<pid>\d+)\]:(?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%d %H:%M:%S

      [PARSER]
          Name        syslog_parser
          Format      regex
          Regex       ^(?<timestamp>\w{3} +\d{1,2} \d{2}:\d{2}:\d{2}) (?<hostname>[^\s]+) (?<identifier>[^:]+): (?<message>.*)
          Time_Key    timestamp
          Time_Format %b %d %H:%M:%S

      [PARSER]
          Name        journald_parser
          Format      regex
          Regex       ^(?<timestamp>\d{4}-\d{2}-\d{2}T[0-9:.+\-Z]+) (?<hostname>[^\s]+) (?<identifier>[^\[]+)\[(?<pid>\d+)\]: (?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%dT%H:%M:%S.%L%z
      EOF

      systemctl daemon-reload
      systemctl enable td-agent-bit
      systemctl restart td-agent-bit

runcmd:
  - systemctl daemon-reexec
  - systemctl daemon-reload
  - systemctl enable initial-setup.service
  - systemctl start initial-setup.service
  - [ systemctl, unmask, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, enable, --now, apt-daily.timer, apt-daily-upgrade.timer ]
