#cloud-config
hostname: ${hostname}

users:
  - name: ubuntu
    sudo:
      - "ALL=(ALL) NOPASSWD:ALL"
    groups: users, admin
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_keys}

ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg-agent
  - software-properties-common
  - zsh
  - nfs-common
  - gnupg
  - lsb-release
  - nftables
  - dnsmasq

growpart:
  mode: auto
  devices: ["/"]

write_files:
  - path: /etc/systemd/system/initial-setup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post-bootstrap setup for Kubernetes node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/environment
      ExecStart=/usr/local/bin/initial-setup.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/initial-setup.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # export HTTP_PROXY=http://10.0.0.10:3128
      # export HTTPS_PROXY=http://10.0.0.10:3128
      # export NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12

      # update-ca-certificates
      systemctl daemon-reload
      /usr/local/bin/performance-tuning.sh
      sysctl --system
      update-grub
      systemctl daemon-reload

      systemctl enable set-dhcp-hostname.service
      systemctl start set-dhcp-hostname.service

      systemctl enable fix-dns-nfs.service
      systemctl start fix-dns-nfs.service
      /usr/local/bin/performance-tuning.sh

      /usr/local/bin/setup-nfs-modules.sh
      systemctl start load-nfs-modules.service

      systemctl enable --now mount-shared-storage.service

      systemctl enable disable-swap.service
      systemctl start disable-swap.service

      systemctl enable setup-hosts-dns.service
      systemctl start setup-hosts-dns.service

      systemctl enable configure-logging.service
      systemctl start configure-logging.service

      systemctl enable setup-runtime.service
      systemctl start setup-runtime.service

      systemctl enable rke2-preload-images.service
      systemctl start rke2-preload-images.service

      systemctl enable bootstrap-rke2.service
      systemctl start bootstrap-rke2.service

      systemctl enable set-nofile-limits.service
      systemctl start set-nofile-limits.service

      systemctl enable k8s-addons.service
      systemctl start k8s-addons.service

      systemctl enable install-apisix-rancher.service
      systemctl start install-apisix-rancher.service

      systemctl enable gpu.service
      systemctl start gpu.service

      systemctl enable post-install.service
      systemctl start post-install.service

  - path: /usr/local/bin/performance-tuning.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Applying performance tuning..."
      
      # CPU Governor
      echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
      
      # Scheduler tuning for SSDs
      for dev in /sys/block/sd*/queue/scheduler; do
        echo none > "$dev"
      done

      systemctl disable apt-daily.timer
      systemctl disable snapd
      systemctl disable motd-news.timer
      
      # Sysctl parameters
      cat <<EOF > /etc/sysctl.d/99-performance-tuning.conf
      fs.inotify.max_user_watches=524288
      vm.max_map_count=262144
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 65536 134217728
      net.ipv4.tcp_congestion_control=bbr
      vm.swappiness=10
      vm.dirty_ratio=15
      vm.dirty_background_ratio=5
      EOF
      
      sysctl --system

      # 1) Install ethtool if missing
      if ! command -v ethtool &>/dev/null; then
        apt-get update && apt-get install -y ethtool
      fi

      # 2) Pick all “large-MTU” interfaces automatically
      #    (adjust the grep if your jumbo-MTU devices have a different naming scheme)
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        # bring MTU up before offloads
        ip link set dev $IF mtu 9000

        # enable big-packet offloads
        ethtool -K $IF gro on gso on tso on rx on tx on

        # increase the kernel TX queue length
        ip link set dev $IF txqueuelen 10000
      done

      # 3) Sysctls — bump backlog and buffers for all interfaces
      #    and enable TCP MTU probing (helps path-MTU discovery)
      sysctl -w net.core.netdev_max_backlog=250000
      sysctl -w net.core.rmem_max=134217728
      sysctl -w net.core.wmem_max=134217728
      sysctl -w net.ipv4.tcp_rmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_wmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_mtu_probing=1

      # 4) Persist sysctls
      cat <<EOF >/etc/sysctl.d/99-network-opt.conf
      net.core.netdev_max_backlog=250000
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 87380 134217728
      net.ipv4.tcp_mtu_probing=1
      EOF

      # 5) Persist ethtool + txqueuelen via a systemd service
      cat <<'EOF' >/etc/systemd/system/network-tweaks.service
      [Unit]
      Description=Apply ethtool offloads + txqueuelen
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/network-tweaks.sh

      [Install]
      WantedBy=multi-user.target
      EOF

      # Install the same script to /usr/local/bin and make it executable
      install -m755 "$0" /usr/local/bin/network-tweaks.sh
      systemctl daemon-reload
      systemctl enable network-tweaks

      echo "✅ Network tweaks applied and will persist across reboots."
      
      # Limit nofile
      cat <<EOF > /etc/security/limits.d/99-nofile.conf
      * soft nofile 1048576
      * hard nofile 1048576
      EOF
      
      # Systemd service overrides
      mkdir -p /etc/systemd/system/containerd.service.d
      mkdir -p /etc/systemd/system/rke2-server.service.d
      mkdir -p /etc/systemd/system/rke2-agent.service.d
      
      cat <<EOF > /etc/systemd/system/containerd.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-server.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-agent.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      EOF

      # cat <<EOF | sudo tee /etc/profile.d/http_proxy.sh
      # export HTTP_PROXY="http://10.0.0.10:3128"
      # export HTTPS_PROXY="http://10.0.0.10:3128"
      # export NO_PROXY="127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12,192.168.0.0/16"
      # EOF

      # sudo chmod +x /etc/profile.d/http_proxy.sh
      
      systemctl daemon-reexec
      systemctl daemon-reload

  - path: /etc/sysctl.d/99-disable-ipv6.conf
    permissions: '0644'
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1

  - path: /etc/default/grub.d/99-disable-ipv6.cfg
    permissions: '0644'
    content: |
      GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX ipv6.disable=1"

  - path: /etc/systemd/system/mount-shared-storage.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount NFS shared storage
      After=network-online.target nfs-common.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'mkdir -p /mnt/shared-storage && /bin/mount -t nfs -o rw,_netdev,hard,intr,noatime,nolock,bg,retry=10 ${proxmox_host_ip}:/mnt/shared-storage /mnt/shared-storage'
      RemainAfterExit=true
      TimeoutSec=60
      Restart=no

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/10-disable-swap.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Disabling swap and modifying fstab..."
      swapoff -a || { echo "❌ Failed to disable swap"; exit 1; }
      cp /etc/fstab /etc/fstab.bak || { echo "❌ Failed to backup fstab"; exit 1; }
      sed -i '/^[^#].*\bswap\b/s/^/#/' /etc/fstab

  - path: /usr/local/bin/performance-tuning.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Applying performance tuning settings..."

      cat <<EOF | sudo tee /etc/sysctl.d/99-k8s-performance.conf
      fs.inotify.max_user_watches=524288
      fs.inotify.max_user_instances=65536
      fs.inotify.max_queued_events=8388608
      vm.max_map_count=262144
      vm.swappiness=10
      vm.dirty_ratio=15
      vm.dirty_background_ratio=5
      fs.aio-max-nr=1048576
      kernel.pid_max=4194304
      net.ipv4.ip_forward=1
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 65536 134217728
      net.ipv4.tcp_congestion_control=bbr
      EOF

      sysctl --system

      echo "performance" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor || true

      for DEV in /sys/block/sd*/queue/scheduler; do
        echo none | sudo tee "$DEV" > /dev/null || true
      done

      echo "✅ Performance tuning complete."

  - path: /etc/systemd/system/disable-swap.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Disable swap and update fstab
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/10-disable-swap.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/20-configure-logging.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "📦 Configuring Fluent Bit for GCP logging..."

      mkdir -p /etc/google-cloud-ops-agent
      echo "${GCP_LOGGING_KEY}" | base64 -d > /etc/google-cloud-ops-agent/logging-key.json

      mkdir -p /usr/share/keyrings
      KEYRING_PATH="/usr/share/keyrings/fluent-bit-archive-keyring.gpg"

      # Clean up any broken or partial key
      rm -f "$KEYRING_PATH"

      until curl -fsSL https://packages.fluentbit.io/fluentbit.key | gpg --dearmor --no-tty --batch -o "$KEYRING_PATH"; do
        echo "Waiting for DNS resolution or valid key for fluentbit.key..."
        sleep 5
        rm -f "$KEYRING_PATH"  # ensure no corrupted key is left behind
      done

      DISTRO=$(lsb_release -cs)
      if [ "$DISTRO" = "${UBUNTU_RELEASE_CODE_NAME}" ]; then
        echo "Detected codename $DISTRO unsupported, falling back to jammy"
        DISTRO="jammy"
      fi

      echo "deb [signed-by=/usr/share/keyrings/fluent-bit-archive-keyring.gpg] https://packages.fluentbit.io/ubuntu/$DISTRO $DISTRO main" > /etc/apt/sources.list.d/fluent-bit.list
      sudo apt-get update
      sudo apt-get install -y td-agent-bit

      mkdir -p /etc/td-agent-bit/conf.d

      cat <<EOF > /etc/td-agent-bit/td-agent-bit.conf
      [SERVICE]
          flush         1
          daemon        Off
          log_level     info
          plugins_file  plugins.conf
          parsers_file  parsers.conf
          http_server   Off
          http_listen   0.0.0.0
          http_port     2020
          storage.metrics on

      @INCLUDE /etc/td-agent-bit/conf.d/*.conf
      EOF

      # cloud-init logs
      cat <<EOF > /etc/td-agent-bit/conf.d/cloudinit.conf
      [INPUT]
          Name               tail
          Mem_Buf_Limit     10MB
          Path               /var/log/cloud-init*.log
          Tag                cloudinit
          Read_from_Head     Off
          DB                 /var/log/flb_cloudinit.db
          DB.Sync            normal
          Skip_Long_Lines    On

      [FILTER]
          Name      parser
          Match     cloudinit
          Key_Name  log
          Parser    cloudinit_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match cloudinit
          Add logName cloudinit

      [FILTER]
          Name    nest
          Match   cloudinit
          Operation nest
          Wildcard process
          Wildcard pid
          Wildcard timestamp
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match cloudinit
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key cloudinit
      EOF

      # journal logs (systemd, rke2, etc.)
      cat <<EOF > /etc/td-agent-bit/conf.d/journald.conf
      [INPUT]
          Name    systemd
          Tag     journal.*
          Mem_Buf_Limit     10MB
          DB      /var/log/flb_journal.db
          Systemd_Filter  _SYSTEMD_UNIT=bootstrap-rke2.service
          Systemd_Filter  _SYSTEMD_UNIT=rke2-server.service
          Systemd_Filter  _SYSTEMD_UNIT=cloud-final.service
          Read_From_Tail  On

      [FILTER]
          Name      parser
          Match     journal.*
          Key_Name  MESSAGE
          Parser    journald_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match journal.*
          Add logName systemd-journal

      [FILTER]
          Name   modify
          Match  journal.*
          Rename message textPayload

      [FILTER]
          Name    nest
          Match   journal.*
          Operation nest
          Wildcard identifier
          Wildcard pid
          Wildcard hostname
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match journal.*
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key systemd-journal
      EOF

      # Optional: catch all syslog (if rsyslog is enabled)
      cat <<EOF > /etc/td-agent-bit/conf.d/syslog.conf
      [INPUT]
          Name              tail
          Mem_Buf_Limit     10MB
          Path              /var/log/syslog
          Tag               syslog
          Read_from_Head    Off
          DB                /var/log/flb_syslog.db
          Skip_Long_Lines   On

      [FILTER]
          Name   parser
          Match  syslog
          Key_Name log
          Parser syslog_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name   modify
          Match  syslog
          Rename message textPayload

      [FILTER]
          Name modify
          Match syslog
          Add logName syslog

      [FILTER]
          Name    nest
          Match   syslog
          Operation nest
          Wildcard hostname
          Wildcard identifier
          Wildcard pid
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match syslog
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key syslog
      EOF

      # cloudinit_parser
      cat <<EOF >> /etc/td-agent-bit/parsers.conf

      [PARSER]
          Name        cloudinit_parser
          Format      regex
          Regex       ^(?<timestamp>[^ ]+\s[^ ]+) (?<process>[^\[]+)\[(?<pid>\d+)\]:(?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%d %H:%M:%S

      [PARSER]
          Name        syslog_parser
          Format      regex
          Regex       ^(?<timestamp>\w{3} +\d{1,2} \d{2}:\d{2}:\d{2}) (?<hostname>[^\s]+) (?<identifier>[^:]+): (?<message>.*)
          Time_Key    timestamp
          Time_Format %b %d %H:%M:%S

      [PARSER]
          Name        journald_parser
          Format      regex
          Regex       ^(?<timestamp>\d{4}-\d{2}-\d{2}T[0-9:.+\-Z]+) (?<hostname>[^\s]+) (?<identifier>[^\[]+)\[(?<pid>\d+)\]: (?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%dT%H:%M:%S.%L%z
      EOF

      systemctl daemon-reload
      systemctl enable td-agent-bit
      systemctl restart td-agent-bit

  - path: /etc/security/limits.d/99-nofile.conf
    permissions: '0644'
    content: |
      * soft nofile 1048576
      * hard nofile 1048576

  - path: /etc/systemd/system/containerd.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576

  - path: /etc/systemd/system/rke2-server.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576

  - path: /etc/systemd/system/rke2-agent.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576

  - path: /usr/local/bin/setup-nfs-modules.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Load immediately
      modprobe nfs || true
      modprobe nfsd || true

      # Persist via /etc/modules if not already present
      grep -qxF nfs /etc/modules || echo nfs >> /etc/modules
      grep -qxF nfsd /etc/modules || echo nfsd >> /etc/modules

      # Create systemd service to load modules early
      cat <<EOF > /etc/systemd/system/load-nfs-modules.service
      [Unit]
      Description=Load NFS kernel modules
      DefaultDependencies=no
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/env modprobe nfs
      ExecStart=/usr/bin/env modprobe nfsd
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      systemctl enable load-nfs-modules.service

  - path: /usr/local/bin/setup-hosts-dns.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      echo "Hostname=$(hostname)" >> /run/systemd/network/10-netplan-eth0.network || true
      sudo systemctl restart systemd-networkd || true

      HOSTNAME=$(hostname)
      grep -q "127.0.1.1 $HOSTNAME" /etc/hosts || echo "127.0.1.1 $HOSTNAME" >> /etc/hosts

      # ---------------------------------------------
      # 🧹 Disable systemd-resolved to free port 53
      # ---------------------------------------------
      echo "🧹 Disabling systemd-resolved..."
      sudo systemctl stop systemd-resolved || true
      sudo systemctl disable systemd-resolved || true
      sudo rm -f /etc/resolv.conf
      echo "nameserver 127.0.0.1" | sudo tee /etc/resolv.conf > /dev/null

      # ---------------------------------------------
      # ⚙️ Configure dnsmasq split-DNS
      # ---------------------------------------------
      sudo tee /etc/dnsmasq.d/k8s-split-dns.conf > /dev/null <<EOF
      # Forward Kubernetes service lookups to CoreDNS
      server=/svc.cluster.local/10.43.0.10

      # Forward internal LAN lookups to LAN DNS
      server=/internal.lan/10.0.0.10

      # Forward everything else to LAN DNS
      server=10.0.0.10

      # Listen locally
      listen-address=127.0.0.1

      # Don't use /etc/resolv.conf
      no-resolv
      EOF

      # Ensure dnsmasq global config allows localhost
      sudo sed -i 's/^#\?listen-address=.*/listen-address=127.0.0.1/' /etc/dnsmasq.conf || echo 'listen-address=127.0.0.1' | sudo tee -a /etc/dnsmasq.conf

      sudo systemctl enable dnsmasq
      sudo systemctl restart dnsmasq

      # Confirm DNS server
      echo "✅ dnsmasq is resolving:"
      echo "  - *.svc.cluster.local → 10.43.0.10"
      echo "  - *.internal.lan      → 10.0.0.10"
      echo "  - all others          → 10.0.0.10"

      # ---------------------------------------------
      # 🛡 IPv6 Hard Disable (Optional)
      # ---------------------------------------------
      sudo modprobe -r ip6_tables || true
      sudo modprobe -r nf_defrag_ipv6 || true
      sudo modprobe -r nf_conntrack_ipv6 || true
      sudo modprobe -r ipv6 || true

      echo "install ipv6 /bin/true" | sudo tee /etc/modprobe.d/force-disable-ipv6.conf
      echo "install ip6_tables /bin/true" | sudo tee -a /etc/modprobe.d/force-disable-ipv6.conf

      if [ -e /usr/sbin/ip6tables ]; then
        sudo mv /usr/sbin/ip6tables /usr/sbin/ip6tables.disabled
      fi

      sudo tee /etc/modprobe.d/disable-ipv6.conf > /dev/null <<EOF
      blacklist ipv6
      blacklist nf_conntrack_ipv6
      blacklist nf_defrag_ipv6
      blacklist ip6_tables
      EOF

      sudo update-initramfs -u

      # ---------------------------------------------
      # 🔁 Force sysctl re-apply on boot
      # ---------------------------------------------
      sudo tee /etc/systemd/system/sysctl-ensure.service > /dev/null <<EOF
      [Unit]
      Description=Force re-apply sysctl settings
      After=network.target
      Wants=network.target

      [Service]
      Type=oneshot
      ExecStart=/sbin/sysctl --system

      [Install]
      WantedBy=multi-user.target
      EOF

      sudo systemctl daemon-reexec
      sudo systemctl enable sysctl-ensure.service

  - path: /etc/systemd/system/setup-hosts-dns.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Setup hosts and DNS configuration
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/setup-hosts-dns.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/configure-logging.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Configure Fluent Bit logging to GCP
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/20-configure-logging.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/01-set-dhcp-hostname.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🌐 Setting DHCP hostname early..."
      echo "Hostname=${hostname}" >> /run/systemd/network/10-netplan-eth0.network

      systemctl restart systemd-networkd

  - path: /etc/systemd/system/set-dhcp-hostname.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Set DHCPHostname and restart systemd-networkd
      After=network-pre.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/01-set-dhcp-hostname.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/rke2-preload-images.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      IMAGE_DIR="/var/lib/rancher/rke2/agent/images"
      ARCH="amd64"

      mkdir -p "$IMAGE_DIR"

      RKE2_VERSION=$(/usr/local/bin/rke2 --version | awk '{print $3}' | head -n1)
      RKE2_VERSION_ENCODED=$(echo "${k8s_version}" | sed 's/+/%2B/g')
      IMAGE_NAME="rke2-images.linux-$ARCH.tar.zst"
      IMAGE_URL="https://github.com/rancher/rke2/releases/download/$RKE2_VERSION_ENCODED/$IMAGE_NAME"

      echo "📦 Downloading $IMAGE_URL..."
      curl -fSL "$IMAGE_URL" -o "/tmp/$IMAGE_NAME"

      echo "📦 Decompressing..."
      zstd -d "/tmp/$IMAGE_NAME" -o "/tmp/rke2-images.tar"

      echo "📂 Moving to $IMAGE_DIR..."
      mv /tmp/rke2-images.tar "$IMAGE_DIR/rke2-images.tar"

      echo "✅ Preload complete"

  - path: /etc/systemd/system/rke2-preload-images.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Preload RKE2 container images
      ConditionPathExists=/usr/local/bin/rke2
      After=network-online.target
      Before=rke2-server.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/rke2-preload-images.sh

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/30-setup-runtime.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      echo "🐳 Installing Docker..."
      until curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -; do
        echo "Retrying Docker GPG key fetch..."; sleep 5;
      done
      sudo apt-key fingerprint 0EBFCD88
      sudo add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
      sudo apt update
      DEBIAN_FRONTEND=noninteractive sudo apt install -y docker-ce docker-ce-cli containerd.io

      # sudo mkdir -p /etc/systemd/system/docker.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/docker.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      # sudo mkdir -p /etc/systemd/system/containerd.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/containerd.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      echo "☸️ Installing kubectl, RKE2, Helm..."

      # Retry with timeout and snapd recovery
      install_with_snap_retry() {
        local package="$1"
        local max_retries=5
        local retry_count=0

        until snap install "$package" --classic && "$package" version --client 2>/dev/null; do
          retry_count=$((retry_count + 1))
          echo "❌ Failed to install $package, attempt $retry_count..."

          if (( retry_count >= max_retries )); then
            echo "🔁 Restarting snapd and trying again..."
            systemctl restart snapd
            retry_count=0
          fi

          sleep 5
        done

        echo "✅ $package installed successfully."
      }

      install_with_snap_retry kubectl

      until which rke2 >/dev/null 2>&1; do
        curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION=${k8s_version} sh -;
        sleep 5
      done

      until which helm >/dev/null 2>&1; do
        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash;
        sleep 5
      done

      echo "🔌 Enabling QEMU guest agent..."
      systemctl start qemu-guest-agent
      systemctl enable qemu-guest-agent

  - path: /etc/systemd/system/setup-runtime.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install Docker, Snapd, RKE2, Helm, kubectl
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/30-setup-runtime.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/40-bootstrap-rke2.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "⚙️ Bootstrapping RKE2 configuration..."
      mkdir -p /etc/rancher/rke2
      cp /mnt/shared-storage/config.yaml /etc/rancher/rke2/config.yaml

      sudo mkdir -p /etc/systemd/system/rke2-server.service.d/

      sudo tee -a /etc/rancher/rke2/config.yaml << 'EOF'
      # ────────────────────────────────────────────────────────────────────────
      # RKE2 Configuration: Admission Plugins + Kubelet NUMA-aware Settings
      # ────────────────────────────────────────────────────────────────────────

      kube-apiserver-arg:
        - "enable-admission-plugins=PodNodeSelector"

      kubelet-arg:
        - "max-pods=${SRVR_NODE_MAX_PODS}"
        - "--cpu-manager-policy=static"
        - "--topology-manager-policy=restricted"
        - "--reserved-cpus=0,1"
      EOF

      systemctl enable rke2-server
      systemctl start rke2-server

      echo "🗑️ Cleaning previous RKE2 tokens..."
      rm -rf /mnt/shared-storage/*.token

      RKE2_TOKEN=$(cat /var/lib/rancher/rke2/server/node-token)
      echo $RKE2_TOKEN > /mnt/shared-storage/$(hostname -I | cut -d" " -f1).token

      until sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml version; do
        echo "Waiting for kube-apiserver to respond..."
        sleep 10
      done

      echo "⏳ Waiting for all 4 nodes to become Ready..."
      while [[ $(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --no-headers | awk '$2 != "Ready" {exit 1} END {print NR}') -ne 4 ]]; do
        echo "Waiting for all 4 nodes to be Ready..."
        sleep 60
      done
      echo "✅ All nodes are Ready!"
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node srvr-node dedicated=srvr-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node etcd-node dedicated=etcd-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node dedicated=work-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node ctrl-node dedicated=ctrl-node --overwrite

  - path: /etc/systemd/system/bootstrap-rke2.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Copy RKE2 config and expose node-token
      After=setup-runtime.service
      Requires=setup-runtime.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/40-bootstrap-rke2.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/99-set-nofile-limits.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Increasing open file limits to 1048576..."

      echo "📄 Updating PAM limits..."
      tee /etc/security/limits.d/99-nofile.conf > /dev/null <<EOF
      * soft nofile 1048576
      * hard nofile 1048576
      root soft nofile 1048576
      root hard nofile 1048576
      EOF

      echo "📄 Updating system.conf.d for global systemd limits..."
      mkdir -p /etc/systemd/system.conf.d
      tee /etc/systemd/system.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "📄 Updating user.conf.d..."
      mkdir -p /etc/systemd/user.conf.d
      tee /etc/systemd/user.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for rke2-server..."
      mkdir -p /etc/systemd/system/rke2-server.service.d
      tee /etc/systemd/system/rke2-server.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for containerd..."
      mkdir -p /etc/systemd/system/containerd.service.d
      tee /etc/systemd/system/containerd.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "🔁 Reloading systemd..."
      systemctl daemon-reload

      systemctl restart rke2-server || true
      systemctl restart containerd || true

      echo "✅ Verifying limits..."
      ulimit -n
      cat /proc/$(pgrep -f kubelet | head -n 1)/limits | grep "Max open files"

  - path: /etc/systemd/system/set-nofile-limits.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Raise nofile limit for rke2 and containerd
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/99-set-nofile-limits.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/50-k8s-addons.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
      NS="kube-system"
      CM_NAME="rke2-coredns-rke2-coredns"
      DEPLOYMENT_NAME="rke2-coredns-rke2-coredns"
      TMP_FILE="/tmp/coredns-patch.yaml"

      echo "🔍 Fetching current CoreDNS config..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NS" get configmap "$CM_NAME" -o yaml > "$TMP_FILE"

      echo "🛠 Patching CoreDNS ConfigMap to prioritize internal.lan..."
      # Replace the line with the kubernetes plugin configuration
      sudo sed -i 's/kubernetes .*cluster.local/kubernetes internal.lan cluster.local/' "$TMP_FILE"

      echo "📦 Applying patched ConfigMap..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NS" apply -f "$TMP_FILE"

      echo "🚀 Restarting CoreDNS deployment..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NS" rollout restart deployment "$DEPLOYMENT_NAME"

      echo "⏳ Waiting for CoreDNS to be ready..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NS" rollout status deployment "$DEPLOYMENT_NAME" --timeout=60s

      echo "✅ CoreDNS patch complete and ready."

      echo "📥 Installing Cert-Manager..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager -n cert-manager
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager-webhook -n cert-manager

      echo "📥 Installing MetalLB..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/metallb/metallb/v0.13.10/config/manifests/metallb-native.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/controller -n metallb-system

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
        name: default
        namespace: metallb-system
      spec:
        addresses:
          - 10.0.0.110-10.0.0.150
      ---
      apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
        name: default
        namespace: metallb-system
      EOF

      echo "📥 Installing Longhorn..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/longhorn/longhorn/master/deploy/longhorn.yaml

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn
        annotations:
          storageclass.kubernetes.io/is-default-class: 'true'
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Retain
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn-rwx
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Retain
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
        fromBackup: ''
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: ephemeral-fast
      provisioner: kubernetes.io/no-provisioner
      volumeBindingMode: WaitForFirstConsumer
      reclaimPolicy: Delete
      EOF

  - path: /etc/systemd/system/k8s-addons.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install K8s Add-ons (Cert-Manager, MetalLB, Longhorn)
      After=bootstrap-rke2.service
      Requires=bootstrap-rke2.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/50-k8s-addons.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/60-install-apisix-rancher.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      echo "📦 Installing NGINX Ingress Controller..."

      # 1. Create your values.yaml inline
      cat <<EOF > /tmp/ingress-values.yaml
      controller:
        allowSnippetAnnotations: true
        service:
          loadBalancerIP: "10.0.0.110"
        config:
          ssl-redirect: "false"
        deployment:
          minReadySeconds: 30
          # omit progressDeadlineSeconds so default is used (likely 600)
      EOF

      # 2. Render the chart locally to YAML
      # ─── Tunables ────────────────────────────────────────────────────────────
      MAX_ATTEMPTS=0          # 0 = retry forever ─ change to e.g. 30 to give up eventually
      SLEEP_SECONDS=10
      VALUES_FILE=/tmp/ingress-values.yaml
      RENDER_FILE=/tmp/ingress-rendered.yaml
      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      # ─────────────────────────────────────────────────────────────────────────

      attempt=0
      while :; do
        attempt=$(( attempt + 1 ))
        echo "▶️  [$attempt] Rendering ingress-nginx chart …"

        if sudo helm --kubeconfig "$KUBECONFIG" \
              template ingress-nginx ingress-nginx \
              --repo https://kubernetes.github.io/ingress-nginx \
              --namespace ingress-nginx \
              --values "$VALUES_FILE" > "$RENDER_FILE.tmp"; then
          mv "$RENDER_FILE.tmp" "$RENDER_FILE"
          echo "✅  Render succeeded on attempt #$attempt"
          break
        fi

        # Give up if we hit the hard limit (unless MAX_ATTEMPTS=0 → infinite)
        if [[ $MAX_ATTEMPTS -ne 0 && $attempt -ge $MAX_ATTEMPTS ]]; then
          echo "❌  Helm template failed after $attempt attempts"
          exit 1
        fi

        echo "🔄  Helm template failed — retrying in $SLEEP_SECONDS …"
        sleep "$SLEEP_SECONDS"
      done

      # 3. Fix invalid `progressDeadlineSeconds: 0` manually:
      sed -i 's/progressDeadlineSeconds: 0/progressDeadlineSeconds: 600/' /tmp/ingress-rendered.yaml

      # 4. Create namespace (if needed)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace ingress-nginx --dry-run=client -o yaml | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 5. Apply manifests directly (bypass Helm install)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f /tmp/ingress-rendered.yaml --validate=false

      # Wait for the NGINX ingress controller to be ready
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/ingress-nginx-controller -n ingress-nginx

      echo "🛠️ Assigning LoadBalancer IP 10.0.0.110 to ingress-nginx-controller..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch svc ingress-nginx-controller -n ingress-nginx \
        --type='merge' \
        -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.110"}}'

      echo "🏗️ Installing Rancher..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add rancher-stable https://releases.rancher.com/server-charts/stable --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo helm repo update
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace cattle-system || true

      openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout tls.key -out tls.crt -subj "/CN=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}/O=Rancher Self-Signed"

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system create secret tls tls-rancher-ingress \
        --cert=tls.crt --key=tls.key

      sudo helm upgrade --install rancher rancher-stable/rancher \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        --namespace cattle-system \
        --set hostname=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN} \
        --set bootstrapPassword=$(openssl rand -base64 18) \
        --set ingress.tls.source=rancher \
        --set ingress.enabled=true 

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/rancher -n cattle-system

      cat <<EOF | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: infrastructure
        namespace: local
        labels:
          field.cattle.io/projectId: infrastructure
      spec:
        displayName: "Infrastructure"
        description: "Infrastructure Project for Rancher and Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: applications
        namespace: local
        labels:
          field.cattle.io/projectId: applications
      spec:
        displayName: "Applications"
        description: "Project for Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: GlobalRoleBinding
      metadata:
        name: github-k8s-cluster-admins
        labels:
          auth-provider: github
      globalRoleName: admin
      groupPrincipalName: 'github_team:${GITHUB_AUTH_VAL}'
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: github-team-cluster-admins
      subjects:
        - kind: Group
          name: 'github_team:${GITHUB_AUTH_VAL}'  # Replace with your team
          apiGroup: rbac.authorization.k8s.io
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      ---
      apiVersion: management.cattle.io/v3
      kind: ClusterRoleTemplateBinding
      metadata:
        name: github-team-cluster-owner
        namespace: local            # Adjust if your cluster name is different
      clusterName: local            # Adjust if your cluster name is different
      groupName: 'github_team:${GITHUB_AUTH_VAL}'
      roleTemplateName: cluster-owner
      ---
      accessMode: required
      apiVersion: management.cattle.io/v3
      kind: AuthConfig
      metadata:
        name: github
        namespace: cattle-system
      enabled: true
      displayName: GitHub Authentication
      clientId: '${GITHUB_CLIENT_ID}'
      clientSecret: '${GITHUB_CLIENT_SECRET}'
      hostname: 'github.com'
      tls: true
      type: githubConfig
      logoutAllSupported: false
      rancherUrl: 'https://${RANCHER_HOSTNAME}.{RANCHER_DOMAIN}'
      allowedPrincipalIds:
        - 'github_team:${GITHUB_AUTH_VAL}'
      scopes:
        - 'read:user'
        - 'user:email'
        - 'read:org'
      ---
      apiVersion: management.cattle.io/v3
      kind: Setting
      metadata:
        name: auth-provider
      value: github
      EOF

      echo "⏳ Waiting for Rancher webhook pod to be created..."

      # Wait until a pod with the correct label appears
      while ! sudo kubectl get pod -n cattle-system -l app=rancher-webhook --no-headers --kubeconfig=/etc/rancher/rke2/rke2.yaml | grep -q .; do
        echo "🔄 Pod not found yet..."
        sleep 60
      done

      echo "⏳ Pod found. Waiting for Rancher webhook pod to become Ready..."

      echo "⏳ Waiting for Rancher webhook pod to become Ready..."
      sudo kubectl wait \
        --for=condition=Ready pod -l app=rancher-webhook \
        -n cattle-system \
        --timeout=1800s \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml || {
          echo "❌ Rancher webhook pod did not become Ready in time"
          exit 1
      }

      echo "⏳ Waiting for Rancher webhook endpoint to become healthy..."

      while true; do
        if ! sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml &>/dev/null; then
          echo "🔄 Endpoint not found yet..."
        elif sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml \
                -o jsonpath="{.subsets[*].addresses[*].ip}" | grep -qE '([0-9]{1,3}\.){3}[0-9]{1,3}'; then
          echo "✅ Rancher webhook is ready"
          break
        else
          echo "🔄 Endpoint exists but has no ready IPs yet..."
        fi
        sleep 10
      done

      echo "🔧 Patching all Rancher webhooks with timeoutSeconds=30..."

      # Extract webhook indices and names using jq
      mapfile -t WEBHOOKS < <(
        sudo kubectl get validatingwebhookconfiguration rancher.cattle.io \
          -o=json \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml |
          jq -r '.webhooks | to_entries[] | "[" + (.key|tostring) + "] " + .value.name'
      )

      # Build JSON patch
      PATCHES=""
      SEP=""
      for entry in "$WEBHOOKS[@]"; do
        index=$(echo "$entry" | grep -oP '^\[\K[0-9]+')
        name=$(echo "$entry" | cut -d' ' -f2-)
        echo "  → Patching webhook [$index]: $name"
        PATCHES="$PATCHES$SEP{\"op\": \"replace\", \"path\": \"/webhooks/$index/timeoutSeconds\", \"value\": 30}"
        SEP=","
      done

      PATCH_JSON="[$PATCHES]"

      # Apply the patch
      sudo kubectl patch validatingwebhookconfiguration rancher.cattle.io \
        --type=json \
        -p="$PATCH_JSON" \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace metallb-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace longhorn-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system patch nodedriver linode \
        --type=merge \
        -p '{"spec":{"active":false}}'

      # 4. Add Linode node driver
      echo "⚙️ Installing Linode node driver..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f - <<EOF
      apiVersion: management.cattle.io/v3
      kind: NodeDriver
      metadata:
        name: linode
        namespace: cattle-system
      spec:
        active: true
        builtin: false
        url: "${LINODE_DRIVER_URL}"
        checksum: ""
        displayName: "Linode"
        uiUrl: "https://unpkg.com/rancher-ui-driver-none@0.2.0/component.js"
      EOF

      echo "✔️ Node driver added"

      echo "⏳ Waiting for Rancher to register 'linodecredentialConfig' schema..."
      until curl -sk \
        -H "Authorization: Bearer $( \
            curl -sk "https://10.0.0.110/v3-public/localProviders/local?action=login" \
              -H 'Content-Type: application/json' \
              -H "Host: ${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}" \
              -d "{\"username\":\"admin\",\"password\":\"$( \
                    sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get secret bootstrap-secret \
                      -o jsonpath='{.data.bootstrapPassword}' | base64 -d | tr -d '\n' \
                  )\"}" \
            | jq -r .token \
          )" \
        -H "Host: ${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}" \
        https://10.0.0.110/v3/schemas | grep -q linodecredentialConfig; do
        sleep 60
      done
      echo "✅ 'linodecredentialConfig' schema registered."

      echo "📥 Installing Linode token..."
      curl -sk -X POST "https://10.0.0.110/v3/cloudcredentials" \
        -H "Authorization: Bearer $( \
            curl -sk "https://10.0.0.110/v3-public/localProviders/local?action=login" \
              -H 'Content-Type: application/json' \
              -H "Host: ${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}" \
              -d "{\"username\":\"admin\",\"password\":\"$( \
                    sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get secret bootstrap-secret \
                      -o jsonpath='{.data.bootstrapPassword}' | base64 -d | tr -d '\n' \
                  )\"}" \
            | jq -r .token \
          )" \
        -H 'Content-Type: application/json' \
        -H "Host: ${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}" \
        -d "{
          \"name\": \"suncoast-systems-dotcomrow-credential\",
          \"type\": \"cloudCredential\",
          \"linodecredentialConfig\": {
            \"token\": \"${LINODE_TOKEN}\"
          }
        }"

      echo "✔️ Cloud credential created"

      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      K="sudo -E kubectl --kubeconfig=$KUBECONFIG"

      echo "🔍 Locating ClusterRoleTemplateBinding for local:// user..."

      BINDING_NAME=$($K get clusterroletemplatebindings.management.cattle.io -n local -o json \
        | jq -r '.items[] 
          | select(.userPrincipalName? // "" | startswith("local://")) 
          | select(.roleTemplateName == "cluster-owner") 
          | .metadata.name')

      if [[ -n "$BINDING_NAME" ]]; then
        echo "⚠️  Found local admin binding: $BINDING_NAME — Deleting it..."
        $K delete clusterroletemplatebindings.management.cattle.io "$BINDING_NAME" -n local
      else
        echo "✅ No local:// cluster-owner binding found — nothing to remove."
      fi

      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get users.management.cattle.io -o jsonpath='{range .items[?(@.username=="admin")]}{.metadata.name}{"\n"}{end}' | \
      xargs -I {} sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        delete users.management.cattle.io {}

      bash -c "sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch settings.management.cattle.io first-login --type='merge' -p '{\"value\": \"admin\"}'"
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml rollout restart deployment rancher -n cattle-system

      until sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/local/bin/yq; do
        echo "Retry on failed download of yq..."
        sleep 5
      done
      sudo chmod +x /usr/local/bin/yq

      export HOME=/home/ubuntu

      curl -sL https://run.linkerd.io/install | sh -s -- --version version-2.18
      sudo cp ~/.linkerd2/bin/linkerd /usr/local/bin/

      # Wait for the deployment to appear
      until sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get deployment rancher-webhook -n cattle-system >/dev/null 2>&1; do
        echo "⏳ Waiting for rancher-webhook deployment to appear..."
        sleep 5
      done

      echo "⏳ Waiting for Rancher webhook pod to become ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Available deployment/rancher-webhook -n cattle-system --timeout=120s
      echo "✅ Rancher webhook is ready."

      # Confirm version matches
      sudo linkerd version --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd-viz
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd-jaeger

      sudo kubectl annotate namespace linkerd field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace linkerd scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate ns linkerd linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-viz linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-jaeger linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      echo "📥 Installing Gateway API CRDs..."
      # sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/standard-install.yaml
            
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/experimental-install.yaml

      # 2) Install the CRDs
      sudo linkerd install --crds \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      sudo linkerd install \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
        --set clusterNetworks="10.42.0.0/16\,10.43.0.0/16" \
        --set proxyInit.ignoreOutboundPorts="4567\,4568\,4317\,2379" \
        --set proxy.tracing.enabled=true \
        --set proxy.tracing.collector.endpoint="collector.linkerd-jaeger.svc.cluster.local:55678" \
        --set proxy.tracing.collector.scheme="opencensus" \
        | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 4) Wait for Linkerd to come up
      sudo linkerd check --kubeconfig /etc/rancher/rke2/rke2.yaml

      # Install Jaeger extension with collector config
      cat <<EOF | sudo tee /tmp/linkerd-jaeger-values.yaml
      collector:
        enabled: true
        useOtel: true
        config:
          receivers:
            opencensus:
              endpoint: 0.0.0.0:55678
          processors:
            batch: {}
            k8sattributes: {}
          exporters:
            jaeger:
              endpoint: jaeger.linkerd-jaeger.svc.cluster.local:14250
              tls:
                insecure: true
          service:
            pipelines:
              traces:
                receivers: [opencensus]
                processors: [batch, k8sattributes]
                exporters: [jaeger]
      ui:
        tls:
          enabled: false
        auth:
          enabled: false
      EOF

      # After generating the Jaeger manifest
      sudo linkerd jaeger install -f /tmp/linkerd-jaeger-values.yaml \
        --kubeconfig /etc/rancher/rke2/rke2.yaml > /tmp/jaeger-install.yaml

      sudo yq -i '
        (. | select(.kind == "Deployment" and .metadata.name == "collector") |
          .spec.template.metadata.annotations["linkerd.io/inject"]) = "disabled" |
        (. | select(.kind == "Deployment" and .metadata.name == "jaeger") |
          .spec.template.metadata.annotations["linkerd.io/inject"]) = "disabled"
      ' /tmp/jaeger-install.yaml

      # Apply the patched manifest
      sudo kubectl apply -f /tmp/jaeger-install.yaml --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # Wait for rollout to complete after patch
      sudo kubectl rollout status deploy/jaeger -n linkerd-jaeger --kubeconfig /etc/rancher/rke2/rke2.yaml

      sudo linkerd jaeger check --kubeconfig /etc/rancher/rke2/rke2.yaml

      # 6) Install the Viz extension (dashboard + embedded Jaeger UI),
      #    disabling *only* the dashboard’s TLS + auth
      sudo linkerd viz install \
        --set dashboard.tls.enabled=false \
        --set dashboard.auth.enabled=false \
        --set jaeger.enabled=true \
        --set dashboard.enforcedHostRegexp=".*" \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 7) Tell Linkerd this namespace hosts the viz extension
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        label ns linkerd-viz linkerd.io/extension=viz --overwrite

      # 8) Validate the viz extension
      sudo linkerd viz check --kubeconfig /etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n linkerd-viz set env deployment/web LINKERD_DASHBOARD_ALLOW_ORIGIN="*"

      sudo kubectl rollout status deploy/web -n linkerd-viz --kubeconfig /etc/rancher/rke2/rke2.yaml

      echo "Installing Kyverno..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace kyverno || true
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace policy-reporter || true
      
      sudo kubectl annotate namespace kyverno field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace kyverno scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add kyverno https://kyverno.github.io/kyverno/ --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update
      echo "Installing Kyverno..."
      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Policy Reporter..."
        sudo helm install kyverno kyverno/kyverno -n kyverno --create-namespace --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      echo "Installing policy reporter..."
      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add policy-reporter https://kyverno.github.io/policy-reporter --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Policy Reporter..."
        sudo helm install policy-reporter policy-reporter/policy-reporter \
          -n policy-reporter --create-namespace \
          --set ui.enabled=true \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      echo "📦 Adding Helm repos for APISIX and Bitnami..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add apisix https://charts.apiseven.com --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add bitnami https://charts.bitnami.com/bitnami --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      sudo kubectl create namespace apisix --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace apisix field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace apisix linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
    
      echo "🚀 Installing APISIX Gateway and Dashboard..."
      sudo helm upgrade --install apisix apisix/apisix \
        --version 2.10.1 \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        --namespace apisix \
        --set service.type=NodePort \
        --set ingress-controller.enabled=true \
        --set ingress-controller.config.apisix.serviceNamespace=apisix \
        --set ingress-controller.config.kubernetes.enableGatewayAPI=true \
        --set ingress-controller.args[0]="ingress-apisix" \
        --set ingress-controller.args[1]="--namespace-selector=" \
        --set config.enable_ipv6=false \
        --set-string config.nginx_config.http_listen="[127.0.0.1:9080]" \
        --set-string config.nginx_config.ssl.listen="[127.0.0.1:9443]" \
        --set-string config.nginx_config.stream_proxy.tcp="[]" \
        --set-string config.nginx_config.stream_proxy.udp="[]" \
        --set extraEnv[0].name=APISIX_ENABLE_IPV6 \
        --set extraEnv[0].value="false" \
        --set config.plugins="{api-breaker,authz-keycloak,cors,echo,openid-connect,prometheus,proxy-rewrite,real-ip}"

      sudo apt install yq jq -y
      NAMESPACE="apisix"
      CONFIGMAP_NAME="apisix"
      KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
      TMP_FILE="$HOME/disable-ipv6-apisix.yaml"

      echo "📦 Exporting current config..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get configmap "$CONFIGMAP_NAME" \
        -o jsonpath='{.data.config\.yaml}' > "$TMP_FILE"

      echo "🛠 Patching enable_ipv6: false..."
      sudo yq -i '.apisix.enable_ipv6 = false' "$TMP_FILE"


      echo "🚀 Updating ConfigMap..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" create configmap "$CONFIGMAP_NAME" \
        --from-file=config.yaml="$TMP_FILE" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig "$KUBECONFIG" apply -f -

      echo "🔥 Restarting APISIX pod..."
      sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" delete pod -l app.kubernetes.io/name=apisix

      echo "✅ IPv6 disabled and pod restarted."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch service apisix-gateway --namespace apisix --type 'merge'         -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.112"}}'

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install APISIX Dashboard..."
        sudo helm install apisix-dashboard apisix/apisix-dashboard --namespace apisix --set replicaCount=1 --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install APISIX Dashboard after $RETRIES attempts." >&2
        exit 1
      fi     

      echo "⏳ Waiting for APISIX components..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-ingress-controller -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-dashboard -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix -n apisix

      echo "🚀 Deploying OAuth2 Proxy..."
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: apisix
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://apisix-dashboard.apisix.svc.cluster.local
                  - --email-domain=*
                  - --cookie-secret=${OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${GATEWAY_MANAGER_OAUTH2_CLIENT_ID}
                  - --client-secret=${GATEWAY_MANAGER_OAUTH2_CLIENT_SECRET}
                  - --redirect-url=https://gateway-manager.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --allowed-group=${GITHUB_ORG}:k8s_cluster_admins
      EOF

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: apisix
      spec:
        ports:
          - port: 80
            targetPort: 4180
        type: LoadBalancer
        loadBalancerIP: 10.0.0.111
        selector:
          app: oauth2-proxy
      EOF

      # --- Enable real client IP extraction everywhere ---------------------------
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: real-ip-global
      spec:
        plugins:
          - name: real-ip
            enable: true
            config:
              # read the address that HAProxy appends
              source: http_x_forwarded_for
              recursive: true                
              trusted_addresses:
                - "10.0.0.0/24"              
      EOF

  - path: /etc/systemd/system/install-apisix-rancher.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install APISIX Gateway, OAuth2 Proxy, Rancher
      After=k8s-addons.service
      Requires=k8s-addons.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/60-install-apisix-rancher.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/70-gpu.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      echo "⚙️ Labeling node for GPU support..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node         nvidia.com/gpu.present=true         nvidia.com/gpu=1 --overwrite

      echo "📥 Installing NVIDIA Helm repos..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvdp https://nvidia.github.io/k8s-device-plugin --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvidia https://helm.ngc.nvidia.com/nvidia --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      echo "📥 Creating nvidia namespace..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace nvidia || true
      sudo kubectl annotate namespace nvidia field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # echo "📦 Creating GPU time-slicing config..."
      # cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      # apiVersion: v1
      # kind: ConfigMap
      # metadata:
      #   name: time-slicing-config
      #   namespace: nvidia
      # data:
      #   any: |-
      #     version: v1
      #     flags:
      #       migStrategy: none
      #     sharing:
      #       timeSlicing:
      #         renameByDefault: true
      #         resources:
      #           - name: nvidia.com/gpu
      #             replicas: 4
      # EOF

      echo "🚀 Installing GPU Operator..."
      sudo helm upgrade -i gpu-operator nvidia/gpu-operator \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n nvidia \
        --wait \
        --version=v24.9.2 \
        --set driver.enabled=false \
        --set toolkit.env[0].name=CONTAINERD_SOCKET \
        --set toolkit.env[0].value="/run/k3s/containerd/containerd.sock" \
        --set devicePlugin.env[0].name=HOST_ULIMIT \
        --set-string devicePlugin.env[0].value="1048576" 

      # echo "🔧 Patching GPU Operator default config..."
      # sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch clusterpolicies.nvidia.com/cluster-policy         \
      #     -n gpu-operator --type merge        \
      #     -p '{"spec": {"devicePlugin": {"config": {"name": "time-slicing-config", "default": "any"}}}}'

  - path: /etc/systemd/system/gpu.service
    permissions: '0644'
    content: |
      [Unit]
      Description=GPU Operator Bootstrap
      After=install-apisix-rancher.service
      Requires=install-apisix-rancher.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/70-gpu.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/80-post-install.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /root/.bashrc && echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /home/ubuntu/.bashrc

      sudo helm repo add nfd https://kubernetes-sigs.github.io/node-feature-discovery/charts --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo helm install nfd nfd/node-feature-discovery \
        -n node-feature-discovery \
        --create-namespace \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        --set topologyUpdater.enabled=true

      sudo kubectl annotate namespace node-feature-discovery field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      cat << 'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: scheduler-plugins
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "dedicated=srvr-node"
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: scheduler-sa
        namespace: scheduler-plugins
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: scheduler-config
        namespace: scheduler-plugins
      data:
        scheduler-config.yaml: |
          apiVersion: kubescheduler.config.k8s.io/v1beta3
          kind: KubeSchedulerConfiguration
          profiles:
            - schedulerName: topology-aware-scheduler
              plugins:
                score:
                  enabled:
                    - name: NodeResourcesFit
                    - name: NodeAffinity
                  disabled:
                    - name: '*'
                filter:
                  enabled:
                    - name: NodeUnschedulable
                    - name: NodeName
                    - name: NodeAffinity
                    - name: TaintToleration
                  disabled:
                    - name: '*'
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: scheduler-plugins
        namespace: scheduler-plugins
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: scheduler-plugins
        template:
          metadata:
            labels:
              app: scheduler-plugins
          spec:
            serviceAccountName: scheduler-sa
            containers:
              - name: scheduler
                image: registry.k8s.io/scheduler-plugins/kube-scheduler:v0.28.9
                command: ["kube-scheduler"]
                args:
                  - "--config=/etc/kubernetes/scheduler-config.yaml"
                  - "--v=3"
                volumeMounts:
                  - name: scheduler-config
                    mountPath: /etc/kubernetes
                    readOnly: true
            volumes:
              - name: scheduler-config
                configMap:
                  name: scheduler-config
      ---
      apiVersion: scheduling.k8s.io/v1
      kind: PriorityClass
      metadata:
        name: topology-aware-critical
      value: 1000000000
      globalDefault: false
      description: "Priority class for topology-aware scheduler"
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: scheduler-plugins
      rules:
        - apiGroups: [""]
          resources:
            - pods
            - nodes
            - configmaps
            - services
            - persistentvolumeclaims
            - persistentvolumes
            - replicationcontrollers
            - namespaces
            - resourcequotas
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources:
            - events
          verbs: ["create", "patch", "update"]
        - apiGroups: ["apps"]
          resources:
            - replicasets
            - replicasets/status
            - statefulsets
            - statefulsets/status
            - deployments
            - deployments/status
            - daemonsets
            - daemonsets/status
          verbs: ["get", "list", "watch"]
        - apiGroups: ["autoscaling"]
          resources:
            - horizontalpodautoscalers
          verbs: ["get", "list", "watch"]
        - apiGroups: ["policy"]
          resources:
            - poddisruptionbudgets
            - poddisruptionbudgets/status
          verbs: ["get", "list", "watch"]
        - apiGroups: ["storage.k8s.io"]
          resources:
            - csidrivers
            - csinodes
            - csistoragecapacities
            - storageclasses
          verbs: ["get", "list", "watch"]
        - apiGroups: ["flowcontrol.apiserver.k8s.io"]
          resources:
            - flowschemas
            - prioritylevelconfigurations
          verbs: ["get", "list", "watch"]
        - apiGroups: ["node.k8s.io"]
          resources:
            - runtimeclasses
          verbs: ["get", "list", "watch"]
        - apiGroups: ["coordination.k8s.io"]               # ✅ NEW for leader election
          resources:
            - leases
          verbs: ["get", "list", "watch", "create", "update", "patch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: scheduler-plugins
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: scheduler-plugins
      subjects:
        - kind: ServiceAccount
          name: scheduler-sa
          namespace: scheduler-plugins
      EOF

      # adding apisix routes for linkerd and jaeger
      cat << 'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: apisix-ingress-controller
      rules:
        - apiGroups: ["apisix.apache.org"]
          resources:
            - apisixroutes
            - apisixpluginconfigs
            - apisixconsumers
            - apisixclusterconfigs
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["services", "endpoints", "pods", "namespaces"]
          verbs: ["get", "list", "watch"]
        - apiGroups: ["networking.k8s.io"]
          resources: ["ingresses", "ingressclasses"]
          verbs: ["get", "list", "watch"]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy-jaeger
        namespace: linkerd-jaeger
        labels:
          app: oauth2-proxy-jaeger
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy-jaeger
        template:
          metadata:
            labels:
              app: oauth2-proxy-jaeger
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://jaeger.linkerd-jaeger.svc.cluster.local:16686
                  - --email-domain=*
                  - --cookie-secret=${JAEGER_OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${JAEGER_CLIENT_ID}
                  - --client-secret=${JAEGER_CLIENT_SECRET}
                  - --redirect-url=https://jaeger.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --set-authorization-header=true
                  - --pass-authorization-header=true
                  - --allowed-group=${GITHUB_ORG}:linkerd_admins
                ports:
                  - containerPort: 4180
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy-jaeger
        namespace: linkerd-jaeger
      spec:
        selector:
          app: oauth2-proxy-jaeger
        ports:
          - name: http
            port: 80
            targetPort: 4180
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://web.linkerd-viz.svc.cluster.local:8084
                  - --email-domain=*
                  - --cookie-secret=${LINKERD_OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${LINKERD_CLIENT_ID}
                  - --client-secret=${LINKERD_CLIENT_SECRET}
                  - --redirect-url=https://linkerd.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --set-authorization-header=true
                  - --pass-authorization-header=true
                  - --allowed-group=${GITHUB_ORG}:linkerd_admins
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
      spec:
        selector:
          app: oauth2-proxy
        ports:
          - name: http
            port: 80
            targetPort: 4180
      ---
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: jaeger-ui
        namespace: linkerd-jaeger
        annotations:
          apisix.apache.org/timeout: "900"
          apisix.apache.org/websocket: "true"
          apisix.apache.org/enable-cors: "true"
      spec:
        ingressClassName: apisix
        http:
          - name: jaeger-auth
            match:
              hosts:
                - jaeger.${RANCHER_DOMAIN}
              paths:
                - "/"
                - "/oauth2/*"
                - "/jaeger/*"
            backends:
              - serviceName: oauth2-proxy-jaeger
                servicePort: 80
          - name: jaeger-websocket
            websocket: true
            match:
              hosts:
                - jaeger.${RANCHER_DOMAIN}
              paths:
                - "/api/*"
                - "/metrics/*"
            backends:
              - serviceName: jaeger
                servicePort: 16686
      ---
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: linkerd-dashboard
        namespace: linkerd-viz
        annotations:
          apisix.apache.org/timeout: "900"
          apisix.apache.org/websocket: "true"
          apisix.apache.org/enable-cors: "true"
      spec:
        ingressClassName: apisix
        http:
          - name: protected-ui
            match:
              hosts:
                - linkerd.${RANCHER_DOMAIN}
              paths:
                - "/"
                - "/oauth2/*"
                - "/dist/*"
            backends:
              - serviceName: oauth2-proxy
                servicePort: 80
            plugins:
              - name: proxy-rewrite
                enable: true
                config:
                  host: web.linkerd-viz.svc.cluster.local
          - name: direct-linkerd
            websocket: true
            match:
              hosts:
                - linkerd.${RANCHER_DOMAIN}
              paths:
                - "/api/*"
                - "/metrics/*"
                - "/ws/*"
                - "/tap/*"
                - "/profiles/*"
                - "/routes/*"
            backends:
              - serviceName: linkerd-web-proxy
                servicePort: 80
            plugins:
              - name: proxy-rewrite
                enable: true
                config:
                  host: web.linkerd-viz.svc.cluster.local
                  headers:
                    set: '{"Origin": "http://localhost"}'
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: linkerd-web-proxy
        template:
          metadata:
            labels:
              app: linkerd-web-proxy
          spec:
            containers:
              - name: nginx
                image: nginx:stable
                ports:
                  - containerPort: 80
                volumeMounts:
                  - name: nginx-config
                    mountPath: /etc/nginx/nginx.conf
                    subPath: nginx.conf
            volumes:
              - name: nginx-config
                configMap:
                  name: linkerd-web-proxy-config
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: linkerd-web-proxy-config
        namespace: linkerd-viz
      data:
        nginx.conf: |
          events {}

          http {
            map $http_upgrade $origin_override {
              default     "";
              websocket   "http://localhost";
            }

            server {
              listen 80;

              access_log /var/log/nginx/access.log;
              error_log  /var/log/nginx/error.log debug;

              location / {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                proxy_set_header Origin $origin_override;

                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
              }

              location /api/tap {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                # 🔥 Remove Origin entirely to bypass CheckOrigin() on /api/tap
                proxy_set_header Origin "";
              }
            }
          }
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        selector:
          app: linkerd-web-proxy
        ports:
          - name: http
            port: 80
            targetPort: 80
      ---
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: kyverno-ui
        namespace: policy-reporter
      spec:
        ingressClassName: apisix
        http:
          - name: ui
            match:
              hosts:
                - policy-reporter.${RANCHER_DOMAIN}
              paths:
                - /*
            backends:
              - serviceName: policy-reporter-ui
                servicePort: 8080
      EOF
      # end apisix routes for linkerd and jaeger

      # Installing NFS system
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: nfs-system
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "dedicated=srvr-node"
      ---
      # PVC for backing NFS server
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: nfs-storage
        namespace: nfs-system
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: ${NFS_DRIVE_STORAGE}
      ---
      # NFS Server Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-server
        template:
          metadata:
            labels:
              app: nfs-server
          spec:
            containers:
              - name: nfs-server
                image: erichough/nfs-server:latest
                securityContext:
                  privileged: true
                resources:
                  limits:
                    memory: "256Mi"
                    cpu: "500m"
                  requests:
                    memory: "128Mi"
                    cpu: "250m"
                env:
                  - name: NFS_EXPORT_0
                    value: "/export *(rw,sync,no_subtree_check,no_root_squash)"
                  - name: MOUNTD_PORT
                    value: "20048"
                  - name: STATD_PORT
                    value: "32765"
                  - name: STATD_OUTGOING_PORT
                    value: "32766"
                ports:
                  - name: nfs
                    containerPort: 2049
                    protocol: TCP
                  - name: mountd
                    containerPort: 20048
                    protocol: TCP
                  - name: rpcbind
                    containerPort: 111
                    protocol: TCP
                  - name: statd
                    containerPort: 32765
                    protocol: TCP
                  - name: statd-listen
                    containerPort: 32766
                    protocol: TCP
                volumeMounts:
                  - mountPath: /export
                    name: nfs-volume
            volumes:
              - name: nfs-volume
                persistentVolumeClaim:
                  claimName: nfs-storage
      ---
      # Headless Service for the NFS Server (for DNS)
      apiVersion: v1
      kind: Service
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        clusterIP: None
        selector:
          app: nfs-server
        ports:
          - name: nfs
            port: 2049
            targetPort: 2049
            protocol: TCP
          - name: mountd
            port: 20048
            targetPort: 20048
            protocol: TCP
          - name: rpcbind
            port: 111
            targetPort: 111
            protocol: TCP
          - name: rpcbind-udp
            port: 111
            targetPort: 111
            protocol: UDP
          - name: statd
            port: 32765
            targetPort: 32765
            protocol: TCP
          - name: statd-udp
            port: 32765
            targetPort: 32765
            protocol: UDP
          - name: statd-listen
            port: 32766
            targetPort: 32766
            protocol: TCP
          - name: statd-listen-udp
            port: 32766
            targetPort: 32766
            protocol: UDP
      ---
      # NFS Provisioner RBAC
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: nfs-client-provisioner-runner
      rules:
        - apiGroups: [""]
          resources: ["persistentvolumes"]
          verbs: ["get", "list", "watch", "create", "delete"]
        - apiGroups: [""]
          resources: ["persistentvolumeclaims"]
          verbs: ["get", "list", "watch", "update"]
        - apiGroups: [""]
          resources: ["endpoints"]  # 👈 ADD THIS
          verbs: ["get", "list", "watch", "create", "update"]
        - apiGroups: ["storage.k8s.io"]
          resources: ["storageclasses"]
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["events"]
          verbs: ["create", "update", "patch"]
      ---
      kind: ClusterRoleBinding
      apiVersion: rbac.authorization.k8s.io/v1
      metadata:
        name: run-nfs-client-provisioner
      subjects:
        - kind: ServiceAccount
          name: nfs-client-provisioner
          namespace: nfs-system
      roleRef:
        kind: ClusterRole
        name: nfs-client-provisioner-runner
        apiGroup: rbac.authorization.k8s.io
      ---
      # NFS Provisioner Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-client-provisioner
        template:
          metadata:
            labels:
              app: nfs-client-provisioner
          spec:
            serviceAccountName: nfs-client-provisioner
            containers:
              - name: nfs-client-provisioner
                image: registry.k8s.io/sig-storage/nfs-subdir-external-provisioner:v4.0.2
                resources:
                  limits:
                    memory: "128Mi"
                    cpu: "500m"
                  requests:
                    memory: "64Mi"
                    cpu: "250m"
                env:
                  - name: PROVISIONER_NAME
                    value: example.com/nfs
                  - name: NFS_SERVER
                    value: nfs-server.nfs-system.svc.cluster.local
                  - name: NFS_PATH
                    value: /export
                volumeMounts:
                  - name: nfs-client-root
                    mountPath: /persistentvolumes
            volumes:
              - name: nfs-client-root
                nfs:
                  server: nfs-server.nfs-system.svc.cluster.local
                  path: /export
      ---
      # StorageClass to use the provisioner
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: nfs-client
      provisioner: example.com/nfs
      parameters:
        archiveOnDelete: "true"
      reclaimPolicy: Retain
      volumeBindingMode: Immediate
      EOF
      # End NFS install

      VAULT_OIDC_SECRET=$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)

      # installing vault
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      # Vault namespace
      apiVersion: v1
      kind: Namespace
      metadata:
        name: vault
        labels:
          app: "vault"
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "dedicated=work-node"
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: gcp-service-account
        namespace: vault
      type: Opaque
      data:
        key.json: ${GOOGLE_CREDENTIALS}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-id
        namespace: vault
      data:
        PROJECT_ID: ${GCP_PROJECT_ID}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-region
        namespace: vault
      data:
        PROJECT_REGION: ${GCP_REGION}
      ---
      # Grant Dex permission to manage its CRDs (cluster-admin required)
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: dex-crd-manager
      subjects:
      - kind: ServiceAccount
        name: default
        namespace: vault
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      ---
      # GCP KMS unseal credentials
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-unseal-gcp-creds
        namespace: vault
      type: Opaque
      data:
        vault-unseal-sa.json: ${VAULT_KEY_ACCOUNT}
      ---
      # Vault OIDC client credentials (using Dex)
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-oidc-creds
        namespace: vault
      type: Opaque
      stringData:
        client_id: "vault"
        client_secret: "$VAULT_OIDC_SECRET"
        redirect_uri: "https://vault.app.suncoast.systems/ui/vault/auth/oidc/oidc/callback"
      ---
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: vault-creds-pvc
        namespace: vault
      spec:
        accessModes:
          - ReadWriteMany
        resources:
          requests:
            storage: 1Gi
        storageClassName: nfs-client  # Or whatever you use for RWX
      ---
      # Dex configuration (GitHub connector and Vault client)
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: dex-config
        namespace: vault
      data:
        config.docker.yaml: |
          issuer: https://vault.app.suncoast.systems/dex
          storage:
            type: kubernetes
            config:
              inCluster: true
          web:
            http: 0.0.0.0:5556
            prefix: /dex

          staticClients:
          - id: "vault"
            redirectURIs:
            - "https://vault.app.suncoast.systems/ui/vault/auth/oidc/oidc/callback"
            name: "Vault UI"
            secret: "$VAULT_OIDC_SECRET"

          connectors:
          - type: github
            id: github
            name: GitHub
            config:
              clientID: ${VAULT_OIDC_CLIENT_ID}
              clientSecret: ${VAULT_OIDC_CLIENT_SECRET}
              redirectURI: https://vault.app.suncoast.systems/dex/callback
              orgs:
              - name: dotcomrow
                teams:
                - vault_admins
              scopes:
              - read:org  
              loadAllGroups: true    
              teamNameField: slug
      ---
      # Dex Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: dex
        namespace: vault
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: dex
        template:
          metadata:
            labels:
              app: dex
          spec:
            containers:
            - name: dex
              image: ghcr.io/dexidp/dex:v2.37.0
              resources:
                requests:
                  cpu: "100m"
                  memory: "128Mi"
                limits:
                  cpu: "250m"
                  memory: "256Mi"
              volumeMounts:
              - name: config
                mountPath: /etc/dex/config.docker.yaml
                subPath: config.docker.yaml
              ports:
              - containerPort: 5556
            volumes:
            - name: config
              configMap:
                name: dex-config
      ---
      # Dex Service
      apiVersion: v1
      kind: Service
      metadata:
        name: dex
        namespace: vault
      spec:
        selector:
          app: dex
        ports:
        - name: http
          port: 5556
          targetPort: 5556
      ---
      # APISIXRoute for Dex (expose at /dex)
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: dex-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: dex-gui
          match:
            hosts:
            - "vault.app.suncoast.systems"
            paths:
            - /dex/*
          backends:
            - serviceName: dex
              servicePort: http
      ---
      # Vault production config
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-config
        namespace: vault
      data:
        vault.hcl: |
          disable_mlock = true
          cluster_addr  = "http://vault.vault.svc.cluster.local:8201"
          api_addr      = "https://vault.app.suncoast.systems"

          seal "gcpckms" {
            project     = "${GCP_PROJECT_ID}"
            region      = "${GCP_REGION}"
            key_ring    = "vault-infra-ring"
            crypto_key  = "vault-unseal"
            credentials = "/etc/vault/vault-unseal-sa.json"
          }

          listener "tcp" {
            address     = "0.0.0.0:8200"
            tls_disable = 1
          }

          storage "file" {
            path = "/vault/data"
          }

          ui = true
      ---
      # Vault StatefulSet with OIDC enable
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: vault
        namespace: vault
        labels:
          app: vault
      spec:
        serviceName: vault
        replicas: 1
        selector:
          matchLabels:
            app: vault
        template:
          metadata:
            labels:
              app: vault
          spec:
            dnsPolicy: "None"                     
            dnsConfig:                            
              nameservers:
                - 10.43.0.10
                - 1.1.1.1                         
              options:
                - name: ndots
                  value: "2"
            securityContext:
              fsGroup: 1000
            initContainers:
              - name: install-utils
                image: bitnami/kubectl:latest
                command: ["sh", "-c"]
                args:
                  - cp /opt/bitnami/kubectl/bin/kubectl /shared/kubectl && chmod +x /shared/kubectl
                volumeMounts:
                  - name: shared-utils
                    mountPath: /shared
            containers:
              - name: vault
                image: hashicorp/vault:1.14.3
                resources:
                  requests:
                    cpu: "250m"
                    memory: "256Mi"
                  limits:
                    cpu: "500m"
                    memory: "512Mi"
                env:
                  - name: VAULT_ADDR
                    value: "http://127.0.0.1:8200"
                  - name: VAULT_NAMESPACE
                    value: "root"
                volumeMounts:
                  - name: config
                    mountPath: /vault/config/vault.hcl
                    subPath: vault.hcl
                  - name: data
                    mountPath: /vault/data
                  - name: gcp-creds
                    mountPath: /etc/vault
                    readOnly: true
                  - name: oidc-creds
                    mountPath: /etc/vault-oidc
                    readOnly: true
                  - name: shared-utils
                    mountPath: /usr/local/bin/kubectl
                    subPath: kubectl
                  - name: shared-data
                    mountPath: /vault/creds-data
                  - name: gcp-project-id
                    mountPath: /config/gcp-project-id
                    readOnly: true
                  - name: gcp-project-region
                    mountPath: /config/gcp-project-region
                    readOnly: true
                  - name: script
                    mountPath: /opt/configscript
                    readOnly: true
                  - name: script-tmp
                    mountPath: /opt/scripts
                command: ["/bin/sh"]
                args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]
                ports:
                  - name: vault
                    containerPort: 8200
            volumes:
              - name: config
                configMap:
                  name: vault-config
              - name: gcp-creds
                secret:
                  secretName: vault-unseal-gcp-creds
              - name: oidc-creds
                secret:
                  secretName: vault-oidc-creds
              - name: shared-utils
                emptyDir: {}
              - name: shared-data
                persistentVolumeClaim:
                  claimName: vault-creds-pvc
              - name: gcp-project-id
                configMap:
                  name: gcp-project-id
              - name: gcp-project-region
                configMap:
                  name: gcp-project-region
              - name: script
                configMap:
                  name: vault-init-script
              - name: script-tmp
                emptyDir: {}
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes: ["ReadWriteOnce"]
            resources:
              requests:
                storage: 1Gi
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-init-script
        namespace: vault
      data:
        run.sh: |
          vault server -config=/vault/config/vault.hcl &
          VAULT_PID=\$!
          sleep 5

          # Initialize if necessary
          if [ ! -f /vault/data/init.json ]; then
            vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json > /vault/data/init.json
          fi

          apk add --no-cache jq

          # Wait for Vault to be unsealed and ready
          until vault status -format=json | jq -e '.sealed == false'; do
            echo "Waiting for Vault to be unsealed..."
            sleep 2
          done

          # Write admin policy
          cat <<EOF > /vault/data/admin-policy.hcl
          path "*" { capabilities = ["create","read","update","delete","list","sudo"] }
          EOF
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write admin /vault/data/admin-policy.hcl

          # Enable auth methods
          if ! VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q '"oidc/"'; then
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth enable oidc
          fi

          if ! VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q '"kubernetes/"'; then
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth enable kubernetes
          fi

          if ! VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q '"approle/"'; then
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth enable approle
          fi

          # Kubernetes config
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/config \
            token_reviewer_jwt="\$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)" \
            kubernetes_host="https://\$KUBERNETES_SERVICE_HOST:\$KUBERNETES_SERVICE_PORT_HTTPS" \
            kubernetes_ca_cert=@/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

          # Enable KV secrets engine
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault secrets enable -path=secret -version=2 kv

          # AVP policy
          cat <<EOF > /vault/data/avp-policy.hcl
          path "secret/data/*" {
            capabilities = ["read"]
          }
          EOF

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write vault-sync - <<EOF
          # KV v2 read, write, delete
          path "secret/data/*" {
            capabilities = ["create", "read", "update", "delete"]
          }

          # KV v2 metadata access (for deletes and versions)
          path "secret/metadata/*" {
            capabilities = ["read", "delete", "list"]
          }

          # Optional: list root secrets path
          path "secret/*" {
            capabilities = ["list"]
          }
          EOF

          cat <<EOF | VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write avp -
          path "secret/data/*" {
            capabilities = ["read"]
          }
          EOF

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/approle/role/vault-sync \
            token_ttl=1h \
            token_max_ttl=4h \
            bind_secret_id=true \
            secret_id_bound_cidrs=0.0.0.0/0 \
            policies=vault-sync

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault read -field=role_id auth/approle/role/vault-sync/role-id > /vault/creds-data/role_id.txt
          echo >> /vault/creds-data/role_id.txt

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write -f -field=secret_id auth/approle/role/vault-sync/secret-id > /vault/creds-data/secret_id.txt
          echo >> /vault/creds-data/secret_id.txt

          # GCP identifiers
          cat /config/gcp-project-id/PROJECT_ID > /vault/creds-data/project_id.txt
          cat /config/gcp-project-region/PROJECT_REGION > /vault/creds-data/region.txt
          echo "vault-sync-run-container" > /vault/creds-data/service_name.txt

          # ArgoCD role for AVP
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/role/argocd \
            bound_service_account_names=argocd-repo-server \
            bound_service_account_namespaces=argocd \
            policies=avp \
            ttl=24h

          # OIDC setup
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/config \
            oidc_discovery_url="https://vault.app.suncoast.systems/dex" \
            oidc_client_id="\$(cat /etc/vault-oidc/client_id)" \
            oidc_client_secret="\$(cat /etc/vault-oidc/client_secret)" \
            default_role="default"

          # Disable GitHub auth if present
          if VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q '"github/"'; then
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth disable github
          fi

          # Default OIDC role
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/role/default \
            bound_audiences="\$(cat /etc/vault-oidc/client_id)" \
            user_claim="email" \
            groups_claim="groups" \
            allowed_redirect_uris="https://vault.app.suncoast.systems/ui/vault/auth/oidc/oidc/callback,https://vault.app.suncoast.systems/ui/vault/auth/oidc/callback,https://vault.app.suncoast.systems/ui/vault/auth/oidc/default/callback,https://vault.app.suncoast.systems/ui/vault/auth?with=oidc" \
            oidc_scopes="openid,email,groups" \
            policies="admin" \
            ttl="1h"

          # Trigger follow-up job
          cat <<EOF | kubectl apply -f -
          apiVersion: batch/v1
          kind: Job
          metadata:
            name: update-cloudrun-vault-cred
            namespace: vault
          spec:
            template:
              spec:
                serviceAccountName: default
                restartPolicy: Never

                volumes:
                  - name: kubectl-bin
                    emptyDir: {}
                  - name: gcp-creds
                    secret:
                      secretName: gcp-service-account
                  - name: shared-creds
                    persistentVolumeClaim:
                      claimName: vault-creds-pvc
                  - name: script
                    configMap:
                      name: vault-sync-script
                  - name: script-tmp
                    emptyDir: {}

                initContainers:
                  - name: load-kubectl
                    image: bitnami/kubectl:latest
                    command: ["sh", "-c"]
                    args:
                      - cp /opt/bitnami/kubectl/bin/kubectl /kubectl-bin/kubectl && chmod +x /kubectl-bin/kubectl
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /kubectl-bin

                containers:
                  - name: gcloud-update
                    image: google/cloud-sdk:slim
                    resources:
                      requests:
                        cpu: "100m"
                        memory: "128Mi"
                      limits:
                        cpu: "250m"
                        memory: "256Mi"
                        
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /usr/local/bin
                      - name: gcp-creds
                        mountPath: /tmp
                        readOnly: true
                      - name: shared-creds
                        mountPath: /shared-creds
                      - name: script
                        mountPath: /opt/configscript
                        readOnly: true
                      - name: script-tmp
                        mountPath: /opt/scripts
                    command: ["/bin/sh"]
                    args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]

                volumes:
                  - name: gcp-creds
                    secret:
                      secretName: gcp-service-account
                  - name: shared-creds
                    persistentVolumeClaim:
                      claimName: vault-creds-pvc
                  - name: script
                    configMap:
                      name: vault-sync-script
                  - name: script-tmp
                    emptyDir: {}
                  - name: kubectl-bin
                    emptyDir: {}
          EOF

          wait \$VAULT_PID
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-sync-script
        namespace: vault
      data:
        run.sh: |
          #!/bin/sh
          set -e

          echo "Waiting for Vault to write role_id and secret_id..."
          while [ ! -f /shared-creds/role_id.txt ] || [ ! -f /shared-creds/secret_id.txt ]; do
            sleep 2
          done

          ROLE_ID="\$(cat /shared-creds/role_id.txt | tr -d '\r\n')"
          SECRET_ID="\$(cat /shared-creds/secret_id.txt | tr -d '\r\n')"
          PROJECT_ID="\$(cat /shared-creds/project_id.txt | tr -d '\r\n')"
          REGION="\$(cat /shared-creds/region.txt | tr -d '\r\n')"
          SERVICE_NAME="\$(cat /shared-creds/service_name.txt | tr -d '\r\n')"

          echo "ROLE_ID=\$ROLE_ID"
          echo "SECRET_ID=\$SECRET_ID"
          echo "PROJECT_ID=\$PROJECT_ID"
          echo "REGION=\$REGION"
          echo "SERVICE_NAME=\$SERVICE_NAME"

          if [ -z "\$PROJECT_ID" ] || [ -z "\$REGION" ] || [ -z "\$SERVICE_NAME" ]; then
            echo "❌ Missing required environment variables"
            exit 1
          fi

          gcloud auth activate-service-account --key-file=/tmp/key.json
          gcloud config set project "\$PROJECT_ID"
          gcloud run services update "\$SERVICE_NAME" \
            --region="\$REGION" \
            --update-env-vars "VAULT_ROLE_ID=\$ROLE_ID,VAULT_SECRET_ID=\$SECRET_ID"
          
          SVC_URL=\$(gcloud run services describe "\$SERVICE_NAME" --region "\$REGION" --format="value(status.url)");
          if [ -z "\$SVC_URL" ]; then
            echo "❌ Failed to get service URL"
            exit 1
          fi

          curl -X POST -H "Authorization: Bearer \$(gcloud auth print-identity-token)" \$SVC_URL/sync-all

          echo "✅ Vault credentials updated successfully"

          echo "🚀 Applying App of Apps configuration..."
          kubectl apply -n argocd -f - <<EOF
          apiVersion: argoproj.io/v1alpha1
          kind: Application
          metadata:
            name: argocd-post-install-apps-repo-app
            namespace: argocd
          spec:
            project: default
            source:
              repoURL: git@github.com:${GITHUB_ORG}/argocd-post-install.git
              targetRevision: prod 
              path: apps
              directory:
                recurse: true
            destination:
              server: https://kubernetes.default.svc
              namespace: argocd
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
          EOF

          echo "✅ App of Apps applied."
      ---
      # Vault Service
      apiVersion: v1
      kind: Service
      metadata:
        name: vault
        namespace: vault
        labels:
          app: vault
      spec:
        selector:
          app: vault
        ports:
        - name: vault
          port: 8200
          targetPort: vault
      ---
      # APISIXRoute for Vault UI
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: vault-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: vault-ui
          match:
            hosts:
            - "vault.app.suncoast.systems"
            paths:
            - /*
          backends:
            - serviceName: vault
              servicePort: vault
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        namespace: vault
        name: vault-job-manager
      rules:
        - apiGroups: ["batch"]
          resources: ["jobs"]
          verbs: ["create", "get", "list", "watch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: RoleBinding
      metadata:
        name: vault-job-manager-binding
        namespace: vault
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: Role
        name: vault-job-manager
      subjects:
        - kind: ServiceAccount
          name: default  # or a dedicated SA your Vault pod uses
          namespace: vault
      EOF

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: argocd
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "dedicated=srvr-node"
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: argocd-github-oauth
        namespace: argocd
      type: Opaque
      stringData:
        dex.github.clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: argocd
        namespace: argocd
      spec:
        chart: argo-cd
        repo: https://argoproj.github.io/argo-helm
        version: 8.0.3
        targetNamespace: argocd
        valuesContent: |-
          server:
            service:
              type: ClusterIP
              ports:
                - name: http
                  port: 80
                  targetPort: 8080
            extraArgs:
              - --insecure
            ingress:
              enabled: false

          repoServer:
            image:
              repository: ghcr.io/dotcomrow/argocd-repo-server-avp
              tag: 448b62e1ce08d396ab1450f07ecd911f56a731b7

            automountServiceAccountToken: true

            podSecurityContext:
              fsGroup: 999

            # 6) Vault-plugin ENV configuration
            env:
              - name: AVP_AUTH_TYPE
                value: "k8s"
              - name: AVP_K8S_ROLE
                value: "argocd"
              - name: AVP_K8S_MOUNT_PATH
                value: "auth/kubernetes"
              - name: AVP_VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: AVP_KV_VERSION
                value: "2"
              - name: AVP_TYPE
                value: "vault"
              - name: AVP_MOUNT_PATH
                value: "secret"

          configs:
            params:
              server.insecure: true
            cm:
              admin.enabled: false
              url: https://argocd.${RANCHER_DOMAIN}
              dex.config: |
                connectors:
                  - type: github
                    id: github
                    name: GitHub
                    config:
                      clientID: ${ARGOCD_GITHUB_CLIENT_ID}
                      clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
                      orgs:
                        - name: ${GITHUB_ORG}
              application.namespaces: |
                - argocd
              application.namespaceResourceBlacklist: |
                - group: ""
                  kind: Namespace
              configManagementPlugins: |-
                - name: avp-v1
                  allowConcurrency: true
                  discover:
                    fileName: "*.yaml"
                  generate:
                    command:
                      - /usr/local/bin/argocd-vault-plugin
                    args:
                      - generate
                      - .
                  provideGitCreds: true
                  preserveFileMode: false

            rbac:
              policy.csv: |
                p, role:admin, applications, *, *, allow
                p, role:admin, clusters, get, *, allow
                p, role:admin, repositories, *, *, allow
                p, role:admin, logs, get, *, allow
                p, role:admin, exec, create, *, allow
                p, role:admin, projects, *, *, allow
                g, ${GITHUB_ORG}:ARGOCD_ADMINS, role:admin
              policy.default: role:readonly
      ---
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: argocd-route
        namespace: argocd
      spec:
        ingressClassName: apisix
        http:
          - name: argocd
            match:
              hosts:
                - argocd.${RANCHER_DOMAIN}
              paths:
                - "/*"
            backends:
              - serviceName: argocd-server
                servicePort: 80
      EOF

      KUBECONFIG_PATH="/etc/rancher/rke2/rke2.yaml"
      ARGOCD_NAMESPACE="argocd"
      DEPLOYMENT_NAME="argocd-server"
      TIMEOUT_SECONDS=900

      echo "⏳ Waiting for Argo CD deployment '$DEPLOYMENT_NAME' to appear..."

      # Wait for deployment to appear (up to TIMEOUT_SECONDS)
      SECONDS_WAITED=0
      while ! sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n "$ARGOCD_NAMESPACE" get deployment "$DEPLOYMENT_NAME" &>/dev/null; do
        if (( SECONDS_WAITED >= TIMEOUT_SECONDS )); then
          echo "❌ Timeout waiting for deployment '$DEPLOYMENT_NAME' to appear."
          exit 1
        fi
        sleep 90
        (( SECONDS_WAITED += 5 ))
      done

      echo "✅ Deployment '$DEPLOYMENT_NAME' found. Waiting for it to be ready..."

      # Wait for deployment to be available
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" wait \
        --for=condition=available \
        --timeout=300s \
        deployment/"$DEPLOYMENT_NAME" \
        -n "$ARGOCD_NAMESPACE"

      echo "✅ Argo CD is ready."

      echo "Adding repo key..."
      REPO_URL_B64=$(echo -n "git@github.com:${GITHUB_ORG}/argocd-post-install.git" | base64 -w0)
      INSECURE_B64=$(echo -n "true" | base64 -w0)
      PRIVATE_KEY_B64="${ARGOCD_REPO_POST_INSTALL_KEY}"

      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n cattle-system rollout status deploy rancher-webhook --timeout=120s

      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" apply -f - <<EOF
      apiVersion: v1
      kind: Secret
      metadata:
        name: argocd-post-install-apps-repo-secret 
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repository
      type: Opaque
      data:
        url: $REPO_URL_B64
        sshPrivateKey: $PRIVATE_KEY_B64
        insecure: $INSECURE_B64
      EOF

      echo "Cleaning up uneeded resources..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace applications
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace infrastructure

  - path: /etc/systemd/system/post-install.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post Install Tasks
      After=gpu.service
      Requires=gpu.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/80-post-install.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/fix-dns-nfs.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Fix systemd-resolved DNS config for NFS
      After=network-online.target systemd-resolved.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/bash -c "systemctl restart systemd-resolved; rm -f /etc/resolv.conf; ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reexec
  - systemctl daemon-reload
  - systemctl enable initial-setup.service
  - systemctl start initial-setup.service