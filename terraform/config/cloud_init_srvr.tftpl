      echo "⏳ Waiting for VPA CRDs to be established..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Established --timeout=300s crd/verticalpodautoscalers.autoscaling.k8s.io
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Established --timeout=300s crd/verticalpodautoscalercheckpoints.autoscaling.k8s.io

      echo "📦 Installing Kyverno early (required for ClusterPolicy automation)..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace kyverno || true
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml annotate namespace kyverno field.cattle.io/projectId=local:infrastructure --overwrite || true

      KYVERNO_RETRIES=5
      KYVERNO_DELAY=5

      for i in $(seq 1 $KYVERNO_RETRIES); do
        echo "Attempt $i to add Kyverno Helm repo..."
        sudo helm repo add kyverno https://kyverno.github.io/kyverno/ --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $KYVERNO_DELAY seconds..."
        sleep $KYVERNO_DELAY
      done

      if [[ $i -eq $KYVERNO_RETRIES ]]; then
        echo "Failed to add Kyverno Helm repo after $KYVERNO_RETRIES attempts" >&2
        exit 1
      fi

      sudo helm repo update

      KYVERNO_VERSION="$(sudo helm search repo kyverno/kyverno --versions 2>/dev/null | awk 'NR==2 {print $2}')"
      if [ -n "$KYVERNO_VERSION" ]; then
        echo "Using Kyverno chart version $KYVERNO_VERSION"
        KYVERNO_HELM_VERSION_ARGS="--version $KYVERNO_VERSION"
      else
        echo "Unable to determine Kyverno chart version; installing latest available"
        KYVERNO_HELM_VERSION_ARGS=""
      fi

      for i in $(seq 1 $KYVERNO_RETRIES); do
        echo "Attempt $i to install Kyverno..."
        sudo helm upgrade --install kyverno kyverno/kyverno -n kyverno --create-namespace --kubeconfig=/etc/rancher/rke2/rke2.yaml $KYVERNO_HELM_VERSION_ARGS && break

        echo "Helm install failed. Retrying in $KYVERNO_DELAY seconds..."
        sleep $KYVERNO_DELAY
      done

      if [[ $i -eq $KYVERNO_RETRIES ]]; then
        echo "❌ Failed to install Kyverno after $KYVERNO_RETRIES attempts." >&2
        exit 1
      fi

      # Ensure Kyverno is ready before applying policies (webhook validates policies on create)
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno rollout status deploy/kyverno-admission-controller --timeout=300s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno rollout status deploy/kyverno-background-controller --timeout=300s

      # Ensure Kyverno admission controller has enough capacity for policy validation
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        scale deploy/kyverno-admission-controller --replicas=2
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        set resources deploy/kyverno-admission-controller \
        --requests=cpu=200m,memory=256Mi --limits=cpu=1,memory=512Mi
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        rollout status deploy/kyverno-admission-controller --timeout=180s

      # Give Kyverno background controller permission to patch namespaces (needed for mutateExistingOnPolicyUpdate)
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kyverno-background-controller-namespace-update
      rules:
        - apiGroups: [""]
          resources: ["namespaces"]
          verbs: ["get", "list", "watch", "patch", "update"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: kyverno-background-controller-namespace-update
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: kyverno-background-controller-namespace-update
      subjects:
        - kind: ServiceAccount
          name: kyverno-background-controller
          namespace: kyverno
      EOF

      echo "📦 Applying VPA components, Goldilocks, and resource-management Kyverno policies..."
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: goldilocks
        labels:
          app.kubernetes.io/name: goldilocks
        annotations:
          linkerd.io/inject: disabled
          field.cattle.io/projectId: local:infrastructure
      
      ---
      apiVersion: v1
      kind: Namespace
      metadata:
        name: k8s-resource-management
        annotations:
          linkerd.io/inject: disabled
          field.cattle.io/projectId: local:infrastructure
      
      ---
      apiVersion: scheduling.k8s.io/v1
      kind: PriorityClass
      metadata:
        name: platform-system-high
      value: 1000000000
      globalDefault: false
      description: "Preferred for platform system namespaces."
      
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:metrics-reader
      rules:
        - apiGroups:
            - "metrics.k8s.io"
          resources:
            - pods
          verbs:
            - get
            - list
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:vpa-actor
      rules:
        - apiGroups:
            - ""
          resources:
            - pods
            - nodes
            - limitranges
          verbs:
            - get
            - list
            - watch
        - apiGroups:
            - ""
            - events.k8s.io
          resources:
            - events
          verbs:
            - create
            - get
            - list
            - watch
            - patch
            - update
        - apiGroups:
            - "poc.autoscaling.k8s.io"
          resources:
            - verticalpodautoscalers
          verbs:
            - get
            - list
            - watch
        - apiGroups:
            - "autoscaling.k8s.io"
          resources:
            - verticalpodautoscalers
          verbs:
            - get
            - list
            - watch
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:vpa-status-actor
      rules:
        - apiGroups:
            - "autoscaling.k8s.io"
          resources:
            - verticalpodautoscalers/status
          verbs:
            - get
            - patch
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:vpa-checkpoint-actor
      rules:
        - apiGroups:
            - "poc.autoscaling.k8s.io"
          resources:
            - verticalpodautoscalercheckpoints
          verbs:
            - get
            - list
            - watch
            - create
            - patch
            - delete
        - apiGroups:
            - "autoscaling.k8s.io"
          resources:
            - verticalpodautoscalercheckpoints
          verbs:
            - get
            - list
            - watch
            - create
            - patch
            - delete
        - apiGroups:
            - ""
          resources:
            - namespaces
          verbs:
            - get
            - list
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:evictioner
      rules:
        - apiGroups:
            - "apps"
            - "extensions"
          resources:
            - replicasets
          verbs:
            - get
        - apiGroups:
            - ""
          resources:
            - pods/eviction
          verbs:
            - create
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: system:vpa-updater-in-place
      rules:
        - apiGroups:
            - ""
          resources:
            - pods/resize
            - pods # required for patching vpaInPlaceUpdated annotations onto the pod
          verbs:
            - patch
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: system:vpa-updater-in-place-binding
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: system:vpa-updater-in-place
      subjects:
        - kind: ServiceAccount
          name: vpa-updater
          namespace: kube-system
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: system:metrics-reader
      roleRef:
