#cloud-config
hostname: ${hostname}

users:
  - name: ubuntu
    sudo:
      - "ALL=(ALL) NOPASSWD:ALL"
    groups: users, admin
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_keys}

bootcmd:
  - [ systemctl, stop, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, disable, apt-daily.timer, apt-daily-upgrade.timer ]
  - [ systemctl, mask, apt-daily.service, apt-daily-upgrade.service ]

ssh_pwauth: false
package_update: true
package_upgrade: true
apt:
  conf: |
    Acquire::Retries "10";
    Acquire::http::Timeout "15";
    Acquire::https::Timeout "15";
    Acquire::ForceIPv4 "true";
    DPkg::Lock::Timeout "600";

packages:
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg-agent
  - software-properties-common
  - zsh
  - nfs-common
  - gnupg
  - lsb-release
  - nftables
  - dnsmasq
  - ethtool
  - jq
  - cockpit

growpart:
  mode: auto
  devices: ["/"]

write_files:
  - path: /etc/systemd/system/initial-setup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post-bootstrap setup for Kubernetes node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/environment
      ExecStart=/usr/local/bin/initial-setup.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/initial-setup.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # export HTTP_PROXY=http://10.0.0.10:3128
      # export HTTPS_PROXY=http://10.0.0.10:3128
      # export NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12

      # update-ca-certificates
      systemctl daemon-reload
      /usr/local/bin/performance-tuning.sh
      sysctl --system
      update-grub
      systemctl daemon-reload

      systemctl enable set-dhcp-hostname.service
      systemctl start set-dhcp-hostname.service

      systemctl enable fix-dns-nfs.service
      systemctl start fix-dns-nfs.service

      /usr/local/bin/setup-nfs-modules.sh
      systemctl start load-nfs-modules.service

      systemctl enable --now mount-shared-storage.service

      systemctl enable disable-swap.service
      systemctl start disable-swap.service

      systemctl restart systemd-journald || true

      systemctl enable setup-hosts-dns.service
      systemctl start setup-hosts-dns.service

      systemctl enable configure-logging.service
      systemctl start configure-logging.service

      systemctl enable setup-cockpit.service
      systemctl start setup-cockpit.service

      systemctl enable setup-runtime.service
      systemctl start setup-runtime.service

      systemctl enable rke2-preload-images.service
      systemctl start rke2-preload-images.service

      systemctl enable bootstrap-rke2.service
      systemctl start bootstrap-rke2.service

      systemctl enable set-nofile-limits.service
      systemctl start set-nofile-limits.service

      systemctl enable k8s-addons.service
      systemctl start k8s-addons.service

      systemctl enable install-apisix-rancher.service
      systemctl start install-apisix-rancher.service

      systemctl enable gpu.service
      systemctl start gpu.service

      systemctl enable post-install.service
      systemctl start post-install.service
      /usr/local/bin/cleanup-install-services.sh

  - path: /root/oo-auth-bridge.py
    permissions: '0755'
    content: |
      import base64
      import hashlib
      import hmac
      import json
      import os
      import time
      import urllib.error
      import urllib.parse
      import urllib.request
      from datetime import timezone
      from email.utils import parsedate_to_datetime
      from http.server import BaseHTTPRequestHandler, HTTPServer

      OO_URL = os.getenv("OO_URL", "http://openobserve-router:5080").rstrip("/")
      OO_ORG = os.getenv("OO_ORG", "default")
      OO_ADMIN_USER = os.environ["OO_ADMIN_USER"]
      OO_ADMIN_PASS = os.environ["OO_ADMIN_PASS"]
      HMAC_SECRET = os.environ["OO_USER_PASSWORD_SECRET"].encode("utf-8")
      OO_EMAIL_HEADER = os.getenv("OO_EMAIL_HEADER", "X-Auth-Request-Email")
      OO_LOGIN_HEADER = os.getenv("OO_LOGIN_HEADER", "X-Auth-Request-User")
      OO_LISTEN_PORT = int(os.getenv("OO_LISTEN_PORT", "4181"))
      TOKEN_CACHE = {}
      TOKEN_CACHE_SKEW = 30

      _basic = base64.b64encode(f"{OO_ADMIN_USER}:{OO_ADMIN_PASS}".encode("utf-8")).decode("ascii")
      ADMIN_HEADERS = {
          "Authorization": f"Basic {_basic}",
          "Content-Type": "application/json",
          "Accept": "application/json",
          "organization": OO_ORG,
      }

      def log(msg: str) -> None:
          print(f"[oo-auth-bridge] {msg}", flush=True)

      def derive_password(email: str) -> str:
          email_norm = email.strip().lower()
          digest = hmac.new(HMAC_SECRET, email_norm.encode("utf-8"), hashlib.sha256).digest()
          pwd = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")
          return (pwd[:32] + "A!").replace("-", "A").replace("_", "B")

      def parse_cookie_expiry(attrs: list[str]) -> float:
          max_age = None
          expires_at = None
          for attr in attrs:
              lower = attr.lower()
              if lower.startswith("max-age="):
                  try:
                      max_age = int(attr.split("=", 1)[1])
                  except ValueError:
                      pass
              elif lower.startswith("expires="):
                  try:
                      dt = parsedate_to_datetime(attr.split("=", 1)[1].strip())
                      if dt.tzinfo is None:
                          expires_at = dt.replace(tzinfo=timezone.utc).timestamp()
                      else:
                          expires_at = dt.timestamp()
                  except Exception:
                      pass
          if max_age is not None:
              return time.time() + max_age
          if expires_at is not None:
              return expires_at
          return time.time() + 3600

      def extract_auth_token(cookies: list[str]) -> tuple[str | None, float | None]:
          for cookie in cookies:
              parts = [p.strip() for p in cookie.split(";") if p.strip()]
              if not parts:
                  continue
              if not parts[0].startswith("auth_tokens="):
                  continue
              token = parts[0].split("=", 1)[1]
              return token, parse_cookie_expiry(parts[1:])
          return None, None

      def cached_token(email: str) -> str | None:
          entry = TOKEN_CACHE.get(email)
          if not entry:
              return None
          token, expires_at = entry
          if expires_at - time.time() > TOKEN_CACHE_SKEW:
              return token
          TOKEN_CACHE.pop(email, None)
          return None

      def cache_token(email: str, token: str, expires_at: float | None) -> None:
          TOKEN_CACHE[email] = (token, expires_at or (time.time() + 3600))

      def http_json(url: str, method: str, *, body=None, headers=None, timeout: int = 20):
          data = None
          hdrs = dict(ADMIN_HEADERS)
          if headers:
              hdrs.update(headers)
          if body is not None:
              data = json.dumps(body).encode("utf-8")
          req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
          try:
              with urllib.request.urlopen(req, timeout=timeout) as res:
                  raw = res.read() or b""
                  txt = raw.decode("utf-8", "replace")
                  try:
                      obj = json.loads(txt) if txt else {}
                  except Exception:
                      obj = None
                  return res.status, obj, txt, res.headers
          except urllib.error.HTTPError as e:
              txt = (e.read() or b"").decode("utf-8", "replace")
              return e.code, None, txt, e.headers
          except Exception as e:
              log(f"http error url={url} method={method}: {e}")
              return 599, None, "", None

      def ensure_user(email: str, first_name: str, password: str) -> None:
          status, _, txt, _ = http_json(
              f"{OO_URL}/api/{OO_ORG}/users",
              "POST",
              body={
                  "email": email,
                  "password": password,
                  "role": "admin",
                  "first_name": first_name,
                  "last_name": "",
              },
          )
          if status == 200:
              log(f"created user email={email}")
          elif status == 400 and "already exists" in txt.lower():
              log(f"user already exists email={email}")
          elif status in (200,):
              pass
          else:
              log(f"user create failed email={email} status={status} body={txt[:200]}")

          encoded = urllib.parse.quote(email, safe="")
          status, _, txt, _ = http_json(
              f"{OO_URL}/api/{OO_ORG}/users/{encoded}",
              "PUT",
              body={
                  "change_password": True,
                  "new_password": password,
                  "first_name": first_name,
                  "last_name": "",
              },
          )
          if status == 200:
              log(f"password synced email={email}")
          else:
              log(f"user update failed email={email} status={status} body={txt[:200]}")

      def user_info_payload(email: str, login_name: str) -> dict:
          return {
              "email": email,
              "name": login_name,
              "family_name": login_name,
              "given_name": "",
          }

      def fetch_auth_cookies(email: str, password: str) -> list[str]:
          data = json.dumps({"name": email, "password": password}).encode("utf-8")
          req = urllib.request.Request(
              f"{OO_URL}/auth/login",
              data=data,
              method="POST",
              headers={"Content-Type": "application/json"},
          )
          try:
              with urllib.request.urlopen(req, timeout=20) as res:
                  return res.headers.get_all("Set-Cookie") or []
          except urllib.error.HTTPError as e:
              body = (e.read() or b"").decode("utf-8", "replace")
              log(f"login failed email={email} status={e.code} body={body[:200]}")
          except Exception as e:
              log(f"login error email={email}: {e}")
          return []

      class Handler(BaseHTTPRequestHandler):
          def do_GET(self):
              if self.path == "/health":
                  self.send_response(200)
                  self.end_headers()
                  self.wfile.write(b"ok")
                  return

              email = self.headers.get(OO_EMAIL_HEADER)
              login_name = self.headers.get(OO_LOGIN_HEADER)
              if not email:
                  for header in (
                      "X-Forwarded-Email",
                      "X-Auth-Request-Email",
                      "X-Auth-Request-User",
                      "X-Forwarded-User",
                  ):
                      value = self.headers.get(header)
                      if value and "@" in value:
                          email = value
                          break
              if not email:
                  debug_headers = {
                      k: self.headers.get(k)
                      for k in (
                          "X-Auth-Request-Email",
                          "X-Auth-Request-User",
                          "X-Auth-Request-Preferred-Username",
                          "X-Forwarded-Email",
                          "X-Forwarded-User",
                          "X-Forwarded-Proto",
                          "X-Forwarded-Host",
                      )
                      if self.headers.get(k)
                  }
                  log(f"missing email header headers={debug_headers}")
                  self.send_response(401)
                  self.send_header("Content-Type", "text/plain")
                  self.end_headers()
                  self.wfile.write(b"missing email header")
                  return

              if login_name and "/" in login_name:
                  login_name = login_name.split("/")[-1]
              if not login_name:
                  login_name = email.split("@", 1)[0]

              password = derive_password(email)
              log(f"request path={self.path} email={email} login={login_name}")

              if self.path == "/__oo_userinfo":
                  ensure_user(email, login_name, password)
                  payload = user_info_payload(email, login_name)
                  body = json.dumps(payload).encode("utf-8")
                  self.send_response(200)
                  self.send_header("Content-Type", "application/json")
                  self.send_header("Cache-Control", "no-store")
                  self.end_headers()
                  self.wfile.write(body)
                  return

              ensure_user(email, login_name, password)
              if self.path == "/__oo_token":
                  token = cached_token(email)
                  if not token:
                      cookies = fetch_auth_cookies(email, password)
                      token, expires_at = extract_auth_token(cookies)
                      if not token:
                          self.send_response(502)
                          self.end_headers()
                          self.wfile.write(b"failed to log in")
                          return
                      cache_token(email, token, expires_at)
                  self.send_response(204)
                  self.send_header("X-OO-Auth-Token", token)
                  self.send_header("Cache-Control", "no-store")
                  self.end_headers()
                  return

              cookies = fetch_auth_cookies(email, password)
              if not cookies:
                  self.send_response(502)
                  self.end_headers()
                  self.wfile.write(b"failed to log in")
                  return
              token, expires_at = extract_auth_token(cookies)
              if token:
                  cache_token(email, token, expires_at)

              rewritten = []
              for cookie in cookies:
                  try:
                      parts = [p.strip() for p in cookie.split(";") if p.strip()]
                      if not parts:
                          continue
                      attrs = [
                          p
                          for p in parts[1:]
                          if not p.lower().startswith("domain=") and not p.lower().startswith("path=")
                      ]
                      attrs.append("Path=/")
                      rewritten.append("; ".join([parts[0]] + attrs))
                  except Exception as e:
                      log(f"failed to rewrite cookie: {e}")
                      rewritten.append(cookie)

              self.send_response(302)
              for cookie in rewritten:
                  self.send_header("Set-Cookie", cookie)
              self.send_header("Location", "/web/")
              self.send_header("Cache-Control", "no-store")
              self.end_headers()

          def log_message(self, format, *args):
              return

      if __name__ == "__main__":
          log(
              f"start listen_port={OO_LISTEN_PORT} org={OO_ORG} email_header={OO_EMAIL_HEADER} login_header={OO_LOGIN_HEADER}"
          )
          HTTPServer(("0.0.0.0", OO_LISTEN_PORT), Handler).serve_forever()

  - path: /root/oo-auth-nginx.conf
    permissions: '0644'
    content: |
      worker_processes  1;
      events { worker_connections  1024; }
      http {
        upstream oo_router { server openobserve-router.openobserve.svc.cluster.local:5080; }
        upstream oauth2_proxy { server oo-oauth2-proxy.openobserve.svc.cluster.local:4180; }
        upstream oo_bridge { server oo-auth-bridge.openobserve.svc.cluster.local:4181; }
        map $http_cookie $has_auth_tokens {
          default 0;
          "~*auth_tokens=" 1;
        }
        server {
          listen 5080;
          set $public_host "openobserve.teleport.app.${RANCHER_DOMAIN}";

        location /oauth2/ {
          auth_request off;
          proxy_pass http://oauth2_proxy;
          proxy_set_header Host $public_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $public_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Cookie $http_cookie;
        }

        location = /oauth2/auth {
          auth_request off;
          proxy_pass http://oauth2_proxy;
          proxy_set_header Host $public_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $public_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Content-Length "";
          proxy_pass_request_body off;
          proxy_set_header Cookie $http_cookie;
        }

          error_page 401 = /oauth2/sign_in?rd=/__oo_login;

        location = /__oo_login {
          auth_request /oauth2/auth;
          auth_request_set $auth_user  $upstream_http_x_auth_request_user;
          auth_request_set $auth_email $upstream_http_x_auth_request_email;
          proxy_set_header X-Auth-Request-User $auth_user;
          proxy_set_header X-Auth-Request-Email $auth_email;
          proxy_set_header Host $host;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_pass http://oo_bridge/__oo_login;
        }

        location = /__oo_userinfo {
          auth_request /oauth2/auth;
          auth_request_set $auth_user  $upstream_http_x_auth_request_user;
          auth_request_set $auth_email $upstream_http_x_auth_request_email;
          proxy_set_header X-Auth-Request-User $auth_user;
          proxy_set_header X-Auth-Request-Email $auth_email;
          proxy_set_header Host $host;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_pass http://oo_bridge/__oo_userinfo;
        }

        location = / {
          return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
        }

        location = /web/ {
          if ($has_auth_tokens = 0) {
            return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
          }
          proxy_pass http://oo_router;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Accept-Encoding "";
          sub_filter_once on;
          sub_filter_types text/html;
          sub_filter '</head>' '<script>try{if(!localStorage.getItem("userInfo")){fetch("/__oo_userinfo",{credentials:"include"}).then(function(r){return r.ok?r.json():null;}).then(function(data){if(!data||!data.email){return;}var json=JSON.stringify(data);var enc=btoa(encodeURIComponent(json).replace(/%([0-9A-F]{2})/g,function(m,p1){return String.fromCharCode(parseInt("0x"+p1));}));localStorage.setItem("userInfo",enc);if(window.location.pathname==="/web/login"){window.location.replace("/web/");}}).catch(function(){});}}catch(e){};</script></head>';
        }

        location = /web/login {
          if ($has_auth_tokens = 1) {
            return 302 /web/;
          }
          return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
          }

          location / {
            if ($has_auth_tokens = 0) {
              return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
            }
            proxy_pass http://oo_router;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          }
        }
      }

  - path: /root/oo-auth-proxy.yaml
    permissions: '0644'
    content: |
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oo-auth-bridge
        namespace: openobserve
        labels:
          app: oo-auth-bridge
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oo-auth-bridge
        template:
          metadata:
            labels:
              app: oo-auth-bridge
          spec:
            containers:
            - name: bridge
              image: python:3.12-slim
              imagePullPolicy: IfNotPresent
              env:
              - name: OO_URL
                value: http://openobserve-router:5080
              - name: OO_ORG
                value: default
              - name: OO_ADMIN_USER
                valueFrom:
                  secretKeyRef:
                    name: openobserve-root-creds
                    key: username
              - name: OO_ADMIN_PASS
                valueFrom:
                  secretKeyRef:
                    name: openobserve-root-creds
                    key: password
              - name: OO_USER_PASSWORD_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-auth-bridge
                    key: hmac_secret
              - name: OO_EMAIL_HEADER
                value: X-Auth-Request-Email
              - name: OO_LOGIN_HEADER
                value: X-Auth-Request-User
              ports:
              - name: http
                containerPort: 4181
              volumeMounts:
              - name: bridge-script
                mountPath: /app
              command: ["python"]
              args: ["/app/bridge.py"]
            volumes:
            - name: bridge-script
              configMap:
                name: oo-auth-bridge
                defaultMode: 0555
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oo-auth-bridge
        namespace: openobserve
      spec:
        selector:
          app: oo-auth-bridge
        ports:
        - name: http
          port: 4181
          targetPort: http
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oo-oauth2-proxy
        namespace: openobserve
        labels:
          app: oo-oauth2-proxy
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oo-oauth2-proxy
        template:
          metadata:
            labels:
              app: oo-oauth2-proxy
          spec:
            containers:
            - name: oauth2-proxy
              image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0-alpine
              imagePullPolicy: IfNotPresent
              command: ["/bin/sh", "-c"]
              args:
              - exec oauth2-proxy --http-address=0.0.0.0:4180 --provider=oidc --oidc-issuer-url=https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex --redirect-url=https://openobserve.teleport.app.${RANCHER_DOMAIN}/oauth2/callback --email-domain=* --scope="openid profile email groups" --upstream=http://openobserve-router.openobserve.svc.cluster.local:5080/ --reverse-proxy=true --set-xauthrequest=true --cookie-secret="${OAUTH2_PROXY_COOKIE_SECRET}" --cookie-secure=true --cookie-samesite=lax --cookie-refresh=1h --cookie-expire=8h --skip-provider-button=true
              env:
              - name: OAUTH2_PROXY_CLIENT_ID
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: client_id
              - name: OAUTH2_PROXY_CLIENT_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: client_secret
              - name: OAUTH2_PROXY_COOKIE_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: cookie_secret
              ports:
              - name: http
                containerPort: 4180
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oo-oauth2-proxy
        namespace: openobserve
      spec:
        selector:
          app: oo-oauth2-proxy
        ports:
        - name: http
          port: 4180
          targetPort: http
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: openobserve-auth-proxy
        namespace: openobserve
        labels:
          app: openobserve-auth-proxy
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: openobserve-auth-proxy
        template:
          metadata:
            labels:
              app: openobserve-auth-proxy
          spec:
            containers:
            - name: nginx
              image: nginx:1.27-alpine
              imagePullPolicy: IfNotPresent
              ports:
              - name: http
                containerPort: 5080
              volumeMounts:
              - name: nginx-conf
                mountPath: /etc/nginx/nginx.conf
                subPath: nginx.conf
                readOnly: true
            volumes:
            - name: nginx-conf
              configMap:
                name: oo-auth-proxy-nginx
                defaultMode: 0444
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-auth-proxy
        namespace: openobserve
      spec:
        selector:
          app: openobserve-auth-proxy
        ports:
        - name: http
          port: 5080
          targetPort: http

  - path: /usr/local/bin/cleanup-install-services.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      INSTALL_SERVICES=(
        initial-setup.service
        set-dhcp-hostname.service
        fix-dns-nfs.service
        disable-swap.service
        setup-hosts-dns.service
        configure-logging.service
        setup-cockpit.service
        setup-runtime.service
        rke2-preload-images.service
        bootstrap-rke2.service
        set-nofile-limits.service
        k8s-addons.service
        install-apisix-rancher.service
        gpu.service
        post-install.service
      )

      for svc in "$INSTALL_SERVICES[@]"; do
        if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
          systemctl disable "$svc" || true
          systemctl reset-failed "$svc" || true
        fi
      done

  - path: /usr/local/bin/performance-tuning.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Applying performance tuning..."
      
      # CPU Governor
      GOVERNOR_PATH="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
      if [ -f "$GOVERNOR_PATH" ]; then
        for CPU in /sys/devices/system/cpu/cpu[0-9]*; do
          echo performance > "$CPU/cpufreq/scaling_governor" 2>/dev/null || true
        done
        echo "✅ CPU governors set to performance"
      else
        echo "⚠️ CPU frequency scaling not available — skipping governor tuning"
      fi
      
      # Scheduler tuning for SSDs
      for dev in /sys/block/sd*/queue/scheduler; do
        echo mq-deadline > "$dev"
      done

      systemctl disable apt-daily.timer
      systemctl disable snapd
      systemctl disable motd-news.timer
      
      # Sysctl parameters
      cat <<EOF > /etc/sysctl.d/99-performance-tuning.conf
      fs.inotify.max_user_watches=524288
      vm.max_map_count=262144
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 65536 134217728
      net.ipv4.tcp_congestion_control=bbr
      vm.swappiness=10
      vm.dirty_ratio=15
      vm.dirty_background_ratio=5
      EOF
      
      sysctl --system

      # 2) Pick all “large-MTU” interfaces automatically
      #    (adjust the grep if your jumbo-MTU devices have a different naming scheme)
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        # bring MTU up before offloads
        ip link set dev $IF mtu 9000

        # enable big-packet offloads
        ethtool -K $IF gro on gso on tso on rx on tx on

        # increase the kernel TX queue length
        ip link set dev $IF txqueuelen 10000
      done

      # 3) Sysctls — bump backlog and buffers for all interfaces
      #    and enable TCP MTU probing (helps path-MTU discovery)
      sysctl -w net.core.netdev_max_backlog=250000
      sysctl -w net.core.rmem_max=134217728
      sysctl -w net.core.wmem_max=134217728
      sysctl -w net.ipv4.tcp_rmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_wmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_mtu_probing=1

      # 4) Persist sysctls
      cat <<EOF >/etc/sysctl.d/99-network-opt.conf
      net.core.netdev_max_backlog=250000
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 87380 134217728
      net.ipv4.tcp_mtu_probing=1
      EOF

      # 5) Persist ethtool + txqueuelen via a systemd service
      cat <<'EOF' >/etc/systemd/system/network-tweaks.service
      [Unit]
      Description=Apply ethtool offloads + txqueuelen
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/network-tweaks.sh

      [Install]
      WantedBy=multi-user.target
      EOF

      # Install the same script to /usr/local/bin and make it executable
            cat <<'EOF' >/usr/local/bin/network-tweaks.sh
      #!/bin/bash
      set -e
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        CURRENT_MTU=$(ip -o link show "$IF" | awk '{print $4}')
        if [ "$CURRENT_MTU" != "9000" ]; then
          ip link set dev "$IF" mtu 9000
        fi
        ethtool -K $IF gro on gso on tso on rx on tx on
        ip link set dev $IF txqueuelen 10000
      done
      EOF

      chmod +x /usr/local/bin/network-tweaks.sh

      systemctl daemon-reload
      systemctl enable network-tweaks

      echo "✅ Network tweaks applied and will persist across reboots."
      
      # Limit nofile
      cat <<EOF > /etc/security/limits.d/99-nofile.conf
      * soft nofile 1048576
      * hard nofile 1048576
      EOF
      
      # Systemd service overrides
      mkdir -p /etc/systemd/system/containerd.service.d
      mkdir -p /etc/systemd/system/rke2-server.service.d
      mkdir -p /etc/systemd/system/rke2-agent.service.d
      
      cat <<EOF > /etc/systemd/system/containerd.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-server.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-agent.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF

      # cat <<EOF | sudo tee /etc/profile.d/http_proxy.sh
      # export HTTP_PROXY="http://10.0.0.10:3128"
      # export HTTPS_PROXY="http://10.0.0.10:3128"
      # export NO_PROXY="127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12,192.168.0.0/16"
      # EOF

      # sudo chmod +x /etc/profile.d/http_proxy.sh

      # Unbind kernel workqueues from specific CPUs (recommended on NUMA/multicore systems)
      if [ -e /sys/module/workqueue/parameters/disable_bound ]; then
        echo y > /sys/module/workqueue/parameters/disable_bound
        echo "✅ Enabled unbound kernel workqueues for better scalability"
      fi

      # 6) Add GRUB performance kernel parameters
      echo "✅ Adding performance kernel parameters to GRUB..."
      GRUB_CONFIG_FILE="/etc/default/grub"

      # Append only if not already present
      if ! grep -q "workqueue.disable_bound=1" "$GRUB_CONFIG_FILE"; then
        sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="workqueue.disable_bound=1 intel_pstate=disable processor.max_cstate=1 idle=poll transparent_hugepage=never mitigations=off /' "$GRUB_CONFIG_FILE"
        update-grub
        echo "✅ GRUB updated. Kernel parameters will apply on next boot."
      else
        echo "⚠️ GRUB already configured. Skipping update."
      fi
      
      systemctl daemon-reload

  - path: /etc/sysctl.d/99-disable-ipv6.conf
    permissions: '0644'
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1

  - path: /etc/default/grub.d/99-disable-ipv6.cfg
    permissions: '0644'
    content: |
      GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX ipv6.disable=1"

  - path: /etc/systemd/system/mount-shared-storage.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount NFS shared storage
      After=network-online.target nfs-common.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'mkdir -p /mnt/shared-storage && /bin/mount -t nfs -o rw,_netdev,hard,intr,noatime,nolock,bg,retry=10 ${proxmox_host_ip}:/mnt/shared-storage /mnt/shared-storage'
      RemainAfterExit=true
      TimeoutSec=60
      Restart=no

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/10-disable-swap.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Disabling swap and modifying fstab..."
      swapoff -a || { echo "❌ Failed to disable swap"; exit 1; }
      cp /etc/fstab /etc/fstab.bak || { echo "❌ Failed to backup fstab"; exit 1; }
      sed -i '/^[^#].*\bswap\b/s/^/#/' /etc/fstab

  - path: /etc/systemd/system/disable-swap.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Disable swap and update fstab
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/10-disable-swap.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/15-setup-cockpit.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "Enabling Cockpit..."
      mkdir -p /etc/cockpit
      cat <<'EOF' >/etc/cockpit/cockpit.conf
      [WebService]
      AllowUnencrypted = false
      EOF

      if systemctl list-unit-files cockpit.socket >/dev/null 2>&1; then
        systemctl enable --now cockpit.socket
        echo "Cockpit enabled on port 9090."
      else
        echo "cockpit.socket not found; is the cockpit package installed?"
      fi

  - path: /usr/local/bin/20-configure-logging.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "📦 Configuring Fluent Bit for GCP logging..."

      mkdir -p /etc/google-cloud-ops-agent
      echo "${GCP_LOGGING_KEY}" | base64 -d > /etc/google-cloud-ops-agent/logging-key.json

      mkdir -p /usr/share/keyrings
      KEYRING_PATH="/usr/share/keyrings/fluent-bit-archive-keyring.gpg"

      # Clean up any broken or partial key
      rm -f "$KEYRING_PATH"

      until curl -fsSL https://packages.fluentbit.io/fluentbit.key | gpg --dearmor --no-tty --batch -o "$KEYRING_PATH"; do
        echo "Waiting for DNS resolution or valid key for fluentbit.key..."
        sleep 5
        rm -f "$KEYRING_PATH"  # ensure no corrupted key is left behind
      done

      DISTRO=$(lsb_release -cs)
      if [ "$DISTRO" = "${UBUNTU_RELEASE_CODE_NAME}" ]; then
        echo "Detected codename $DISTRO unsupported, falling back to jammy"
        DISTRO="jammy"
      fi

      echo "deb [signed-by=/usr/share/keyrings/fluent-bit-archive-keyring.gpg] https://packages.fluentbit.io/ubuntu/$DISTRO $DISTRO main" > /etc/apt/sources.list.d/fluent-bit.list
      sudo apt-get update
      sudo apt-get install -y td-agent-bit

      mkdir -p /etc/td-agent-bit/conf.d

      cat <<EOF > /etc/td-agent-bit/td-agent-bit.conf
      [SERVICE]
          flush         1
          daemon        Off
          log_level     info
          plugins_file  plugins.conf
          parsers_file  parsers.conf
          http_server   Off
          http_listen   0.0.0.0
          http_port     2020
          storage.metrics on

      @INCLUDE /etc/td-agent-bit/conf.d/*.conf
      EOF

      # cloud-init logs
      cat <<EOF > /etc/td-agent-bit/conf.d/cloudinit.conf
      [INPUT]
          Name               tail
          Mem_Buf_Limit     10MB
          Path               /var/log/cloud-init*.log
          Tag                cloudinit
          Read_from_Head     Off
          DB                 /var/log/flb_cloudinit.db
          DB.Sync            normal
          Skip_Long_Lines    On

      [FILTER]
          Name      parser
          Match     cloudinit
          Key_Name  log
          Parser    cloudinit_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match cloudinit
          Add logName cloudinit

      [FILTER]
          Name    nest
          Match   cloudinit
          Operation nest
          Wildcard process
          Wildcard pid
          Wildcard timestamp
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match cloudinit
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key cloudinit
      EOF

      # journal logs (systemd, rke2, etc.)
      cat <<EOF > /etc/td-agent-bit/conf.d/journald.conf
      [INPUT]
          Name    systemd
          Tag     journal.*
          Mem_Buf_Limit     10MB
          DB      /var/log/flb_journal.db
          Systemd_Filter  _SYSTEMD_UNIT=bootstrap-rke2.service
          Systemd_Filter  _SYSTEMD_UNIT=rke2-server.service
          Systemd_Filter  _SYSTEMD_UNIT=cloud-final.service
          Read_From_Tail  On

      [FILTER]
          Name      parser
          Match     journal.*
          Key_Name  MESSAGE
          Parser    journald_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match journal.*
          Add logName systemd-journal

      [FILTER]
          Name   modify
          Match  journal.*
          Rename message textPayload

      [FILTER]
          Name    nest
          Match   journal.*
          Operation nest
          Wildcard identifier
          Wildcard pid
          Wildcard hostname
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match journal.*
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key systemd-journal
      EOF

      # Optional: catch all syslog (if rsyslog is enabled)
      cat <<EOF > /etc/td-agent-bit/conf.d/syslog.conf
      [INPUT]
          Name              tail
          Mem_Buf_Limit     10MB
          Path              /var/log/syslog
          Tag               syslog
          Read_from_Head    Off
          DB                /var/log/flb_syslog.db
          Skip_Long_Lines   On

      [FILTER]
          Name   parser
          Match  syslog
          Key_Name log
          Parser syslog_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name   modify
          Match  syslog
          Rename message textPayload

      [FILTER]
          Name modify
          Match syslog
          Add logName syslog

      [FILTER]
          Name    nest
          Match   syslog
          Operation nest
          Wildcard hostname
          Wildcard identifier
          Wildcard pid
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match syslog
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key syslog
      EOF

      # cloudinit_parser
      cat <<EOF >> /etc/td-agent-bit/parsers.conf

      [PARSER]
          Name        cloudinit_parser
          Format      regex
          Regex       ^(?<timestamp>[^ ]+\s[^ ]+) (?<process>[^\[]+)\[(?<pid>\d+)\]:(?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%d %H:%M:%S

      [PARSER]
          Name        syslog_parser
          Format      regex
          Regex       ^(?<timestamp>\w{3} +\d{1,2} \d{2}:\d{2}:\d{2}) (?<hostname>[^\s]+) (?<identifier>[^:]+): (?<message>.*)
          Time_Key    timestamp
          Time_Format %b %d %H:%M:%S

      [PARSER]
          Name        journald_parser
          Format      regex
          Regex       ^(?<timestamp>\d{4}-\d{2}-\d{2}T[0-9:.+\-Z]+) (?<hostname>[^\s]+) (?<identifier>[^\[]+)\[(?<pid>\d+)\]: (?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%dT%H:%M:%S.%L%z
      EOF

      systemctl daemon-reload
      systemctl enable td-agent-bit
      systemctl restart td-agent-bit

  - path: /etc/security/limits.d/99-nofile.conf
    permissions: '0644'
    content: |
      * soft nofile 1048576
      * hard nofile 1048576

  - path: /etc/systemd/system/containerd.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/journald.conf.d/99-retention.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=2G
      RuntimeMaxUse=500M
      MaxRetentionSec=259200
      SystemMaxFileSize=200M

  - path: /etc/systemd/system/rke2-server.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/system/rke2-agent.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /usr/local/bin/setup-nfs-modules.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Load immediately
      modprobe nfs || true
      modprobe nfsd || true

      # Persist via /etc/modules if not already present
      grep -qxF nfs /etc/modules || echo nfs >> /etc/modules
      grep -qxF nfsd /etc/modules || echo nfsd >> /etc/modules

      # Create systemd service to load modules early
      cat <<EOF > /etc/systemd/system/load-nfs-modules.service
      [Unit]
      Description=Load NFS kernel modules
      DefaultDependencies=no
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/env modprobe nfs
      ExecStart=/usr/bin/env modprobe nfsd
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      systemctl enable load-nfs-modules.service

  - path: /usr/local/bin/setup-hosts-dns.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      echo "Hostname=$(hostname)" >> /run/systemd/network/10-netplan-eth0.network || true
      sudo systemctl restart systemd-networkd || true

      HOSTNAME=$(hostname)
      grep -q "127.0.1.1 $HOSTNAME" /etc/hosts || echo "127.0.1.1 $HOSTNAME" >> /etc/hosts

      # ---------------------------------------------
      # 🧹 Disable systemd-resolved to free port 53
      # ---------------------------------------------
      echo "🧹 Disabling systemd-resolved..."
      sudo systemctl stop systemd-resolved || true
      sudo systemctl disable systemd-resolved || true
      sudo rm -f /etc/resolv.conf
      echo "nameserver 127.0.0.1" | sudo tee /etc/resolv.conf > /dev/null

      # ---------------------------------------------
      # ⚙️ Configure dnsmasq split-DNS
      # ---------------------------------------------
      sudo tee /etc/dnsmasq.d/k8s-split-dns.conf > /dev/null <<EOF
      # Forward Kubernetes service lookups to CoreDNS
      server=/svc.cluster.local/10.43.0.10

      # Forward internal LAN lookups to LAN DNS
      server=/internal.lan/10.0.0.10

      # Forward everything else to LAN DNS
      server=10.0.0.10

      # Listen locally
      listen-address=127.0.0.1

      # Don't use /etc/resolv.conf
      no-resolv
      EOF

      # Ensure dnsmasq global config allows localhost
      sudo sed -i 's/^#\?listen-address=.*/listen-address=127.0.0.1/' /etc/dnsmasq.conf || echo 'listen-address=127.0.0.1' | sudo tee -a /etc/dnsmasq.conf

      sudo systemctl enable dnsmasq
      sudo systemctl restart dnsmasq

      # Confirm DNS server
      echo "✅ dnsmasq is resolving:"
      echo "  - *.svc.cluster.local → 10.43.0.10"
      echo "  - *.internal.lan      → 10.0.0.10"
      echo "  - all others          → 10.0.0.10"

      # ---------------------------------------------
      # 🛡 IPv6 Hard Disable (Optional)
      # ---------------------------------------------
      sudo modprobe -r ip6_tables || true
      sudo modprobe -r nf_defrag_ipv6 || true
      sudo modprobe -r nf_conntrack_ipv6 || true
      sudo modprobe -r ipv6 || true

      echo "install ipv6 /bin/true" | sudo tee /etc/modprobe.d/force-disable-ipv6.conf
      echo "install ip6_tables /bin/true" | sudo tee -a /etc/modprobe.d/force-disable-ipv6.conf

      if [ -e /usr/sbin/ip6tables ]; then
        sudo mv /usr/sbin/ip6tables /usr/sbin/ip6tables.disabled
      fi

      sudo tee /etc/modprobe.d/disable-ipv6.conf > /dev/null <<EOF
      blacklist ipv6
      blacklist nf_conntrack_ipv6
      blacklist nf_defrag_ipv6
      blacklist ip6_tables
      EOF

      sudo update-initramfs -u

      # ---------------------------------------------
      # 🔁 Force sysctl re-apply on boot
      # ---------------------------------------------
      sudo tee /etc/systemd/system/sysctl-ensure.service > /dev/null <<EOF
      [Unit]
      Description=Force re-apply sysctl settings
      After=network.target
      Wants=network.target

      [Service]
      Type=oneshot
      ExecStart=/sbin/sysctl --system

      [Install]
      WantedBy=multi-user.target
      EOF

      sudo systemctl daemon-reexec
      sudo systemctl enable sysctl-ensure.service

  - path: /etc/systemd/system/setup-hosts-dns.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Setup hosts and DNS configuration
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/setup-hosts-dns.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/configure-logging.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Configure Fluent Bit logging to GCP
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/20-configure-logging.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/setup-cockpit.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Enable Cockpit web console
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/15-setup-cockpit.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/01-set-dhcp-hostname.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🌐 Setting DHCP hostname early..."
      echo "Hostname=${hostname}" >> /run/systemd/network/10-netplan-eth0.network

      systemctl restart systemd-networkd

  - path: /etc/systemd/system/set-dhcp-hostname.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Set DHCPHostname and restart systemd-networkd
      After=network-pre.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/01-set-dhcp-hostname.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/rke2-preload-images.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      IMAGE_DIR="/var/lib/rancher/rke2/agent/images"
      ARCH="amd64"

      mkdir -p "$IMAGE_DIR"

      RKE2_VERSION=$(/usr/local/bin/rke2 --version | awk '{print $3}' | head -n1)
      RKE2_VERSION_ENCODED=$(echo "${k8s_version}" | sed 's/+/%2B/g')
      IMAGE_NAME="rke2-images.linux-$ARCH.tar.zst"
      IMAGE_URL="https://github.com/rancher/rke2/releases/download/$RKE2_VERSION_ENCODED/$IMAGE_NAME"

      echo "📦 Downloading $IMAGE_URL..."
      curl -fSL "$IMAGE_URL" -o "/tmp/$IMAGE_NAME"

      echo "📦 Decompressing..."
      zstd -d "/tmp/$IMAGE_NAME" -o "/tmp/rke2-images.tar"

      echo "📂 Moving to $IMAGE_DIR..."
      mv /tmp/rke2-images.tar "$IMAGE_DIR/rke2-images.tar"

      echo "✅ Preload complete"

  - path: /etc/systemd/system/rke2-preload-images.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Preload RKE2 container images
      ConditionPathExists=/usr/local/bin/rke2
      After=network-online.target
      Before=rke2-server.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/rke2-preload-images.sh

      [Install]
      WantedBy=multi-user.target

  - path: /etc/rancher/rke2/registries.yaml
    permissions: '0755'
    content: |
      mirrors:
        docker.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/dockerhub"
        quay.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/quay"
        gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/gcr"
        k8s.gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/k8s-gcr"
        registry.k8s.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/registry-k8s"
        ghcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/ghcr"
        "nvidia":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "nvcr.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "cr.l5d.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/linkerd"
        "reg.kyverno.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/kyverno"

      configs:
        utility-node.internal.lan:
          tls:
            insecure_skip_verify: true

  - path: /usr/local/bin/30-setup-runtime.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      echo "🐳 Installing Docker..."
      until curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -; do
        echo "Retrying Docker GPG key fetch..."; sleep 5;
      done
      sudo apt-key fingerprint 0EBFCD88
      sudo add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
      sudo apt update
      DEBIAN_FRONTEND=noninteractive sudo apt install -y docker-ce docker-ce-cli containerd.io

      # Generate containerd config and configure registry mirrors
      containerd config default > /etc/containerd/config.toml

      sudo apt install python3-pip -y
      sudo apt install python3-tomlkit
      sudo python3 /usr/local/bin/patch.py

      systemctl restart containerd
      systemctl enable containerd
      # sudo mkdir -p /etc/systemd/system/docker.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/docker.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      # sudo mkdir -p /etc/systemd/system/containerd.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/containerd.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      echo "☸️ Installing kubectl, RKE2, Helm..."

      # Retry with timeout and snapd recovery
      install_with_snap_retry() {
        local package="$1"
        local max_retries=5
        local retry_count=0

        until snap install "$package" --classic && "$package" version --client 2>/dev/null; do
          retry_count=$((retry_count + 1))
          echo "❌ Failed to install $package, attempt $retry_count..."

          if (( retry_count >= max_retries )); then
            echo "🔁 Restarting snapd and trying again..."
            systemctl restart snapd
            retry_count=0
          fi

          sleep 5
        done

        echo "✅ $package installed successfully."
      }

      install_with_snap_retry kubectl

      until which rke2 >/dev/null 2>&1; do
        curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION=${k8s_version} sh -;
        sleep 5
      done

      until which helm >/dev/null 2>&1; do
        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash;
        sleep 5
      done

      echo "🔌 Enabling QEMU guest agent..."
      systemctl start qemu-guest-agent
      systemctl enable qemu-guest-agent

  - path: /usr/local/bin/patch.py
    permissions: '0755'
    content: |
      from pathlib import Path
      from tomlkit import parse, dumps, table
      import re

      TOML_PATH = "/etc/containerd/config.toml"

      # Load TOML and parse
      doc = parse(Path(TOML_PATH).read_text())

      # Ensure registry section exists (containerd defaults may omit it)
      plugins = doc.get("plugins", table())
      cri_plugin = plugins.get("io.containerd.grpc.v1.cri", table())
      cri_registry = cri_plugin.get("registry", table())

      # Configs
      configs = cri_registry.get("configs", table())
      if "utility-node.internal.lan" not in configs:
          configs["utility-node.internal.lan"] = table()
      configs["utility-node.internal.lan"]["tls"] = {"insecure_skip_verify": True}
      cri_registry["configs"] = configs

      # Mirrors
      mirrors = cri_registry.get("mirrors", table())
      mirror_map = {
          "docker.io": "dockerhub",
          "quay.io": "quay",
          "gcr.io": "gcr",
          "k8s.gcr.io": "k8s-gcr",
          "registry.k8s.io": "registry-k8s",
          "ghcr.io": "ghcr",
          "nvidia": "nvidia",
          "nvcr.io": "nvidia"
      }
      for registry, mirror_name in mirror_map.items():
          mirrors[registry] = {
              "endpoint": [f"http://utility-node.internal.lan/v2/{mirror_name}"]
          }

      cri_registry["mirrors"] = mirrors
      cri_plugin["registry"] = cri_registry
      plugins["io.containerd.grpc.v1.cri"] = cri_plugin
      doc["plugins"] = plugins

      # Dump raw TOML
      raw_toml = dumps(doc)

      # Fix indentation: match just the affected lines and re-indent
      def indent_cri_registry_values(toml_str: str) -> str:
          output = []
          indent = None
          in_target_section = False

          for line in toml_str.splitlines():
              # Detect target section
              if re.match(r'\s*\[plugins\."io\.containerd\.grpc\.v1\.cri"\.registry\..*]', line):
                  in_target_section = True
                  output.append(line)
                  continue
              # Stop when out of section
              elif re.match(r'\s*\[.*]', line):
                  in_target_section = False
                  output.append(line)
                  continue

              # Indent values under the target section
              if in_target_section and "=" in line.strip():
                  output.append("      " + line.strip())
              else:
                  output.append(line)

          return "\n".join(output)

      # Write patched file
      Path(TOML_PATH).write_text(indent_cri_registry_values(raw_toml))
      print("✅ containerd config patched with consistent indentation.")

  - path: /etc/systemd/system/setup-runtime.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install Docker, Snapd, RKE2, Helm, kubectl
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/30-setup-runtime.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/40-bootstrap-rke2.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "⚙️ Bootstrapping RKE2 configuration..."
      mkdir -p /etc/rancher/rke2
      cp /mnt/shared-storage/config.yaml /etc/rancher/rke2/config.yaml

      sudo mkdir -p /etc/systemd/system/rke2-server.service.d/

      sudo tee -a /etc/rancher/rke2/config.yaml << 'EOF'
      # ────────────────────────────────────────────────────────────────────────
      # RKE2 Configuration: Admission Plugins + Kubelet NUMA-aware Settings
      # ────────────────────────────────────────────────────────────────────────

      kube-apiserver-arg:
        - "enable-admission-plugins=PodNodeSelector"

      kubelet-arg:
        - "--max-pods=${SRVR_NODE_MAX_PODS}"
        - "--cpu-manager-policy=static"
        - "--topology-manager-policy=restricted"
        - "--reserved-cpus=0,1"
        - "--container-log-max-size=10Mi"
        - "--container-log-max-files=3"
        - "--system-reserved=memory=2Gi"
      EOF

      systemctl enable rke2-server
      systemctl start rke2-server

      echo "🗑️ Cleaning previous RKE2 tokens..."
      rm -rf /mnt/shared-storage/*.token

      RKE2_TOKEN=$(cat /var/lib/rancher/rke2/server/node-token)
      echo $RKE2_TOKEN > /mnt/shared-storage/$(hostname -I | cut -d" " -f1).token

      until sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml version; do
        echo "Waiting for kube-apiserver to respond..."
        sleep 10
      done

      echo "⏳ Waiting for all 5 nodes to become Ready..."
      while [[ $(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --no-headers | awk '$2 != "Ready" {exit 1} END {print NR}') -ne 5 ]]; do
        echo "Waiting for all 5 nodes to be Ready..."
        sleep 60
      done
      echo "✅ All nodes are Ready!"
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node srvr-node dedicated=srvr-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node etcd-node dedicated=etcd-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-no-gpu dedicated=work-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu dedicated=work-node-gpu --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-no-gpu work-node=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu work-node=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node ctrl-node dedicated=ctrl-node --overwrite

  - path: /etc/systemd/system/bootstrap-rke2.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Copy RKE2 config and expose node-token
      After=setup-runtime.service
      Requires=setup-runtime.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/40-bootstrap-rke2.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/99-set-nofile-limits.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Increasing open file limits to 1048576..."

      echo "📄 Updating PAM limits..."
      tee /etc/security/limits.d/99-nofile.conf > /dev/null <<EOF
      * soft nofile 1048576
      * hard nofile 1048576
      root soft nofile 1048576
      root hard nofile 1048576
      EOF

      echo "📄 Updating system.conf.d for global systemd limits..."
      mkdir -p /etc/systemd/system.conf.d
      tee /etc/systemd/system.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "📄 Updating user.conf.d..."
      mkdir -p /etc/systemd/user.conf.d
      tee /etc/systemd/user.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for rke2-server..."
      mkdir -p /etc/systemd/system/rke2-server.service.d
      tee /etc/systemd/system/rke2-server.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for containerd..."
      mkdir -p /etc/systemd/system/containerd.service.d
      tee /etc/systemd/system/containerd.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "🔁 Reloading systemd..."
      systemctl daemon-reload

      systemctl restart rke2-server || true
      systemctl restart containerd || true

      echo "✅ Verifying limits..."
      ulimit -n
      cat /proc/$(pgrep -f kubelet | head -n 1)/limits | grep "Max open files"

  - path: /etc/systemd/system/set-nofile-limits.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Raise nofile limit for rke2 and containerd
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/99-set-nofile-limits.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/50-k8s-addons.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      until sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/local/bin/yq; do
        echo "Retry on failed download of yq..."
        sleep 5
      done
      sudo chmod +x /usr/local/bin/yq

      # Detect RKE2 or K3s
      if [ -d "/etc/rancher/rke2/server/manifests" ]; then
        MANIFEST_DIR="/etc/rancher/rke2/server/manifests"
      elif [ -d "/var/lib/rancher/k3s/server/manifests" ]; then
        MANIFEST_DIR="/var/lib/rancher/k3s/server/manifests"
      elif [ -d "/var/lib/rancher/rke2/server/manifests" ]; then
        MANIFEST_DIR="/var/lib/rancher/rke2/server/manifests"
      else
        echo "❌ Could not detect RKE2 or K3s manifest directory."
        exit 1
      fi

      # 1) Ensure we’re on RKE2 and set the manifests dir
      [ -d "$MANIFEST_DIR" ] || { echo "❌ $MANIFEST_DIR not found (is rke2-server installed on this node?)"; exit 1; }

      # 2) Find the CoreDNS HelmChart name (typically rke2-coredns)
      CHART_NAME="$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get helmcharts.helm.cattle.io \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | grep -E '^rke2-coredns|^coredns$' | head -n1)"

      if [ -z "$CHART_NAME" ]; then
        echo "❌ Could not find CoreDNS HelmChart in kube-system. Run:
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get helmcharts.helm.cattle.io"
        exit 1
      fi
      echo "🔎 CoreDNS HelmChart name: $CHART_NAME"

      # 3) Set your internal DNS upstream(s)
      INTERNAL_DNS="10.0.0.10"

      # 4) Write the HelmChartConfig overlay
      sudo tee "$MANIFEST_DIR/coredns-config.yaml" >/dev/null <<EOF
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: $CHART_NAME
        namespace: kube-system
      spec:
        valuesContent: |-
          servers:
            - zones:
                - zone: .
              port: 53
              plugins:
                - name: errors
                - name: health
                - name: ready
                - name: kubernetes
                  parameters: cluster.local in-addr.arpa ip6.arpa
                  configBlock: |
                    pods insecure
                    fallthrough in-addr.arpa ip6.arpa
                - name: forward
                  parameters: . $INTERNAL_DNS
                - name: cache
                  parameters: 30
                - name: loop
                - name: reload
                - name: loadbalance
      EOF

      echo "✅ Wrote $MANIFEST_DIR/coredns-config.yaml"

      # 5) Give the controller a moment, then verify it applied
      sleep 15
      echo "🔍 Checking Corefile for your upstream(s)..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get configmap rke2-coredns-rke2-coredns -o yaml | grep -A2 'forward \. ' || true

      # 6) (Optional) Nudge a rollout if you want it immediate:
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system rollout restart deploy/rke2-coredns-rke2-coredns

      echo "✅ CoreDNS is patched and ready with persistent DNS fallback."

      echo "📥 Installing Cert-Manager..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager -n cert-manager
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager-webhook -n cert-manager

      echo "📥 Installing MetalLB..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/metallb/metallb/v0.13.10/config/manifests/metallb-native.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/controller -n metallb-system

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
        name: default
        namespace: metallb-system
      spec:
        addresses:
          - 10.0.0.110-10.0.0.150
      ---
      apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
        name: default
        namespace: metallb-system
      EOF

      echo "📥 Installing Longhorn..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/longhorn/longhorn/master/deploy/longhorn.yaml

      echo "⏳ Waiting for Longhorn CRDs..."
      for i in {1..60}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd volumes.longhorn.io >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn CRDs to become available ($i/60)..."
        sleep 10
      done

      echo "⏳ Waiting for Longhorn configmaps..."
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get configmap longhorn-storageclass >/dev/null 2>&1 && \
           sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get configmap longhorn-default-setting >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn configmaps to become available ($i/30)..."
        sleep 10
      done

      echo "🔧 Setting Longhorn defaults/configmaps to 1 replica..."
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: longhorn-default-setting
        namespace: longhorn-system
      data:
        default-setting.yaml: |-
          default-replica-count: "1"
          priority-class: "longhorn-critical"
          disable-revision-counter: "{\"v1\":\"true\"}"
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: longhorn-storageclass
        namespace: longhorn-system
      data:
        storageclass.yaml: |
          kind: StorageClass
          apiVersion: storage.k8s.io/v1
          metadata:
            name: longhorn
            annotations:
              storageclass.kubernetes.io/is-default-class: "true"
          provisioner: driver.longhorn.io
          allowVolumeExpansion: true
          reclaimPolicy: "Delete"
          volumeBindingMode: Immediate
          parameters:
            numberOfReplicas: "1"
            staleReplicaTimeout: "30"
            fromBackup: ""
            fsType: "ext4"
            dataLocality: "disabled"
            unmapMarkSnapChainRemoved: "ignored"
            disableRevisionCounter: "true"
            dataEngine: "v1"
            backupTargetName: "default"
      EOF

      # Wait for the Longhorn settings CRD before patching defaults
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get settings.longhorn.io default-replica-count >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn settings to become available ($i/30)..."
        sleep 10
      done

      echo "🔧 Forcing Longhorn default replica count to 1..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system patch settings.longhorn.io default-replica-count --type=merge -p '{"value":"1"}'

      echo "🔄 Recreating Longhorn StorageClasses with 1 replica..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete storageclass longhorn longhorn-rwx --ignore-not-found

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn
        annotations:
          storageclass.kubernetes.io/is-default-class: 'true'
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
        archiveOnDelete: "false"
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn-rwx
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
        fromBackup: ''
        archiveOnDelete: "false"
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: ephemeral-fast
      provisioner: kubernetes.io/no-provisioner
      volumeBindingMode: WaitForFirstConsumer
      reclaimPolicy: Delete
      parameters:
        archiveOnDelete: "false"
      EOF

      echo "⏳ Waiting for Longhorn core components to be Ready..."
      for deploy in longhorn-driver-deployer longhorn-ui longhorn-admission-webhook longhorn-conversion-webhook longhorn-recovery-backend; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get deploy "$deploy" >/dev/null 2>&1; then
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status deploy/"$deploy" --timeout=600s
        fi
      done
      for ds in longhorn-manager longhorn-csi-plugin; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get ds "$ds" >/dev/null 2>&1; then
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status ds/"$ds" --timeout=600s
        fi
      done

      echo "🚫 Disabling Longhorn scheduling on control/etcd/srvr nodes..."
      for NODE in ${CTRL_HOSTNAME} ${ETCD_HOSTNAME} ${SRVR_HOSTNAME}; do
        for i in {1..12}; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "$NODE" >/dev/null 2>&1; then
            if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system patch nodes.longhorn.io "$NODE" --type=merge -p '{"spec":{"allowScheduling":false}}'; then
              echo "✅ Longhorn scheduling disabled on $NODE"
              break
            fi
          fi
          echo "⏳ Waiting for Longhorn node $NODE to be ready ($i/12)..."
          sleep 10
        done
      done

      echo "⏳ Waiting for schedulable Longhorn nodes with available disks..."
      for i in {1..60}; do
        SCHED_READY=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o json | \
          jq '[.items[]
              | select(.spec.allowScheduling==true)
              | select((.status.conditions // []) | any(.type=="Ready" and .status=="True"))
              | select((.status.diskStatus // {} | to_entries | any(
                  ((.value.conditions // []) | any(.type=="Schedulable" and .status=="True"))
                  and ((.value.storageAvailable|tonumber)>0)
                )))
            ] | length')
        if [ "$SCHED_READY" -ge 1 ]; then
          echo "✅ Longhorn scheduling is ready on $SCHED_READY node(s)."
          break
        fi
        echo "⏳ Waiting for Longhorn schedulable nodes to be ready ($i/60)..."
        sleep 10
      done
      if [ "$SCHED_READY" -lt 1 ]; then
        echo "❌ No schedulable Longhorn nodes with available disk detected."
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o wide || true
        exit 1
      fi

  - path: /etc/systemd/system/k8s-addons.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install K8s Add-ons (Cert-Manager, MetalLB, Longhorn)
      After=bootstrap-rke2.service
      Requires=bootstrap-rke2.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/50-k8s-addons.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/60-install-apisix-rancher.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      cleanup_longhorn_smoke() {
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete pod longhorn-smoke-pod -n longhorn-smoke --ignore-not-found >/dev/null 2>&1 || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete pvc longhorn-smoke-pvc -n longhorn-smoke --ignore-not-found >/dev/null 2>&1 || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete ns longhorn-smoke --ignore-not-found --wait=false >/dev/null 2>&1 || true
      }

      wait_for_longhorn() {
        echo "⏳ Verifying Longhorn is fully ready before continuing..."

        for i in {1..60}; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get ns longhorn-system >/dev/null 2>&1; then
            break
          fi
          echo "⏳ Waiting for longhorn-system namespace ($i/60)..."
          sleep 10
        done

        if ! sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get ns longhorn-system >/dev/null 2>&1; then
          echo "❌ longhorn-system namespace not found."
          exit 1
        fi

        for crd in volumes.longhorn.io nodes.longhorn.io settings.longhorn.io; do
          for i in {1..60}; do
            if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd "$crd" >/dev/null 2>&1; then
              break
            fi
            echo "⏳ Waiting for Longhorn CRD $crd ($i/60)..."
            sleep 10
          done
          if ! sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd "$crd" >/dev/null 2>&1; then
            echo "❌ Longhorn CRD $crd not ready."
            exit 1
          fi
        done

        echo "⏳ Waiting for Longhorn core components to be Ready..."
        for deploy in longhorn-driver-deployer longhorn-ui longhorn-admission-webhook longhorn-conversion-webhook longhorn-recovery-backend; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get deploy "$deploy" >/dev/null 2>&1; then
            sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status deploy/"$deploy" --timeout=600s
          fi
        done
        for ds in longhorn-manager longhorn-csi-plugin; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get ds "$ds" >/dev/null 2>&1; then
            sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status ds/"$ds" --timeout=600s
          fi
        done

        echo "⏳ Waiting for schedulable Longhorn nodes with available disks..."
        local sched_ready
        for i in {1..60}; do
          sched_ready=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o json | \
            jq '[.items[]
                | select(.spec.allowScheduling==true)
                | select((.status.conditions // []) | any(.type=="Ready" and .status=="True"))
                | select((.status.diskStatus // {} | to_entries | any(
                    ((.value.conditions // []) | any(.type=="Schedulable" and .status=="True"))
                    and ((.value.storageAvailable|tonumber)>0)
                  )))
              ] | length')
          if [ "$sched_ready" -ge 1 ]; then
            echo "✅ Longhorn scheduling is ready on $sched_ready node(s)."
            break
          fi
          echo "⏳ Waiting for Longhorn schedulable nodes to be ready ($i/60)..."
          sleep 10
        done
        if [ "$sched_ready" -lt 1 ]; then
          echo "❌ No schedulable Longhorn nodes with available disk detected."
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o wide || true
          exit 1
        fi

        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "${SRVR_HOSTNAME}" >/dev/null 2>&1; then
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "${SRVR_HOSTNAME}" -o json | jq -e '.spec.allowScheduling==true' >/dev/null; then
            echo "❌ Longhorn scheduling is still enabled on ${SRVR_HOSTNAME}; refusing to proceed."
            exit 1
          fi
        fi

        echo "🔍 Running a Longhorn provisioning smoke test on work nodes..."
        cleanup_longhorn_smoke
        trap cleanup_longhorn_smoke EXIT
        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: longhorn-smoke
      EOF

        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: longhorn-smoke-pvc
        namespace: longhorn-smoke
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: longhorn
        resources:
          requests:
            storage: 1Gi
      EOF

        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Pod
      metadata:
        name: longhorn-smoke-pod
        namespace: longhorn-smoke
      spec:
        nodeSelector:
          work-node: "true"
        containers:
          - name: smoke
            image: public.ecr.aws/docker/library/busybox:1.36.1
            command: ["sh","-c","echo ok > /data/ready && sleep 30"]
            volumeMounts:
              - name: data
                mountPath: /data
        volumes:
          - name: data
            persistentVolumeClaim:
              claimName: longhorn-smoke-pvc
        restartPolicy: Never
      EOF

        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-smoke wait --for=jsonpath='{.status.phase}'=Bound pvc/longhorn-smoke-pvc --timeout=300s
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-smoke wait --for=condition=Ready pod/longhorn-smoke-pod --timeout=300s
        cleanup_longhorn_smoke
        trap - EXIT
        echo "✅ Longhorn provisioning smoke test passed."
      }

      wait_for_longhorn

      echo "📦 Installing NGINX Ingress Controller..."

      # 1. Create your values.yaml inline
      cat <<EOF > /tmp/ingress-values.yaml
      controller:
        allowSnippetAnnotations: true
        service:
          loadBalancerIP: "10.0.0.110"
        config:
          ssl-redirect: "false"
        deployment:
          minReadySeconds: 30
          # omit progressDeadlineSeconds so default is used (likely 600)
      EOF

      # 2. Render the chart locally to YAML
      # ─── Tunables ────────────────────────────────────────────────────────────
      MAX_ATTEMPTS=0          # 0 = retry forever ─ change to e.g. 30 to give up eventually
      SLEEP_SECONDS=10
      VALUES_FILE=/tmp/ingress-values.yaml
      RENDER_FILE=/tmp/ingress-rendered.yaml
      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      # ─────────────────────────────────────────────────────────────────────────

      attempt=0
      while :; do
        attempt=$(( attempt + 1 ))
        echo "▶️  [$attempt] Rendering ingress-nginx chart …"

        if sudo helm --kubeconfig "$KUBECONFIG" \
              template ingress-nginx ingress-nginx \
              --repo https://kubernetes.github.io/ingress-nginx \
              --namespace ingress-nginx \
              --values "$VALUES_FILE" > "$RENDER_FILE.tmp"; then
          mv "$RENDER_FILE.tmp" "$RENDER_FILE"
          echo "✅  Render succeeded on attempt #$attempt"
          break
        fi

        # Give up if we hit the hard limit (unless MAX_ATTEMPTS=0 → infinite)
        if [[ $MAX_ATTEMPTS -ne 0 && $attempt -ge $MAX_ATTEMPTS ]]; then
          echo "❌  Helm template failed after $attempt attempts"
          exit 1
        fi

        echo "🔄  Helm template failed — retrying in $SLEEP_SECONDS …"
        sleep "$SLEEP_SECONDS"
      done

      # 3. Fix invalid `progressDeadlineSeconds: 0` manually:
      sed -i 's/progressDeadlineSeconds: 0/progressDeadlineSeconds: 600/' /tmp/ingress-rendered.yaml

      # 4. Create namespace (if needed)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace ingress-nginx --dry-run=client -o yaml | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 5. Apply manifests directly (bypass Helm install)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f /tmp/ingress-rendered.yaml --validate=false

      # Wait for the NGINX ingress controller to be ready
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/ingress-nginx-controller -n ingress-nginx

      echo "🛠️ Assigning LoadBalancer IP 10.0.0.110 to ingress-nginx-controller..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch svc ingress-nginx-controller -n ingress-nginx \
        --type='merge' \
        -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.110"}}'

      echo "🏗️ Installing Rancher..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add rancher-stable https://releases.rancher.com/server-charts/stable --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo helm repo update
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace cattle-system || true

      openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout tls.key -out tls.crt -subj "/CN=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}/O=Rancher Self-Signed"

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system create secret tls tls-rancher-ingress \
        --cert=tls.crt --key=tls.key

      sudo helm upgrade --install rancher rancher-stable/rancher \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        --namespace cattle-system \
        --set hostname=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN} \
        --set bootstrapPassword=$(openssl rand -base64 18) \
        --set ingress.tls.source=rancher \
        --set ingress.enabled=true 

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=8000s deployment/rancher -n cattle-system

      echo "🌐 Patching Rancher server URL to https://k8s-platform.suncoast.systems ..."
      # Wait for the settings CRD to be registered, then patch with retries
      SETTINGS_READY=false
      for i in {1..60}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd settings.management.cattle.io >/dev/null 2>&1; then
          # Ensure the API is actually served and the Setting resource is reachable
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get --raw /apis/management.cattle.io/v3/settings/server-url >/dev/null 2>&1; then
            SETTINGS_READY=true
            break
          fi
        fi
        echo "⏳ Waiting for Rancher settings CRD/API to be ready ($i/60)..."
        sleep 10
      done

      if [[ "$SETTINGS_READY" != true ]]; then
        echo "❌ settings.management.cattle.io CRD/API not ready after waiting."
        exit 1
      fi

      PATCHED=false
      for i in {1..20}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch settings.management.cattle.io server-url \
          --type merge \
          -p '{"value":"https://k8s-platform.suncoast.systems"}'; then
          echo "✅ Rancher server URL patched"
          PATCHED=true
          break
        fi
        echo "🔄 Retry patching Rancher server URL ($i/20)..."
        sleep 10
      done

      if [[ "$PATCHED" != true ]]; then
        echo "❌ Failed to patch Rancher server URL after multiple attempts."
        exit 1
      fi

      cat <<EOF | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: infrastructure
        namespace: local
        labels:
          field.cattle.io/projectId: infrastructure
      spec:
        displayName: "Infrastructure"
        description: "Infrastructure Project for Rancher and Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: applications
        namespace: local
        labels:
          field.cattle.io/projectId: applications
      spec:
        displayName: "Applications"
        description: "Project for Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: GlobalRoleBinding
      metadata:
        name: github-k8s-cluster-admins
        labels:
          auth-provider: github
      globalRoleName: admin
      groupPrincipalName: 'github_team:${GITHUB_AUTH_VAL}'
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: github-team-cluster-admins
      subjects:
        - kind: Group
          name: 'github_team:${GITHUB_AUTH_VAL}'  # Replace with your team
          apiGroup: rbac.authorization.k8s.io
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      ---
      apiVersion: management.cattle.io/v3
      kind: ClusterRoleTemplateBinding
      metadata:
        name: github-team-cluster-owner
        namespace: local            # Adjust if your cluster name is different
      clusterName: local            # Adjust if your cluster name is different
      groupName: 'github_team:${GITHUB_AUTH_VAL}'
      roleTemplateName: cluster-owner
      ---
      accessMode: required
      apiVersion: management.cattle.io/v3
      kind: AuthConfig
      metadata:
        name: github
        namespace: cattle-system
      enabled: true
      displayName: GitHub Authentication
      clientId: '${GITHUB_CLIENT_ID}'
      clientSecret: '${GITHUB_CLIENT_SECRET}'
      hostname: 'github.com'
      tls: true
      type: githubConfig
      logoutAllSupported: false
      rancherUrl: 'https://${RANCHER_HOSTNAME}.{RANCHER_DOMAIN}'
      allowedPrincipalIds:
        - 'github_team:${GITHUB_AUTH_VAL}'
      scopes:
        - 'read:user'
        - 'user:email'
        - 'read:org'
      ---
      apiVersion: management.cattle.io/v3
      kind: Setting
      metadata:
        name: auth-provider
      value: github
      EOF

      echo "⏳ Waiting for Rancher webhook pod to be created..."

      # Wait until a pod with the correct label appears
      while ! sudo kubectl get pod -n cattle-system -l app=rancher-webhook --no-headers --kubeconfig=/etc/rancher/rke2/rke2.yaml | grep -q .; do
        echo "🔄 Pod not found yet..."
        sleep 60
      done

      echo "⏳ Pod found. Waiting for Rancher webhook pod to become Ready..."

      echo "⏳ Waiting for Rancher webhook pod to become Ready..."
      sudo kubectl wait \
        --for=condition=Ready pod -l app=rancher-webhook \
        -n cattle-system \
        --timeout=1800s \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml || {
          echo "❌ Rancher webhook pod did not become Ready in time"
          exit 1
      }

      echo "⏳ Waiting for Rancher webhook endpoint to become healthy..."

      while true; do
        if ! sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml &>/dev/null; then
          echo "🔄 Endpoint not found yet..."
        elif sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml \
                -o jsonpath="{.subsets[*].addresses[*].ip}" | grep -qE '([0-9]{1,3}\.){3}[0-9]{1,3}'; then
          echo "✅ Rancher webhook is ready"
          break
        else
          echo "🔄 Endpoint exists but has no ready IPs yet..."
        fi
        sleep 10
      done

      echo "🔧 Patching all Rancher webhooks with timeoutSeconds=30..."
      # Extract webhook indices and names using jq
      mapfile -t WEBHOOKS < <(
        sudo kubectl get validatingwebhookconfiguration rancher.cattle.io \
          -o=json \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml |
          jq -r '.webhooks | to_entries[] | "[" + (.key|tostring) + "] " + .value.name'
      )

      # Build JSON patch
      PATCHES=""
      SEP=""
      for entry in "$WEBHOOKS[@]"; do
        index=$(echo "$entry" | grep -oP '^\[\K[0-9]+')
        name=$(echo "$entry" | cut -d' ' -f2-)
        echo "  → Patching webhook [$index]: $name"
        PATCHES="$PATCHES$SEP{\"op\": \"replace\", \"path\": \"/webhooks/$index/timeoutSeconds\", \"value\": 30}"
        SEP=","
      done

      PATCH_JSON="[$PATCHES]"

      # Apply the patch
      sudo kubectl patch validatingwebhookconfiguration rancher.cattle.io \
        --type=json \
        -p="$PATCH_JSON" \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace metallb-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace longhorn-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system patch nodedriver linode \
        --type=merge \
        -p '{"spec":{"active":false}}'

      # 4. Add Linode node driver
      echo "⚙️ Installing Linode node driver..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f - <<EOF
      apiVersion: management.cattle.io/v3
      kind: NodeDriver
      metadata:
        name: linode
        namespace: cattle-system
      spec:
        active: true
        builtin: false
        url: "${LINODE_DRIVER_URL}"
        checksum: ""
        displayName: "Linode"
        uiUrl: "https://unpkg.com/rancher-ui-driver-none@0.2.0/component.js"
      EOF

      echo "✔️ Node driver added"

      echo "⏳ Waiting for Rancher to register 'linodecredentialConfig' schema..."
      get_rancher_token() {
        local password token
        # Prefer talking directly to the rancher service ClusterIP to avoid ingress timing issues
        local svc_ip login_url http_status
        for i in {1..30}; do
          # Wait for bootstrap secret to exist and read its password
          if ! password=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get secret bootstrap-secret \
            -o jsonpath='{.data.bootstrapPassword}' 2>/dev/null | base64 -d | tr -d '\n'); then
            echo "🔄 Waiting for bootstrap-secret to be available ($i/30)..."
            sleep 10
            continue
          fi

          svc_ip=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get svc rancher -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)
          if [[ -n "$svc_ip" ]]; then
            login_url="https://$svc_ip/v3-public/localProviders/local?action=login"
          else
            login_url="https://10.0.0.110/v3-public/localProviders/local?action=login"
          fi

          # Try to exchange for a token; ignore jq parse errors and keep retrying
          curl -sk -D /tmp/rancher-login.headers -o /tmp/rancher-login.json "$login_url" \
            -H 'Content-Type: application/json' \
            -H "Host: rancher.cattle-system.svc" \
            -d "{\"username\":\"admin\",\"password\":\"$password\"}" 2>/dev/null || true
          http_status=$(awk 'NR==1 {print $2}' /tmp/rancher-login.headers 2>/dev/null || true)
          token=$(jq -r '.token // empty' /tmp/rancher-login.json 2>/dev/null || true)

          if [[ -n "$token" ]]; then
            echo "$token"
            return 0
          fi
          echo "⚠️  Token empty on attempt $i (HTTP $http_status); body: $(head -c 120 /tmp/rancher-login.json 2>/dev/null)"
          sleep 10
        done
        return 1
      }

      TOKEN="$(get_rancher_token)" || { echo "❌ Failed to obtain Rancher token"; exit 1; }

      # Prefer service ClusterIP for schema check to avoid ingress timing issues
      SCHEMA_URL="https://10.0.0.110/v3/schemas"
      svc_ip=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get svc rancher -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)
      if [[ -n "$svc_ip" ]]; then
        SCHEMA_URL="https://$svc_ip/v3/schemas"
      fi

      until curl -sk \
        -H "Authorization: Bearer $TOKEN" \
        -H "Host: rancher.cattle-system.svc" \
        "$SCHEMA_URL" | grep -q linodecredentialConfig; do
        echo "🔄 Waiting for linodecredentialConfig schema..."
        sleep 60
      done
      echo "✅ 'linodecredentialConfig' schema registered."

      echo "📥 Installing Linode token..."
      API_BASE="https://10.0.0.110"
      if [[ -n "$svc_ip" ]]; then
        API_BASE="https://$svc_ip"
      fi

      curl -sk -X POST "$API_BASE/v3/cloudcredentials" \
        -H "Authorization: Bearer $TOKEN" \
        -H 'Content-Type: application/json' \
        -H "Host: rancher.cattle-system.svc" \
        -d "{
          \"name\": \"suncoast-systems-dotcomrow-credential\",
          \"type\": \"cloudCredential\",
          \"linodecredentialConfig\": {
            \"token\": \"${LINODE_TOKEN}\"
          }
        }"

      echo "✔️ Cloud credential created"

      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      K="sudo kubectl --kubeconfig=$KUBECONFIG"

      echo "🔍 Locating ClusterRoleTemplateBinding for local:// user..."

      BINDING_NAME=$($K get clusterroletemplatebindings.management.cattle.io -n local -o json \
        | jq -r '.items[] 
          | select(.userPrincipalName? // "" | startswith("local://")) 
          | select(.roleTemplateName == "cluster-owner") 
          | .metadata.name')

      if [[ -n "$BINDING_NAME" ]]; then
        echo "⚠️  Found local admin binding: $BINDING_NAME — Deleting it..."
        $K delete clusterroletemplatebindings.management.cattle.io "$BINDING_NAME" -n local
      else
        echo "✅ No local:// cluster-owner binding found — nothing to remove."
      fi

      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get users.management.cattle.io -o jsonpath='{range .items[?(@.username=="admin")]}{.metadata.name}{"\n"}{end}' | \
      xargs -I {} sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        delete users.management.cattle.io {}

      bash -c "sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch settings.management.cattle.io first-login --type='merge' -p '{\"value\": \"admin\"}'"
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml rollout restart deployment rancher -n cattle-system

      export HOME=/home/ubuntu

      LINKERD_VERSION="edge-25.8.1"  # "stable-2.18.0", "edge-25.7.5", "version-2.18", etc.
      MAX_RETRIES=5
      SLEEP_BETWEEN_RETRIES=5
      LINKERD_CLI_PATH="$HOME/.linkerd2/bin/linkerd"

      echo "🔄 Installing Linkerd CLI ($LINKERD_VERSION)..."

      for attempt in $(seq 1 "$MAX_RETRIES"); do
        echo "🔁 Attempt $attempt to download Linkerd CLI..."
        if curl -sL https://run.linkerd.io/install | sh -s -- --version "$LINKERD_VERSION"; then
          echo "✅ Linkerd CLI download succeeded"
          break
        else
          echo "⚠️  Download failed (attempt $attempt)"
          if [ "$attempt" -eq "$MAX_RETRIES" ]; then
            echo "❌ Linkerd CLI download failed after $MAX_RETRIES attempts"
            exit 1
          fi
          sleep "$SLEEP_BETWEEN_RETRIES"
        fi
      done

      if [ -f "$LINKERD_CLI_PATH" ]; then
        echo "📦 Found Linkerd CLI at $LINKERD_CLI_PATH"
        sudo cp "$LINKERD_CLI_PATH" /usr/local/bin/
        echo "✅ Linkerd CLI installed to /usr/local/bin"
      else
        echo "❌ Linkerd CLI binary not found at $LINKERD_CLI_PATH"
        exit 1
      fi

      # Optional: Verify
      if ! command -v linkerd >/dev/null; then
        echo "❌ Linkerd CLI not found in PATH after installation"
        exit 1
      fi

      echo "🎉 Linkerd CLI is ready:"
      linkerd version

      # Wait for the deployment to appear
      until sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get deployment rancher-webhook -n cattle-system >/dev/null 2>&1; do
        echo "⏳ Waiting for rancher-webhook deployment to appear..."
        sleep 5
      done

      echo "⏳ Waiting for Rancher webhook pod to become ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Available deployment/rancher-webhook -n cattle-system --timeout=120s
      echo "✅ Rancher webhook is ready."

      # Confirm version matches
      sudo linkerd version --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd-viz
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace linkerd-jaeger

      sudo kubectl annotate namespace linkerd field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace linkerd scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate ns linkerd linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-viz linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-jaeger linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      echo "📥 Installing Gateway API CRDs..."
      # sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/standard-install.yaml
            
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/experimental-install.yaml

      # 2) Install the CRDs
      sudo linkerd install --crds \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      sudo linkerd install \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
        --set clusterNetworks="10.42.0.0/16\,10.43.0.0/16" \
        --set proxyInit.ignoreOutboundPorts="4567\,4568\,4317\,4318\,2379\,8200" \
        --set proxyInit.ignoreInboundPorts="4567\,4568\,4317\,4318\,2379\,8200" \
        --set-string global.tracing.enabled=true \
        --set proxy.tracing.enabled=true \
        --set-string proxy.tracing.otlp.endpoint="otel-collector.observability.svc.cluster.local:4317" \
        --set-string proxy.tracing.collector.endpoint="otel-collector.observability.svc.cluster.local:4317" \
        --set-string proxy.tracing.collector.meshIdentity.serviceAccountName="linkerd-jaeger" \
        --set-string proxy.tracing.collector.meshIdentity.namespace="linkerd-jaeger" \
        --set-string proxy.telemetry.spans.enabled=true \
        --set proxy.tracing.otlp.insecure=true \
        --set-string proxy.telemetry.spans.level=trace \
        | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 4) Wait for Linkerd to come up
      sudo linkerd check --kubeconfig /etc/rancher/rke2/rke2.yaml

      # Installing NFS system
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: nfs-system
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "work-node=true"
      ---
      # PVC for backing NFS server
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: nfs-storage
        namespace: nfs-system
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: ${NFS_DRIVE_STORAGE}
      ---
      # NFS Server Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-server
        template:
          metadata:
            labels:
              app: nfs-server
          spec:
            containers:
              - name: nfs-server
                image: erichough/nfs-server:latest
                securityContext:
                  privileged: true
                resources:
                  limits:
                    memory: "256Mi"
                    cpu: "500m"
                  requests:
                    memory: "128Mi"
                    cpu: "250m"
                env:
                  - name: NFS_EXPORT_0
                    value: "/export *(rw,sync,no_subtree_check,no_root_squash)"
                  - name: MOUNTD_PORT
                    value: "20048"
                  - name: STATD_PORT
                    value: "32765"
                  - name: STATD_OUTGOING_PORT
                    value: "32766"
                ports:
                  - name: nfs
                    containerPort: 2049
                    protocol: TCP
                  - name: mountd
                    containerPort: 20048
                    protocol: TCP
                  - name: rpcbind
                    containerPort: 111
                    protocol: TCP
                  - name: statd
                    containerPort: 32765
                    protocol: TCP
                  - name: statd-listen
                    containerPort: 32766
                    protocol: TCP
                volumeMounts:
                  - mountPath: /export
                    name: nfs-volume
            volumes:
              - name: nfs-volume
                persistentVolumeClaim:
                  claimName: nfs-storage
      ---
      # Headless Service for the NFS Server (for DNS)
      apiVersion: v1
      kind: Service
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        clusterIP: None
        selector:
          app: nfs-server
        ports:
          - name: nfs
            port: 2049
            targetPort: 2049
            protocol: TCP
          - name: mountd
            port: 20048
            targetPort: 20048
            protocol: TCP
          - name: rpcbind
            port: 111
            targetPort: 111
            protocol: TCP
          - name: rpcbind-udp
            port: 111
            targetPort: 111
            protocol: UDP
          - name: statd
            port: 32765
            targetPort: 32765
            protocol: TCP
          - name: statd-udp
            port: 32765
            targetPort: 32765
            protocol: UDP
          - name: statd-listen
            port: 32766
            targetPort: 32766
            protocol: TCP
          - name: statd-listen-udp
            port: 32766
            targetPort: 32766
            protocol: UDP
      ---
      # NFS Provisioner RBAC
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: nfs-client-provisioner-runner
      rules:
        - apiGroups: [""]
          resources: ["persistentvolumes"]
          verbs: ["get", "list", "watch", "create", "delete"]
        - apiGroups: [""]
          resources: ["persistentvolumeclaims"]
          verbs: ["get", "list", "watch", "update"]
        - apiGroups: [""]
          resources: ["endpoints"]  # 👈 ADD THIS
          verbs: ["get", "list", "watch", "create", "update"]
        - apiGroups: ["storage.k8s.io"]
          resources: ["storageclasses"]
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["events"]
          verbs: ["create", "update", "patch"]
      ---
      kind: ClusterRoleBinding
      apiVersion: rbac.authorization.k8s.io/v1
      metadata:
        name: run-nfs-client-provisioner
      subjects:
        - kind: ServiceAccount
          name: nfs-client-provisioner
          namespace: nfs-system
      roleRef:
        kind: ClusterRole
        name: nfs-client-provisioner-runner
        apiGroup: rbac.authorization.k8s.io
      ---
      # NFS Provisioner Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-client-provisioner
        template:
          metadata:
            labels:
              app: nfs-client-provisioner
          spec:
            serviceAccountName: nfs-client-provisioner
            containers:
              - name: nfs-client-provisioner
                image: registry.k8s.io/sig-storage/nfs-subdir-external-provisioner:v4.0.2
                resources:
                  limits:
                    memory: "128Mi"
                    cpu: "500m"
                  requests:
                    memory: "64Mi"
                    cpu: "250m"
                env:
                  - name: PROVISIONER_NAME
                    value: example.com/nfs
                  - name: NFS_SERVER
                    value: nfs-server.nfs-system.svc.cluster.local
                  - name: NFS_PATH
                    value: /export
                volumeMounts:
                  - name: nfs-client-root
                    mountPath: /persistentvolumes
            volumes:
              - name: nfs-client-root
                nfs:
                  server: nfs-server.nfs-system.svc.cluster.local
                  path: /export
      ---
      # StorageClass to use the provisioner
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: nfs-client
      provisioner: example.com/nfs
      parameters:
        archiveOnDelete: "false"
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      ---
      # Vault namespace
      apiVersion: v1
      kind: Namespace
      metadata:
        name: vault
        labels:
          app: "vault"
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "work-node=true"
      EOF
      # End NFS install

      # 5) install openobserve
      # Generate random username and password
      export OPENOBSERVE_USERNAME="user$(openssl rand -hex 4)@suncoast.systems"
      export OPENOBSERVE_PASSWORD="$(openssl rand -base64 24)"
      export OPENOBSERVE_PG_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"
      export OPENOBSERVE_MINIO_USER="oo$(openssl rand -hex 4)"
      export OPENOBSERVE_MINIO_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"

      echo "🏗️ Installing OpenObserve..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add openobserve https://charts.openobserve.ai --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo kubectl create namespace openobserve --kubeconfig=/etc/rancher/rke2/rke2.yaml --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl create namespace observability --kubeconfig=/etc/rancher/rke2/rke2.yaml --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl annotate namespace observability field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace observability scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace observability linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace openobserve field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace openobserve scheduler.alpha.kubernetes.io/node-selector="dedicated=work-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace openobserve linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      echo "📦 Installing CloudNativePG operator (for OpenObserve metadata store)..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply --server-side -f https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.22/releases/cnpg-1.22.1.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cnpg-system rollout status deploy/cnpg-controller-manager --timeout=300s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cnpg-system wait --for=condition=Available deploy/cnpg-controller-manager --timeout=60s

      export OO_GH_CLIENT_ID="${OPENOBSERVE_CLIENT_ID}"
      export OO_GH_CLIENT_SECRET="${OPENOBSERVE_CLIENT_SECRET}"
      export OPENOBSERVE_GITHUB_TOKEN="${OPENOBSERVE_GITHUB_TOKEN}"
      export OO_GH_ORG="${GITHUB_ORG}"
      export OO_GH_ADMIN_TEAM="${OPENOBSERVE_GITHUB_ADMIN_TEAM}"   # e.g., platform-admins
      export OO_GH_USER_TEAM="${OPENOBSERVE_GITHUB_USER_TEAM}"    # e.g., engineers
      # Public URL OpenObserve users hit (used in redirects)
      export OO_PUBLIC_URL="https://openobserve.teleport.app.${RANCHER_DOMAIN}"
      # Dex discovery host (where OpenObserve fetches .well-known; can be internal)
      export OO_DEX_DISCOVERY_HOST="openobserve-dex.openobserve.svc.cluster.local"
      # Dex issuer/authorize host (external — Teleport by default)
      export OO_DEX_ISSUER_HOST="openobserve-dex.teleport.app.${RANCHER_DOMAIN}"
      # Dex callback host for GitHub OAuth (keep Teleport by default)
      export OO_DEX_CALLBACK_HOST="openobserve-dex.teleport.app.${RANCHER_DOMAIN}"
      export OO_DEX_DISCOVERY_BASE="http://$OO_DEX_DISCOVERY_HOST:5556/dex"
      export OO_DEX_DISCOVERY_URL="$OO_DEX_DISCOVERY_BASE/.well-known/openid-configuration"
      export OO_DEX_ISSUER_URL="https://$OO_DEX_ISSUER_HOST"
      export OO_DEX_CALLBACK_URL="https://$OO_DEX_CALLBACK_HOST"
      export OO_OAUTH2_PROXY_CLIENT_ID="oo-auth-proxy"
      export OO_OAUTH2_PROXY_CLIENT_SECRET="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"
      export OO_OAUTH2_PROXY_COOKIE_SECRET="$(python3 -c 'import secrets,string; alphabet=string.ascii_letters+string.digits; print("".join(secrets.choice(alphabet) for _ in range(32)))')"
      export OO_AUTH_BRIDGE_HMAC_SECRET="$(python3 -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())')"

      sudo helm repo update
      OO_IMAGE_TAG="${OPENOBSERVE_IMAGE_TAG}"
      sudo helm upgrade --install openobserve openobserve/openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --set-string image.oss.tag="$OO_IMAGE_TAG" \
        --set enterprise.enabled=false \
        --set enterprise.openfga.enabled=false \
        --set minio.enabled=true \
        --set-string minio.rootUser="$OPENOBSERVE_MINIO_USER" \
        --set-string minio.rootPassword="$OPENOBSERVE_MINIO_PASSWORD" \
        --set-string minio.mode=standalone \
        --set minio.replicas=1 \
        --set-string minio.persistence.storageClass=longhorn \
        --set-string minio.persistence.size=50Gi \
        --set-string minio.buckets[0].name=openobserve \
        --set-string minio.buckets[0].policy=none \
        --set minio.buckets[0].purge=false \
        --set-string auth.ZO_ROOT_USER_EMAIL="$OPENOBSERVE_USERNAME" \
        --set-string auth.ZO_ROOT_USER_PASSWORD="$OPENOBSERVE_PASSWORD" \
        --set-string auth.ZO_META_POSTGRES_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/app?sslmode=disable" \
        --set-string auth.ZO_META_POSTGRES_RO_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-ro.openobserve.svc.cluster.local:5432/app?sslmode=disable" \
        --set-string postgres.spec.password="$OPENOBSERVE_PG_PASSWORD" \
        --set-string postgres.spec.storage.size=20Gi \
        --set-string postgres.spec.storage.storageClass=longhorn \
        --set-string config.ZO_COMPACT_DATA_RETENTION_DAYS="14" \
        --set-string config.ZO_S3_BUCKET_NAME=openobserve \
        --set-string config.ZO_PROMETHEUS_ENABLE=true \
        --set replicaCount.ingester=0 \
        --set replicaCount.querier=0 \
        --set replicaCount.router=0 \
        --set replicaCount.compactor=0 \
        --set replicaCount.alertmanager=0 \
        --set replicaCount.dex=0 \
        --set-string ingester.persistence.storageClass=longhorn \
        --set-string ingester.persistence.size=50Gi \
        --set-string querier.persistence.storageClass=longhorn \
        --set-string querier.persistence.size=50Gi \
        --set-string alertmanager.persistence.storageClass=longhorn \
        --set-string alertmanager.persistence.size=20Gi \
        --set-string alertquerier.persistence.storageClass=longhorn \
        --set-string alertquerier.persistence.size=20Gi \
        --set-string nats.config.jetstream.fileStore.pvc.storageClassName=longhorn \
        --set-string nats.config.jetstream.fileStore.pvc.size=20Gi \
        --set replicaCount.dex=0

      sudo helm repo add dex https://charts.dexidp.io || true
      sudo helm repo update
      sudo helm upgrade --install openobserve-dex dex/dex \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --create-namespace \
        --set fullnameOverride=openobserve-dex \
        --set config.issuer="https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex" \
        --set config.storage.type=kubernetes \
        --set config.storage.config.inCluster=true \
        --set config.web.http="0.0.0.0:5556" \
        --set config.grpc.address="0.0.0.0:5557" \
        --set config.enablePasswordDB=false \
        --set config.oauth2.responseTypes[0]=code \
        --set config.oauth2.skipApprovalScreen=true \
        --set config.staticClients[0].id="$OO_OAUTH2_PROXY_CLIENT_ID" \
        --set config.staticClients[0].name="OpenObserve Auth Proxy" \
        --set-string config.staticClients[0].secret="$OO_OAUTH2_PROXY_CLIENT_SECRET" \
        --set config.staticClients[0].redirectURIs[0]="$OO_PUBLIC_URL/oauth2/callback" \
        --set config.connectors[0].type=github \
        --set config.connectors[0].id=github \
        --set config.connectors[0].name="GitHub" \
        --set-string config.connectors[0].config.clientID="$OO_GH_CLIENT_ID" \
        --set-string config.connectors[0].config.clientSecret="$OO_GH_CLIENT_SECRET" \
        --set config.connectors[0].config.redirectURI="https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex/callback" \
        --set-string config.connectors[0].config.orgs[0].name="$OO_GH_ORG" \
        --set-string config.connectors[0].config.orgs[0].teams[0]="${OPENOBSERVE_GITHUB_ADMIN_TEAM}" \
        --set-string config.connectors[0].config.orgs[0].teams[1]="${OPENOBSERVE_GITHUB_USER_TEAM}" \
        --set config.connectors[0].config.scopes[0]=read:org \
        --set config.connectors[0].config.scopes[1]=user:email \
        --set config.connectors[0].config.loadAllGroups=true \
        --set config.connectors[0].config.teamNameField=slug \
        --set service.ports.http.port=5556 \
        --set ingress.enabled=true \
        --set ingress.className=nginx \
        --set ingress.hosts[0].host="openobserve-dex.teleport.app.${RANCHER_DOMAIN}" \
        --set ingress.hosts[0].paths[0].path="/" \
        --set ingress.hosts[0].paths[0].pathType=Prefix \
        --set ingress.tls[0].hosts[0]="openobserve-dex.teleport.app.${RANCHER_DOMAIN}" \
        --set ingress.tls[0].secretName="dex-openobserve-tls"

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-dex --timeout=180s

      # Keep CNPG/Postgres uninjected so init jobs and DB pods don't get a Linkerd sidecar.
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch cluster.postgresql.cnpg.io openobserve-postgres --type merge -p '{
        "metadata": { "annotations": { "linkerd.io/inject": "disabled" }},
        "spec": {
          "podTemplate": {
            "metadata": { "annotations": { "linkerd.io/inject": "disabled" }}
          }
        }
      }' || true

      # wait for minio to be ready
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-minio --timeout=120s

      MINIO_USER=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
          get secret openobserve-minio -o jsonpath='{.data.rootUser}' | base64 -d)
      MINIO_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        get secret openobserve-minio -o jsonpath='{.data.rootPassword}' | base64 -d)

      # create bucket using mc image (idempotent with -p)
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve run minio-mc --rm -i --restart=Never \
          --image quay.io/minio/mc --command -- /bin/sh -c "
            mc alias set local http://openobserve-minio:9000 \"$MINIO_USER\" \"$MINIO_PASS\" >/dev/null &&
            mc mb -p local/openobserve &&
            mc ls local
          "

      echo "⏳ Waiting for OpenObserve Postgres cluster to be Ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=condition=Ready cluster.postgresql.cnpg.io/openobserve-postgres --timeout=300s

      echo "🚀 Scaling OpenObserve workloads up (app runs migrations on startup)..."
      sudo helm upgrade openobserve openobserve/openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --reuse-values \
        --set replicaCount.ingester=1 \
        --set replicaCount.querier=1 \
        --set replicaCount.router=1 \
        --set replicaCount.compactor=1 \
        --set replicaCount.alertmanager=1

      # now wait for the main OpenObserve workloads after scaling up
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status statefulset/openobserve-ingester --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status statefulset/openobserve-querier --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deployment/openobserve-compactor --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deployment/openobserve-router --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status statefulset/openobserve-alertmanager --timeout=600s
      echo "✔️ OpenObserve installed."

      OO_BASIC="$(printf '%s:%s' "$OPENOBSERVE_USERNAME" "$OPENOBSERVE_PASSWORD" | base64 | tr -d '\r\n')"
      OO_AUTH_HEADER="Basic $OO_BASIC"

      # Note: OpenObserve OSS does not support custom roles; access control is handled by Dex + oauth2-proxy.

      # store it in the same namespace as the collector
      sudo kubectl -n observability \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        create secret generic oo-auth \
        --from-literal=OO_AUTH_HEADER="$OO_AUTH_HEADER" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl -n openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        create secret generic oo-auth \
        --from-literal=OO_AUTH_HEADER="$OO_AUTH_HEADER" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic openobserve-root-creds \
        --from-literal=username="$OPENOBSERVE_USERNAME" \
        --from-literal=password="$OPENOBSERVE_PASSWORD" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      echo "🔐 Installing GitHub auth proxy for OpenObserve (Dex + oauth2-proxy + NGINX + cookie bootstrap)..."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic oo-oauth2-proxy \
        --from-literal=client_id="$OO_OAUTH2_PROXY_CLIENT_ID" \
        --from-literal=client_secret="$OO_OAUTH2_PROXY_CLIENT_SECRET" \
        --from-literal=cookie_secret="$OO_OAUTH2_PROXY_COOKIE_SECRET" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic oo-auth-bridge \
        --from-literal=hmac_secret="$OO_AUTH_BRIDGE_HMAC_SECRET" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -


      # Overwrite auth-bridge with a known-good version (the file is loaded into a ConfigMap below).

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create configmap oo-auth-bridge \
        --from-file=bridge.py=/root/oo-auth-bridge.py \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sed "s|__OO_AUTH_HEADER__|$OO_AUTH_HEADER|g" /root/oo-auth-nginx.conf > /root/oo-auth-nginx.rendered.conf

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create configmap oo-auth-proxy-nginx \
        --from-file=nginx.conf=/root/oo-auth-nginx.rendered.conf \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      echo "ℹ️  GitHub team→role sync is not deployed on OSS builds (OpenObserve OSS enforces admin-only org roles); team access is enforced at Dex."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f - <<'EOF'
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: otel-collector
        namespace: observability
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: otel-collector-read
      rules:
      - apiGroups: [""]
        resources: ["pods", "endpoints", "services", "namespaces", "nodes"]
        verbs: ["get", "list", "watch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: otel-collector-read
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: otel-collector-read
      subjects:
        - kind: ServiceAccount
          name: otel-collector
          namespace: observability
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: Server
      metadata:
        name: otlp-grpc
        namespace: observability
      spec:
        podSelector:
          matchLabels:
            app: otel-collector
        port: 4317
        proxyProtocol: gRPC
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: Server
      metadata:
        name: otlp-http
        namespace: observability
      spec:
        podSelector:
          matchLabels:
            app: otel-collector
        port: 4318
        proxyProtocol: HTTP/1
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: ServerAuthorization
      metadata:
        name: allow-mesh-to-otel
        namespace: observability
      spec:
        server:
          name: otlp-grpc
        client:
          meshTLS:
            identities:
              - "*"
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: ServerAuthorization
      metadata:
        name: allow-mesh-to-otel-http
        namespace: observability
      spec:
        server:
          name: otlp-http
        client:
          meshTLS:
            identities:
              - "*"
      ---
      # TEMPLATE ConfigMap (note the literal __AUTH_HEADER__ token)
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: otel-collector-config
        namespace: observability
        labels:
          app: otel-collector
      data:
        config.yaml: |
          receivers:
            prometheus/linkerd:
              config:
                global:
                  evaluation_interval: 10s
                  scrape_interval: 10s
                  scrape_timeout: 9s
                scrape_configs:
                  - job_name: 'linkerd-controller'
                    kubernetes_sd_configs:
                      - role: pod
                        namespaces:
                          names:
                            # include the namespaces you actually use
                            - linkerd
                            - linkerd-jaeger
                            - linkerd-viz
                    relabel_configs:
                      - source_labels: [__meta_kubernetes_pod_container_port_name]
                        action: keep
                        regex: (admin|admin-http)
                      - source_labels: [__meta_kubernetes_pod_container_name]
                        action: replace
                        target_label: component

                  - job_name: 'linkerd-multicluster-controller'
                    kubernetes_sd_configs:
                      - role: pod
                    relabel_configs:
                      - source_labels:
                          [__meta_kubernetes_pod_label_component, __meta_kubernetes_pod_container_port_name]
                        action: keep
                        regex: (linkerd-service-mirror|controller);admin(-http)?$

                  - job_name: 'linkerd-proxy'
                    kubernetes_sd_configs:
                      - role: pod
                    relabel_configs:
                      - source_labels:
                          [__meta_kubernetes_pod_container_name,
                          __meta_kubernetes_pod_container_port_name,
                          __meta_kubernetes_pod_label_linkerd_io_control_plane_ns]
                        action: keep
                        # allow either linkerd or linkerd-jaeger as control-plane ns
                        regex: ^linkerd-proxy;linkerd-admin;(linkerd|linkerd-jaeger)$
                      - source_labels: [__meta_kubernetes_namespace]
                        action: replace
                        target_label: namespace
                      - source_labels: [__meta_kubernetes_pod_name]
                        action: replace
                        target_label: pod
                      - source_labels: [__meta_kubernetes_pod_label_linkerd_io_proxy_job]
                        action: replace
                        target_label: k8s_job
                      - action: labeldrop
                        regex: __meta_kubernetes_pod_label_linkerd_io_proxy_job
                      # Map *only once* from linkerd_io labels to normal labels
                      - action: labelmap
                        regex: __meta_kubernetes_pod_label_linkerd_io_(.+)
                      # Bring over the rest of pod labels
                      - action: labelmap
                        regex: __meta_kubernetes_pod_label_(.+)
                        replacement: __tmp_pod_label_$$1
                      - action: labelmap
                        regex: __tmp_pod_label_linkerd_io_(.+)
                        replacement: __tmp_pod_label_$$1
                      - action: labeldrop
                        regex: __tmp_pod_label_linkerd_io_(.+)
                      - action: labelmap
                        regex: __tmp_pod_label_(.+)

            otlp:
              protocols:
                grpc:
                  endpoint: 0.0.0.0:4317
                http:
                  endpoint: 0.0.0.0:4318

          processors:
            memory_limiter:
              # Using percentages so this scales with pod limit.
              # With a 512Mi limit, 75% ~= 384Mi, giving ~50% headroom over your current ~220Mi usage.
              limit_percentage: 75
              spike_limit_percentage: 25
              check_interval: 5s
            batch:
              timeout: 10s
              send_batch_size: 1024
              send_batch_max_size: 2048

          exporters:
            otlp/openobserve:
              endpoint: openobserve-router.openobserve.svc.cluster.local:5081
              headers:
                Authorization: __AUTH_HEADER__
                organization: default
                stream-name: default
              tls:
                insecure: true
              sending_queue:
                enabled: true
                num_consumers: 4
                queue_size: 5000
              retry_on_failure:
                enabled: true
                initial_interval: 5s
                max_interval: 30s
                max_elapsed_time: 300s
            debug:
              verbosity: detailed

          service:
            pipelines:
              metrics:
                receivers: [prometheus/linkerd]
                processors: [memory_limiter, batch]
                exporters: [debug, otlp/openobserve]
              traces:
                receivers: [otlp]
                processors: [memory_limiter, batch]
                exporters: [debug, otlp/openobserve]
              logs:
                receivers: [otlp]
                processors: [memory_limiter, batch]
                exporters: [debug, otlp/openobserve]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: otel-collector
        namespace: observability
        labels:
          app: otel-collector
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: otel-collector
        template:
          metadata:
            labels:
              app: otel-collector
            annotations:
              config.linkerd.io/opaque-ports: "4317,4318"
          spec:
            serviceAccountName: otel-collector

            volumes:
              # Template from ConfigMap
              - name: otel-config-tpl
                configMap:
                  name: otel-collector-config
                  items:
                    - key: config.yaml
                      path: config.yaml
              # Secret with full Authorization header
              - name: oo-auth
                secret:
                  secretName: oo-auth
                  items:
                    - key: OO_AUTH_HEADER
                      path: authorization_header
              # Writable target for rendered config
              - name: otel-config-final
                emptyDir: {}

            # Render config without using 
            initContainers:
              - name: render-config
                image: alpine:3.20
                command: ["/bin/sh","-c"]
                args:
                  - |
                    mkdir -p /etc/otelcol
                    AUTH="$(tr -d '\r\n' < /etc/secret/authorization_header)"
                    awk -v val="$AUTH" '{ gsub(/__AUTH_HEADER__/, val); print }' /etc/otelcol-src/config.yaml > /etc/otelcol/config.yaml
                volumeMounts:
                  - name: otel-config-tpl
                    mountPath: /etc/otelcol-src
                    readOnly: true
                  - name: oo-auth
                    mountPath: /etc/secret
                    readOnly: true
                  - name: otel-config-final
                    mountPath: /etc/otelcol

            containers:
              - name: otel-collector
                image: otel/opentelemetry-collector-contrib:0.104.0
                args: ["--config=/etc/otelcol/config.yaml"]
                ports:
                  - name: grpc
                    containerPort: 4317
                  - name: http
                    containerPort: 4318
                volumeMounts:
                  - name: otel-config-final
                    mountPath: /etc/otelcol
                    readOnly: true
                resources:
                  requests:
                    cpu: 250m
                    memory: 256Mi
                  limits:
                    cpu: "1"
                    memory: 512Mi
                securityContext:
                  runAsNonRoot: true
                  allowPrivilegeEscalation: false
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: otel-collector
        namespace: observability
        labels:
          app: otel-collector
        annotations:
          config.linkerd.io/opaque-ports: "4317,4318"
      spec:
        type: ClusterIP
        selector:
          app: otel-collector
        ports:
          - name: otlp-grpc
            port: 4317
            targetPort: 4317
            protocol: TCP
          - name: otlp-http
            port: 4318
            targetPort: 4318
            protocol: TCP
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-gui
        namespace: openobserve
        annotations:
          teleport.dev/name: "openobserve-gui"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "openobserve.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "OpenObserve GUI"
        labels:
          app: openobserve
          app.kubernetes.io/name: openobserve
          app.kubernetes.io/component: openobserve
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: openobserve-auth-proxy
        ports:
          - name: http
            port: 5080
            protocol: TCP
            targetPort: http
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-dex-external
        namespace: openobserve
      spec:
        type: LoadBalancer
        loadBalancerIP: 10.0.0.113
        selector:
          app.kubernetes.io/instance: openobserve-dex
          app.kubernetes.io/name: dex
        ports:
          - name: http
            port: 5556
            protocol: TCP
            targetPort: 5556
      ---
      # Linkerd policy fixes for prometheus-admin access from otel-collector
      apiVersion: policy.linkerd.io/v1alpha1
      kind: MeshTLSAuthentication
      metadata:
        name: otel-collector-mtls
        namespace: linkerd-viz
      spec:
        identities:
          - "otel-collector.observability.serviceaccount.identity.linkerd.cluster.local"
      ---
      apiVersion: policy.linkerd.io/v1alpha1
      kind: AuthorizationPolicy
      metadata:
        name: prometheus-admin-otel-collector
        namespace: linkerd-viz
      spec:
        targetRef:
          group: policy.linkerd.io
          kind: Server
          name: prometheus-admin
        requiredAuthenticationRefs:
          - group: policy.linkerd.io
            kind: MeshTLSAuthentication
            name: otel-collector-mtls
      EOF

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve apply -f /root/oo-auth-proxy.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/oo-oauth2-proxy --timeout=180s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/oo-auth-bridge --timeout=180s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-auth-proxy --timeout=180s

      echo "📊 Installing OpenObserve community dashboards..."
      if [[ -z "$OPENOBSERVE_DASHBOARD_FOLDER" ]]; then
        OO_DASHBOARD_FOLDER="default"
      else
        OO_DASHBOARD_FOLDER="$OPENOBSERVE_DASHBOARD_FOLDER"
      fi

      if [[ -z "$OO_AUTH_HEADER" ]]; then
        echo "⚠️  OO_AUTH_HEADER is empty; skipping dashboard import."
      else
          # 2) Folders (no heredoc)
          DASHBOARD_FOLDERS_B64=$(printf '%s\n' \
            "Kubernetes(kube-prometheus-stack)" \
            "Kubernetes(openobserve-collector)" \
            "NVIDIA GPU Monitoring" | base64 | tr -d '\r\n')

          # 3) Python script as a single variable (no heredoc)
          DASHBOARD_SCRIPT=$'import base64, json, os, sys, urllib.parse, urllib.request\n'
          DASHBOARD_SCRIPT+=$'auth = os.environ.get("OO_AUTH_HEADER")\n'
          DASHBOARD_SCRIPT+=$'folders_raw = os.environ.get("OO_DASHBOARD_FOLDERS_B64", "")\n'
          DASHBOARD_SCRIPT+=$'if not auth: sys.exit("missing OO_AUTH_HEADER")\n'
          DASHBOARD_SCRIPT+=$'try: folders_text = base64.b64decode(folders_raw).decode()\n'
          DASHBOARD_SCRIPT+=$'except Exception as exc: sys.exit(f"unable to decode folders list: {exc}")\n'
          DASHBOARD_SCRIPT+=$'folders = [f.strip() for f in folders_text.splitlines() if f.strip()]\n'
          DASHBOARD_SCRIPT+=$'repo_base = "https://api.github.com/repos/openobserve/dashboards/contents/"\n'
          DASHBOARD_SCRIPT+=$'target_url = "http://openobserve-router:5080/api/default/dashboards?folder=default"\n'
          DASHBOARD_SCRIPT+=$'headers = {"Authorization": auth, "Content-Type": "application/json"}\n'
          DASHBOARD_SCRIPT+=$'def fetch_json(url):\n    with urllib.request.urlopen(url) as resp: return json.load(resp)\n'
          DASHBOARD_SCRIPT+=$'def fetch_bytes(url):\n    with urllib.request.urlopen(url) as resp: return resp.read()\n'
          DASHBOARD_SCRIPT+=$'success = 0\n'
          DASHBOARD_SCRIPT+=$'for folder in folders:\n'
          DASHBOARD_SCRIPT+=$'    encoded_folder = urllib.parse.quote(folder, safe="()")\n'
          DASHBOARD_SCRIPT+=$'    list_url = f"{repo_base}{encoded_folder}?ref=main"\n'
          DASHBOARD_SCRIPT+=$'    try:\n        entries = fetch_json(list_url)\n'
          DASHBOARD_SCRIPT+=$'    except Exception as exc:\n        print(f"❌ List failed for {folder}: {exc}", file=sys.stderr)\n        continue\n'
          DASHBOARD_SCRIPT+=$'    for entry in entries:\n'
          DASHBOARD_SCRIPT+=$'        if entry.get("type") != "file": continue\n'
          DASHBOARD_SCRIPT+=$'        name = entry.get("name", "")\n'
          DASHBOARD_SCRIPT+=$'        if not name.endswith(".dashboard.json"): continue\n'
          DASHBOARD_SCRIPT+=$'        download_url = entry.get("download_url")\n'
          DASHBOARD_SCRIPT+=$'        if not download_url: continue\n'
          DASHBOARD_SCRIPT+=$'        try:\n'
          DASHBOARD_SCRIPT+=$'            payload = fetch_bytes(download_url)\n'
          DASHBOARD_SCRIPT+=$'            req = urllib.request.Request(target_url, data=payload, headers=headers, method="POST")\n'
          DASHBOARD_SCRIPT+=$'            with urllib.request.urlopen(req) as resp:\n'
          DASHBOARD_SCRIPT+=$'                print(f"✅ {folder}/{name} -> HTTP {resp.status}")\n'
          DASHBOARD_SCRIPT+=$'                success += 1\n'
          DASHBOARD_SCRIPT+=$'        except Exception as exc:\n'
          DASHBOARD_SCRIPT+=$'            print(f"❌ Import failed {folder}/{name}: {exc}", file=sys.stderr)\n'
          DASHBOARD_SCRIPT+=$'print(f"Total imported: {success}")\n'

          DASHBOARD_SCRIPT64=$(printf '%s' "$DASHBOARD_SCRIPT" | base64 | tr -d '\r\n')

          # Run inside cluster (no heredocs)
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve run oo-dash-import --rm -i --restart=Never \
            --image=python:3-alpine \
            --env OO_AUTH_HEADER="$OO_AUTH_HEADER" \
            --env OO_DASHBOARD_FOLDERS_B64="$DASHBOARD_FOLDERS_B64" \
            --env DASHBOARD_SCRIPT64="$DASHBOARD_SCRIPT64" \
            -- /bin/sh -c 'python -c "import os,base64;exec(base64.b64decode(os.environ[\"DASHBOARD_SCRIPT64\"]).decode())"'
      fi

      # 6) Install the Viz extension (dashboard + embedded Jaeger UI),
      #    disabling *only* the dashboard’s TLS + auth
      sudo linkerd viz install \
        --set dashboard.tls.enabled=false \
        --set dashboard.auth.enabled=false \
        --set jaeger.enabled=true \
        --set dashboard.enforcedHostRegexp=".*" \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 7) Tell Linkerd this namespace hosts the viz extension
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        label ns linkerd-viz linkerd.io/extension=viz --overwrite

      # 8) Validate the viz extension
      sudo linkerd viz check --kubeconfig /etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n linkerd-viz set env deployment/web LINKERD_DASHBOARD_ALLOW_ORIGIN="*"

      sudo kubectl rollout status deploy/web -n linkerd-viz --kubeconfig /etc/rancher/rke2/rke2.yaml

      echo "Installing Kyverno..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace kyverno || true
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace policy-reporter || true
      
      sudo kubectl annotate namespace kyverno field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace kyverno scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add kyverno https://kyverno.github.io/kyverno/ --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update
      echo "Installing Kyverno..."
      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Policy Reporter..."
        sudo helm install kyverno kyverno/kyverno -n kyverno --create-namespace --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      echo "Installing policy reporter..."
      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add policy-reporter https://kyverno.github.io/policy-reporter --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      sudo kubectl create namespace etcd --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl create namespace apisix --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace apisix field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace apisix linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd scheduler.alpha.kubernetes.io/node-selector="dedicated=srvr-node" --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # Choose strong passwords; you can reuse the same value for both if you want
      ETCD_ROOT_PASS=$(openssl rand -base64 48 | tr -d '=\n' | tr '/+' '_-')
      APISIX_ETCD_PASS=$(openssl rand -base64 48 | tr -d '=\n' | tr '/+' '_-')

      # etcd (root) secret
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd \
        create secret generic etcd-root-auth \
        --from-literal=ROOT_PASS="$ETCD_ROOT_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix \
        create secret generic etcd-root-auth \
        --from-literal=ROOT_PASS="$ETCD_ROOT_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      # apisix etcd password secret
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd \
        create secret generic etcd-apisix \
        --from-literal=etcd-password="$APISIX_ETCD_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix \
        create secret generic etcd-apisix \
        --from-literal=etcd-password="$APISIX_ETCD_PASS" \
        --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix annotate secret etcd-apisix \
        meta.helm.sh/release-name=apisix \
        meta.helm.sh/release-namespace=apisix --overwrite

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix label secret etcd-apisix \
        app.kubernetes.io/managed-by=Helm --overwrite

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Service
      metadata:
        name: etcd
        namespace: etcd
        labels: { app: etcd }
      spec:
        clusterIP: None
        ports:
          - { name: client, port: 2379, targetPort: 2379 }
          - { name: peer,   port: 2380, targetPort: 2380 }
        selector: { app: etcd }
      ---
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: etcd
        namespace: etcd
      spec:
        serviceName: etcd
        replicas: 3
        selector: { matchLabels: { app: etcd } }
        template:
          metadata:
            labels: { app: etcd }
          spec:
            containers:
              - name: etcd
                image: quay.io/coreos/etcd:v3.5.12
                imagePullPolicy: IfNotPresent
                env:
                  - name: ETCD_NAME
                    valueFrom: { fieldRef: { fieldPath: metadata.name } }
                  - name: ETCD_INITIAL_CLUSTER
                    value: |
                      etcd-0=http://etcd-0.etcd.etcd.svc.cluster.local:2380,etcd-1=http://etcd-1.etcd.etcd.svc.cluster.local:2380,etcd-2=http://etcd-2.etcd.etcd.svc.cluster.local:2380
                  - name: ETCD_INITIAL_CLUSTER_STATE
                    value: new
                  - name: ETCD_INITIAL_ADVERTISE_PEER_URLS
                    value: http://$(ETCD_NAME).etcd.etcd.svc.cluster.local:2380
                  - name: ETCD_ADVERTISE_CLIENT_URLS
                    value: http://$(ETCD_NAME).etcd.etcd.svc.cluster.local:2379
                  - name: ETCD_LISTEN_PEER_URLS
                    value: http://0.0.0.0:2380
                  - name: ETCD_LISTEN_CLIENT_URLS
                    value: http://0.0.0.0:2379
                  - name: ETCD_DATA_DIR
                    value: /var/lib/etcd
                ports:
                  - { name: client, containerPort: 2379 }
                  - { name: peer,   containerPort: 2380 }
                volumeMounts:
                  - { name: data, mountPath: /var/lib/etcd }
        volumeClaimTemplates:
          - metadata: { name: data }
            spec:
              accessModes: [ "ReadWriteOnce" ]
              resources: { requests: { storage: 5Gi } }
              # storageClassName: longhorn
      EOF

      # Wait for etcd pods to be Ready
      cat <<'YAML' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: batch/v1
      kind: Job
      metadata:
        name: etcd-auth-bootstrap
        namespace: etcd
      spec:
        completions: 1
        parallelism: 1
        backoffLimit: 0
        ttlSecondsAfterFinished: null
        template:
          spec:
            restartPolicy: Never
            containers:
              - name: etcdctl
                image: alpine:3.20
                command: ["/bin/sh","-lc"]
                env:
                  - { name: ETCDCTL_API, value: "3" }
                  - { name: EP, value: "http://etcd.etcd.svc.cluster.local:2379" }
                  - name: ROOT_PASS
                    valueFrom: { secretKeyRef: { name: etcd-root-auth, key: ROOT_PASS } }
                  - name: APISIX_PASS
                    valueFrom: { secretKeyRef: { name: etcd-apisix, key: etcd-password } }
                args:
                  - |
                    set -eu
                    echo "📦 Installing curl+tar..."
                    apk add --no-cache ca-certificates curl tar >/dev/null

                    VER="v3.5.12"
                    ARCH="$(uname -m)"
                    case "$ARCH" in
                      x86_64)  ETC_ARCH=amd64 ;;
                      aarch64) ETC_ARCH=arm64 ;;
                      *) echo "Unsupported arch: $ARCH"; exit 1 ;;
                    esac

                    URL="https://github.com/etcd-io/etcd/releases/download/$VER/etcd-$VER-linux-$ETC_ARCH.tar.gz"
                    echo "⬇️  Fetching etcdctl from $URL"
                    # simple retry loop for flaky DNS/egress
                    for i in 1 2 3; do
                      if curl -fsSL "$URL" -o /tmp/etcd.tgz; then break; fi
                      echo "curl failed (attempt $i), retrying..." >&2
                      sleep 2
                    done
                    tar -xzf /tmp/etcd.tgz -C /tmp
                    cp "/tmp/etcd-$VER-linux-$ETC_ARCH/etcdctl" /usr/local/bin/etcdctl
                    chmod +x /usr/local/bin/etcdctl
                    etcdctl version

                    echo "⏱️  Waiting for etcd to be healthy..."
                    until etcdctl --endpoints="$EP" endpoint health >/dev/null 2>&1; do sleep 2; done

                    echo "🔐 Checking auth status..."
                    if etcdctl --endpoints="$EP" auth status -w json | grep -q '"enabled":true'; then
                      echo "Auth already enabled."
                    else
                      echo "👑 Creating root (if needed) & enabling auth..."
                      etcdctl --endpoints="$EP" user add root --interactive=false --new-user-password="$ROOT_PASS" || true
                      # enable can be momentarily racy; retry a few times
                      for j in 1 2 3; do
                        etcdctl --endpoints="$EP" auth enable && break || sleep 1
                      done
                    fi

                    ROOT="--user=root:$ROOT_PASS"

                    echo "👤 Ensure 'apisix' role exists..."
                    etcdctl --endpoints="$EP" $ROOT role add apisix 2>/dev/null || true

                    echo "🔏 Ensure 'apisix' role has RW on /apisix/ ..."
                    etcdctl --endpoints="$EP" $ROOT role grant-permission --prefix=true apisix readwrite /apisix/ 2>/dev/null || true

                    echo "👤 Ensure 'apisix' user exists..."
                    etcdctl --endpoints="$EP" $ROOT user add apisix --interactive=false --new-user-password="$APISIX_PASS" 2>/dev/null || true

                    echo "🔗 Ensure 'apisix' user has 'apisix' role..."
                    etcdctl --endpoints="$EP" $ROOT user grant-role apisix apisix 2>/dev/null || true

                    echo "✅ Final auth status (must be enabled):"
                    etcdctl --endpoints="$EP" $ROOT auth status -w json | grep -q '"enabled":true'
      YAML

      # Wait for the Job to complete
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd wait --for=condition=complete job/etcd-auth-bootstrap --timeout=180s

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Policy Reporter..."
        sudo helm install policy-reporter policy-reporter/policy-reporter \
          -n policy-reporter --create-namespace \
          --set ui.enabled=true \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      echo "📦 Adding Helm repos for APISIX..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add apisix https://charts.apiseven.com --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      cat >/tmp/apisix-plugins.yaml <<'YAML'
      apisix:
        enableIPv6: false

        # Explicitly enable the plugins you want available
        plugins:
          - api-breaker
          - authz-keycloak
          - cors
          - echo
          - openid-connect
          - opentelemetry
          - prometheus
          - proxy-rewrite
          - real-ip
          - client-control

        # Per-plugin settings
        pluginAttrs:
          opentelemetry:
            collector:
              # OTLP/HTTP endpoint on your Linkerd Jaeger collector
              address: otel-collector.observability.svc.cluster.local:4318
      YAML

      echo "🚀 Installing APISIX Gateway and Dashboard..."
      sudo helm upgrade --install apisix apisix/apisix \
        --version 2.10.1 \
        --namespace apisix \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -f /tmp/apisix-plugins.yaml \
        --set etcd.enabled=false \
        --set externalEtcd.host[0]="http://etcd.etcd.svc.cluster.local:2379" \
        --set externalEtcd.user="apisix" \
        --set-string externalEtcd.password="$APISIX_ETCD_PASS" \
        --set-string externalEtcd.user=apisix \
        --set externalEtcd.tls.enabled=false \
        --set config.etcd.prefix="/apisix" \
        --set config.etcd.timeout=30 \
        --set config.etcd.user="apisix" \
        --set apisix.deployment.role=traditional \
        --set apisix.deployment.role_traditional.config_provider=etcd \
        --set apisix.enableIPv6=false \
        --set apisix.podAnnotations."linkerd\.io/inject"="disabled" \
        --set config.nginx_config.http_listen[0]="0.0.0.0:9080" \
        --set config.nginx_config.ssl.listen[0]="0.0.0.0:9443" \
        --set config.nginx_config.stream_proxy.tcp="[]" \
        --set config.nginx_config.stream_proxy.udp="[]" \
        --set ingress-controller.enabled=true \
        --set ingress-controller.replicaCount=1 \
        --set ingress-controller.config.provider.type=apisix \
        --set ingress-controller.config.apisix.serviceNamespace=apisix 

        NAMESPACE="apisix"
        CONFIGMAP_NAME="apisix"
        KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
        TMP_FILE="$HOME/disable-ipv6-apisix.yaml"

        # 1) Grab the apisix etcd password from the apisix namespace secret
        APISIX_ETCD_PASS="$(
          sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" \
            get secret etcd-apisix -o jsonpath='{.data.etcd-password}' 2>/dev/null | base64 -d
        )"

        # Fallback: if not in apisix ns (shouldn’t happen now), pull from etcd ns
        if [ -z "$APISIX_ETCD_PASS" ]; then
          APISIX_ETCD_PASS="$(
            sudo kubectl --kubeconfig "$KUBECONFIG" -n etcd \
              get secret etcd-apisix -o jsonpath='{.data.etcd-password}' 2>/dev/null | base64 -d
          )"
        fi

        if [ -z "$APISIX_ETCD_PASS" ]; then
          echo "❌ Could not read etcd password from secret 'etcd-apisix'." >&2
          exit 1
        fi

        echo "📦 Exporting current config..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get configmap "$CONFIGMAP_NAME" \
          -o jsonpath='{.data.config\.yaml}' > "$TMP_FILE"

        # 2) Patch config: disable IPv6 and ensure etcd auth block is present
        echo "🛠 Patching config (disable IPv6 + set etcd credentials)..."
        # Static bits
        sudo yq -i '
          .apisix.enable_ipv6 = false
          | .etcd.host = ["http://etcd.etcd.svc.cluster.local:2379"]
          | .etcd.prefix = "/apisix"
          | .etcd.user = "apisix"
        ' "$TMP_FILE"

        # Secret value (use env-injection so special chars are safe)
        printf '%s' "$APISIX_ETCD_PASS" \
          | sudo yq -i '.etcd.password = load_str("/dev/stdin")' "$TMP_FILE"
        
        # 3) Apply the updated ConfigMap
        echo "🚀 Updating ConfigMap..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" create configmap "$CONFIGMAP_NAME" \
          --from-file=config.yaml="$TMP_FILE" --dry-run=client -o yaml | \
          sudo kubectl --kubeconfig "$KUBECONFIG" apply -f -

        # (Optional) Show the etcd section we just wrote
        echo "🔎 New etcd section in config.yaml:"
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get cm "$CONFIGMAP_NAME" \
          -o jsonpath='{.data.config\.yaml}' | sed -n '/^etcd:/,/^[^[:space:]]/p'

        # 4) Restart APISIX so it picks up the new config
        echo "🔥 Restarting APISIX pod(s)..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" delete pod -l app.kubernetes.io/name=apisix

        echo "✅ IPv6 disabled, etcd auth configured, APISIX restarting."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch service apisix-gateway --namespace apisix --type 'merge'         -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.112"}}'

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install APISIX Dashboard..."
        sudo helm upgrade --install apisix-dashboard apisix/apisix-dashboard \
          --namespace apisix \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml \
          --set replicaCount=1 \
          --set config.conf.etcd.endpoints[0]="http://etcd.etcd.svc.cluster.local:2379" \
          --set config.conf.etcd.username="apisix" \
          --set-string config.conf.etcd.password="$APISIX_ETCD_PASS" && break
        
        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install APISIX Dashboard after $RETRIES attempts." >&2
        exit 1
      fi     

      echo "⏳ Waiting for APISIX components..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-ingress-controller -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-dashboard -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix -n apisix

      echo "🚀 Deploying OAuth2 Proxy..."
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: apisix
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://apisix-dashboard.apisix.svc.cluster.local
                  - --email-domain=*
                  - --cookie-secret=${OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${GATEWAY_MANAGER_OAUTH2_CLIENT_ID}
                  - --client-secret=${GATEWAY_MANAGER_OAUTH2_CLIENT_SECRET}
                  - --redirect-url=https://gateway-manager.teleport.app.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --allowed-group=${GITHUB_ORG}:k8s_cluster_admins
      EOF

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: apisix
        annotations:
          teleport.dev/name: "apisix-external-gateway"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "gateway-manager.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "APISIX External Gateway"
        labels:
          app: apisix-external-gateway
          app.kubernetes.io/name: apisix-external-gateway
          app.kubernetes.io/component: apisix-external-gateway
          teleport.dev/enroll: "true"
      spec:
        ports:
          - port: 80
            targetPort: 4180
        type: LoadBalancer
        loadBalancerIP: 10.0.0.111
        selector:
          app: oauth2-proxy
      EOF

      # --- Enable real client IP extraction everywhere ---------------------------
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: real-ip-global
      spec:
        plugins:
          - name: real-ip
            enable: true
            config:
              # read the address that HAProxy appends
              source: http_x_forwarded_for
              recursive: true                
              trusted_addresses:
                - "10.0.0.0/24"    # Host/node network
                - "10.42.0.0/16"   # Pod network (cluster network 1)
                - "10.43.0.0/16"   # Service network (cluster network 2)           
      EOF

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: opentelemetry-global
        namespace: apisix
      spec:
        plugins:
          - name: opentelemetry
            enable: true
            config:
              # Always sample while you validate. You can switch to trace_id_ratio later.
              sampler:
                name: always_on
              # Point at your Linkerd Jaeger collector (OTLP/HTTP).
              collector:
                address: otel-collector.observability.svc.cluster.local:4318
              # Optional but helpful: add resource attributes so traces are labeled nicely.
              resource:
                service.name: apisix-gateway
                service.namespace: apisix
      EOF

  - path: /etc/systemd/system/install-apisix-rancher.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install APISIX Gateway, OAuth2 Proxy, Rancher
      After=k8s-addons.service
      Requires=k8s-addons.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/60-install-apisix-rancher.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/70-gpu.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      echo "⚙️ Labeling node for GPU support..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu         nvidia.com/gpu.present=true         nvidia.com/gpu=1 --overwrite

      echo "📥 Installing NVIDIA Helm repos..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvdp https://nvidia.github.io/k8s-device-plugin --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvidia https://helm.ngc.nvidia.com/nvidia --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      echo "📥 Creating nvidia namespace..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace nvidia || true
      sudo kubectl annotate namespace nvidia field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # echo "📦 Creating GPU time-slicing config..."
      # cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      # apiVersion: v1
      # kind: ConfigMap
      # metadata:
      #   name: time-slicing-config
      #   namespace: nvidia
      # data:
      #   any: |-
      #     version: v1
      #     flags:
      #       migStrategy: none
      #     sharing:
      #       timeSlicing:
      #         renameByDefault: true
      #         resources:
      #           - name: nvidia.com/gpu
      #             replicas: 4
      # EOF

      echo "🚀 Installing GPU Operator..."
      sudo helm upgrade -i gpu-operator nvidia/gpu-operator \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n nvidia \
        --wait \
        --version=v24.9.2 \
        --set driver.enabled=false \
        --set toolkit.env[0].name=CONTAINERD_SOCKET \
        --set toolkit.env[0].value="/run/k3s/containerd/containerd.sock" \
        --set devicePlugin.env[0].name=HOST_ULIMIT \
        --set-string devicePlugin.env[0].value="1048576" 

      # echo "🔧 Patching GPU Operator default config..."
      # sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch clusterpolicies.nvidia.com/cluster-policy         \
      #     -n gpu-operator --type merge        \
      #     -p '{"spec": {"devicePlugin": {"config": {"name": "time-slicing-config", "default": "any"}}}}'

  - path: /etc/systemd/system/gpu.service
    permissions: '0644'
    content: |
      [Unit]
      Description=GPU Operator Bootstrap
      After=install-apisix-rancher.service
      Requires=install-apisix-rancher.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/70-gpu.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/80-post-install.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /root/.bashrc && echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /home/ubuntu/.bashrc

      # adding apisix routes for linkerd and jaeger + oauth2-proxy alpha config + mounts
      cat << 'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: apisix-ingress-controller
      rules:
        - apiGroups: ["apisix.apache.org"]
          resources:
            - apisixroutes
            - apisixpluginconfigs
            - apisixconsumers
            - apisixclusterconfigs
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["services", "endpoints", "pods", "namespaces"]
          verbs: ["get", "list", "watch"]
        - apiGroups: ["networking.k8s.io"]
          resources: ["ingresses", "ingressclasses"]
          verbs: ["get", "list", "watch"]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.12.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://linkerd-web-proxy.linkerd-viz.svc.cluster.local
                  - --email-domain=*
                  - --cookie-secret=${LINKERD_OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${LINKERD_CLIENT_ID}
                  - --client-secret=${LINKERD_CLIENT_SECRET}
                  - --redirect-url=https://linkerd.teleport.app.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --set-authorization-header=true
                  - --pass-authorization-header=true
                  - --allowed-group=${GITHUB_ORG}:linkerd_admins
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
        annotations:
          teleport.dev/name: "linkerd-gui"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "linkerd.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "linkerd-gui"
        labels:
          app: linkerd
          app.kubernetes.io/name: linkerd
          app.kubernetes.io/component: linkerd
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: oauth2-proxy
        ports:
          - name: http
            port: 80
            targetPort: 4180
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: linkerd-web-proxy
        template:
          metadata:
            labels:
              app: linkerd-web-proxy
          spec:
            containers:
              - name: nginx
                image: nginx:stable
                ports:
                  - containerPort: 80
                volumeMounts:
                  - name: nginx-config
                    mountPath: /etc/nginx/nginx.conf
                    subPath: nginx.conf
            volumes:
              - name: nginx-config
                configMap:
                  name: linkerd-web-proxy-config
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: linkerd-web-proxy-config
        namespace: linkerd-viz
      data:
        nginx.conf: |
          events {}

          http {
            map $http_upgrade $origin_override {
              default     "";
              websocket   "http://localhost";
            }

            server {
              listen 80;

              access_log /var/log/nginx/access.log;
              error_log  /var/log/nginx/error.log debug;

              location / {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                proxy_set_header Origin $origin_override;

                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
              }

              location /api/tap {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                # 🔥 Remove Origin entirely to bypass CheckOrigin() on /api/tap
                proxy_set_header Origin "";
              }
            }
          }
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        selector:
          app: linkerd-web-proxy
        ports:
          - name: http
            port: 80
            targetPort: 80
      EOF
      # end apisix routes for linkerd and jaeger

      VAULT_OIDC_SECRET=$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)

      sudo kubectl get secret tls-rancher --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system -o yaml | \
        sed 's/namespace: cattle-system/namespace: vault/' | \
        sudo kubectl apply --kubeconfig=/etc/rancher/rke2/rke2.yaml -f -

      # installing vault
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Secret
      metadata:
        name: gcp-service-account
        namespace: vault
      type: Opaque
      data:
        key.json: ${GOOGLE_CREDENTIALS}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-id
        namespace: vault
      data:
        PROJECT_ID: ${GCP_PROJECT_ID}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-region
        namespace: vault
      data:
        PROJECT_REGION: ${GCP_REGION}
      ---
      # Grant cluster-admin to "default" in vault (matches your previous working state)
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: dex-crd-manager
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      subjects:
      - kind: ServiceAccount
        name: default
        namespace: vault
      ---
      # ALSO grant cluster-admin to vault-auth (so both the pod & the Job can act cluster-wide)
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: vault-auth
        namespace: vault
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: vault-auth-admin
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      subjects:
      - kind: ServiceAccount
        name: vault-auth
        namespace: vault
      ---
      # GCP KMS unseal credentials
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-unseal-gcp-creds
        namespace: vault
      type: Opaque
      data:
        vault-unseal-sa.json: ${VAULT_KEY_ACCOUNT}
      ---
      # Vault OIDC client credentials (using Dex)
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-oidc-creds
        namespace: vault
      type: Opaque
      stringData:
        client_id: "vault"
        client_secret: "$VAULT_OIDC_SECRET"
        redirect_uri: "https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback"
      ---
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: vault-creds-pvc
        namespace: vault
      spec:
        accessModes:
          - ReadWriteMany
        resources:
          requests:
            storage: 1Gi
        storageClassName: longhorn
      ---
      # Dex configuration (GitHub connector and Vault client)
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: dex-config
        namespace: vault
      data:
        config.docker.yaml: |
          issuer: https://vault-dex.teleport.app.${RANCHER_DOMAIN}
          storage:
            type: kubernetes
            config:
              inCluster: true
          web:
            http: 0.0.0.0:5556

          staticClients:
          - id: "vault"
            redirectURIs:
            - "https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback"
            name: "Vault UI"
            secret: "$VAULT_OIDC_SECRET"

          connectors:
          - type: github
            id: github
            name: GitHub
            config:
              clientID: ${VAULT_OIDC_CLIENT_ID}
              clientSecret: ${VAULT_OIDC_CLIENT_SECRET}
              redirectURI: https://vault-dex.teleport.app.${RANCHER_DOMAIN}/callback
              orgs:
              - name: dotcomrow
                teams:
                - vault_admins
              scopes:
              - read:org
              loadAllGroups: true
              teamNameField: slug
      ---
      # Dex Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: dex
        namespace: vault
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: dex
        template:
          metadata:
            labels:
              app: dex
          spec:
            containers:
            - name: dex
              image: ghcr.io/dexidp/dex:v2.37.0
              resources:
                requests:
                  cpu: "100m"
                  memory: "128Mi"
                limits:
                  cpu: "250m"
                  memory: "256Mi"
              volumeMounts:
              - name: config
                mountPath: /etc/dex/config.docker.yaml
                subPath: config.docker.yaml
              ports:
              - containerPort: 5556
            volumes:
            - name: config
              configMap:
                name: dex-config
      ---
      # Dex Service (LoadBalancer as before)
      apiVersion: v1
      kind: Service
      metadata:
        name: dex
        namespace: vault
        annotations:
          teleport.dev/name: "vault-dex"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "vault-dex.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "Vault DEX Service"
        labels:
          app: vault-dex
          app.kubernetes.io/name: vault-dex
          app.kubernetes.io/component: vault-dex
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: dex
        type: LoadBalancer
        loadBalancerIP: 10.0.0.122
        ports:
        - name: http
          port: 5556
          targetPort: 5556
      ---
      # APISIXRoute for Dex (optional; harmless even with LB)
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: dex-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: dex-gui
          match:
            hosts:
            - "vault-dex.teleport.app.${RANCHER_DOMAIN}"
            paths:
            - /*
          backends:
          - serviceName: dex
            servicePort: http
      ---
      # Vault production config
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-config
        namespace: vault
      data:
        vault.hcl: |
          disable_mlock = true
          cluster_addr  = "http://vault.vault.svc.cluster.local:8201"
          api_addr      = "https://vault.teleport.app.${RANCHER_DOMAIN}"

          seal "gcpckms" {
            project     = "${GCP_PROJECT_ID}"
            region      = "${GCP_REGION}"
            key_ring    = "vault-infra-ring"
            crypto_key  = "vault-unseal"
            credentials = "/etc/vault/vault-unseal-sa.json"
          }

          listener "tcp" {
            address     = "0.0.0.0:8200"
            tls_disable = 1
          }

          storage "file" {
            path = "/vault/data"
          }

          ui = true
      ---
      # Vault StatefulSet (runs as vault-auth which has cluster-admin for bootstrap)
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: vault
        namespace: vault
        labels:
          app: vault
      spec:
        serviceName: vault
        replicas: 1
        selector:
          matchLabels:
            app: vault
        template:
          metadata:
            labels:
              app: vault
          spec:
            serviceAccountName: vault-auth
            dnsPolicy: "None"
            dnsConfig:
              nameservers:
                - 10.43.0.10
                - 1.1.1.1
              options:
                - name: ndots
                  value: "2"
            securityContext:
              fsGroup: 1000
            initContainers:
              - name: install-utils
                image: alpine/k8s:${KUBECTL_IMAGE_VERSION}
                command: ["sh", "-c"]
                args:
                  - cp /usr/bin/kubectl /shared/kubectl && chmod +x /shared/kubectl
                volumeMounts:
                  - name: shared-utils
                    mountPath: /shared
            containers:
              - name: vault
                image: hashicorp/vault:1.14.3
                resources:
                  requests:
                    cpu: "250m"
                    memory: "256Mi"
                  limits:
                    cpu: "500m"
                    memory: "512Mi"
                env:
                  - name: VAULT_ADDR
                    value: "http://127.0.0.1:8200"
                  - name: VAULT_NAMESPACE
                    value: "root"
                volumeMounts:
                  - name: config
                    mountPath: /vault/config/vault.hcl
                    subPath: vault.hcl
                  - name: data
                    mountPath: /vault/data
                  - name: gcp-creds
                    mountPath: /etc/vault
                    readOnly: true
                  - name: oidc-creds
                    mountPath: /etc/vault-oidc
                    readOnly: true
                  - name: shared-utils
                    mountPath: /usr/local/bin/kubectl
                    subPath: kubectl
                  - name: shared-data
                    mountPath: /vault/creds-data
                  - name: gcp-project-id
                    mountPath: /config/gcp-project-id
                    readOnly: true
                  - name: gcp-project-region
                    mountPath: /config/gcp-project-region
                    readOnly: true
                  - name: script
                    mountPath: /opt/configscript
                    readOnly: true
                  - name: script-tmp
                    mountPath: /opt/scripts
                command: ["/bin/sh"]
                args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]
                ports:
                  - name: vault
                    containerPort: 8200
                # --- Probes (minimal addition) ---
                startupProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true&sealedcode=503&uninitcode=501
                    port: 8200
                  failureThreshold: 60
                  periodSeconds: 5
                livenessProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true
                    port: 8200
                  failureThreshold: 3
                  periodSeconds: 10
                readinessProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true
                    port: 8200
                  failureThreshold: 2
                  periodSeconds: 5
            volumes:
              - name: config
                configMap:
                  name: vault-config
              - name: gcp-creds
                secret:
                  secretName: vault-unseal-gcp-creds
              - name: oidc-creds
                secret:
                  secretName: vault-oidc-creds
              - name: shared-utils
                emptyDir: {}
              - name: shared-data
                persistentVolumeClaim:
                  claimName: vault-creds-pvc
              - name: gcp-project-id
                configMap:
                  name: gcp-project-id
              - name: gcp-project-region
                configMap:
                  name: gcp-project-region
              - name: script
                configMap:
                  name: vault-init-script
              - name: script-tmp
                emptyDir: {}
        volumeClaimTemplates:
          - metadata:
              name: data
            spec:
              accessModes: ["ReadWriteOnce"]
              resources:
                requests:
                  storage: 1Gi
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-init-script
        namespace: vault
      data:
        run.sh: |
          #!/bin/sh
          # Minimal/targeted changes only: robust state detection + one-time restart if sealed.
          set -e

          export VAULT_ADDR="\$VAULT_ADDR"

          SEAL_JSON=/etc/vault/vault-unseal-sa.json
          CONF=/vault/config/vault.hcl

          echo "Preflight: waiting for \$SEAL_JSON and \$CONF ..."
          i=0
          while [ ! -s "\$SEAL_JSON" ] || [ ! -s "\$CONF" ]; do
            i=\$((i+1)); if [ \$i -gt 60 ]; then echo "❌ Seal creds or config missing"; exit 1; fi
            sleep 1
          done
          echo "Preflight OK."

          vault server -config="\$CONF" &
          VAULT_PID=\$!
          trap 'kill \$VAULT_PID 2>/dev/null || true' EXIT
          # Force local listener & bound call time; never hang the loop
          read_status() {
            timeout 2 sh -lc 'vault status -address=http://127.0.0.1:8200 -format=json' 2>/dev/null || true
          }

          # Match JSON robustly (allow spaces around the colon)
          is_initialized() { 
            read_status | grep -Eq '"initialized"[[:space:]]*:[[:space:]]*true'; 
          }
          is_uninitialized() { 
            read_status | grep -Eq '"initialized"[[:space:]]*:[[:space:]]*false'; 
          }
          is_sealed() { 
            read_status | grep -Eq '"sealed"[[:space:]]*:[[:space:]]*true'; 
          }
          is_unsealed() { 
            read_status | grep -Eq '"sealed"[[:space:]]*:[[:space:]]*false'; 
          }

          echo "Waiting for Vault HTTP listener..."
          for _ in \$(seq 1 60); do
            s="\$(read_status)"
            [ -n "\$s" ] && break
            sleep 1
          done

          if is_uninitialized; then
            echo "Vault UNINITIALIZED -> operator init (recovery-shares=1)"
            vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json > /vault/data/init.json
            sleep 3
          fi

          # If sealed for a while (with creds present), restart once to kick KMS
          if is_sealed; then
            echo "Vault SEALED; waiting briefly for auto-unseal..."
            for _ in \$(seq 1 30); do
              is_unsealed && break
              sleep 2
            done
            if ! is_unsealed; then
              echo "Still SEALED; restarting Vault once to re-read KMS seal..."
              kill \$VAULT_PID
              wait \$VAULT_PID || true
              vault server -config="\$CONF" &
              VAULT_PID=\$!
              sleep 5
            fi
          fi

          echo "Waiting for Vault to become unsealed..."
          for _ in \$(seq 1 120); do
            if is_unsealed; then break; fi
            if is_uninitialized; then echo "❌ Unexpected UNINITIALIZED after init"; exit 1; fi
            sleep 2
          done
          if ! is_unsealed; then
            echo "❌ Vault did not unseal in time; deleting this pod to retry cleanly."

            # Discover namespace & pod name without new env vars:
            NS="$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace 2>/dev/null || echo vault)"
            POD="$HOSTNAME"

            # Best-effort self-delete (don’t block the container exit)
            if command -v kubectl >/dev/null 2>&1; then
              kubectl -n "$NS" delete pod "$POD" --wait=false || true
            fi

            # Exit non-zero so the container stops if deletion didn’t happen
            sleep 2
            exit 1
          fi

          echo "✅ Vault is unsealed"

          # Install jq/wget for later steps (same as before)
          apk add --no-cache jq wget >/dev/null 2>&1 || true

          # ---- Existing bootstrap (kept intact) ----

          # Initialize if necessary (convenience; state is already validated)
          if [ ! -f /vault/data/init.json ]; then
            vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json > /vault/data/init.json
          fi

          # Wait for Vault to be unsealed and ready (jq now available)
          until vault status -format=json | jq -e '.sealed == false'; do
            echo "Waiting for Vault to be unsealed..."
            sleep 2
          done

          # Admin policy
          cat <<EOF > /vault/data/admin-policy.hcl
          path "*" { capabilities = ["create","read","update","delete","list","sudo"] }
          EOF
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write admin /vault/data/admin-policy.hcl

          # Enable auth methods (idempotent)
          for m in oidc kubernetes approle; do
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q "\"\$m/\"" || \
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth enable "\$m"
          done

          # Kubernetes auth config
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/config \
            token_reviewer_jwt="\$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)" \
            kubernetes_host="https://\$KUBERNETES_SERVICE_HOST:\$KUBERNETES_SERVICE_PORT_HTTPS" \
            kubernetes_ca_cert=@/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

          # Enable KV v2
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault secrets enable -path=secret -version=2 kv || true

          # Policies
          cat <<EOF > /vault/data/avp-policy.hcl
          path "secret/data/*" { capabilities = ["read"] }
          EOF
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write vault-sync - <<EOF
          path "secret/data/*" { capabilities = ["create","read","update","delete"] }
          path "secret/metadata/*" { capabilities = ["read","delete","list"] }
          path "secret/*" { capabilities = ["list"] }
          EOF
          cat <<EOF | VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write avp -
          path "secret/data/*" { capabilities = ["read"] }
          EOF

          # AppRole for AVP
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/approle/role/vault-sync \
            token_ttl=1h token_max_ttl=4h bind_secret_id=true secret_id_bound_cidrs=0.0.0.0/0 policies=vault-sync

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault read -field=role_id auth/approle/role/vault-sync/role-id > /vault/creds-data/role_id.txt
          echo >> /vault/creds-data/role_id.txt
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write -f -field=secret_id auth/approle/role/vault-sync/secret-id > /vault/creds-data/secret_id.txt
          echo >> /vault/creds-data/secret_id.txt

          # Store root token
          kubectl create secret generic vault-root-token \
            --from-literal=VAULT_TOKEN=\$(jq -r '.root_token' /vault/data/init.json) \
            -n vault || kubectl -n vault get secret vault-root-token >/dev/null

          # GCP identifiers for the follow-up job
          cat /config/gcp-project-id/PROJECT_ID > /vault/creds-data/project_id.txt
          cat /config/gcp-project-region/PROJECT_REGION > /vault/creds-data/region.txt
          echo "vault-sync-run-container" > /vault/creds-data/service_name.txt

          # ArgoCD role for AVP
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/role/argocd \
            bound_service_account_names=argocd-repo-server \
            bound_service_account_namespaces=argocd \
            policies=avp ttl=24h

          # OIDC config (LB should be up, but add a small wait for safety)
          DISC_URL="https://vault-dex.teleport.app.${RANCHER_DOMAIN}/.well-known/openid-configuration"
          for i in \$(seq 1 12); do
            wget -q --spider "\$DISC_URL" && break || true
            echo "Waiting for Dex discovery (\$i/12)..."; sleep 5
          done
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/config \
            oidc_discovery_url="https://vault-dex.teleport.app.${RANCHER_DOMAIN}" \
            oidc_client_id="\$(cat /etc/vault-oidc/client_id)" \
            oidc_client_secret="\$(cat /etc/vault-oidc/client_secret)" \
            default_role="default" || true

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/role/default \
            bound_audiences="\$(cat /etc/vault-oidc/client_id)" \
            user_claim="email" \
            groups_claim="groups" \
            allowed_redirect_uris="https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/default/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth?with=oidc" \
            oidc_scopes="openid,email,groups" \
            policies="admin" \
            ttl="1h"

          # Follow-up Job (runs as vault-auth which is cluster-admin)
          cat <<'EOF' | kubectl apply -f -
          apiVersion: batch/v1
          kind: Job
          metadata:
            name: update-cloudrun-vault-cred
            namespace: vault
          spec:
            template:
              spec:
                serviceAccountName: vault-auth
                restartPolicy: Never
                initContainers:
                  - name: load-kubectl
                    image: alpine/k8s:${KUBECTL_IMAGE_VERSION}
                    command: ["sh","-c"]
                    args: ['cp /usr/bin/kubectl /kubectl-bin/kubectl && chmod +x /kubectl-bin/kubectl']
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /kubectl-bin
                containers:
                  - name: gcloud-update
                    image: google/cloud-sdk:slim
                    resources:
                      requests: { cpu: "100m", memory: "128Mi" }
                      limits:   { cpu: "250m", memory: "256Mi" }
                    command: ["/bin/sh"]
                    args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /usr/local/bin
                      - name: gcp-creds
                        mountPath: /tmp
                        readOnly: true
                      - name: shared-creds
                        mountPath: /shared-creds
                      - name: script
                        mountPath: /opt/configscript
                        readOnly: true
                      - name: script-tmp
                        mountPath: /opt/scripts
                volumes:
                  - name: kubectl-bin
                    emptyDir: {}
                  - name: gcp-creds
                    secret:
                      secretName: gcp-service-account
                  - name: shared-creds
                    persistentVolumeClaim:
                      claimName: vault-creds-pvc
                  - name: script
                    configMap:
                      name: vault-sync-script
                  - name: script-tmp
                    emptyDir: {}
          EOF

          wait \$VAULT_PID
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-sync-script
        namespace: vault
      data:
        run.sh: |
          #!/bin/sh
          set -e

          echo "Waiting for Vault to write role_id and secret_id..."
          while [ ! -f /shared-creds/role_id.txt ] || [ ! -f /shared-creds/secret_id.txt ]; do
            sleep 2
          done

          ROLE_ID="\$(tr -d '\r\n' </shared-creds/role_id.txt)"
          SECRET_ID="\$(tr -d '\r\n' </shared-creds/secret_id.txt)"
          PROJECT_ID="\$(tr -d '\r\n' </shared-creds/project_id.txt)"
          REGION="\$(tr -d '\r\n' </shared-creds/region.txt)"
          SERVICE_NAME="\$(tr -d '\r\n' </shared-creds/service_name.txt)"

          [ -n "\$PROJECT_ID" ] && [ -n "\$REGION" ] && [ -n "\$SERVICE_NAME" ] || { echo "❌ Missing PROJECT_ID/REGION/SERVICE_NAME"; exit 1; }

          gcloud auth activate-service-account --key-file=/tmp/key.json
          gcloud config set project "\$PROJECT_ID"
          gcloud run services update "\$SERVICE_NAME" \
            --region="\$REGION" \
            --update-env-vars "VAULT_ROLE_ID=\$ROLE_ID,VAULT_SECRET_ID=\$SECRET_ID"

          SVC_URL=\$(gcloud run services describe "\$SERVICE_NAME" --region "\$REGION" --format="value(status.url)")
          [ -n "\$SVC_URL" ] || { echo "❌ Failed to get service URL"; exit 1; }

          curl -X POST -H "Authorization: Bearer \$(gcloud auth print-identity-token)" "\$SVC_URL/sync-all"

          echo "✅ Vault credentials updated successfully"

          echo "🚀 Applying App of Apps configuration..."
          kubectl apply -n argocd -f - <<EOF
          apiVersion: argoproj.io/v1alpha1
          kind: Application
          metadata:
            name: argocd-post-install-apps-repo-app
            namespace: argocd
          spec:
            project: default
            source:
              repoURL: https://github.com/dotcomrow/argocd-post-install.git
              targetRevision: prod
              path: apps
              directory:
                recurse: true
            destination:
              server: https://kubernetes.default.svc
              namespace: argocd
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
              syncOptions:
              - PrunePropagationPolicy=foreground
              - PruneLast=true
              - ApplyOutOfSyncOnly=true
              - RespectResourceOrder=true
              retry:
                limit: 5
                backoff:
                  duration: 5s
                  factor: 2
                  maxDuration: 3m
          EOF

          echo "Removing APISIX access route to move access to Teleport"
          kubectl delete apisixroute vault-ui -n vault || true
          kubectl delete apisixroute dex-ui -n vault || true

          kubectl patch statefulset vault -n vault \
            --type='merge' \
            -p '{"spec": {"template": {"spec": {"dnsPolicy": "None", "dnsConfig": {"nameservers": ["10.43.0.10", "10.0.0.10"], "options": [{"name": "ndots", "value": "2"}]}}}}}'

          kubectl delete pod -l app=vault -n vault || true

          echo "✅ App of Apps applied."
      ---
      # Vault Service
      apiVersion: v1
      kind: Service
      metadata:
        name: vault
        namespace: vault
        annotations:
          teleport.dev/name: "vault"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "vault.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "Vault Service"
        labels:
          app: vault
          app.kubernetes.io/name: vault
          app.kubernetes.io/component: vault
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: vault
        ports:
          - name: vault
            port: 8200
            targetPort: vault
      ---
      # APISIXRoute for Vault UI
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: vault-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: vault-ui
          match:
            hosts:
            - "vault.teleport.app.${RANCHER_DOMAIN}"
            paths:
            - /*
          backends:
          - serviceName: vault
            servicePort: vault
      ---
      # cert-manager Issuer and Certificate for the injector webhook
      apiVersion: cert-manager.io/v1
      kind: Issuer
      metadata:
        name: rancher-delegated
        namespace: vault
      spec:
        ca:
          secretName: tls-rancher
      ---
      apiVersion: cert-manager.io/v1
      kind: Certificate
      metadata:
        name: vault-agent-injector-tls
        namespace: vault
      spec:
        secretName: vault-agent-injector-tls
        issuerRef:
          name: rancher-delegated
          kind: Issuer
        commonName: vault-agent-injector.vault.svc
        dnsNames:
          - vault-agent-injector.vault.svc
          - vault-agent-injector.vault.svc.cluster.local
        usages:
          - digital signature
          - key encipherment
          - server auth
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: vault-agent-injector
        namespace: vault
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-agent-injector-config
        namespace: vault
      data:
        config.hcl: |
          vault {
            address = "http://vault.vault.svc.cluster.local:8200"
          }
          injector {
            log_level = "info"
          }
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: vault-agent-injector-role
      rules:
        - apiGroups: ["admissionregistration.k8s.io"]
          resources: ["mutatingwebhookconfigurations"]
          verbs: ["get", "list", "watch", "patch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: vault-agent-injector-binding
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: vault-agent-injector-role
      subjects:
        - kind: ServiceAccount
          name: vault-agent-injector
          namespace: vault
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: vault-agent-injector
        namespace: vault
        labels:
          app: vault-agent-injector
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: vault-agent-injector
        template:
          metadata:
            labels:
              app: vault-agent-injector
          spec:
            serviceAccountName: vault-agent-injector
            containers:
              - name: injector
                image: hashicorp/vault-k8s:1.3.0
                args:
                  - "agent-inject"
                  - "-log-level=info"
                  - "-vault-address=http://vault.vault.svc.cluster.local:8200"
                  - "-tls-cert-file=/tls/tls.crt"
                  - "-tls-key-file=/tls/tls.key"
                volumeMounts:
                  - name: config
                    mountPath: /etc/vault/config
                    readOnly: true
                  - name: tls
                    mountPath: /tls
                    readOnly: true
            volumes:
              - name: config
                configMap:
                  name: vault-agent-injector-config
              - name: tls
                secret:
                  secretName: vault-agent-injector-tls
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: vault-agent-injector
        namespace: vault
      spec:
        selector:
          app: vault-agent-injector
        ports:
          - name: https
            port: 443
            targetPort: 8080
      ---
      apiVersion: admissionregistration.k8s.io/v1
      kind: MutatingWebhookConfiguration
      metadata:
        name: vault-agent-injector-cfg
        labels:
          app: vault-agent-injector
        annotations:
          cert-manager.io/inject-ca-from: vault/vault-agent-injector-tls
      webhooks:
        - name: vault.hashicorp.com
          sideEffects: None
          admissionReviewVersions: ["v1"]
          clientConfig:
            service:
              name: vault-agent-injector
              namespace: vault
              path: "/mutate"
              port: 443
            caBundle: null  # Automatically populated
          rules:
            - operations: ["CREATE"]
              apiGroups: [""]
              apiVersions: ["v1"]
              resources: ["pods"]
          failurePolicy: Ignore
          namespaceSelector: {}
      EOF

      echo "🏗️ Installing Stakater..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add stakater https://stakater.github.io/stakater-charts --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo helm repo update

      sudo helm --kubeconfig=/etc/rancher/rke2/rke2.yaml install reloader stakater/reloader \
        --namespace reloader \
        --create-namespace

      sudo kubectl annotate namespace reloader field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace reloader scheduler.alpha.kubernetes.io/node-selector=dedicated=srvr-node --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: argocd
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/node-selector: "dedicated=srvr-node"
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: argocd-github-oauth
        namespace: argocd
      type: Opaque
      stringData:
        dex.github.clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: argocd
        namespace: argocd
      spec:
        chart: argo-cd
        repo: https://argoproj.github.io/argo-helm
        version: 9.1.4      # matches Argo CD v3.2.0
        targetNamespace: argocd
        valuesContent: |-
          global:
            image:
              repository: quay.io/argoproj/argocd
              tag: v3.2.0          # applies to controller/server/appset/dex/redis-ha

          server:
            service:
              type: ClusterIP
              ports:
                - name: http
                  port: 80
                  targetPort: 8080
            extraArgs:
              - --insecure
            ingress:
              enabled: false

          repoServer:
            image:
              repository: ghcr.io/dotcomrow/argocd-repo-server-avp
              tag: 32a8c86c334577dd7f296684d9c1aedbef023c4a

            automountServiceAccountToken: true

            podSecurityContext:
              fsGroup: 999

            # 6) Vault-plugin ENV configuration
            env:
              - name: AVP_AUTH_TYPE
                value: "k8s"
              - name: AVP_K8S_ROLE
                value: "argocd"
              - name: AVP_K8S_MOUNT_PATH
                value: "auth/kubernetes"
              - name: AVP_VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: AVP_KV_VERSION
                value: "2"
              - name: AVP_TYPE
                value: "vault"
              - name: AVP_MOUNT_PATH
                value: "secret"

          configs:
            params:
              server.insecure: true
            cm:
              admin.enabled: false
              url: https://argocd.teleport.app.${RANCHER_DOMAIN}
              dex.config: |
                connectors:
                  - type: github
                    id: github
                    name: GitHub
                    config:
                      clientID: ${ARGOCD_GITHUB_CLIENT_ID}
                      clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
                      orgs:
                        - name: ${GITHUB_ORG}
              application.namespaces: |
                - argocd
              application.namespaceResourceBlacklist: |
                - group: ""
                  kind: Namespace
              configManagementPlugins: |-
                - name: avp-v1
                  allowConcurrency: true
                  discover:
                    fileName: "*.yaml"
                  generate:
                    command:
                      - /usr/local/bin/argocd-vault-plugin
                    args:
                      - generate
                      - .
                  provideGitCreds: true
                  preserveFileMode: false
              resource.customizations.health.argoproj.io_Application: |
                hs = {}
                if obj.status ~= nil and obj.status.health ~= nil then
                  hs.status = obj.status.health.status
                  hs.message = obj.status.health.message
                else
                  hs.status = "Progressing"
                  hs.message = "Waiting for Application to be healthy"
                end
                return hs

            rbac:
              policy.csv: |
                p, role:admin, applications, *, *, allow
                p, role:admin, clusters, get, *, allow
                p, role:admin, repositories, *, *, allow
                p, role:admin, logs, get, *, allow
                p, role:admin, exec, create, *, allow
                p, role:admin, projects, *, *, allow
                g, ${GITHUB_ORG}:ARGOCD_ADMINS, role:admin
              policy.default: role:readonly
      EOF

      KUBECONFIG_PATH="/etc/rancher/rke2/rke2.yaml"
      ARGOCD_NAMESPACE="argocd"
      DEPLOYMENT_NAME="argocd-server"
      TIMEOUT_SECONDS=900

      echo "⏳ Waiting for Argo CD deployment '$DEPLOYMENT_NAME' to appear..."

      # Wait for deployment to appear (up to TIMEOUT_SECONDS)
      SECONDS_WAITED=0
      while ! sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n "$ARGOCD_NAMESPACE" get deployment "$DEPLOYMENT_NAME" &>/dev/null; do
        if (( SECONDS_WAITED >= TIMEOUT_SECONDS )); then
          echo "❌ Timeout waiting for deployment '$DEPLOYMENT_NAME' to appear."
          exit 1
        fi
        sleep 90
        (( SECONDS_WAITED += 5 ))
      done

      echo "✅ Deployment '$DEPLOYMENT_NAME' found. Waiting for it to be ready..."

      # Wait for deployment to be available
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" wait \
        --for=condition=available \
        --timeout=300s \
        deployment/"$DEPLOYMENT_NAME" \
        -n "$ARGOCD_NAMESPACE"

      echo "✅ Argo CD is ready."
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n cattle-system rollout status deploy rancher-webhook --timeout=120s
      
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" apply -f - <<EOF
      apiVersion: v1
      kind: Service
      metadata:
        name: argocd-ui-svc
        namespace: argocd
        annotations:
          teleport.dev/name: "argocd"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "argocd.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "ArgoCD Service"
        labels:
          app: argocd
          app.kubernetes.io/name: argocd
          app.kubernetes.io/component: argocd
          teleport.dev/enroll: "true"
      spec:
        selector:
          app.kubernetes.io/instance: argocd
          app.kubernetes.io/name: argocd-server
        ports:
          - name: http
            port: 80
            protocol: TCP
            targetPort: 8080
      EOF

      echo "Adding annotations to services that are installed through helm..."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch svc openobserve-dex-external --type merge \
        -p '{"metadata":{"annotations":{"teleport.dev/name":"openobserve-dex","teleport.dev/protocol":"http","teleport.dev/public-addr":"openobserve-dex.teleport.app.suncoast.systems","teleport.dev/description":"OpenObserve Dex Service"},"labels":{"app":"openobserve-dex","app.kubernetes.io/name":"openobserve-dex","app.kubernetes.io/component":"openobserve-dex","teleport.dev/enroll":"true"}}}' \
        -n openobserve

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch svc policy-reporter-ui --type merge \
        -p '{"metadata":{"annotations":{"teleport.dev/name":"policy-reporter-ui","teleport.dev/protocol":"http","teleport.dev/public-addr":"policy-reporter-ui.teleport.app.suncoast.systems","teleport.dev/description":"Policy Reporter UI Service"},"labels":{"app":"policy-reporter-ui","app.kubernetes.io/name":"policy-reporter-ui","app.kubernetes.io/component":"policy-reporter-ui","teleport.dev/enroll":"true"}}}' \
        -n policy-reporter

      echo "Cleaning up uneeded resources..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace applications
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace infrastructure

  - path: /etc/systemd/system/post-install.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post Install Tasks
      After=gpu.service
      Requires=gpu.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/80-post-install.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/fix-dns-nfs.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Fix systemd-resolved DNS config for NFS
      After=network-online.target systemd-resolved.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/bash -c "systemctl restart systemd-resolved; rm -f /etc/resolv.conf; ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reexec
  - systemctl daemon-reload
  - systemctl enable initial-setup.service
  - systemctl start initial-setup.service
  - [ systemctl, unmask, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, enable, --now, apt-daily.timer, apt-daily-upgrade.timer ]
