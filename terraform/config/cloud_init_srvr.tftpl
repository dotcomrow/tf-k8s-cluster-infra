          teleport.dev/protocol: "http"
          teleport.dev/public_addr: "goldilocks-gui.app.suncoast.systems"
          teleport.dev/labels: "environment=production,service=goldilocks"
          teleport.dev/description: "Goldilocks dashboard for Kubernetes resource recommendations"
        labels:
          app.kubernetes.io/name: goldilocks
          helm.sh/chart: goldilocks-10.2.0
          app.kubernetes.io/instance: goldilocks
          app.kubernetes.io/managed-by: Helm
          app.kubernetes.io/component: dashboard
          teleport.dev/enroll: "true"
          teleport.dev/app: "goldilocks-gui"
      spec:
        type: ClusterIP
        ports:
          - port: 80
            targetPort: http
            protocol: TCP
            name: http
        selector:
          app.kubernetes.io/name: goldilocks
          app.kubernetes.io/instance: goldilocks
          app.kubernetes.io/component: dashboard
      ---
      # Source: goldilocks/templates/controller-deployment.yaml
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: goldilocks-controller
        namespace: goldilocks
        labels:
          app.kubernetes.io/name: goldilocks
          helm.sh/chart: goldilocks-10.2.0
          app.kubernetes.io/instance: goldilocks
          app.kubernetes.io/managed-by: Helm
          app.kubernetes.io/component: controller
      spec:
        replicas: 0
        revisionHistoryLimit: 10
        selector:
          matchLabels:
            app.kubernetes.io/name: goldilocks
            app.kubernetes.io/instance: goldilocks
            app.kubernetes.io/component: controller
        template:
          metadata:
            labels:
              app.kubernetes.io/name: goldilocks
              app.kubernetes.io/instance: goldilocks
              app.kubernetes.io/component: controller
          spec:
            serviceAccountName: goldilocks-controller
            securityContext:
              seccompProfile:
                type: RuntimeDefault
            containers:
              - name: goldilocks
                image: "us-docker.pkg.dev/fairwinds-ops/oss/goldilocks:v4.14.1"
                imagePullPolicy: Always
                command:
                  - /goldilocks
                  - controller
                  - -v2
                securityContext:
                  allowPrivilegeEscalation: false
                  capabilities:
                    drop:
                    - ALL
                  readOnlyRootFilesystem: true
                  runAsNonRoot: true
                  runAsUser: 10324
      ---
      # Source: goldilocks/templates/dashboard-deployment.yaml
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: goldilocks-dashboard
        namespace: goldilocks
        labels:
          app.kubernetes.io/name: goldilocks
          helm.sh/chart: goldilocks-10.2.0
          app.kubernetes.io/instance: goldilocks
          app.kubernetes.io/managed-by: Helm
          app.kubernetes.io/component: dashboard
      spec:
        replicas: 2
        revisionHistoryLimit: 10
        selector:
          matchLabels:
            app.kubernetes.io/name: goldilocks
            app.kubernetes.io/instance: goldilocks
            app.kubernetes.io/component: dashboard
        template:
          metadata:
            labels:
              app.kubernetes.io/name: goldilocks
              app.kubernetes.io/instance: goldilocks
              app.kubernetes.io/component: dashboard
          spec:
            serviceAccountName: goldilocks-dashboard
            securityContext:
              seccompProfile:
                type: RuntimeDefault
            containers:
              - name: goldilocks
                image: "us-docker.pkg.dev/fairwinds-ops/oss/goldilocks:v4.14.1"
                imagePullPolicy: Always
                command:
                  - /goldilocks
                  - dashboard
                  - --exclude-containers=linkerd-proxy,istio-proxy
                  - -v2
                securityContext:
                  allowPrivilegeEscalation: false
                  capabilities:
                    drop:
                    - ALL
                  readOnlyRootFilesystem: true
                  runAsNonRoot: true
                  runAsUser: 10324
                ports:
                  - name: http
                    containerPort: 8080
                    protocol: TCP
                livenessProbe:
                  httpGet:
                    path: /health
                    port: http
                readinessProbe:
                  httpGet:
                    path: /health
                    port: http
      
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kyverno-manage-rancher-projects
        annotations:
          argocd.argoproj.io/sync-wave: "-2"
      rules:
        - apiGroups:
            - management.cattle.io
          resources:
            - projects
          verbs:
            - get
            - list
            - watch
            - update
            - patch
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: kyverno-manage-rancher-projects
        annotations:
          argocd.argoproj.io/sync-wave: "-2"
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: kyverno-manage-rancher-projects
      subjects:
        - kind: ServiceAccount
          name: kyverno-admission-controller
          namespace: kyverno
        - kind: ServiceAccount
          name: kyverno-background-controller
          namespace: kyverno
        - kind: ServiceAccount
          name: kyverno-reports-controller
          namespace: kyverno
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: system-namespace-vpa-exclude
      spec:
        background: true
        mutateExistingOnPolicyUpdate: true
        rules:
          - name: label-system-namespaces
            match:
              resources:
                kinds:
                  - Namespace
            preconditions:
              all:
                - key: "{{ request.object.metadata.labels.\"field.cattle.io/projectId\" || request.object.metadata.annotations.\"field.cattle.io/projectId\" || '' }}"
                  operator: NotIn
                  value:
                    - infrastructure
                    - applications
                    - local:infrastructure
                    - local:applications
            mutate:
              targets:
                - apiVersion: v1
                  kind: Namespace
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/system: "true"
                    platform.suncoast.systems/vpa-exclude: "true"
                  annotations:
                    platform.suncoast.systems/vpa-exclude: "true"
                    scheduler.alpha.kubernetes.io/affinity: |
                      {"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"system","operator":"In","values":["true"]}]}}]}}
            skipBackgroundRequests: false
          - name: clear-system-labels-in-app-projects
            match:
              resources:
                kinds:
                  - Namespace
            preconditions:
              all:
                - key: "{{ request.object.metadata.labels.\"field.cattle.io/projectId\" || request.object.metadata.annotations.\"field.cattle.io/projectId\" || '' }}"
                  operator: In
                  value:
                    - infrastructure
                    - applications
                    - local:infrastructure
                    - local:applications
            mutate:
              targets:
                - apiVersion: v1
                  kind: Namespace
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/system: null
                    platform.suncoast.systems/vpa-exclude: null
                  annotations:
                    platform.suncoast.systems/vpa-exclude: null
                    scheduler.alpha.kubernetes.io/affinity: null
            skipBackgroundRequests: false
          - name: annotate-system-projects
            match:
              any:
                - resources:
                    kinds:
                      - management.cattle.io/v3/Project
            preconditions:
              all:
                - key: "{{ request.object.metadata.name }}"
                  operator: NotIn
                  value:
                    - applications
                    - infrastructure
            mutate:
              targets:
                - apiVersion: management.cattle.io/v3
                  kind: Project
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  annotations:
                    platform.suncoast.systems/vpa-exclude: "true"
            skipBackgroundRequests: false
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: system-namespace-priority
      spec:
        background: true
        rules:
          - name: default-system-priority
            match:
              any:
                - resources:
                    kinds:
                      - Pod
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/system: "true"
            preconditions:
              all:
                - key: "{{ request.namespace || '' }}"
                  operator: NotEquals
                  value: openobserve
            mutate:
              patchStrategicMerge:
                spec:
                  +(priorityClassName): platform-system-high
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: add-goldilocks-label-by-project
      spec:
        background: true
        mutateExistingOnPolicyUpdate: true
        rules:
          - name: label-goldilocks-namespaces
            match:
              resources:
                kinds:
                  - Namespace
            preconditions:
              all:
                - key: "{{ request.object.metadata.labels.\"field.cattle.io/projectId\" || request.object.metadata.annotations.\"field.cattle.io/projectId\" || '' }}"
                  operator: In
                  value:
                    - infrastructure
                    - applications
                    - local:infrastructure
                    - local:applications
                - key: "{{ request.object.metadata.name }}"
                  operator: NotIn
                  value:
                    - argocd
                    - kyverno
                    - nvidia
                - key: "{{ request.object.metadata.labels.\"platform.suncoast.systems/goldilocks\" || '' }}"
                  operator: NotEquals
                  value: "disabled"
                - key: "{{ request.object.metadata.labels.\"platform.suncoast.systems/vpa-exclude\" || '' }}"
                  operator: NotEquals
                  value: "true"
            mutate:
              targets:
                - apiVersion: v1
                  kind: Namespace
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/autosize: "enabled"
                    goldilocks.fairwinds.com/enabled: "true"
            skipBackgroundRequests: false
          - name: remove-autosize-label-outside-projects
            match:
              resources:
                kinds:
                  - Namespace
                selector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            preconditions:
              any:
                - key: "{{ request.object.metadata.name }}"
                  operator: In
                  value:
                    - argocd
                    - kyverno
                    - nvidia
                - key: "{{ request.object.metadata.labels.\"platform.suncoast.systems/vpa-exclude\" || '' }}"
                  operator: Equals
                  value: "true"
                - key: "{{ request.object.metadata.labels.\"platform.suncoast.systems/goldilocks\" || '' }}"
                  operator: Equals
                  value: "disabled"
                - key: "{{ request.object.metadata.labels.\"field.cattle.io/projectId\" || request.object.metadata.annotations.\"field.cattle.io/projectId\" || '' }}"
                  operator: NotIn
                  value:
                    - infrastructure
                    - applications
                    - local:infrastructure
                    - local:applications
            exclude:
              any:
                - resources:
                    names:
                      - ingress-nginx
            mutate:
              targets:
                - apiVersion: v1
                  kind: Namespace
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/autosize: null
                    goldilocks.fairwinds.com/enabled: null
            skipBackgroundRequests: false
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: app-infra-namespace-prefer-work-nodes
      spec:
        background: true
        mutateExistingOnPolicyUpdate: true
        rules:
          - name: prefer-work-nodes-for-app-infra
            match:
              resources:
                kinds:
                  - Namespace
            preconditions:
              all:
                - key: "{{ request.object.metadata.labels.\"field.cattle.io/projectId\" || request.object.metadata.annotations.\"field.cattle.io/projectId\" || '' }}"
                  operator: In
                  value:
                    - infrastructure
                    - applications
                    - local:infrastructure
                    - local:applications
            mutate:
              targets:
                - apiVersion: v1
                  kind: Namespace
                  name: "{{request.object.metadata.name}}"
              patchStrategicMerge:
                metadata:
                  annotations:
                    scheduler.alpha.kubernetes.io/affinity: |
                      {"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"work-node","operator":"In","values":["true"]}]}}]}}
            skipBackgroundRequests: false
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: critical-workloads-vpa-exclude
      spec:
        background: true
        mutateExistingOnPolicyUpdate: true
        rules:
          - name: exclude-yugabyte
            match:
              resources:
                kinds:
                  - StatefulSet
                namespaces:
                  - yugabyte
                names:
                  - yb-master
                  - yb-tserver
            mutate:
              targets:
                - apiVersion: "{{request.object.apiVersion}}"
                  kind: "{{request.object.kind}}"
                  name: "{{request.object.metadata.name}}"
                  namespace: "{{request.object.metadata.namespace}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/vpa-exclude: "true"
          - name: exclude-teleport
            match:
              resources:
                kinds:
                  - StatefulSet
                namespaces:
                  - teleport
                names:
                  - etcd
                  - teleport
            mutate:
              targets:
                - apiVersion: "{{request.object.apiVersion}}"
                  kind: "{{request.object.kind}}"
                  name: "{{request.object.metadata.name}}"
                  namespace: "{{request.object.metadata.namespace}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/vpa-exclude: "true"
          - name: exclude-redis
            match:
              resources:
                kinds:
                  - StatefulSet
                namespaces:
                  - redis
                names:
                  - redis
            mutate:
              targets:
                - apiVersion: "{{request.object.apiVersion}}"
                  kind: "{{request.object.kind}}"
                  name: "{{request.object.metadata.name}}"
                  namespace: "{{request.object.metadata.namespace}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/vpa-exclude: "true"
          - name: exclude-kafka
            match:
              resources:
                kinds:
                  - StatefulSet
                  - Deployment
                namespaces:
                  - kafka
                names:
                  - kafka
                  - schema-registry
                  - kafka-connect
                  - kafka-ui
                  - oauth2-proxy
                  - bootstrap-watcher
            mutate:
              targets:
                - apiVersion: "{{request.object.apiVersion}}"
                  kind: "{{request.object.kind}}"
                  name: "{{request.object.metadata.name}}"
                  namespace: "{{request.object.metadata.namespace}}"
              patchStrategicMerge:
                metadata:
                  labels:
                    platform.suncoast.systems/vpa-exclude: "true"
      
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kyverno-generate-vpa
        annotations:
          argocd.argoproj.io/sync-wave: "-2"
      rules:
        - apiGroups:
            - autoscaling.k8s.io
          resources:
            - verticalpodautoscalers
            - verticalpodautoscalercheckpoints
          verbs:
            - get
            - list
            - watch
            - create
            - update
            - patch
            - delete
        - apiGroups:
            - policy
          resources:
            - poddisruptionbudgets
          verbs:
            - get
            - list
            - watch
            - create
            - update
            - patch
            - delete
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: kyverno-generate-vpa
        annotations:
          argocd.argoproj.io/sync-wave: "-2"
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: kyverno-generate-vpa
      subjects:
        - kind: ServiceAccount
          name: kyverno-admission-controller
          namespace: kyverno
        - kind: ServiceAccount
          name: kyverno-background-controller
          namespace: kyverno
        - kind: ServiceAccount
          name: kyverno-reports-controller
          namespace: kyverno
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: generate-limitrange-defaults
        annotations:
          argocd.argoproj.io/sync-options: Replace=true,Force=true
      spec:
        rules:
          - name: generate-default-limitrange
            match:
              resources:
                kinds:
                  - Namespace
                selector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              resources:
                selector:
                  matchLabels:
                    platform.suncoast.systems/limitrange: "disabled"
            generate:
              apiVersion: v1
              kind: LimitRange
              name: default-resource-limits
              namespace: "{{request.object.metadata.name}}"
              generateExisting: true
              synchronize: true
              data:
                metadata:
                  labels:
                    app.kubernetes.io/managed-by: kyverno
                spec:
                  limits:
                    - type: Container
                      defaultRequest:
                        cpu: "200m"
                        memory: "256Mi"
                      default:
                        cpu: "1"
                        memory: "3Gi"
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: generate-pdbs
        annotations:
          argocd.argoproj.io/sync-options: Replace=true,Force=true
      spec:
        rules:
          - name: generate-pdb-for-deployments
            match:
              resources:
                kinds:
                  - Deployment
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/pdb-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/pdb-exclude: "true"
            preconditions:
              all:
                - key: "{{ request.object.spec.replicas || `1` }}"
                  operator: GreaterThanOrEquals
                  value: 2
            generate:
              apiVersion: policy/v1
              kind: PodDisruptionBudget
              name: "{{request.object.metadata.name}}-pdb"
              namespace: "{{request.object.metadata.namespace}}"
              synchronize: true
              generateExisting: true
              data:
                metadata:
                  labels:
                    app.kubernetes.io/managed-by: kyverno
                spec:
                  maxUnavailable: 1
                  selector:
                    matchLabels: "{{request.object.spec.selector.matchLabels}}"
            skipBackgroundRequests: false
          - name: generate-pdb-for-statefulsets
            match:
              resources:
                kinds:
                  - StatefulSet
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/pdb-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/pdb-exclude: "true"
            preconditions:
              all:
                - key: "{{ request.object.spec.replicas || `1` }}"
                  operator: GreaterThanOrEquals
                  value: 2
            generate:
              apiVersion: policy/v1
              kind: PodDisruptionBudget
              name: "{{request.object.metadata.name}}-pdb"
              namespace: "{{request.object.metadata.namespace}}"
              synchronize: true
              generateExisting: true
              data:
                metadata:
                  labels:
                    app.kubernetes.io/managed-by: kyverno
                spec:
                  minAvailable: 1
                  selector:
                    matchLabels: "{{request.object.spec.selector.matchLabels}}"
            skipBackgroundRequests: false
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: generate-vpa-autosize
        annotations:
          argocd.argoproj.io/sync-options: Replace=true,Force=true
      spec:
        rules:
          - name: generate-vpa-for-deployments
            match:
              resources:
                kinds:
                  - Deployment
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: kyverno
            generate:
              apiVersion: autoscaling.k8s.io/v1
              kind: VerticalPodAutoscaler
              name: "goldilocks-{{request.object.metadata.name}}"
              namespace: "{{request.object.metadata.namespace}}"
              synchronize: true
              generateExisting: true
              data:
                metadata:
                  labels:
                    app.kubernetes.io/managed-by: kyverno
                spec:
                  targetRef:
                    apiVersion: apps/v1
                    kind: Deployment
                    name: "{{request.object.metadata.name}}"
                  updatePolicy:
                    updateMode: "InPlaceOrRecreate"
                  resourcePolicy:
                    containerPolicies:
                      - containerName: "*"
                        controlledValues: "RequestsAndLimits"
                        minAllowed:
                          cpu: "200m"
                          memory: "256Mi"
                        maxAllowed:
                          cpu: "1"
                          memory: "3Gi"
            skipBackgroundRequests: false
          - name: generate-vpa-for-statefulsets
            match:
              resources:
                kinds:
                  - StatefulSet
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: kyverno
            generate:
              apiVersion: autoscaling.k8s.io/v1
              kind: VerticalPodAutoscaler
              name: "goldilocks-{{request.object.metadata.name}}"
              namespace: "{{request.object.metadata.namespace}}"
              synchronize: true
              generateExisting: true
              data:
                metadata:
                  labels:
                    app.kubernetes.io/managed-by: kyverno
                spec:
                  targetRef:
                    apiVersion: apps/v1
                    kind: StatefulSet
                    name: "{{request.object.metadata.name}}"
                  updatePolicy:
                    updateMode: "InPlaceOrRecreate"
                  resourcePolicy:
                    containerPolicies:
                      - containerName: "*"
                        controlledValues: "RequestsAndLimits"
                        minAllowed:
                          cpu: "200m"
                          memory: "256Mi"
                        maxAllowed:
                          cpu: "1"
                          memory: "3Gi"
            skipBackgroundRequests: false
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: autosize-require-vpa
        annotations:
          policies.kyverno.io/title: Autosize workloads must have VPA
          policies.kyverno.io/category: Autosize
          policies.kyverno.io/severity: medium
          policies.kyverno.io/subject: Deployment,StatefulSet
      spec:
        validationFailureAction: Audit
        background: true
        rules:
          - name: vpa-required
            match:
              resources:
                kinds:
                  - Deployment
                  - StatefulSet
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: kyverno
            context:
              - name: vpaCount
                apiCall:
                  urlPath: "/apis/autoscaling.k8s.io/v1/namespaces/{{request.object.metadata.namespace}}/verticalpodautoscalers"
                  jmesPath: "items[?metadata.name=='goldilocks-{{request.object.metadata.name}}'] | length(@)"
            validate:
              message: "VPA goldilocks-{{request.object.metadata.name}} must exist in autosize namespaces."
              deny:
                conditions:
                  any:
                    - key: "{{ vpaCount }}"
                      operator: Equals
                      value: 0
      
      ---
      apiVersion: kyverno.io/v1
      kind: ClusterPolicy
      metadata:
        name: autosize-no-explicit-resources
        annotations:
          policies.kyverno.io/title: Autosize workloads should not set explicit resources
          policies.kyverno.io/category: Autosize
          policies.kyverno.io/severity: medium
          policies.kyverno.io/subject: Deployment,StatefulSet
      spec:
        validationFailureAction: Audit
        background: true
        rules:
          - name: no-explicit-resources
            match:
              resources:
                kinds:
                  - Deployment
                  - StatefulSet
                namespaceSelector:
                  matchLabels:
                    platform.suncoast.systems/autosize: "enabled"
            exclude:
              any:
                - resources:
                    selector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        platform.suncoast.systems/vpa-exclude: "true"
                - resources:
                    namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: kyverno
            validate:
              message: "Explicit requests/limits should be removed; VPA will manage resources."
              deny:
                conditions:
                  any:
                    - key: "{{ request.object.spec.template.spec.containers[?resources.requests || resources.limits] | length(@) }}"
                      operator: GreaterThan
                      value: 0
      
      EOF

      echo "⏳ Waiting for VPA webhook cert to be ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system wait --for=condition=Ready --timeout=600s certificate/vpa-webhook-tls || true

      echo "⏳ Waiting for VPA deployments..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system rollout status deploy/vpa-recommender --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system rollout status deploy/vpa-updater --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system rollout status deploy/vpa-admission-controller --timeout=600s

      echo "⏳ Waiting for Goldilocks dashboard..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n goldilocks rollout status deploy/goldilocks-dashboard --timeout=600s

      ) || { echo "❌ Resource management bootstrap failed"; exit 1; }

      sudo kubectl annotate namespace metallb-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace longhorn-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system patch nodedriver linode \
        --type=merge \
        -p '{"spec":{"active":false}}'

      # 4. Add Linode node driver
      echo "⚙️ Installing Linode node driver..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f - <<EOF
      apiVersion: management.cattle.io/v3
      kind: NodeDriver
      metadata:
        name: linode
        namespace: cattle-system
      spec:
        active: true
        builtin: false
        url: "${LINODE_DRIVER_URL}"
        checksum: ""
        displayName: "Linode"
        uiUrl: "https://unpkg.com/rancher-ui-driver-none@0.2.0/component.js"
      EOF

      echo "✔️ Node driver added"

      echo "⏳ Waiting for Rancher to register 'linodecredentialConfig' schema..."
      get_rancher_token() {
        local password token
        # Prefer talking directly to the rancher service ClusterIP to avoid ingress timing issues
        local svc_ip login_url http_status
        for i in {1..30}; do
          # Wait for bootstrap secret to exist and read its password
          if ! password=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get secret bootstrap-secret \
            -o jsonpath='{.data.bootstrapPassword}' 2>/dev/null | base64 -d | tr -d '\n'); then
            echo "🔄 Waiting for bootstrap-secret to be available ($i/30)..."
            sleep 10
            continue
          fi

          svc_ip=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get svc rancher -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)
          if [[ -n "$svc_ip" ]]; then
            login_url="https://$svc_ip/v3-public/localProviders/local?action=login"
          else
            login_url="https://10.0.0.110/v3-public/localProviders/local?action=login"
          fi

          # Try to exchange for a token; ignore jq parse errors and keep retrying
          curl -sk -D /tmp/rancher-login.headers -o /tmp/rancher-login.json "$login_url" \
            -H 'Content-Type: application/json' \
            -H "Host: rancher.cattle-system.svc" \
            -d "{\"username\":\"admin\",\"password\":\"$password\"}" 2>/dev/null || true
          http_status=$(awk 'NR==1 {print $2}' /tmp/rancher-login.headers 2>/dev/null || true)
          token=$(jq -r '.token // empty' /tmp/rancher-login.json 2>/dev/null || true)

          if [[ -n "$token" ]]; then
            echo "$token"
            return 0
          fi
          echo "⚠️  Token empty on attempt $i (HTTP $http_status); body: $(head -c 120 /tmp/rancher-login.json 2>/dev/null)"
          sleep 10
        done
        return 1
      }

      TOKEN="$(get_rancher_token)" || { echo "❌ Failed to obtain Rancher token"; exit 1; }

      # Prefer service ClusterIP for schema check to avoid ingress timing issues
      SCHEMA_URL="https://10.0.0.110/v3/schemas"
      svc_ip=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system get svc rancher -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)
      if [[ -n "$svc_ip" ]]; then
        SCHEMA_URL="https://$svc_ip/v3/schemas"
      fi

      until curl -sk \
        -H "Authorization: Bearer $TOKEN" \
        -H "Host: rancher.cattle-system.svc" \
        "$SCHEMA_URL" | grep -q linodecredentialConfig; do
        echo "🔄 Waiting for linodecredentialConfig schema..."
        sleep 60
      done
      echo "✅ 'linodecredentialConfig' schema registered."

      echo "📥 Installing Linode token..."
      API_BASE="https://10.0.0.110"
      if [[ -n "$svc_ip" ]]; then
        API_BASE="https://$svc_ip"
      fi

      curl -sk -X POST "$API_BASE/v3/cloudcredentials" \
        -H "Authorization: Bearer $TOKEN" \
        -H 'Content-Type: application/json' \
        -H "Host: rancher.cattle-system.svc" \
        -d "{
          \"name\": \"suncoast-systems-dotcomrow-credential\",
          \"type\": \"cloudCredential\",
          \"linodecredentialConfig\": {
            \"token\": \"${LINODE_TOKEN}\"
          }
        }"

      echo "✔️ Cloud credential created"

      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      K="sudo kubectl --kubeconfig=$KUBECONFIG"

      echo "🔍 Locating ClusterRoleTemplateBinding for local:// user..."

      BINDING_NAME=$($K get clusterroletemplatebindings.management.cattle.io -n local -o json \
        | jq -r '.items[] 
          | select(.userPrincipalName? // "" | startswith("local://")) 
          | select(.roleTemplateName == "cluster-owner") 
          | .metadata.name')

      if [[ -n "$BINDING_NAME" ]]; then
        echo "⚠️  Found local admin binding: $BINDING_NAME — Deleting it..."
        $K delete clusterroletemplatebindings.management.cattle.io "$BINDING_NAME" -n local
      else
        echo "✅ No local:// cluster-owner binding found — nothing to remove."
      fi

      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get users.management.cattle.io -o jsonpath='{range .items[?(@.username=="admin")]}{.metadata.name}{"\n"}{end}' | \
      xargs -I {} sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        delete users.management.cattle.io {}

      bash -c "sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch settings.management.cattle.io first-login --type='merge' -p '{\"value\": \"admin\"}'"
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml rollout restart deployment rancher -n cattle-system

      export HOME=/home/ubuntu

      LINKERD_VERSION="edge-25.8.1"  # "stable-2.18.0", "edge-25.7.5", "version-2.18", etc.
      MAX_RETRIES=5
      SLEEP_BETWEEN_RETRIES=5
      LINKERD_CLI_PATH="$HOME/.linkerd2/bin/linkerd"

      echo "🔄 Installing Linkerd CLI ($LINKERD_VERSION)..."

      for attempt in $(seq 1 "$MAX_RETRIES"); do
        echo "🔁 Attempt $attempt to download Linkerd CLI..."
        if curl -sL https://run.linkerd.io/install | sh -s -- --version "$LINKERD_VERSION"; then
          echo "✅ Linkerd CLI download succeeded"
          break
        else
          echo "⚠️  Download failed (attempt $attempt)"
          if [ "$attempt" -eq "$MAX_RETRIES" ]; then
            echo "❌ Linkerd CLI download failed after $MAX_RETRIES attempts"
            exit 1
          fi
          sleep "$SLEEP_BETWEEN_RETRIES"
        fi
      done

      if [ -f "$LINKERD_CLI_PATH" ]; then
        echo "📦 Found Linkerd CLI at $LINKERD_CLI_PATH"
        sudo cp "$LINKERD_CLI_PATH" /usr/local/bin/
        echo "✅ Linkerd CLI installed to /usr/local/bin"
      else
        echo "❌ Linkerd CLI binary not found at $LINKERD_CLI_PATH"
        exit 1
      fi

      # Optional: Verify
      if ! command -v linkerd >/dev/null; then
        echo "❌ Linkerd CLI not found in PATH after installation"
        exit 1
      fi

      echo "🎉 Linkerd CLI is ready:"
      linkerd version

      # Wait for the deployment to appear
      until sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get deployment rancher-webhook -n cattle-system >/dev/null 2>&1; do
        echo "⏳ Waiting for rancher-webhook deployment to appear..."
        sleep 5
      done

      echo "⏳ Waiting for Rancher webhook pod to become ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Available deployment/rancher-webhook -n cattle-system --timeout=120s
      echo "✅ Rancher webhook is ready."

      echo "🔧 Tuning Rancher webhooks and excluding Rancher from VPA..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        label deployment/rancher platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        annotate deployment/rancher platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        patch deployment rancher --type=merge -p '{"spec":{"template":{"metadata":{"labels":{"platform.suncoast.systems/vpa-exclude":"true"},"annotations":{"platform.suncoast.systems/vpa-exclude":"true"}}}}}'

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        label deployment/rancher-webhook platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        annotate deployment/rancher-webhook platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system \
        patch deployment rancher-webhook --type=strategic -p '{"spec":{"replicas":2,"template":{"metadata":{"labels":{"platform.suncoast.systems/vpa-exclude":"true"},"annotations":{"platform.suncoast.systems/vpa-exclude":"true"}},"spec":{"containers":[{"name":"rancher-webhook","resources":{"requests":{"cpu":"100m","memory":"256Mi"},"limits":{"cpu":"500m","memory":"512Mi"}},"livenessProbe":{"timeoutSeconds":5,"periodSeconds":10,"failureThreshold":6},"startupProbe":{"timeoutSeconds":5,"periodSeconds":10,"failureThreshold":60}}]}}}}'
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system rollout status deploy/rancher-webhook --timeout=180s

      # Confirm version matches
      sudo linkerd version --kubeconfig=/etc/rancher/rke2/rke2.yaml

      for ns in linkerd linkerd-viz linkerd-jaeger; do
        sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace "$ns" --dry-run=client -o yaml | \
          sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -
      done

      sudo kubectl annotate namespace linkerd field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace linkerd scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-viz scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace linkerd-jaeger scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate ns linkerd linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-viz linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate ns linkerd-jaeger linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      echo "📥 Installing Gateway API CRDs..."
      # sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/standard-install.yaml
            
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/experimental-install.yaml

      # 2) Install the CRDs
      sudo linkerd install --crds \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      sudo linkerd install \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
        --set clusterNetworks="10.42.0.0/16\,10.43.0.0/16" \
        --set proxyInit.ignoreOutboundPorts="4567\,4568\,4317\,4318\,2379\,8200" \
        --set proxyInit.ignoreInboundPorts="4567\,4568\,4317\,4318\,2379\,8200" \
        --set-string global.tracing.enabled=true \
        --set proxy.tracing.enabled=true \
        --set-string proxy.tracing.otlp.endpoint="otel-collector.observability.svc.cluster.local:4317" \
        --set-string proxy.tracing.collector.endpoint="otel-collector.observability.svc.cluster.local:4317" \
        --set-string proxy.tracing.collector.meshIdentity.serviceAccountName="linkerd-jaeger" \
        --set-string proxy.tracing.collector.meshIdentity.namespace="linkerd-jaeger" \
        --set-string proxy.telemetry.spans.enabled=true \
        --set proxy.tracing.otlp.insecure=true \
        --set-string proxy.telemetry.spans.level=trace \
        | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 4) Wait for Linkerd control-plane deployments, then run readiness checks.
      for deploy in linkerd-identity linkerd-destination linkerd-proxy-injector; do
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n linkerd rollout status deploy/"$deploy" --timeout=900s
      done
      sudo linkerd check --kubeconfig /etc/rancher/rke2/rke2.yaml --wait 15m

      # Installing NFS system
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: nfs-system
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/affinity: '{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"work-node","operator":"In","values":["true"]}]}}]}}'
      ---
      # PVC for backing NFS server
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: nfs-storage
        namespace: nfs-system
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: ${NFS_DRIVE_STORAGE}
      ---
      # NFS Server Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-server
        template:
          metadata:
            labels:
              app: nfs-server
          spec:
            containers:
              - name: nfs-server
                image: erichough/nfs-server:latest
                securityContext:
                  privileged: true
                resources:
                  requests:
                    cpu: "100m"
                    memory: "512Mi"
                  limits:
                    cpu: "500m"
                    memory: "512Mi"
                env:
                  - name: NFS_EXPORT_0
                    value: "/export *(rw,sync,no_subtree_check,no_root_squash)"
                  - name: MOUNTD_PORT
                    value: "20048"
                  - name: STATD_PORT
                    value: "32765"
                  - name: STATD_OUTGOING_PORT
                    value: "32766"
                ports:
                  - name: nfs
                    containerPort: 2049
                    protocol: TCP
                  - name: mountd
                    containerPort: 20048
                    protocol: TCP
                  - name: rpcbind
                    containerPort: 111
                    protocol: TCP
                  - name: statd
                    containerPort: 32765
                    protocol: TCP
                  - name: statd-listen
                    containerPort: 32766
                    protocol: TCP
                volumeMounts:
                  - mountPath: /export
                    name: nfs-volume
            volumes:
              - name: nfs-volume
                persistentVolumeClaim:
                  claimName: nfs-storage
      ---
      # Headless Service for the NFS Server (for DNS)
      apiVersion: v1
      kind: Service
      metadata:
        name: nfs-server
        namespace: nfs-system
      spec:
        clusterIP: None
        selector:
          app: nfs-server
        ports:
          - name: nfs
            port: 2049
            targetPort: 2049
            protocol: TCP
          - name: mountd
            port: 20048
            targetPort: 20048
            protocol: TCP
          - name: rpcbind
            port: 111
            targetPort: 111
            protocol: TCP
          - name: rpcbind-udp
            port: 111
            targetPort: 111
            protocol: UDP
          - name: statd
            port: 32765
            targetPort: 32765
            protocol: TCP
          - name: statd-udp
            port: 32765
            targetPort: 32765
            protocol: UDP
          - name: statd-listen
            port: 32766
            targetPort: 32766
            protocol: TCP
          - name: statd-listen-udp
            port: 32766
            targetPort: 32766
            protocol: UDP
      ---
      # NFS Provisioner RBAC
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: nfs-client-provisioner-runner
      rules:
        - apiGroups: [""]
          resources: ["persistentvolumes"]
          verbs: ["get", "list", "watch", "create", "delete"]
        - apiGroups: [""]
          resources: ["persistentvolumeclaims"]
          verbs: ["get", "list", "watch", "update"]
        - apiGroups: [""]
          resources: ["endpoints"]  # 👈 ADD THIS
          verbs: ["get", "list", "watch", "create", "update"]
        - apiGroups: ["storage.k8s.io"]
          resources: ["storageclasses"]
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["events"]
          verbs: ["create", "update", "patch"]
      ---
      kind: ClusterRoleBinding
      apiVersion: rbac.authorization.k8s.io/v1
      metadata:
        name: run-nfs-client-provisioner
      subjects:
        - kind: ServiceAccount
          name: nfs-client-provisioner
          namespace: nfs-system
      roleRef:
        kind: ClusterRole
        name: nfs-client-provisioner-runner
        apiGroup: rbac.authorization.k8s.io
      ---
      # NFS Provisioner Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nfs-client-provisioner
        namespace: nfs-system
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: nfs-client-provisioner
        template:
          metadata:
            labels:
              app: nfs-client-provisioner
          spec:
            serviceAccountName: nfs-client-provisioner
            containers:
              - name: nfs-client-provisioner
                image: registry.k8s.io/sig-storage/nfs-subdir-external-provisioner:v4.0.2
                resources:
                  requests:
                    cpu: "100m"
                    memory: "512Mi"
                  limits:
                    cpu: "250m"
                    memory: "512Mi"
                env:
                  - name: PROVISIONER_NAME
                    value: example.com/nfs
                  - name: NFS_SERVER
                    value: nfs-server.nfs-system.svc.cluster.local
                  - name: NFS_PATH
                    value: /export
                volumeMounts:
                  - name: nfs-client-root
                    mountPath: /persistentvolumes
            volumes:
              - name: nfs-client-root
                nfs:
                  server: nfs-server.nfs-system.svc.cluster.local
                  path: /export
      ---
      # StorageClass to use the provisioner
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: nfs-client
      provisioner: example.com/nfs
      parameters:
        archiveOnDelete: "false"
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      ---
      # Vault namespace
      apiVersion: v1
      kind: Namespace
      metadata:
        name: vault
        labels:
          app: "vault"
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/affinity: '{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"work-node","operator":"In","values":["true"]}]}}]}}'
      EOF
      # End NFS install

      # 5) install openobserve
      # Reuse existing credentials when present so reruns are idempotent.
      EXISTING_OO_USER=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-root-creds -o jsonpath='{.data.username}' 2>/dev/null | base64 -d || true)
      EXISTING_OO_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-root-creds -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)
      if [ -n "$EXISTING_OO_USER" ] && [ -n "$EXISTING_OO_PASS" ]; then
        export OPENOBSERVE_USERNAME="$EXISTING_OO_USER"
        export OPENOBSERVE_PASSWORD="$EXISTING_OO_PASS"
      else
        export OPENOBSERVE_USERNAME="user$(openssl rand -hex 4)@suncoast.systems"
        export OPENOBSERVE_PASSWORD="$(openssl rand -base64 24)"
      fi

      EXISTING_OO_PG_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-postgres-app -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)
      if [ -n "$EXISTING_OO_PG_PASS" ]; then
        export OPENOBSERVE_PG_PASSWORD="$EXISTING_OO_PG_PASS"
      else
        export OPENOBSERVE_PG_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"
      fi

      EXISTING_MINIO_USER=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-minio -o jsonpath='{.data.rootUser}' 2>/dev/null | base64 -d || true)
      EXISTING_MINIO_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-minio -o jsonpath='{.data.rootPassword}' 2>/dev/null | base64 -d || true)
      if [ -n "$EXISTING_MINIO_USER" ] && [ -n "$EXISTING_MINIO_PASS" ]; then
        export OPENOBSERVE_MINIO_USER="$EXISTING_MINIO_USER"
        export OPENOBSERVE_MINIO_PASSWORD="$EXISTING_MINIO_PASS"
      else
        export OPENOBSERVE_MINIO_USER="oo$(openssl rand -hex 4)"
        export OPENOBSERVE_MINIO_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"
      fi

      echo "🏗️ Installing OpenObserve..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add openobserve https://charts.openobserve.ai --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo kubectl create namespace openobserve --kubeconfig=/etc/rancher/rke2/rke2.yaml --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl create namespace observability --kubeconfig=/etc/rancher/rke2/rke2.yaml --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl annotate namespace observability field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace observability scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace observability linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace openobserve field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace openobserve scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["work-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace openobserve linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl label namespace openobserve platform.suncoast.systems/system=false --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      echo "⏳ Waiting for openobserve namespace to be outside system-priority policy..."
      ns_system_label=""
      for i in {1..60}; do
        ns_system_label=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get namespace openobserve -o jsonpath='{.metadata.labels.platform\.suncoast\.systems/system}' 2>/dev/null || true)
        if [[ "$ns_system_label" != "true" ]]; then
          echo "✅ openobserve namespace system label is '$${ns_system_label:-<unset>}'"
          break
        fi
        echo "🔄 openobserve namespace still labeled system=true ($i/60); waiting..."
        sleep 2
      done
      if [[ "$ns_system_label" == "true" ]]; then
        echo "❌ openobserve namespace still labeled system=true; aborting OpenObserve bootstrap."
        exit 1
      fi

      echo "📦 Installing CloudNativePG operator (for OpenObserve metadata store)..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply --server-side -f https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.22/releases/cnpg-1.22.1.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cnpg-system rollout status deploy/cnpg-controller-manager --timeout=300s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cnpg-system wait --for=condition=Available deploy/cnpg-controller-manager --timeout=60s

      export OO_GH_CLIENT_ID="${OPENOBSERVE_CLIENT_ID}"
      export OO_GH_CLIENT_SECRET="${OPENOBSERVE_CLIENT_SECRET}"
      export OPENOBSERVE_GITHUB_TOKEN="${OPENOBSERVE_GITHUB_TOKEN}"
      export OO_GH_ORG="${GITHUB_ORG}"
      export OO_GH_ADMIN_TEAM="${OPENOBSERVE_GITHUB_ADMIN_TEAM}"   # e.g., platform-admins
      export OO_GH_USER_TEAM="${OPENOBSERVE_GITHUB_USER_TEAM}"    # e.g., engineers
      # Public URL OpenObserve users hit (used in redirects)
      export OO_PUBLIC_URL="https://openobserve.teleport.app.${RANCHER_DOMAIN}"
      # Dex discovery host (where OpenObserve fetches .well-known; can be internal)
      export OO_DEX_DISCOVERY_HOST="openobserve-dex.openobserve.svc.cluster.local"
      # Dex issuer/authorize host (external — Teleport by default)
      export OO_DEX_ISSUER_HOST="openobserve-dex.teleport.app.${RANCHER_DOMAIN}"
      # Dex callback host for GitHub OAuth (keep Teleport by default)
      export OO_DEX_CALLBACK_HOST="openobserve-dex.teleport.app.${RANCHER_DOMAIN}"
      export OO_DEX_DISCOVERY_BASE="http://$OO_DEX_DISCOVERY_HOST:5556/dex"
      export OO_DEX_DISCOVERY_URL="$OO_DEX_DISCOVERY_BASE/.well-known/openid-configuration"
      export OO_DEX_ISSUER_URL="https://$OO_DEX_ISSUER_HOST"
      export OO_DEX_CALLBACK_URL="https://$OO_DEX_CALLBACK_HOST"
      export OO_OAUTH2_PROXY_CLIENT_ID="oo-auth-proxy"
      export OO_OAUTH2_PROXY_CLIENT_SECRET="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)"
      export OO_OAUTH2_PROXY_COOKIE_SECRET="$(python3 -c 'import secrets,string; alphabet=string.ascii_letters+string.digits; print("".join(secrets.choice(alphabet) for _ in range(32)))')"
      export OO_AUTH_BRIDGE_HMAC_SECRET="$(python3 -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())')"

      sudo helm repo update
      OO_IMAGE_TAG="${OPENOBSERVE_IMAGE_TAG}"
      sudo helm upgrade --install openobserve openobserve/openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --set-string image.oss.repository=public.ecr.aws/zinclabs/openobserve \
        --set-string image.oss.tag="$OO_IMAGE_TAG" \
        --set enterprise.enabled=false \
        --set enterprise.openfga.enabled=false \
        --set minio.enabled=true \
        --set-string minio.rootUser="$OPENOBSERVE_MINIO_USER" \
        --set-string minio.rootPassword="$OPENOBSERVE_MINIO_PASSWORD" \
        --set-string minio.mode=standalone \
        --set minio.replicas=1 \
        --set-string minio.deploymentUpdate.type=Recreate \
        --set-string minio.persistence.storageClass=longhorn \
        --set-string minio.persistence.size=250Gi \
        --set-string minio.buckets[0].name=openobserve \
        --set-string minio.buckets[0].policy=none \
        --set minio.buckets[0].purge=false \
        --set-string auth.ZO_ROOT_USER_EMAIL="$OPENOBSERVE_USERNAME" \
        --set-string auth.ZO_ROOT_USER_PASSWORD="$OPENOBSERVE_PASSWORD" \
        --set-string auth.ZO_META_POSTGRES_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/app?sslmode=disable" \
        --set-string auth.ZO_META_POSTGRES_RO_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/app?sslmode=disable" \
        --set-string auth.ZO_META_DDL_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/app?sslmode=disable" \
        --set-string postgres.spec.password="$OPENOBSERVE_PG_PASSWORD" \
        --set postgres.spec.instances=1 \
        --set-string postgres.spec.storage.size=10Gi \
        --set-string postgres.spec.storage.storageClass=longhorn \
        --set-string config.ZO_COMPACT_DATA_RETENTION_DAYS="14" \
        --set-string config.ZO_IGNORE_FILE_RETENTION_BY_STREAM="true" \
        --set-string config.ZO_S3_BUCKET_NAME=openobserve \
        --set-string config.ZO_META_STORE=postgres \
        --set-string config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string config.ZO_META_TRANSACTION_LOCK_TIMEOUT=1800 \
        --set-string config.ZO_META_TRANSACTION_RETRIES=10 \
        --set-string router.config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string router.config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string ingester.config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string ingester.config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string querier.config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string querier.config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string compactor.config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string compactor.config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string alertmanager.config.ZO_META_CONNECTION_POOL_MIN_SIZE=1 \
        --set-string alertmanager.config.ZO_META_CONNECTION_POOL_MAX_SIZE=5 \
        --set-string config.ZO_PROMETHEUS_ENABLE=true \
        --set probes.router.enabled=true \
        --set probes.router.config.startupProbe.initialDelaySeconds=30 \
        --set probes.router.config.startupProbe.periodSeconds=10 \
        --set probes.router.config.startupProbe.failureThreshold=90 \
        --set probes.router.config.readinessProbe.initialDelaySeconds=30 \
        --set probes.router.config.livenessProbe.initialDelaySeconds=120 \
        --set replicaCount.ingester=0 \
        --set replicaCount.querier=0 \
        --set replicaCount.router=0 \
        --set replicaCount.compactor=0 \
        --set replicaCount.alertmanager=0 \
        --set replicaCount.dex=0 \
        --set-string ingester.persistence.storageClass=longhorn \
        --set-string ingester.persistence.size=25Gi \
        --set-string querier.persistence.storageClass=longhorn \
        --set-string querier.persistence.size=25Gi \
        --set-string alertmanager.persistence.storageClass=longhorn \
        --set-string alertmanager.persistence.size=20Gi \
        --set-string alertquerier.persistence.storageClass=longhorn \
        --set-string alertquerier.persistence.size=20Gi \
        --set-string nats.config.jetstream.fileStore.pvc.storageClassName=longhorn \
        --set-string nats.config.jetstream.fileStore.pvc.size=10Gi \
        --set replicaCount.dex=0

      sudo helm repo add dex https://charts.dexidp.io || true
      sudo helm repo update
      sudo helm upgrade --install openobserve-dex dex/dex \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --create-namespace \
        --set fullnameOverride=openobserve-dex \
        --set config.issuer="https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex" \
        --set config.storage.type=kubernetes \
        --set config.storage.config.inCluster=true \
        --set config.web.http="0.0.0.0:5556" \
        --set config.grpc.address="0.0.0.0:5557" \
        --set config.enablePasswordDB=false \
        --set config.oauth2.responseTypes[0]=code \
        --set config.oauth2.skipApprovalScreen=true \
        --set config.staticClients[0].id="$OO_OAUTH2_PROXY_CLIENT_ID" \
        --set config.staticClients[0].name="OpenObserve Auth Proxy" \
        --set-string config.staticClients[0].secret="$OO_OAUTH2_PROXY_CLIENT_SECRET" \
        --set config.staticClients[0].redirectURIs[0]="$OO_PUBLIC_URL/oauth2/callback" \
        --set config.connectors[0].type=github \
        --set config.connectors[0].id=github \
        --set config.connectors[0].name="GitHub" \
        --set-string config.connectors[0].config.clientID="$OO_GH_CLIENT_ID" \
        --set-string config.connectors[0].config.clientSecret="$OO_GH_CLIENT_SECRET" \
        --set config.connectors[0].config.redirectURI="https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex/callback" \
        --set-string config.connectors[0].config.orgs[0].name="$OO_GH_ORG" \
        --set-string config.connectors[0].config.orgs[0].teams[0]="${OPENOBSERVE_GITHUB_ADMIN_TEAM}" \
        --set-string config.connectors[0].config.orgs[0].teams[1]="${OPENOBSERVE_GITHUB_USER_TEAM}" \
        --set config.connectors[0].config.scopes[0]=read:org \
        --set config.connectors[0].config.scopes[1]=user:email \
        --set config.connectors[0].config.loadAllGroups=true \
        --set config.connectors[0].config.teamNameField=slug \
        --set service.ports.http.port=5556 \
        --set ingress.enabled=true \
        --set ingress.className=nginx \
        --set ingress.annotations."nginx\.ingress\.kubernetes\.io/app-root"="/dex" \
        --set ingress.hosts[0].host="openobserve-dex.teleport.app.${RANCHER_DOMAIN}" \
        --set ingress.hosts[0].paths[0].path="/" \
        --set ingress.hosts[0].paths[0].pathType=Prefix \
        --set ingress.tls[0].hosts[0]="openobserve-dex.teleport.app.${RANCHER_DOMAIN}" \
        --set ingress.tls[0].secretName="dex-openobserve-tls"

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-dex --timeout=180s

      # Keep CNPG/Postgres uninjected so init jobs and DB pods don't get a Linkerd sidecar.
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch cluster.postgresql.cnpg.io openobserve-postgres --type merge -p '{
        "metadata": { "annotations": { "linkerd.io/inject": "disabled" }},
        "spec": {
          "inheritedMetadata": {
            "annotations": { "linkerd.io/inject": "disabled" }
          }
        }
      }' || true
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch cluster.postgresql.cnpg.io openobserve-postgres --type merge -p '{"spec":{"instances":1}}' || true

      # wait for minio to be ready
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-minio --timeout=120s

      MINIO_USER=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
          get secret openobserve-minio -o jsonpath='{.data.rootUser}' | base64 -d)
      MINIO_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        get secret openobserve-minio -o jsonpath='{.data.rootPassword}' | base64 -d)

      # create bucket using mc image (idempotent with -p)
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod minio-mc --ignore-not-found >/dev/null 2>&1 || true
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Pod
      metadata:
        name: minio-mc
        namespace: openobserve
      spec:
        priorityClassName: platform-system-high
        restartPolicy: Never
        containers:
          - name: mc
            image: quay.io/minio/mc
            command: ["/bin/sh","-c"]
            args:
              - |
                mc alias set local http://openobserve-minio:9000 "$MINIO_USER" "$MINIO_PASS" >/dev/null &&
                mc mb -p local/openobserve &&
                mc ls local
      EOF
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=jsonpath='{.status.phase}'=Succeeded pod/minio-mc --timeout=180s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs pod/minio-mc || true
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod minio-mc --ignore-not-found >/dev/null 2>&1 || true

      echo "⏳ Waiting for OpenObserve Postgres cluster to be Ready..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label namespace openobserve platform.suncoast.systems/system=false --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=condition=Ready cluster.postgresql.cnpg.io/openobserve-postgres --timeout=600s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=condition=Ready pod/openobserve-postgres-1 --timeout=300s || true

      # Safety: build DSN from CNPG app secret (authoritative source) and mirror into OpenObserve secret.
      PG_APP_USER=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-postgres-app -o jsonpath='{.data.username}' 2>/dev/null | base64 -d || true)
      PG_APP_PASS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-postgres-app -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)
      PG_APP_DB=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve-postgres-app -o jsonpath='{.data.dbname}' 2>/dev/null | base64 -d || true)
      if [ -z "$PG_APP_DB" ]; then
        PG_APP_DB="app"
      fi
      if [ -n "$PG_APP_USER" ] && [ -n "$PG_APP_PASS" ]; then
        OO_RW_DSN="postgres://$PG_APP_USER:$PG_APP_PASS@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/$PG_APP_DB?sslmode=disable"
      else
        OO_RW_DSN=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get secret openobserve -o jsonpath='{.data.ZO_META_POSTGRES_DSN}' 2>/dev/null | base64 -d || true)
      fi
      if [ -z "$OO_RW_DSN" ]; then
        OO_RW_DSN="postgres://openobserve:$OPENOBSERVE_PG_PASSWORD@openobserve-postgres-rw.openobserve.svc.cluster.local:5432/app?sslmode=disable"
      fi
      if [ -n "$OO_RW_DSN" ]; then
        OO_RW_DSN_B64=$(printf '%s' "$OO_RW_DSN" | base64 | tr -d '\n')
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch secret openobserve --type=merge -p "{\"data\":{\"ZO_META_POSTGRES_DSN\":\"$OO_RW_DSN_B64\",\"ZO_META_POSTGRES_RO_DSN\":\"$OO_RW_DSN_B64\",\"ZO_META_DDL_DSN\":\"$OO_RW_DSN_B64\"}}" || true
      fi

      set_openobserve_dsn_env() {
        echo "🔧 Enforcing PostgreSQL DSNs on OpenObserve workloads..."
        for target in deployment/openobserve-router statefulset/openobserve-ingester statefulset/openobserve-querier deployment/openobserve-compactor statefulset/openobserve-alertmanager; do
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve set env "$target" \
            ZO_META_POSTGRES_DSN="$OO_RW_DSN" \
            ZO_META_POSTGRES_RO_DSN="$OO_RW_DSN" \
            ZO_META_DDL_DSN="$OO_RW_DSN" \
            ZO_META_CONNECTION_POOL_MIN_SIZE=5 \
            ZO_META_CONNECTION_POOL_MAX_SIZE=50 \
            ZO_META_CONNECTION_POOL_ACQUIRE_TIMEOUT=120 \
            ZO_META_TRANSACTION_RETRIES=30 \
            ZO_META_TRANSACTION_LOCK_TIMEOUT=3600 \
            RUST_BACKTRACE=1 >/dev/null 2>&1 || true
        done
      }

      dump_openobserve_debug() {
        echo "===== OpenObserve debug dump ====="
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get pods -o wide || true
        echo "----- events -----"
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get events --sort-by=.lastTimestamp | tail -n 200 || true
        OO_PODS=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve get pods -o name 2>/dev/null || true)
        if [ -z "$OO_PODS" ]; then
          echo "No OpenObserve pods found."
          return
        fi
        for pod_name in $OO_PODS; do
          pod_name=$(echo "$pod_name" | sed 's#^pod/##')
          echo "----- describe $pod_name -----"
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve describe pod "$pod_name" | tail -n 200 || true
          echo "----- logs $pod_name (current) -----"
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs "$pod_name" --all-containers=true --tail=200 || true
          echo "----- logs $pod_name (previous) -----"
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs "$pod_name" --all-containers=true --previous --tail=200 || true
        done
      }

      wait_for_openobserve_rollout() {
        target="$1"
        timeout="$2"
        if [ -z "$timeout" ]; then
          timeout="600s"
        fi
        if ! sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status "$target" --timeout="$timeout"; then
          echo "❌ OpenObserve rollout failed for $target"
          dump_openobserve_debug
          exit 1
        fi
      }

      echo "🚀 Starting OpenObserve router first so DB migrations run once..."
      sudo helm upgrade openobserve openobserve/openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --reuse-values \
        --set-string image.oss.repository=public.ecr.aws/zinclabs/openobserve \
        --set replicaCount.router=1 \
        --set replicaCount.ingester=0 \
        --set replicaCount.querier=0 \
        --set replicaCount.compactor=0 \
        --set replicaCount.alertmanager=0
      if [ -n "$OO_RW_DSN" ]; then
        set_openobserve_dsn_env
      fi
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch deployment openobserve-router --type=json -p='[
        {"op":"replace","path":"/spec/strategy","value":{"type":"Recreate"}}
      ]' || sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch deployment openobserve-router --type=json -p='[
        {"op":"add","path":"/spec/strategy","value":{"type":"Recreate"}}
      ]'
      wait_for_openobserve_rollout deployment/openobserve-router 900s

      echo "🚀 Scaling remaining OpenObserve workloads..."
      sudo helm upgrade openobserve openobserve/openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n openobserve \
        --reuse-values \
        --set-string image.oss.repository=public.ecr.aws/zinclabs/openobserve \
        --set replicaCount.ingester=1 \
        --set replicaCount.querier=1 \
        --set replicaCount.compactor=1 \
        --set replicaCount.alertmanager=1 \
        --set probes.router.enabled=true \
        --set probes.router.config.startupProbe.initialDelaySeconds=30 \
        --set probes.router.config.startupProbe.periodSeconds=10 \
        --set probes.router.config.startupProbe.failureThreshold=90 \
        --set probes.router.config.readinessProbe.initialDelaySeconds=30 \
        --set probes.router.config.livenessProbe.initialDelaySeconds=120 \
        --set replicaCount.router=1
      if [ -n "$OO_RW_DSN" ]; then
        set_openobserve_dsn_env
      fi
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch deployment openobserve-router --type=json -p='[
        {"op":"replace","path":"/spec/strategy","value":{"type":"Recreate"}}
      ]' || sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve patch deployment openobserve-router --type=json -p='[
        {"op":"add","path":"/spec/strategy","value":{"type":"Recreate"}}
      ]'

      # now wait for the main OpenObserve workloads after scaling up
      wait_for_openobserve_rollout statefulset/openobserve-ingester 600s
      wait_for_openobserve_rollout statefulset/openobserve-querier 600s
      wait_for_openobserve_rollout deployment/openobserve-compactor 600s
      wait_for_openobserve_rollout statefulset/openobserve-alertmanager 600s
      wait_for_openobserve_rollout deployment/openobserve-router 600s
      echo "✔️ OpenObserve installed."

      OO_BASIC="$(printf '%s:%s' "$OPENOBSERVE_USERNAME" "$OPENOBSERVE_PASSWORD" | base64 | tr -d '\r\n')"
      OO_AUTH_HEADER="Basic $OO_BASIC"

      # Note: OpenObserve OSS does not support custom roles; access control is handled by Dex + oauth2-proxy.

      # store it in the same namespace as the collector
      sudo kubectl -n observability \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        create secret generic oo-auth \
        --from-literal=OO_AUTH_HEADER="$OO_AUTH_HEADER" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl -n openobserve \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        create secret generic oo-auth \
        --from-literal=OO_AUTH_HEADER="$OO_AUTH_HEADER" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic openobserve-root-creds \
        --from-literal=username="$OPENOBSERVE_USERNAME" \
        --from-literal=password="$OPENOBSERVE_PASSWORD" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      OO_STREAM_INDEX_FIELDS_B64=$(printf '%s\n' \
        trace_id \
        span_id \
        user_agent \
        x_client_ip \
        x_forwarded_for \
        x_forwarded_host \
        x_forwarded_proto \
        x_real_ip \
        x_user_email \
        x_user_id \
        x_user_issuer \
        x_user_username \
        gravitee_request_id \
        gravitee_transaction_id | base64 | tr -d '\r\n')
      OO_STREAMS_B64=$(printf '%s\n' default k8s_pod_logs | base64 | tr -d '\r\n')

      echo "Seeding OpenObserve log stream schema with trace_id/span_id fields..."
      if [[ -z "$OO_AUTH_HEADER" ]]; then
        echo "⚠️  OO_AUTH_HEADER is empty; skipping OpenObserve schema seed."
      else
          OO_SCHEMA_SEED_SCRIPT=$'import base64, json, os, sys, urllib.request, urllib.error\n'
          OO_SCHEMA_SEED_SCRIPT+=$'auth = os.environ.get("OO_AUTH_HEADER")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'org = os.environ.get("OO_ORG", "default")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'streams_raw = os.environ.get("OO_STREAMS_B64", "")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'default_stream = os.environ.get("OO_STREAM", "default")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'if not auth:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    sys.exit("missing OO_AUTH_HEADER")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'streams = []\n'
          OO_SCHEMA_SEED_SCRIPT+=$'if streams_raw:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    try:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        streams = [s.strip() for s in base64.b64decode(streams_raw).decode().splitlines() if s.strip()]\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    except Exception as exc:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        print(f"unable to decode streams list: {exc}", file=sys.stderr)\n'
          OO_SCHEMA_SEED_SCRIPT+=$'if not streams:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    streams = [default_stream]\n'
          OO_SCHEMA_SEED_SCRIPT+=$'for stream in streams:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    url = f"http://openobserve-router:5080/api/{org}/{stream}/_json"\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    payload = [{\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "trace_id": "00000000000000000000000000000001",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "span_id": "0000000000000001",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "user_agent": "Python-urllib/3.11",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_client_ip": "72.187.152.150",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_forwarded_for": "72.187.152.150, 72.187.152.150, 72.187.152.150",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_forwarded_host": "graphql.app.suncoast.systems",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_forwarded_proto": "http",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_real_ip": "72.187.152.150",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_user_email": "administrator@suncoast.systems",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_user_id": "8dfd3008-b361-4af9-8590-4abebc08734a",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_user_issuer": "https://auth.suncoast.systems/realms/external",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "x_user_username": "administrator@suncoast.systems",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "gravitee_request_id": "c0b0a3d0-8b63-406b-b0a3-d08b63206b6a",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "gravitee_transaction_id": "c0b0a3d0-8b63-406b-b0a3-d08b63206b6a",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "level": "info",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "message": "openobserve schema seed: trace/span + header fields",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "source": "bootstrap",\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        "seed": True\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    }]\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    data = json.dumps(payload).encode("utf-8")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    req = urllib.request.Request(url, data=data, headers={"Authorization": auth, "Content-Type": "application/json"})\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    try:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        with urllib.request.urlopen(req, timeout=20) as resp:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'            print(f"[{stream}] seed log ingest status={resp.status}")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    except urllib.error.HTTPError as exc:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        try:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'            body = exc.read().decode("utf-8", errors="ignore")\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        except Exception:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'            body = ""\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        print(f"[{stream}] seed log ingest failed: {exc.code} {body}", file=sys.stderr)\n'
          OO_SCHEMA_SEED_SCRIPT+=$'    except Exception as exc:\n'
          OO_SCHEMA_SEED_SCRIPT+=$'        print(f"[{stream}] seed log ingest error: {exc}", file=sys.stderr)\n'

          OO_SCHEMA_SEED_SCRIPT64=$(printf '%s' "$OO_SCHEMA_SEED_SCRIPT" | base64 | tr -d '\r\n')

          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-stream-seed --ignore-not-found >/dev/null 2>&1 || true
          cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
          apiVersion: v1
          kind: Pod
          metadata:
            name: oo-stream-seed
            namespace: openobserve
          spec:
            priorityClassName: platform-system-high
            restartPolicy: Never
            containers:
              - name: runner
                image: python:3-alpine
                command: ["/bin/sh","-c"]
                args:
                  - |
                    python -c 'import os,base64;exec(base64.b64decode(os.environ["OO_SCHEMA_SEED_SCRIPT64"]).decode())'
                env:
                  - name: OO_AUTH_HEADER
                    value: "$OO_AUTH_HEADER"
                  - name: OO_ORG
                    value: "default"
                  - name: OO_STREAMS_B64
                    value: "$OO_STREAMS_B64"
                  - name: OO_SCHEMA_SEED_SCRIPT64
                    value: "$OO_SCHEMA_SEED_SCRIPT64"
      EOF
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=jsonpath='{.status.phase}'=Succeeded pod/oo-stream-seed --timeout=300s
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs pod/oo-stream-seed || true
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-stream-seed --ignore-not-found >/dev/null 2>&1 || true
      fi

      echo "Ensuring OpenObserve log stream indexes include trace_id and span_id..."
      if [[ -z "$OO_AUTH_HEADER" ]]; then
        echo "⚠️  OO_AUTH_HEADER is empty; skipping OpenObserve stream settings."
      else
          OO_STREAM_SETTINGS_SCRIPT=$'import base64, json, os, sys, urllib.request, urllib.error\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'auth = os.environ.get("OO_AUTH_HEADER")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'if not auth: sys.exit("missing OO_AUTH_HEADER")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'org = os.environ.get("OO_ORG", "default")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'streams_raw = os.environ.get("OO_STREAMS_B64", "")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'default_stream = os.environ.get("OO_STREAM", "default")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'fields_raw = os.environ.get("OO_STREAM_INDEX_FIELDS_B64", "")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    fields = [f.strip() for f in base64.b64decode(fields_raw).decode().splitlines() if f.strip()]\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'except Exception as exc:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    sys.exit(f"unable to decode index fields: {exc}")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'if not fields:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    sys.exit("no index fields supplied")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'headers = {"Authorization": auth, "Content-Type": "application/json"}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'streams = []\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'if streams_raw:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        streams = [s.strip() for s in base64.b64decode(streams_raw).decode().splitlines() if s.strip()]\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    except Exception as exc:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        print(f"unable to decode streams list: {exc}", file=sys.stderr)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'if not streams:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    streams = [default_stream]\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'def request(method, url, payload=None):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    data = None\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if payload is not None:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        data = json.dumps(payload).encode("utf-8")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    req = urllib.request.Request(url, data=data, headers=headers, method=method)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    with urllib.request.urlopen(req, timeout=20) as resp:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        body = resp.read()\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        if not body:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            return {}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            return json.loads(body)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        except Exception:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            return {}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'def fetch_stream_settings(stream_name):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    url = f"http://openobserve-router:5080/api/{org}/streams/{stream_name}/schema?type=logs"\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    req = urllib.request.Request(url, headers=headers)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    with urllib.request.urlopen(req, timeout=20) as resp:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        data = json.loads(resp.read().decode("utf-8"))\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if isinstance(data, dict) and "data" in data:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        data = data["data"]\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    return data.get("settings") or {}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'def normalize(item):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if item is None:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        return None\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if isinstance(item, (list, tuple)):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        if not item:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            return None\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        return str(item[0])\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if isinstance(item, str):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        return item\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    return str(item)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'def normalize_index_fields(current):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    normalized = []\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    seen = set()\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    for item in current:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        key = normalize(item)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        if not key or key in seen:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            continue\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        seen.add(key)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        normalized.append(key)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    return normalized, seen\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'for stream in streams:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    settings = {}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        settings = fetch_stream_settings(stream)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    except Exception as exc:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        print(f"[{stream}] settings fetch error: {exc}", file=sys.stderr)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        continue\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    current = settings.get("index_fields") or settings.get("indexFields") or []\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    normalized, _ = normalize_index_fields(current)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    counts = {field: normalized.count(field) for field in fields}\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if all(counts.get(field, 0) == 1 for field in fields):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        print(f"[{stream}] index_fields already normalized: {counts}")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        continue\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    urls = [\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        f"http://openobserve-router:5080/api/{org}/streams/{stream}/settings",\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        f"http://openobserve-router:5080/api/{org}/streams/{stream}/settings?type=logs",\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    ]\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    def apply_payload(payload, label):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        last_err = None\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        for url in urls:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'            for method in ("PUT", "POST"):\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    request(method, url, payload)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    print(f"[{stream}] {method} {label} ok url={url}")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    return None\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                except urllib.error.HTTPError as exc:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    last_err = exc\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    try:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                        body = exc.read().decode("utf-8", errors="ignore")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    except Exception:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                        body = ""\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    print(f"[{stream}] {method} {label} failed: {exc.code} {body}", file=sys.stderr)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                except Exception as exc:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    last_err = exc\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'                    print(f"[{stream}] {method} {label} error: {exc}", file=sys.stderr)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        return last_err\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    err = apply_payload({"index_fields": {"remove": fields}}, "remove")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if err:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        sys.exit(1)\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    err = apply_payload({"index_fields": {"add": fields}}, "add")\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'    if err:\n'
          OO_STREAM_SETTINGS_SCRIPT+=$'        sys.exit(1)\n'

          OO_STREAM_SETTINGS_SCRIPT64=$(printf '%s' "$OO_STREAM_SETTINGS_SCRIPT" | base64 | tr -d '\r\n')

          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-stream-settings --ignore-not-found >/dev/null 2>&1 || true
          cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
          apiVersion: v1
          kind: Pod
          metadata:
            name: oo-stream-settings
            namespace: openobserve
          spec:
            priorityClassName: platform-system-high
            restartPolicy: Never
            containers:
              - name: runner
                image: python:3-alpine
                command: ["/bin/sh","-c"]
                args:
                  - |
                    python -c 'import os,base64;exec(base64.b64decode(os.environ["OO_STREAM_SETTINGS_SCRIPT64"]).decode())'
                env:
                  - name: OO_AUTH_HEADER
                    value: "$OO_AUTH_HEADER"
                  - name: OO_ORG
                    value: "default"
                  - name: OO_STREAMS_B64
                    value: "$OO_STREAMS_B64"
                  - name: OO_STREAM_INDEX_FIELDS_B64
                    value: "$OO_STREAM_INDEX_FIELDS_B64"
                  - name: OO_STREAM_SETTINGS_SCRIPT64
                    value: "$OO_STREAM_SETTINGS_SCRIPT64"
      EOF
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=jsonpath='{.status.phase}'=Succeeded pod/oo-stream-settings --timeout=300s
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs pod/oo-stream-settings || true
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-stream-settings --ignore-not-found >/dev/null 2>&1 || true
      fi

      echo "🔐 Installing GitHub auth proxy for OpenObserve (Dex + oauth2-proxy + NGINX + cookie bootstrap)..."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic oo-oauth2-proxy \
        --from-literal=client_id="$OO_OAUTH2_PROXY_CLIENT_ID" \
        --from-literal=client_secret="$OO_OAUTH2_PROXY_CLIENT_SECRET" \
        --from-literal=cookie_secret="$OO_OAUTH2_PROXY_COOKIE_SECRET" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create secret generic oo-auth-bridge \
        --from-literal=hmac_secret="$OO_AUTH_BRIDGE_HMAC_SECRET" \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -


      # Overwrite auth-bridge with a known-good version (the file is loaded into a ConfigMap below).

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create configmap oo-auth-bridge \
        --from-file=bridge.py=/root/oo-auth-bridge.py \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sed "s|__OO_AUTH_HEADER__|$OO_AUTH_HEADER|g" /root/oo-auth-nginx.conf > /root/oo-auth-nginx.rendered.conf

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve \
        create configmap oo-auth-proxy-nginx \
        --from-file=nginx.conf=/root/oo-auth-nginx.rendered.conf \
        --dry-run=client -o yaml | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      echo "ℹ️  GitHub team→role sync is not deployed on OSS builds (OpenObserve OSS enforces admin-only org roles); team access is enforced at Dex."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f - <<'EOF'
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: otel-collector
        namespace: observability
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: otel-collector-read
      rules:
      - apiGroups: [""]
        resources: ["pods", "endpoints", "services", "namespaces", "nodes"]
        verbs: ["get", "list", "watch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: otel-collector-read
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: otel-collector-read
      subjects:
        - kind: ServiceAccount
          name: otel-collector
          namespace: observability
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: otel-collector-k8s
        namespace: observability
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: otel-collector-k8s
      rules:
      - nonResourceURLs: ["/metrics", "/metrics/cadvisor"]
        verbs: ["get", "list", "watch"]
      - apiGroups: [""]
        resources:
        - configmaps
        - endpoints
        - events
        - namespaces
        - namespaces/status
        - nodes
        - nodes/spec
        - nodes/stats
        - nodes/metrics
        - nodes/proxy
        - persistentvolumes
        - persistentvolumeclaims
        - pods
        - pods/status
        - replicationcontrollers
        - replicationcontrollers/status
        - resourcequotas
        - services
        verbs: ["get", "list", "watch"]
      - apiGroups: ["apps"]
        resources:
        - daemonsets
        - deployments
        - replicasets
        - statefulsets
        verbs: ["get", "list", "watch"]
      - apiGroups: ["batch"]
        resources:
        - jobs
        - cronjobs
        verbs: ["get", "list", "watch"]
      - apiGroups: ["autoscaling"]
        resources:
        - horizontalpodautoscalers
        verbs: ["get", "list", "watch"]
      - apiGroups: ["networking.k8s.io"]
        resources:
        - ingresses
        verbs: ["get", "list", "watch"]
      - apiGroups: ["discovery.k8s.io"]
        resources:
        - endpointslices
        verbs: ["get", "list", "watch"]
      - apiGroups: ["events.k8s.io"]
        resources:
        - events
        verbs: ["get", "list", "watch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: otel-collector-k8s
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: otel-collector-k8s
      subjects:
        - kind: ServiceAccount
          name: otel-collector-k8s
          namespace: observability
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: Server
      metadata:
        name: otlp-grpc
        namespace: observability
      spec:
        podSelector:
          matchLabels:
            app: otel-collector
        port: 4317
        proxyProtocol: gRPC
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: Server
      metadata:
        name: otlp-http
        namespace: observability
      spec:
        podSelector:
          matchLabels:
            app: otel-collector
        port: 4318
        proxyProtocol: HTTP/1
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: ServerAuthorization
      metadata:
        name: allow-mesh-to-otel
        namespace: observability
      spec:
        server:
          name: otlp-grpc
        client:
          meshTLS:
            identities:
              - "*"
      ---
      apiVersion: policy.linkerd.io/v1beta1
      kind: ServerAuthorization
      metadata:
        name: allow-mesh-to-otel-http
        namespace: observability
      spec:
        server:
          name: otlp-http
        client:
          meshTLS:
            identities:
              - "*"
      ---
      # TEMPLATE ConfigMap (note the literal __AUTH_HEADER__ token)
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: otel-collector-config
        namespace: observability
        labels:
          app: otel-collector
      data:
        config.yaml: |
          receivers:
            prometheus/linkerd:
              config:
                global:
                  evaluation_interval: 10s
                  scrape_interval: 10s
                  scrape_timeout: 9s
                scrape_configs:
                  - job_name: 'linkerd-controller'
                    kubernetes_sd_configs:
                      - role: pod
                        namespaces:
                          names:
                            # include the namespaces you actually use
                            - linkerd
                            - linkerd-jaeger
                            - linkerd-viz
                    relabel_configs:
                      - source_labels: [__meta_kubernetes_pod_container_port_name]
                        action: keep
                        regex: (admin|admin-http)
                      - source_labels: [__meta_kubernetes_pod_container_name]
                        action: replace
                        target_label: component

                  - job_name: 'linkerd-multicluster-controller'
                    kubernetes_sd_configs:
                      - role: pod
                    relabel_configs:
                      - source_labels:
                          [__meta_kubernetes_pod_label_component, __meta_kubernetes_pod_container_port_name]
                        action: keep
                        regex: (linkerd-service-mirror|controller);admin(-http)?$

                  - job_name: 'linkerd-proxy'
                    kubernetes_sd_configs:
                      - role: pod
                    relabel_configs:
                      - source_labels:
                          [__meta_kubernetes_pod_container_name,
                          __meta_kubernetes_pod_container_port_name,
                          __meta_kubernetes_pod_label_linkerd_io_control_plane_ns]
                        action: keep
                        # allow either linkerd or linkerd-jaeger as control-plane ns
                        regex: ^linkerd-proxy;linkerd-admin;(linkerd|linkerd-jaeger)$
                      - source_labels: [__meta_kubernetes_namespace]
                        action: replace
                        target_label: namespace
                      - source_labels: [__meta_kubernetes_pod_name]
                        action: replace
                        target_label: pod
                      - source_labels: [__meta_kubernetes_pod_label_linkerd_io_proxy_job]
                        action: replace
                        target_label: k8s_job
                      - action: labeldrop
                        regex: __meta_kubernetes_pod_label_linkerd_io_proxy_job
                      # Map *only once* from linkerd_io labels to normal labels
                      - action: labelmap
                        regex: __meta_kubernetes_pod_label_linkerd_io_(.+)
                      # Bring over the rest of pod labels
                      - action: labelmap
                        regex: __meta_kubernetes_pod_label_(.+)
                        replacement: __tmp_pod_label_$$1
                      - action: labelmap
                        regex: __tmp_pod_label_linkerd_io_(.+)
                        replacement: __tmp_pod_label_$$1
                      - action: labeldrop
                        regex: __tmp_pod_label_linkerd_io_(.+)
                      - action: labelmap
                        regex: __tmp_pod_label_(.+)

            otlp:
              protocols:
                grpc:
                  endpoint: 0.0.0.0:4317
                http:
                  endpoint: 0.0.0.0:4318

          processors:
            memory_limiter:
              # Using percentages so this scales with pod limit.
              # With a 512Mi limit, 75% ~= 384Mi, giving ~50% headroom over your current ~220Mi usage.
              limit_percentage: 75
              spike_limit_percentage: 25
              check_interval: 5s
            transform/logs:
              log_statements:
                - context: log
                  statements:
                    - set(attributes["trace_id"], trace_id) where trace_id != nil
                    - set(attributes["span_id"], span_id) where span_id != nil
                    - set(attributes["user_id"], attributes["x-user-id"]) where attributes["x-user-id"] != nil
                    - set(attributes["user_id"], attributes["X-User-Id"]) where attributes["X-User-Id"] != nil
                    - set(attributes["user_id"], attributes["entrypoint-request.headers.x-user-id"]) where attributes["entrypoint-request.headers.x-user-id"] != nil
                    - set(attributes["user_email"], attributes["x-user-email"]) where attributes["x-user-email"] != nil
                    - set(attributes["user_email"], attributes["X-User-Email"]) where attributes["X-User-Email"] != nil
                    - set(attributes["user_email"], attributes["entrypoint-request.headers.x-user-email"]) where attributes["entrypoint-request.headers.x-user-email"] != nil
                    - set(attributes["user_username"], attributes["x-user-username"]) where attributes["x-user-username"] != nil
                    - set(attributes["user_username"], attributes["entrypoint-request.headers.x-user-username"]) where attributes["entrypoint-request.headers.x-user-username"] != nil
                    - set(attributes["user_issuer"], attributes["x-user-issuer"]) where attributes["x-user-issuer"] != nil
                    - set(attributes["user_issuer"], attributes["entrypoint-request.headers.x-user-issuer"]) where attributes["entrypoint-request.headers.x-user-issuer"] != nil
            batch:
              timeout: 10s
              send_batch_size: 1024
              send_batch_max_size: 2048

          exporters:
            otlp/openobserve:
              endpoint: openobserve-router.openobserve.svc.cluster.local:5081
              headers:
                Authorization: __AUTH_HEADER__
                organization: default
                stream-name: default
              tls:
                insecure: true
              sending_queue:
                enabled: true
                num_consumers: 4
                queue_size: 5000
              retry_on_failure:
                enabled: true
                initial_interval: 5s
                max_interval: 30s
                max_elapsed_time: 300s
            debug:
              verbosity: detailed

          service:
            pipelines:
              metrics:
                receivers: [prometheus/linkerd]
                processors: [memory_limiter, batch]
                exporters: [debug, otlp/openobserve]
              traces:
                receivers: [otlp]
                processors: [memory_limiter, batch]
                exporters: [debug, otlp/openobserve]
              logs:
                receivers: [otlp]
                processors: [memory_limiter, transform/logs, batch]
                exporters: [debug, otlp/openobserve]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: otel-collector
        namespace: observability
        labels:
          app: otel-collector
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: otel-collector
        template:
          metadata:
            labels:
              app: otel-collector
            annotations:
              config.linkerd.io/opaque-ports: "4317,4318"
          spec:
            serviceAccountName: otel-collector

            volumes:
              # Template from ConfigMap
              - name: otel-config-tpl
                configMap:
                  name: otel-collector-config
                  items:
                    - key: config.yaml
                      path: config.yaml
              # Secret with full Authorization header
              - name: oo-auth
                secret:
                  secretName: oo-auth
                  items:
                    - key: OO_AUTH_HEADER
                      path: authorization_header
              # Writable target for rendered config
              - name: otel-config-final
                emptyDir: {}

            # Render config without using 
            initContainers:
              - name: render-config
                image: alpine:3.20
                command: ["/bin/sh","-c"]
                args:
                  - |
                    mkdir -p /etc/otelcol
                    AUTH="$(tr -d '\r\n' < /etc/secret/authorization_header)"
                    awk -v val="$AUTH" '{ gsub(/__AUTH_HEADER__/, val); print }' /etc/otelcol-src/config.yaml > /etc/otelcol/config.yaml
                volumeMounts:
                  - name: otel-config-tpl
                    mountPath: /etc/otelcol-src
                    readOnly: true
                  - name: oo-auth
                    mountPath: /etc/secret
                    readOnly: true
                  - name: otel-config-final
                    mountPath: /etc/otelcol

            containers:
              - name: otel-collector
                image: otel/opentelemetry-collector-contrib:0.104.0
                args: ["--config=/etc/otelcol/config.yaml"]
                ports:
                  - name: grpc
                    containerPort: 4317
                  - name: http
                    containerPort: 4318
                volumeMounts:
                  - name: otel-config-final
                    mountPath: /etc/otelcol
                    readOnly: true
                securityContext:
                  runAsNonRoot: true
                  allowPrivilegeEscalation: false
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: otel-collector
        namespace: observability
        labels:
          app: otel-collector
        annotations:
          config.linkerd.io/opaque-ports: "4317,4318"
      spec:
        type: ClusterIP
        selector:
          app: otel-collector
        ports:
          - name: otlp-grpc
            port: 4317
            targetPort: 4317
            protocol: TCP
          - name: otlp-http
            port: 4318
            targetPort: 4318
            protocol: TCP
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: otel-collector-k8s-agent-config
        namespace: observability
        labels:
          app: otel-collector-k8s-agent
      data:
        config.yaml: |
          receivers:
            kubeletstats:
              collection_interval: 30s
              auth_type: serviceAccount
              endpoint: "https://$${env:K8S_NODE_IP}:10250"
              insecure_skip_verify: true
              extra_metadata_labels:
                - container.id
                - k8s.volume.type
              metric_groups:
                - node
                - pod
                - container
                - volume
              metrics:
                k8s.pod.cpu.usage:
                  enabled: true
                k8s.node.cpu.usage:
                  enabled: true
                k8s.node.cpu.time:
                  enabled: true
                container.cpu.usage:
                  enabled: true
                k8s.pod.memory.usage:
                  enabled: true
                k8s.pod.memory.rss:
                  enabled: true
                k8s.node.memory.usage:
                  enabled: true
                k8s.node.memory.rss:
                  enabled: true
                k8s.pod.cpu_limit_utilization:
                  enabled: true
                k8s.pod.cpu_request_utilization:
                  enabled: true
                k8s.pod.memory_limit_utilization:
                  enabled: true
                k8s.pod.memory_request_utilization:
                  enabled: true

          processors:
            memory_limiter:
              check_interval: 1s
              limit_mib: 512
              spike_limit_mib: 128
            resourcedetection:
              detectors: [system, env, k8snode]
              override: true
              system:
                hostname_sources: [os, dns]
            attributes:
              actions:
                - key: k8s_cluster
                  action: insert
                  value: suncoast-systems-k8s-cluster
            k8sattributes:
              auth_type: serviceAccount
              passthrough: false
              filter:
                node_from_env_var: K8S_NODE_NAME
              extract:
                labels:
                  - tag_name: service.name
                    key: app.kubernetes.io/name
                    from: pod
                  - tag_name: k8s.app.name
                    key: k8s-app
                    from: pod
                  - tag_name: k8s.app.instance
                    key: app.kubernetes.io/instance
                    from: pod
                  - tag_name: service.version
                    key: app.kubernetes.io/version
                    from: pod
                  - tag_name: k8s.app.component
                    key: app.kubernetes.io/component
                    from: pod
                metadata:
                  - k8s.pod.name
                  - k8s.pod.uid
                  - k8s.deployment.name
                  - k8s.namespace.name
                  - k8s.node.name
                  - k8s.pod.start_time
                  - k8s.container.name
              pod_association:
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.uid
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.name
                    - from: resource_attribute
                      name: k8s.namespace.name
                    - from: resource_attribute
                      name: k8s.node.name
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.ip
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.name
                    - from: resource_attribute
                      name: k8s.namespace.name
                - sources:
                    - from: connection
            batch:
              send_batch_size: 2000
              send_batch_max_size: 5000
              timeout: 5s

          exporters:
            otlp/openobserve:
              endpoint: openobserve-router.openobserve.svc.cluster.local:5081
              headers:
                Authorization: __AUTH_HEADER__
                organization: default
              tls:
                insecure: true
              sending_queue:
                enabled: true
                num_consumers: 4
                queue_size: 5000
              retry_on_failure:
                enabled: true
                initial_interval: 5s
                max_interval: 30s
                max_elapsed_time: 300s

          service:
            pipelines:
              metrics:
                receivers: [kubeletstats]
                processors: [memory_limiter, resourcedetection, attributes, k8sattributes, batch]
                exporters: [otlp/openobserve]
      ---
      apiVersion: apps/v1
      kind: DaemonSet
      metadata:
        name: otel-collector-k8s-agent
        namespace: observability
        labels:
          app: otel-collector-k8s-agent
      spec:
        selector:
          matchLabels:
            app: otel-collector-k8s-agent
        template:
          metadata:
            labels:
              app: otel-collector-k8s-agent
          spec:
            serviceAccountName: otel-collector-k8s
            tolerations:
              - effect: NoSchedule
                operator: Exists
            volumes:
              - name: otel-config-tpl
                configMap:
                  name: otel-collector-k8s-agent-config
                  items:
                    - key: config.yaml
                      path: config.yaml
              - name: oo-auth
                secret:
                  secretName: oo-auth
                  items:
                    - key: OO_AUTH_HEADER
                      path: authorization_header
              - name: otel-config-final
                emptyDir: {}
            initContainers:
              - name: render-config
                image: alpine:3.20
                command: ["/bin/sh","-c"]
                args:
                  - |
                    mkdir -p /etc/otelcol
                    AUTH="$(tr -d '\r\n' < /etc/secret/authorization_header)"
                    awk -v val="$AUTH" '{ gsub(/__AUTH_HEADER__/, val); print }' /etc/otelcol-src/config.yaml > /etc/otelcol/config.yaml
                volumeMounts:
                  - name: otel-config-tpl
                    mountPath: /etc/otelcol-src
                    readOnly: true
                  - name: oo-auth
                    mountPath: /etc/secret
                    readOnly: true
                  - name: otel-config-final
                    mountPath: /etc/otelcol
            containers:
              - name: otel-collector
                image: otel/opentelemetry-collector-contrib:0.138.0
                args: ["--config=/etc/otelcol/config.yaml"]
                env:
                  - name: K8S_NODE_NAME
                    valueFrom:
                      fieldRef:
                        fieldPath: spec.nodeName
                  - name: K8S_NODE_IP
                    valueFrom:
                      fieldRef:
                        fieldPath: status.hostIP
                resources:
                  requests:
                    cpu: 200m
                    memory: 512Mi
                  limits:
                    cpu: 500m
                    memory: 1Gi
                volumeMounts:
                  - name: otel-config-final
                    mountPath: /etc/otelcol
                    readOnly: true
                securityContext:
                  runAsNonRoot: true
                  allowPrivilegeEscalation: false
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: otel-collector-k8s-gateway-config
        namespace: observability
        labels:
          app: otel-collector-k8s-gateway
      data:
        config.yaml: |
          receivers:
            k8s_cluster:
              collection_interval: 30s
              node_conditions_to_report: [Ready, MemoryPressure, DiskPressure, PIDPressure]
              allocatable_types_to_report: [cpu, memory, storage]
              metrics:
                k8s.container.cpu_limit:
                  enabled: false
                k8s.container.cpu_request:
                  enabled: false
                k8s.container.memory_limit:
                  enabled: false
                k8s.container.memory_request:
                  enabled: false
            k8sobjects/events:
              auth_type: serviceAccount
              objects:
                - name: events
                  mode: watch
                  group: events.k8s.io
            prometheus/cadvisor:
              config:
                scrape_configs:
                  - job_name: cadvisor
                    scheme: https
                    sample_limit: 10000
                    scrape_interval: 30s
                    scrape_timeout: 10s
                    metrics_path: /metrics/cadvisor
                    tls_config:
                      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                      insecure_skip_verify: true
                    authorization:
                      credentials_file: "/var/run/secrets/kubernetes.io/serviceaccount/token"
                      type: Bearer
                    kubernetes_sd_configs:
                      - role: node
                    metric_relabel_configs:
                      - action: keep
                        regex: container_fs_(reads_total|writes_total|reads_bytes_total|writes_bytes_total)
                        source_labels:
                          - __name__
                      - action: drop
                        regex: ".+;"
                        separator: ";"
                        source_labels:
                          - id
                          - pod
                    relabel_configs:
                      - action: replace
                        replacement: "kubelet"
                        target_label: job
                      - action: replace
                        source_labels:
                          - __meta_kubernetes_node_name
                        target_label: node

          processors:
            memory_limiter:
              check_interval: 1s
              limit_mib: 512
              spike_limit_mib: 128
            resourcedetection:
              detectors: [env]
              override: true
              timeout: 2s
            attributes:
              actions:
                - key: k8s_cluster
                  action: insert
                  value: suncoast-systems-k8s-cluster
            k8sattributes:
              auth_type: serviceAccount
              passthrough: false
              extract:
                labels:
                  - tag_name: service.name
                    key: app.kubernetes.io/name
                    from: pod
                  - tag_name: k8s.app.name
                    key: k8s-app
                    from: pod
                  - tag_name: k8s.app.instance
                    key: app.kubernetes.io/instance
                    from: pod
                  - tag_name: service.version
                    key: app.kubernetes.io/version
                    from: pod
                  - tag_name: k8s.app.component
                    key: app.kubernetes.io/component
                    from: pod
                metadata:
                  - k8s.namespace.name
                  - k8s.pod.name
                  - k8s.pod.uid
                  - k8s.node.name
                  - k8s.pod.start_time
                  - k8s.deployment.name
                  - k8s.replicaset.name
                  - k8s.replicaset.uid
                  - k8s.daemonset.name
                  - k8s.daemonset.uid
                  - k8s.job.name
                  - k8s.job.uid
                  - k8s.container.name
                  - k8s.cronjob.name
                  - k8s.statefulset.name
                  - k8s.statefulset.uid
                  - container.image.tag
                  - container.image.name
                  - k8s.cluster.uid
              pod_association:
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.uid
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.name
                    - from: resource_attribute
                      name: k8s.namespace.name
                    - from: resource_attribute
                      name: k8s.node.name
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.ip
                - sources:
                    - from: resource_attribute
                      name: k8s.pod.name
                    - from: resource_attribute
                      name: k8s.namespace.name
                - sources:
                    - from: connection
            batch:
              send_batch_size: 2000
              send_batch_max_size: 5000
              timeout: 5s

          exporters:
            otlp/openobserve:
              endpoint: openobserve-router.openobserve.svc.cluster.local:5081
              headers:
                Authorization: __AUTH_HEADER__
                organization: default
              tls:
                insecure: true
              sending_queue:
                enabled: true
                num_consumers: 4
                queue_size: 5000
              retry_on_failure:
                enabled: true
                initial_interval: 5s
                max_interval: 30s
                max_elapsed_time: 300s
            otlp/openobserve_k8s_events:
              endpoint: openobserve-router.openobserve.svc.cluster.local:5081
              headers:
                Authorization: __AUTH_HEADER__
                organization: default
                stream-name: k8s_events
              tls:
                insecure: true
              sending_queue:
                enabled: true
                num_consumers: 2
                queue_size: 2000
              retry_on_failure:
                enabled: true
                initial_interval: 5s
                max_interval: 30s
                max_elapsed_time: 300s

          service:
            pipelines:
              logs/k8s_events:
                receivers: [k8sobjects/events]
                processors: [memory_limiter, resourcedetection, attributes, k8sattributes, batch]
                exporters: [otlp/openobserve_k8s_events]
              metrics:
                receivers: [k8s_cluster, prometheus/cadvisor]
                processors: [memory_limiter, resourcedetection, attributes, k8sattributes, batch]
                exporters: [otlp/openobserve]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: otel-collector-k8s-gateway
        namespace: observability
        labels:
          app: otel-collector-k8s-gateway
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: otel-collector-k8s-gateway
        template:
          metadata:
            labels:
              app: otel-collector-k8s-gateway
          spec:
            serviceAccountName: otel-collector-k8s
            volumes:
              - name: otel-config-tpl
                configMap:
                  name: otel-collector-k8s-gateway-config
                  items:
                    - key: config.yaml
                      path: config.yaml
              - name: oo-auth
                secret:
                  secretName: oo-auth
                  items:
                    - key: OO_AUTH_HEADER
                      path: authorization_header
              - name: otel-config-final
                emptyDir: {}
            initContainers:
              - name: render-config
                image: alpine:3.20
                command: ["/bin/sh","-c"]
                args:
                  - |
                    mkdir -p /etc/otelcol
                    AUTH="$(tr -d '\r\n' < /etc/secret/authorization_header)"
                    awk -v val="$AUTH" '{ gsub(/__AUTH_HEADER__/, val); print }' /etc/otelcol-src/config.yaml > /etc/otelcol/config.yaml
                volumeMounts:
                  - name: otel-config-tpl
                    mountPath: /etc/otelcol-src
                    readOnly: true
                  - name: oo-auth
                    mountPath: /etc/secret
                    readOnly: true
                  - name: otel-config-final
                    mountPath: /etc/otelcol
            containers:
              - name: otel-collector
                image: otel/opentelemetry-collector-contrib:0.138.0
                args: ["--config=/etc/otelcol/config.yaml"]
                resources:
                  requests:
                    cpu: 200m
                    memory: 512Mi
                  limits:
                    cpu: 500m
                    memory: 1Gi
                volumeMounts:
                  - name: otel-config-final
                    mountPath: /etc/otelcol
                    readOnly: true
                securityContext:
                  runAsNonRoot: true
                  allowPrivilegeEscalation: false
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-gui
        namespace: openobserve
        annotations:
          teleport.dev/name: "openobserve-gui"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "openobserve.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "OpenObserve GUI"
        labels:
          app: openobserve
          app.kubernetes.io/name: openobserve
          app.kubernetes.io/component: openobserve
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: openobserve-auth-proxy
        ports:
          - name: http
            port: 5080
            protocol: TCP
            targetPort: http
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-dex-external
        namespace: openobserve
      spec:
        type: LoadBalancer
        loadBalancerIP: 10.0.0.113
        selector:
          app.kubernetes.io/instance: openobserve-dex
          app.kubernetes.io/name: dex
        ports:
          - name: http
            port: 5556
            protocol: TCP
            targetPort: 5556
      ---
      # Linkerd policy fixes for prometheus-admin access from otel-collector
      apiVersion: policy.linkerd.io/v1alpha1
      kind: MeshTLSAuthentication
      metadata:
        name: otel-collector-mtls
        namespace: linkerd-viz
      spec:
        identities:
          - "otel-collector.observability.serviceaccount.identity.linkerd.cluster.local"
      ---
      apiVersion: policy.linkerd.io/v1alpha1
      kind: AuthorizationPolicy
      metadata:
        name: prometheus-admin-otel-collector
        namespace: linkerd-viz
      spec:
        targetRef:
          group: policy.linkerd.io
          kind: Server
          name: prometheus-admin
        requiredAuthenticationRefs:
          - group: policy.linkerd.io
            kind: MeshTLSAuthentication
            name: otel-collector-mtls
      EOF

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve apply -f /root/oo-auth-proxy.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/oo-oauth2-proxy --timeout=180s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/oo-auth-bridge --timeout=180s
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve rollout status deploy/openobserve-auth-proxy --timeout=180s

      sudo kubectl annotate namespace cnpg-system field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace cnpg-system scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["work-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace cnpg-system linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      echo "📊 Installing OpenObserve community dashboards..."
      if [[ -z "$OPENOBSERVE_DASHBOARD_FOLDER" ]]; then
        OO_DASHBOARD_FOLDER="default"
      else
        OO_DASHBOARD_FOLDER="$OPENOBSERVE_DASHBOARD_FOLDER"
      fi

      if [[ -z "$OO_AUTH_HEADER" ]]; then
        echo "⚠️  OO_AUTH_HEADER is empty; skipping dashboard import."
      else
          # 2) Folders (no heredoc)
          DASHBOARD_FOLDERS_B64=$(printf '%s\n' \
            "Kubernetes(openobserve-collector)" \
            "NVIDIA GPU Monitoring" | base64 | tr -d '\r\n')

          # 3) Python script as a single variable (no heredoc)
          DASHBOARD_SCRIPT=$'import base64, json, os, sys, urllib.parse, urllib.request\n'
          DASHBOARD_SCRIPT+=$'auth = os.environ.get("OO_AUTH_HEADER")\n'
          DASHBOARD_SCRIPT+=$'folders_raw = os.environ.get("OO_DASHBOARD_FOLDERS_B64", "")\n'
          DASHBOARD_SCRIPT+=$'if not auth: sys.exit("missing OO_AUTH_HEADER")\n'
          DASHBOARD_SCRIPT+=$'try: folders_text = base64.b64decode(folders_raw).decode()\n'
          DASHBOARD_SCRIPT+=$'except Exception as exc: sys.exit(f"unable to decode folders list: {exc}")\n'
          DASHBOARD_SCRIPT+=$'folders = [f.strip() for f in folders_text.splitlines() if f.strip()]\n'
          DASHBOARD_SCRIPT+=$'if not folders: sys.exit("no dashboard folders configured")\n'
          DASHBOARD_SCRIPT+=$'repo_base = "https://api.github.com/repos/openobserve/dashboards/contents/"\n'
          DASHBOARD_SCRIPT+=$'target_url = "http://openobserve-router:5080/api/default/dashboards?folder=default"\n'
          DASHBOARD_SCRIPT+=$'headers = {"Authorization": auth, "Content-Type": "application/json"}\n'
          DASHBOARD_SCRIPT+=$'def fetch_json(url):\n    with urllib.request.urlopen(url) as resp: return json.load(resp)\n'
          DASHBOARD_SCRIPT+=$'def fetch_bytes(url):\n    with urllib.request.urlopen(url) as resp: return resp.read()\n'
          DASHBOARD_SCRIPT+=$'success = 0\n'
          DASHBOARD_SCRIPT+=$'for folder in folders:\n'
          DASHBOARD_SCRIPT+=$'    encoded_folder = urllib.parse.quote(folder, safe="()")\n'
          DASHBOARD_SCRIPT+=$'    list_url = f"{repo_base}{encoded_folder}?ref=main"\n'
          DASHBOARD_SCRIPT+=$'    try:\n        entries = fetch_json(list_url)\n'
          DASHBOARD_SCRIPT+=$'    except Exception as exc:\n        print(f"❌ List failed for {folder}: {exc}", file=sys.stderr)\n        continue\n'
          DASHBOARD_SCRIPT+=$'    for entry in entries:\n'
          DASHBOARD_SCRIPT+=$'        if entry.get("type") != "file": continue\n'
          DASHBOARD_SCRIPT+=$'        name = entry.get("name", "")\n'
          DASHBOARD_SCRIPT+=$'        if not name.endswith(".dashboard.json"): continue\n'
          DASHBOARD_SCRIPT+=$'        download_url = entry.get("download_url")\n'
          DASHBOARD_SCRIPT+=$'        if not download_url: continue\n'
          DASHBOARD_SCRIPT+=$'        try:\n'
          DASHBOARD_SCRIPT+=$'            payload = fetch_bytes(download_url)\n'
          DASHBOARD_SCRIPT+=$'            req = urllib.request.Request(target_url, data=payload, headers=headers, method="POST")\n'
          DASHBOARD_SCRIPT+=$'            with urllib.request.urlopen(req) as resp:\n'
          DASHBOARD_SCRIPT+=$'                print(f"✅ {folder}/{name} -> HTTP {resp.status}")\n'
          DASHBOARD_SCRIPT+=$'                success += 1\n'
          DASHBOARD_SCRIPT+=$'        except Exception as exc:\n'
          DASHBOARD_SCRIPT+=$'            print(f"❌ Import failed {folder}/{name}: {exc}", file=sys.stderr)\n'
          DASHBOARD_SCRIPT+=$'print(f"Total imported: {success}")\n'
          DASHBOARD_SCRIPT+=$'if success == 0: sys.exit("no dashboards imported")\n'

          DASHBOARD_SCRIPT64=$(printf '%s' "$DASHBOARD_SCRIPT" | base64 | tr -d '\r\n')

          # Write manifest to disk, validate, then apply from file
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-dash-import --ignore-not-found >/dev/null 2>&1 || true
          OO_DASH_IMPORT_FILE="/root/oo-dash-import.yaml"
          : > "$OO_DASH_IMPORT_FILE"
          printf '%s\n' 'apiVersion: v1' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' 'kind: Pod' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' 'metadata:' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '  name: oo-dash-import' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '  namespace: openobserve' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' 'spec:' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '  priorityClassName: platform-system-high' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '  restartPolicy: Never' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '  containers:' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '    - name: runner' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '      image: python:3-alpine' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '      command: ["/bin/sh","-c"]' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '      args:' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '        - |' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '          python -c '\''import os,base64;exec(base64.b64decode(os.environ["DASHBOARD_SCRIPT64"]).decode())'\''' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '      env:' >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '        - name: OO_AUTH_HEADER' >> "$OO_DASH_IMPORT_FILE"
          printf '          value: "%s"\n' "$OO_AUTH_HEADER" >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '        - name: OO_DASHBOARD_FOLDERS_B64' >> "$OO_DASH_IMPORT_FILE"
          printf '          value: "%s"\n' "$DASHBOARD_FOLDERS_B64" >> "$OO_DASH_IMPORT_FILE"
          printf '%s\n' '        - name: DASHBOARD_SCRIPT64' >> "$OO_DASH_IMPORT_FILE"
          printf '          value: "%s"\n' "$DASHBOARD_SCRIPT64" >> "$OO_DASH_IMPORT_FILE"
          echo "📝 OpenObserve dashboard import manifest written to /root/oo-dash-import.yaml"
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply --dry-run=client -f /root/oo-dash-import.yaml >/dev/null
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f /root/oo-dash-import.yaml
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve wait --for=jsonpath='{.status.phase}'=Succeeded pod/oo-dash-import --timeout=300s
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve logs pod/oo-dash-import || true
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n openobserve delete pod oo-dash-import --ignore-not-found >/dev/null 2>&1 || true
      fi

      # 6) Install the Viz extension (dashboard + embedded Jaeger UI),
      #    disabling *only* the dashboard’s TLS + auth
      sudo linkerd viz install \
        --set dashboard.tls.enabled=false \
        --set dashboard.auth.enabled=false \
        --set jaeger.enabled=true \
        --set dashboard.enforcedHostRegexp=".*" \
        --set prometheus.resources.requests.memory=2Gi \
        --set prometheus.resources.limits.memory=3Gi \
        --kubeconfig /etc/rancher/rke2/rke2.yaml \
      | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 7) Tell Linkerd this namespace hosts the viz extension
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
        label ns linkerd-viz linkerd.io/extension=viz --overwrite

      # Exclude Linkerd Prometheus from VPA adjustments (OOM-sensitive)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml -n linkerd-viz \
        label deployment/prometheus platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml -n linkerd-viz \
        annotate deployment/prometheus platform.suncoast.systems/vpa-exclude=true --overwrite

      # 8) Validate the viz extension
      sudo linkerd viz check --kubeconfig /etc/rancher/rke2/rke2.yaml --wait 15m

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n linkerd-viz set env deployment/web LINKERD_DASHBOARD_ALLOW_ORIGIN="*"

      sudo kubectl rollout status deploy/web -n linkerd-viz --kubeconfig /etc/rancher/rke2/rke2.yaml

      echo "Installing Kyverno..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace kyverno || true
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace policy-reporter || true
      
      sudo kubectl annotate namespace kyverno field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      sudo kubectl annotate namespace kyverno scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace policy-reporter scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add kyverno https://kyverno.github.io/kyverno/ --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update
      echo "Installing Kyverno..."
      RETRIES=5
      DELAY=5

      KYVERNO_VERSION="$(sudo helm search repo kyverno/kyverno --versions 2>/dev/null | awk 'NR==2 {print $2}')"
      if [ -n "$${KYVERNO_VERSION:-}" ]; then
        echo "Using Kyverno chart version $${KYVERNO_VERSION}"
        KYVERNO_HELM_VERSION_ARGS="--version $${KYVERNO_VERSION}"
      else
        echo "Unable to determine Kyverno chart version; installing latest available"
        KYVERNO_HELM_VERSION_ARGS=""
      fi

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Kyverno..."
        sudo helm upgrade --install kyverno kyverno/kyverno -n kyverno --create-namespace --kubeconfig=/etc/rancher/rke2/rke2.yaml $${KYVERNO_HELM_VERSION_ARGS} && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      # Ensure Kyverno admission controller has enough capacity for policy validation
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        scale deploy/kyverno-admission-controller --replicas=2
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        set resources deploy/kyverno-admission-controller \
        --requests=cpu=200m,memory=256Mi --limits=cpu=1,memory=512Mi
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kyverno \
        rollout status deploy/kyverno-admission-controller --timeout=180s

      echo "Installing policy reporter..."
      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add policy-reporter https://kyverno.github.io/policy-reporter --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: kyverno-background-controller-namespace-update
      rules:
        - apiGroups: [""]
          resources: ["namespaces"]
          verbs: ["get", "list", "watch", "patch", "update"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: kyverno-background-controller-namespace-update
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: kyverno-background-controller-namespace-update
      subjects:
        - kind: ServiceAccount
          name: kyverno-background-controller
          namespace: kyverno
      EOF
      
      sudo helm repo update

      ensure_namespace() {
        local ns="$1"
        local retries=30
        local delay=5
        if [ "$#" -ge 2 ] && [ -n "$2" ]; then retries="$2"; fi
        if [ "$#" -ge 3 ] && [ -n "$3" ]; then delay="$3"; fi
        local out=""

        for i in $(seq 1 "$retries"); do
          if out="$(sudo kubectl create namespace "$ns" --kubeconfig=/etc/rancher/rke2/rke2.yaml 2>&1)"; then
            echo "$out"
            return 0
          fi

          if printf '%s' "$out" | grep -qi "AlreadyExists"; then
            echo "namespace/$ns already exists"
            return 0
          fi

          if printf '%s' "$out" | grep -qi "failed calling webhook"; then
            echo "⏳ Namespace '$ns' blocked by admission webhook ($i/$retries); retrying..."
            sleep "$delay"
            continue
          fi

          echo "$out" >&2
          return 1
        done

        echo "❌ Failed to create namespace '$ns' after $retries attempts." >&2
        return 1
      }

      ensure_namespace etcd 30 5
      ensure_namespace apisix 30 5
      sudo kubectl annotate namespace apisix field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace apisix linkerd.io/inject=enabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd linkerd.io/inject=disabled --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace etcd scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # Choose strong passwords; you can reuse the same value for both if you want
      ETCD_ROOT_PASS=$(openssl rand -base64 48 | tr -d '=\n' | tr '/+' '_-')
      APISIX_ETCD_PASS=$(openssl rand -base64 48 | tr -d '=\n' | tr '/+' '_-')

      # etcd (root) secret
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd \
        create secret generic etcd-root-auth \
        --from-literal=ROOT_PASS="$ETCD_ROOT_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix \
        create secret generic etcd-root-auth \
        --from-literal=ROOT_PASS="$ETCD_ROOT_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      # apisix etcd password secret
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd \
        create secret generic etcd-apisix \
        --from-literal=etcd-password="$APISIX_ETCD_PASS" --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix \
        create secret generic etcd-apisix \
        --from-literal=etcd-password="$APISIX_ETCD_PASS" \
        --dry-run=client -o yaml | \
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix annotate secret etcd-apisix \
        meta.helm.sh/release-name=apisix \
        meta.helm.sh/release-namespace=apisix --overwrite

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n apisix label secret etcd-apisix \
        app.kubernetes.io/managed-by=Helm --overwrite

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Service
      metadata:
        name: etcd
        namespace: etcd
        labels: { app: etcd }
      spec:
        clusterIP: None
        ports:
          - { name: client, port: 2379, targetPort: 2379 }
          - { name: peer,   port: 2380, targetPort: 2380 }
        selector: { app: etcd }
      ---
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: etcd
        namespace: etcd
      spec:
        serviceName: etcd
        replicas: 3
        selector: { matchLabels: { app: etcd } }
        template:
          metadata:
            labels: { app: etcd }
          spec:
            containers:
              - name: etcd
                image: quay.io/coreos/etcd:v3.5.12
                imagePullPolicy: IfNotPresent
                env:
                  - name: ETCD_NAME
                    valueFrom: { fieldRef: { fieldPath: metadata.name } }
                  - name: ETCD_INITIAL_CLUSTER
                    value: |
                      etcd-0=http://etcd-0.etcd.etcd.svc.cluster.local:2380,etcd-1=http://etcd-1.etcd.etcd.svc.cluster.local:2380,etcd-2=http://etcd-2.etcd.etcd.svc.cluster.local:2380
                  - name: ETCD_INITIAL_CLUSTER_STATE
                    value: new
                  - name: ETCD_INITIAL_ADVERTISE_PEER_URLS
                    value: http://$(ETCD_NAME).etcd.etcd.svc.cluster.local:2380
                  - name: ETCD_ADVERTISE_CLIENT_URLS
                    value: http://$(ETCD_NAME).etcd.etcd.svc.cluster.local:2379
                  - name: ETCD_LISTEN_PEER_URLS
                    value: http://0.0.0.0:2380
                  - name: ETCD_LISTEN_CLIENT_URLS
                    value: http://0.0.0.0:2379
                  - name: ETCD_DATA_DIR
                    value: /var/lib/etcd
                ports:
                  - { name: client, containerPort: 2379 }
                  - { name: peer,   containerPort: 2380 }
                volumeMounts:
                  - { name: data, mountPath: /var/lib/etcd }
        volumeClaimTemplates:
          - metadata: { name: data }
            spec:
              accessModes: [ "ReadWriteOnce" ]
              resources: { requests: { storage: 5Gi } }
              # storageClassName: longhorn
      EOF

      # Wait for etcd pods to be Ready
      cat <<'YAML' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: batch/v1
      kind: Job
      metadata:
        name: etcd-auth-bootstrap
        namespace: etcd
      spec:
        completions: 1
        parallelism: 1
        backoffLimit: 0
        ttlSecondsAfterFinished: null
        template:
          spec:
            restartPolicy: Never
            containers:
              - name: etcdctl
                image: alpine:3.20
                command: ["/bin/sh","-lc"]
                env:
                  - { name: ETCDCTL_API, value: "3" }
                  - { name: EP, value: "http://etcd.etcd.svc.cluster.local:2379" }
                  - name: ROOT_PASS
                    valueFrom: { secretKeyRef: { name: etcd-root-auth, key: ROOT_PASS } }
                  - name: APISIX_PASS
                    valueFrom: { secretKeyRef: { name: etcd-apisix, key: etcd-password } }
                args:
                  - |
                    set -eu
                    echo "📦 Installing curl+tar..."
                    apk add --no-cache ca-certificates curl tar >/dev/null

                    VER="v3.5.12"
                    ARCH="$(uname -m)"
                    case "$ARCH" in
                      x86_64)  ETC_ARCH=amd64 ;;
                      aarch64) ETC_ARCH=arm64 ;;
                      *) echo "Unsupported arch: $ARCH"; exit 1 ;;
                    esac

                    URL="https://github.com/etcd-io/etcd/releases/download/$VER/etcd-$VER-linux-$ETC_ARCH.tar.gz"
                    echo "⬇️  Fetching etcdctl from $URL"
                    # simple retry loop for flaky DNS/egress
                    for i in 1 2 3; do
                      if curl -fsSL "$URL" -o /tmp/etcd.tgz; then break; fi
                      echo "curl failed (attempt $i), retrying..." >&2
                      sleep 2
                    done
                    tar -xzf /tmp/etcd.tgz -C /tmp
                    cp "/tmp/etcd-$VER-linux-$ETC_ARCH/etcdctl" /usr/local/bin/etcdctl
                    chmod +x /usr/local/bin/etcdctl
                    etcdctl version

                    echo "⏱️  Waiting for etcd to be healthy..."
                    until etcdctl --endpoints="$EP" endpoint health >/dev/null 2>&1; do sleep 2; done

                    echo "🔐 Checking auth status..."
                    if etcdctl --endpoints="$EP" auth status -w json | grep -q '"enabled":true'; then
                      echo "Auth already enabled."
                    else
                      echo "👑 Creating root (if needed) & enabling auth..."
                      etcdctl --endpoints="$EP" user add root --interactive=false --new-user-password="$ROOT_PASS" || true
                      # enable can be momentarily racy; retry a few times
                      for j in 1 2 3; do
                        etcdctl --endpoints="$EP" auth enable && break || sleep 1
                      done
                    fi

                    ROOT="--user=root:$ROOT_PASS"

                    echo "👤 Ensure 'apisix' role exists..."
                    etcdctl --endpoints="$EP" $ROOT role add apisix 2>/dev/null || true

                    echo "🔏 Ensure 'apisix' role has RW on /apisix/ ..."
                    etcdctl --endpoints="$EP" $ROOT role grant-permission --prefix=true apisix readwrite /apisix/ 2>/dev/null || true

                    echo "👤 Ensure 'apisix' user exists..."
                    etcdctl --endpoints="$EP" $ROOT user add apisix --interactive=false --new-user-password="$APISIX_PASS" 2>/dev/null || true

                    echo "🔗 Ensure 'apisix' user has 'apisix' role..."
                    etcdctl --endpoints="$EP" $ROOT user grant-role apisix apisix 2>/dev/null || true

                    echo "✅ Final auth status (must be enabled):"
                    etcdctl --endpoints="$EP" $ROOT auth status -w json | grep -q '"enabled":true'
      YAML

      # Wait for the Job to complete
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n etcd wait --for=condition=complete job/etcd-auth-bootstrap --timeout=180s

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install Policy Reporter..."
        sudo helm install policy-reporter policy-reporter/policy-reporter \
          -n policy-reporter --create-namespace \
          --set ui.enabled=true \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml && break

        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install Policy Reporter after $RETRIES attempts." >&2
        exit 1
      fi

      echo "📦 Adding Helm repos for APISIX..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add apisix https://charts.apiseven.com --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      cat >/tmp/apisix-plugins.yaml <<'YAML'
      apisix:
        enableIPv6: false

        # Explicitly enable the plugins you want available
        plugins:
          - api-breaker
          - authz-keycloak
          - cors
          - echo
          - openid-connect
          - serverless-pre-function
          - opentelemetry
          - prometheus
          - proxy-rewrite
          - response-rewrite
          - real-ip
          - client-control

        # Per-plugin settings
        pluginAttrs:
          opentelemetry:
            collector:
              # OTLP/HTTP endpoint on your Linkerd Jaeger collector
              address: otel-collector.observability.svc.cluster.local:4318
      YAML

      echo "🚀 Installing APISIX Gateway and Dashboard..."
      sudo helm upgrade --install apisix apisix/apisix \
        --version 2.10.1 \
        --namespace apisix \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -f /tmp/apisix-plugins.yaml \
        --set etcd.enabled=false \
        --set externalEtcd.host[0]="http://etcd.etcd.svc.cluster.local:2379" \
        --set externalEtcd.user="apisix" \
        --set-string externalEtcd.password="$APISIX_ETCD_PASS" \
        --set-string externalEtcd.user=apisix \
        --set externalEtcd.tls.enabled=false \
        --set config.etcd.prefix="/apisix" \
        --set config.etcd.timeout=30 \
        --set config.etcd.user="apisix" \
        --set apisix.deployment.role=traditional \
        --set apisix.deployment.role_traditional.config_provider=etcd \
        --set apisix.enableIPv6=false \
        --set apisix.podAnnotations."linkerd\.io/inject"="disabled" \
        --set replicaCount=2 \
        --set config.nginx_config.http_listen[0]="0.0.0.0:9080" \
        --set config.nginx_config.ssl.listen[0]="0.0.0.0:9443" \
        --set config.nginx_config.stream_proxy.tcp="[]" \
        --set config.nginx_config.stream_proxy.udp="[]" \
        --set-string config.nginx_config.http.proxy_buffer_size="256k" \
        --set-string config.nginx_config.http.proxy_buffers="16 256k" \
        --set-string config.nginx_config.http.proxy_busy_buffers_size="512k" \
        --set-string config.nginx_config.http.client_header_buffer_size="64k" \
        --set-string config.nginx_config.http.large_client_header_buffers="8 64k" \
        --set-string config.nginx_config.http_configuration_snippet='proxy_buffer_size 256k; proxy_buffers 16 256k; proxy_busy_buffers_size 512k; client_header_buffer_size 64k; large_client_header_buffers 8 64k;' \
        --set ingress-controller.enabled=true \
        --set ingress-controller.replicaCount=1 \
        --set ingress-controller.config.provider.type=apisix \
        --set ingress-controller.config.apisix.serviceNamespace=apisix 

        NAMESPACE="apisix"
        CONFIGMAP_NAME="apisix"
        KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
        TMP_FILE="$HOME/disable-ipv6-apisix.yaml"

        # 1) Grab the apisix etcd password from the apisix namespace secret
        APISIX_ETCD_PASS="$(
          sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" \
            get secret etcd-apisix -o jsonpath='{.data.etcd-password}' 2>/dev/null | base64 -d
        )"

        # Fallback: if not in apisix ns (shouldn’t happen now), pull from etcd ns
        if [ -z "$APISIX_ETCD_PASS" ]; then
          APISIX_ETCD_PASS="$(
            sudo kubectl --kubeconfig "$KUBECONFIG" -n etcd \
              get secret etcd-apisix -o jsonpath='{.data.etcd-password}' 2>/dev/null | base64 -d
          )"
        fi

        if [ -z "$APISIX_ETCD_PASS" ]; then
          echo "❌ Could not read etcd password from secret 'etcd-apisix'." >&2
          exit 1
        fi

        echo "📦 Exporting current config..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get configmap "$CONFIGMAP_NAME" \
          -o jsonpath='{.data.config\.yaml}' > "$TMP_FILE"

        # 2) Patch config: disable IPv6, set etcd auth, restrict admin API, and trust HAProxy for real client IP
        echo "🛠 Patching config (IPv6 + etcd + admin allowlist + real IP trust)..."

        sudo yq -i '
          .apisix.enable_ipv6 = false
          | .etcd.host = ["http://etcd.etcd.svc.cluster.local:2379"]
          | .etcd.prefix = "/apisix"
          | .etcd.user = "apisix"
          | .plugin_attr.opentelemetry.set_ngx_var = true
          | .deployment.admin.allow_admin = [
              "127.0.0.1/32",
              "10.42.0.0/16",
              "10.0.0.0/24"
            ]
          | .nginx_config.http.real_ip_header = "X-Forwarded-For"
          | .nginx_config.http.real_ip_recursive = "on"
          | .nginx_config.http.enable_access_log = true
          | .nginx_config.http.access_log = "/dev/stdout"
          | .nginx_config.http.access_log_format = "{\"time\":\"$time_iso8601\",\"traceparent\":\"$opentelemetry_context_traceparent\",\"trace_id\":\"$opentelemetry_trace_id\",\"span_id\":\"$opentelemetry_span_id\",\"remote_addr\":\"$remote_addr\",\"x_forwarded_for\":\"$http_x_forwarded_for\",\"x_forwarded_host\":\"$http_x_forwarded_host\",\"x_forwarded_proto\":\"$http_x_forwarded_proto\",\"x_real_ip\":\"$http_x_real_ip\",\"x_client_ip\":\"$http_x_client_ip\",\"user_agent\":\"$http_user_agent\",\"x_user_email\":\"$http_x_user_email\",\"x_user_id\":\"$http_x_user_id\",\"x_user_issuer\":\"$http_x_user_issuer\",\"x_user_username\":\"$http_x_user_username\",\"x_gravitee_request_id\":\"$http_x_gravitee_request_id\",\"x_gravitee_transaction_id\":\"$http_x_gravitee_transaction_id\",\"host\":\"$host\",\"scheme\":\"$scheme\",\"method\":\"$request_method\",\"uri\":\"$uri\",\"status\":\"$status\",\"request_time\":\"$request_time\",\"upstream_status\":\"$upstream_status\",\"upstream_response_time\":\"$upstream_response_time\"}"
          | .nginx_config.http.access_log_format_escape = "json"
          | .nginx_config.http.proxy_buffer_size = "256k"
          | .nginx_config.http.proxy_buffers = "16 256k"
          | .nginx_config.http.proxy_busy_buffers_size = "512k"
          | .nginx_config.http.client_header_buffer_size = "64k"
          | .nginx_config.http.large_client_header_buffers = "8 64k"
          | .nginx_config.http_configuration_snippet = "proxy_buffer_size 256k; proxy_buffers 16 256k; proxy_busy_buffers_size 512k; client_header_buffer_size 64k; large_client_header_buffers 8 64k;"
          | .nginx_config.http.real_ip_recursive style="double"
          | .nginx_config.http.real_ip_from = ["10.0.0.10/32","10.0.0.1/32","10.0.0.0/24","10.42.0.0/16"]
        ' "$TMP_FILE"

        echo "🔎 real_ip_recursive in patched config:"
        grep -n 'real_ip_recursive' "$TMP_FILE"

        # Secret value (use env-injection so special chars are safe)
        printf '%s' "$APISIX_ETCD_PASS" \
          | sudo yq -i '.etcd.password = load_str("/dev/stdin")' "$TMP_FILE"
        
        # 3) Apply the updated ConfigMap
        echo "🚀 Updating ConfigMap..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" create configmap "$CONFIGMAP_NAME" \
          --from-file=config.yaml="$TMP_FILE" --dry-run=client -o yaml | \
          sudo kubectl --kubeconfig "$KUBECONFIG" apply -f -

        # (Optional) Show the etcd section we just wrote
        echo "🔎 New etcd section in config.yaml:"
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get cm "$CONFIGMAP_NAME" \
          -o jsonpath='{.data.config\.yaml}' | sed -n '/^etcd:/,/^[^[:space:]]/p'

        # 4) Restart APISIX so it picks up the new config
        echo "🔥 Restarting APISIX pod(s)..."
        sudo kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" delete pod -l app.kubernetes.io/name=apisix

        echo "✅ IPv6 disabled, etcd auth configured, APISIX restarting."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch service apisix-gateway --namespace apisix --type 'merge'         -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.112", "externalTrafficPolicy": "Local"}}'

      RETRIES=5
      DELAY=5

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to install APISIX Dashboard..."
        sudo helm upgrade --install apisix-dashboard apisix/apisix-dashboard \
          --namespace apisix \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml \
          --set replicaCount=1 \
          --set config.conf.etcd.endpoints[0]="http://etcd.etcd.svc.cluster.local:2379" \
          --set config.conf.etcd.username="apisix" \
          --set-string config.conf.etcd.password="$APISIX_ETCD_PASS" && break
        
        echo "Helm install failed. Retrying in $DELAY seconds..."
        sleep $DELAY
      done

      if [[ $i -eq $RETRIES ]]; then
        echo "❌ Failed to install APISIX Dashboard after $RETRIES attempts." >&2
        exit 1
      fi     

      echo "⏳ Waiting for APISIX components..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-ingress-controller -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix-dashboard -n apisix
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/apisix -n apisix

      echo "🚀 Deploying OAuth2 Proxy..."
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: apisix
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://apisix-dashboard.apisix.svc.cluster.local
                  - --email-domain=*
                  - --cookie-secret=${OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${GATEWAY_MANAGER_OAUTH2_CLIENT_ID}
                  - --client-secret=${GATEWAY_MANAGER_OAUTH2_CLIENT_SECRET}
                  - --redirect-url=https://gateway-manager.teleport.app.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --allowed-group=${GITHUB_ORG}:k8s_cluster_admins
      EOF

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: apisix
        annotations:
          teleport.dev/name: "apisix-external-gateway"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "gateway-manager.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "APISIX External Gateway"
        labels:
          app: apisix-external-gateway
          app.kubernetes.io/name: apisix-external-gateway
          app.kubernetes.io/component: apisix-external-gateway
          teleport.dev/enroll: "true"
      spec:
        ports:
          - port: 80
            targetPort: 4180
        type: LoadBalancer
        loadBalancerIP: 10.0.0.111
        selector:
          app: oauth2-proxy
      EOF

      # --- Enable real client IP extraction everywhere ---------------------------
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: real-ip-global
        namespace: apisix
      spec:
        plugins:
          - name: real-ip
            enable: true
            config:
              source: X-Forwarded-For
              recursive: true
              trusted_addresses:
                - "10.0.0.10/32"     # pfSense/HAProxy internal VIP (if that’s what APISIX sees)
                - "10.0.0.1/32"      # pfSense LAN IP (if that’s what APISIX sees)
                - "10.0.0.0/24"      # (optional) node LAN subnet; keep if unsure
                - "10.42.0.0/16"     # pod CIDR so Linkerd sidecar is trusted
      EOF

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: opentelemetry-global
        namespace: apisix
      spec:
        plugins:
          - name: opentelemetry
            enable: true
            config:
              # Always sample while you validate. You can switch to trace_id_ratio later.
              sampler:
                name: always_on
              # Point at your Linkerd Jaeger collector (OTLP/HTTP).
              collector:
                address: otel-collector.observability.svc.cluster.local:4318
              # Optional but helpful: add resource attributes so traces are labeled nicely.
              resource:
                service.name: apisix-gateway
                service.namespace: apisix
      EOF

      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: apisix.apache.org/v2
      kind: ApisixGlobalRule
      metadata:
        name: trace-context-global
        namespace: apisix
      spec:
        plugins:
          - name: proxy-rewrite
            enable: true
            config:
              headers:
                Traceparent: "$opentelemetry_context_traceparent"
                Tracestate: "$http_tracestate"
                Baggage: "$http_baggage"
                X-Trace-Id: "$opentelemetry_trace_id"
                X-Span-Id: "$opentelemetry_span_id"
                X-Traceparent: "$opentelemetry_context_traceparent"
                X-Tracestate: "$http_tracestate"
                X-Baggage: "$http_baggage"
      EOF

  - path: /etc/systemd/system/install-apisix-rancher.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install APISIX Gateway, OAuth2 Proxy, Rancher
      After=k8s-addons.service
      Requires=k8s-addons.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/60-install-apisix-rancher.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/70-gpu.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      echo "⚙️ Labeling node for GPU support..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu         nvidia.com/gpu.present=true         nvidia.com/gpu=1 --overwrite

      echo "📥 Installing NVIDIA Helm repos..."
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvdp https://nvidia.github.io/k8s-device-plugin --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add nvidia https://helm.ngc.nvidia.com/nvidia --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi
      
      sudo helm repo update

      echo "📥 Creating nvidia namespace..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace nvidia || true
      sudo kubectl annotate namespace nvidia field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml

      # echo "📦 Creating GPU time-slicing config..."
      # cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      # apiVersion: v1
      # kind: ConfigMap
      # metadata:
      #   name: time-slicing-config
      #   namespace: nvidia
      # data:
      #   any: |-
      #     version: v1
      #     flags:
      #       migStrategy: none
      #     sharing:
      #       timeSlicing:
      #         renameByDefault: true
      #         resources:
      #           - name: nvidia.com/gpu
      #             replicas: 4
      # EOF

      echo "🚀 Installing GPU Operator..."
      sudo helm upgrade -i gpu-operator nvidia/gpu-operator \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        -n nvidia \
        --wait \
        --version=${NVIDIA_HELM_CHART_VERSION} \
        --set driver.enabled=false \
        --set validator.driver.env[0].name=HOST_ROOT \
        --set validator.driver.env[0].value=/host \
        --set toolkit.env[0].name=CONTAINERD_SOCKET \
        --set toolkit.env[0].value="/run/k3s/containerd/containerd.sock" \
        --set devicePlugin.env[0].name=HOST_ULIMIT \
        --set-string devicePlugin.env[0].value="1048576" 

      # echo "🔧 Patching GPU Operator default config..."
      # sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch clusterpolicies.nvidia.com/cluster-policy         \
      #     -n gpu-operator --type merge        \
      #     -p '{"spec": {"devicePlugin": {"config": {"name": "time-slicing-config", "default": "any"}}}}'

  - path: /etc/systemd/system/gpu.service
    permissions: '0644'
    content: |
      [Unit]
      Description=GPU Operator Bootstrap
      After=install-apisix-rancher.service
      Requires=install-apisix-rancher.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/70-gpu.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/80-post-install.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /root/.bashrc && echo "export KUBECONFIG=/etc/rancher/rke2/rke2.yaml" >> /home/ubuntu/.bashrc

      # adding apisix routes for linkerd and jaeger + oauth2-proxy alpha config + mounts
      cat << 'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: apisix-ingress-controller
      rules:
        - apiGroups: ["apisix.apache.org"]
          resources:
            - apisixroutes
            - apisixpluginconfigs
            - apisixconsumers
            - apisixclusterconfigs
          verbs: ["get", "list", "watch"]
        - apiGroups: [""]
          resources: ["services", "endpoints", "pods", "namespaces"]
          verbs: ["get", "list", "watch"]
        - apiGroups: ["networking.k8s.io"]
          resources: ["ingresses", "ingressclasses"]
          verbs: ["get", "list", "watch"]
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oauth2-proxy
        template:
          metadata:
            labels:
              app: oauth2-proxy
          spec:
            containers:
              - name: oauth2-proxy
                image: quay.io/oauth2-proxy/oauth2-proxy:v7.12.0
                ports:
                  - containerPort: 4180
                args:
                  - --provider=github
                  - --http-address=0.0.0.0:4180
                  - --upstream=http://linkerd-web-proxy.linkerd-viz.svc.cluster.local
                  - --email-domain=*
                  - --cookie-secret=${LINKERD_OAUTH2_PROXY_COOKIE_SECRET}
                  - --client-id=${LINKERD_CLIENT_ID}
                  - --client-secret=${LINKERD_CLIENT_SECRET}
                  - --redirect-url=https://linkerd.teleport.app.${RANCHER_DOMAIN}/oauth2/callback
                  - --scope=user:email,read:org
                  - --cookie-secure=true
                  - --set-authorization-header=true
                  - --pass-authorization-header=true
                  - --allowed-group=${GITHUB_ORG}:linkerd_admins
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oauth2-proxy
        namespace: linkerd-viz
        annotations:
          teleport.dev/name: "linkerd-gui"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "linkerd.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "linkerd-gui"
        labels:
          app: linkerd
          app.kubernetes.io/name: linkerd
          app.kubernetes.io/component: linkerd
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: oauth2-proxy
        ports:
          - name: http
            port: 80
            targetPort: 4180
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: linkerd-web-proxy
        template:
          metadata:
            labels:
              app: linkerd-web-proxy
          spec:
            containers:
              - name: nginx
                image: nginx:stable
                ports:
                  - containerPort: 80
                volumeMounts:
                  - name: nginx-config
                    mountPath: /etc/nginx/nginx.conf
                    subPath: nginx.conf
            volumes:
              - name: nginx-config
                configMap:
                  name: linkerd-web-proxy-config
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: linkerd-web-proxy-config
        namespace: linkerd-viz
      data:
        nginx.conf: |
          events {}

          http {
            map $http_upgrade $origin_override {
              default     "";
              websocket   "http://localhost";
            }

            server {
              listen 80;

              access_log /var/log/nginx/access.log;
              error_log  /var/log/nginx/error.log debug;

              location / {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                proxy_set_header Origin $origin_override;

                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
              }

              location /api/tap {
                proxy_pass http://web.linkerd-viz.svc.cluster.local:8084;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                # 🔥 Remove Origin entirely to bypass CheckOrigin() on /api/tap
                proxy_set_header Origin "";
              }
            }
          }
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: linkerd-web-proxy
        namespace: linkerd-viz
      spec:
        selector:
          app: linkerd-web-proxy
        ports:
          - name: http
            port: 80
            targetPort: 80
      EOF
      # end apisix routes for linkerd and jaeger

      VAULT_OIDC_SECRET=$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c32)

      sudo kubectl get secret tls-rancher --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system -o yaml | \
        sed 's/namespace: cattle-system/namespace: vault/' | \
        sudo kubectl apply --kubeconfig=/etc/rancher/rke2/rke2.yaml -f -

      # installing vault
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Secret
      metadata:
        name: gcp-service-account
        namespace: vault
      type: Opaque
      data:
        key.json: ${GOOGLE_CREDENTIALS}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-id
        namespace: vault
      data:
        PROJECT_ID: ${GCP_PROJECT_ID}
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: gcp-project-region
        namespace: vault
      data:
        PROJECT_REGION: ${GCP_REGION}
      ---
      # Grant cluster-admin to "default" in vault (matches your previous working state)
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: dex-crd-manager
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      subjects:
      - kind: ServiceAccount
        name: default
        namespace: vault
      ---
      # ALSO grant cluster-admin to vault-auth (so both the pod & the Job can act cluster-wide)
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: vault-auth
        namespace: vault
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: vault-auth-admin
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      subjects:
      - kind: ServiceAccount
        name: vault-auth
        namespace: vault
      ---
      # GCP KMS unseal credentials
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-unseal-gcp-creds
        namespace: vault
      type: Opaque
      data:
        vault-unseal-sa.json: ${VAULT_KEY_ACCOUNT}
      ---
      # Vault OIDC client credentials (using Dex)
      apiVersion: v1
      kind: Secret
      metadata:
        name: vault-oidc-creds
        namespace: vault
      type: Opaque
      stringData:
        client_id: "vault"
        client_secret: "$VAULT_OIDC_SECRET"
        redirect_uri: "https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback"
      ---
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: vault-creds-pvc
        namespace: vault
      spec:
        accessModes:
          - ReadWriteMany
        resources:
          requests:
            storage: 1Gi
        storageClassName: longhorn
      ---
      # Dex configuration (GitHub connector and Vault client)
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: dex-config
        namespace: vault
      data:
        config.docker.yaml: |
          issuer: https://vault-dex.teleport.app.${RANCHER_DOMAIN}
          storage:
            type: kubernetes
            config:
              inCluster: true
          web:
            http: 0.0.0.0:5556

          staticClients:
          - id: "vault"
            redirectURIs:
            - "https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback"
            name: "Vault UI"
            secret: "$VAULT_OIDC_SECRET"

          connectors:
          - type: github
            id: github
            name: GitHub
            config:
              clientID: ${VAULT_OIDC_CLIENT_ID}
              clientSecret: ${VAULT_OIDC_CLIENT_SECRET}
              redirectURI: https://vault-dex.teleport.app.${RANCHER_DOMAIN}/callback
              orgs:
              - name: dotcomrow
                teams:
                - vault_admins
              scopes:
              - read:org
              loadAllGroups: true
              teamNameField: slug
      ---
      # Dex Deployment
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: dex
        namespace: vault
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: dex
        template:
          metadata:
            labels:
              app: dex
          spec:
            containers:
            - name: dex
              image: ghcr.io/dexidp/dex:v2.37.0
              volumeMounts:
              - name: config
                mountPath: /etc/dex/config.docker.yaml
                subPath: config.docker.yaml
              ports:
              - containerPort: 5556
            volumes:
            - name: config
              configMap:
                name: dex-config
      ---
      # Dex Service (LoadBalancer as before)
      apiVersion: v1
      kind: Service
      metadata:
        name: dex
        namespace: vault
        annotations:
          teleport.dev/name: "vault-dex"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "vault-dex.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "Vault DEX Service"
        labels:
          app: vault-dex
          app.kubernetes.io/name: vault-dex
          app.kubernetes.io/component: vault-dex
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: dex
        type: LoadBalancer
        loadBalancerIP: 10.0.0.122
        ports:
        - name: http
          port: 5556
          targetPort: 5556
      ---
      # APISIXRoute for Dex (optional; harmless even with LB)
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: dex-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: dex-gui
          match:
            hosts:
            - "vault-dex.teleport.app.${RANCHER_DOMAIN}"
            paths:
            - /*
          backends:
          - serviceName: dex
            servicePort: http
      ---
      # Vault production config
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-config
        namespace: vault
      data:
        vault.hcl: |
          disable_mlock = true
          cluster_addr  = "http://vault.vault.svc.cluster.local:8201"
          api_addr      = "https://vault.teleport.app.${RANCHER_DOMAIN}"

          seal "gcpckms" {
            project     = "${GCP_PROJECT_ID}"
            region      = "${GCP_REGION}"
            key_ring    = "${VAULT_KMS_KEY_RING}"
            crypto_key  = "vault-unseal"
            credentials = "/etc/vault/vault-unseal-sa.json"
          }

          listener "tcp" {
            address     = "0.0.0.0:8200"
            tls_disable = 1
          }

          storage "file" {
            path = "/vault/data"
          }

          ui = true
      ---
      # Vault StatefulSet (runs as vault-auth which has cluster-admin for bootstrap)
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: vault
        namespace: vault
        labels:
          app: vault
          platform.suncoast.systems/vpa-exclude: "true"
        annotations:
          platform.suncoast.systems/vpa-exclude: "true"
      spec:
        serviceName: vault
        replicas: 1
        selector:
          matchLabels:
            app: vault
        template:
          metadata:
            labels:
              app: vault
          spec:
            serviceAccountName: vault-auth
            dnsPolicy: "None"
            dnsConfig:
              nameservers:
                - 10.43.0.10
                - 1.1.1.1
              options:
                - name: ndots
                  value: "2"
            securityContext:
              fsGroup: 1000
            initContainers:
              - name: install-utils
                image: alpine/k8s:${KUBECTL_IMAGE_VERSION}
                command: ["sh", "-c"]
                args:
                  - cp /usr/bin/kubectl /shared/kubectl && chmod +x /shared/kubectl
                resources:
                  requests:
                    cpu: 50m
                    memory: 64Mi
                  limits:
                    cpu: 200m
                    memory: 128Mi
                volumeMounts:
                  - name: shared-utils
                    mountPath: /shared
            containers:
              - name: vault
                image: hashicorp/vault:${VAULT_VERSION}
                resources:
                  requests:
                    cpu: 200m
                    memory: 1Gi
                  limits:
                    cpu: 500m
                    memory: 2Gi
                env:
                  - name: VAULT_ADDR
                    value: "http://127.0.0.1:8200"
                  - name: VAULT_NAMESPACE
                    value: "root"
                  - name: TFC_API_TOKEN
                    value: "${TFC_API_TOKEN}"
                  - name: TFC_EXTERNAL_APPS_VARSET_ID
                    value: "${TFC_EXTERNAL_APPS_VARSET_ID}"
                  - name: TFC_EXTERNAL_APPS_VARSET_NAME
                    value: "${TFC_EXTERNAL_APPS_VARSET_NAME}"
                  - name: TFC_ORGANIZATION
                    value: "${TFC_ORGANIZATION}"
                  - name: TFC_VAULT_TOKEN_VAR_KEY
                    value: "${TFC_VAULT_TOKEN_VAR_KEY}"
                  - name: TFC_API_BASE_URL
                    value: "${TFC_API_BASE_URL}"
                volumeMounts:
                  - name: config
                    mountPath: /vault/config/vault.hcl
                    subPath: vault.hcl
                  - name: data
                    mountPath: /vault/data
                  - name: gcp-creds
                    mountPath: /etc/vault
                    readOnly: true
                  - name: oidc-creds
                    mountPath: /etc/vault-oidc
                    readOnly: true
                  - name: shared-utils
                    mountPath: /usr/local/bin/kubectl
                    subPath: kubectl
                  - name: shared-data
                    mountPath: /vault/creds-data
                  - name: gcp-project-id
                    mountPath: /config/gcp-project-id
                    readOnly: true
                  - name: gcp-project-region
                    mountPath: /config/gcp-project-region
                    readOnly: true
                  - name: script
                    mountPath: /opt/configscript
                    readOnly: true
                  - name: script-tmp
                    mountPath: /opt/scripts
                command: ["/bin/sh"]
                args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]
                ports:
                  - name: vault
                    containerPort: 8200
                # --- Probes (minimal addition) ---
                startupProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true&sealedcode=503&uninitcode=501
                    port: 8200
                  failureThreshold: 60
                  periodSeconds: 5
                  timeoutSeconds: 5
                livenessProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true
                    port: 8200
                  failureThreshold: 3
                  periodSeconds: 10
                  timeoutSeconds: 5
                readinessProbe:
                  httpGet:
                    path: /v1/sys/health?standbyok=true
                    port: 8200
                  failureThreshold: 2
                  periodSeconds: 5
                  timeoutSeconds: 5
            volumes:
              - name: config
                configMap:
                  name: vault-config
              - name: gcp-creds
                secret:
                  secretName: vault-unseal-gcp-creds
              - name: oidc-creds
                secret:
                  secretName: vault-oidc-creds
              - name: shared-utils
                emptyDir: {}
              - name: shared-data
                persistentVolumeClaim:
                  claimName: vault-creds-pvc
              - name: gcp-project-id
                configMap:
                  name: gcp-project-id
              - name: gcp-project-region
                configMap:
                  name: gcp-project-region
              - name: script
                configMap:
                  name: vault-init-script
              - name: script-tmp
                emptyDir: {}
        volumeClaimTemplates:
          - metadata:
              name: data
            spec:
              accessModes: ["ReadWriteOnce"]
              resources:
                requests:
                  storage: 200Mi
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-init-script
        namespace: vault
      data:
        run.sh: |
          #!/bin/sh
          # Minimal/targeted changes only: robust state detection + one-time restart if sealed.
          set -e

          export VAULT_ADDR="\$VAULT_ADDR"

          SEAL_JSON=/etc/vault/vault-unseal-sa.json
          CONF=/vault/config/vault.hcl

          echo "Preflight: waiting for \$SEAL_JSON and \$CONF ..."
          i=0
          while [ ! -s "\$SEAL_JSON" ] || [ ! -s "\$CONF" ]; do
            i=\$((i+1)); if [ \$i -gt 60 ]; then echo "❌ Seal creds or config missing"; exit 1; fi
            sleep 1
          done
          echo "Preflight OK."

          vault server -config="\$CONF" &
          VAULT_PID=\$!
          trap 'kill \$VAULT_PID 2>/dev/null || true' EXIT
          # Force local listener & bound call time; never hang the loop
          read_status() {
            timeout 2 sh -lc 'vault status -address=http://127.0.0.1:8200 -format=json' 2>/dev/null || true
          }

          # Match JSON robustly (allow spaces around the colon)
          is_initialized() { 
            read_status | grep -Eq '"initialized"[[:space:]]*:[[:space:]]*true'; 
          }
          is_uninitialized() { 
            read_status | grep -Eq '"initialized"[[:space:]]*:[[:space:]]*false'; 
          }
          is_sealed() { 
            read_status | grep -Eq '"sealed"[[:space:]]*:[[:space:]]*true'; 
          }
          is_unsealed() { 
            read_status | grep -Eq '"sealed"[[:space:]]*:[[:space:]]*false'; 
          }

          echo "Waiting for Vault HTTP listener..."
          for _ in \$(seq 1 60); do
            s="\$(read_status)"
            [ -n "\$s" ] && break
            sleep 1
          done

          if is_uninitialized; then
            echo "Vault UNINITIALIZED -> operator init (recovery-shares=1)"
            vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json > /vault/data/init.json
            sleep 3
          fi

          # If sealed for a while (with creds present), restart once to kick KMS
          if is_sealed; then
            echo "Vault SEALED; waiting briefly for auto-unseal..."
            for _ in \$(seq 1 30); do
              is_unsealed && break
              sleep 2
            done
            if ! is_unsealed; then
              echo "Still SEALED; restarting Vault once to re-read KMS seal..."
              kill \$VAULT_PID
              wait \$VAULT_PID || true
              vault server -config="\$CONF" &
              VAULT_PID=\$!
              sleep 5
            fi
          fi

          echo "Waiting for Vault to become unsealed..."
          for _ in \$(seq 1 120); do
            if is_unsealed; then break; fi
            if is_uninitialized; then echo "❌ Unexpected UNINITIALIZED after init"; exit 1; fi
            sleep 2
          done
          if ! is_unsealed; then
            echo "❌ Vault did not unseal in time; deleting this pod to retry cleanly."

            # Discover namespace & pod name without new env vars:
            NS="$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace 2>/dev/null || echo vault)"
            POD="$HOSTNAME"
            if [ -z "$POD" ]; then
              POD="$(cat /etc/hostname 2>/dev/null || true)"
            fi

            # Best-effort self-delete (don’t block the container exit)
            if [ -n "$POD" ] && command -v kubectl >/dev/null 2>&1; then
              kubectl -n "$NS" delete pod "$POD" --wait=false || true
            else
              echo "WARN: pod name not found; skipping self-delete."
            fi

            # Exit non-zero so the container stops if deletion didn’t happen
            sleep 2
            exit 1
          fi

          echo "✅ Vault is unsealed"

          # Install tools used by bootstrap follow-up steps.
          apk add --no-cache jq wget curl >/dev/null 2>&1 || true

          # ---- Existing bootstrap (kept intact) ----

          # Initialize if necessary (convenience; state is already validated)
          if [ ! -f /vault/data/init.json ]; then
            vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json > /vault/data/init.json
          fi

          # Wait for Vault to be unsealed and ready (jq now available)
          until vault status -format=json | jq -e '.sealed == false'; do
            echo "Waiting for Vault to be unsealed..."
            sleep 2
          done

          # Admin policy
          cat <<EOF > /vault/data/admin-policy.hcl
          path "*" { capabilities = ["create","read","update","delete","list","sudo"] }
          EOF
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write admin /vault/data/admin-policy.hcl

          # Enable auth methods (idempotent)
          for m in oidc kubernetes approle; do
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth list -format=json | grep -q "\"\$m/\"" || \
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault auth enable "\$m"
          done

          # Kubernetes auth config (use long-lived SA token for reviewer)
          for i in \$(seq 1 30); do
            kubectl -n vault get sa vault-auth >/dev/null 2>&1 && break
            echo "Waiting for vault-auth service account..."
            sleep 2
          done
          cat <<EOF | kubectl apply -f -
          apiVersion: v1
          kind: Secret
          metadata:
            name: vault-auth-token
            namespace: vault
            annotations:
              kubernetes.io/service-account.name: vault-auth
          type: kubernetes.io/service-account-token
          EOF

          TOKEN_B64=""
          for i in \$(seq 1 30); do
            TOKEN_B64="\$(kubectl -n vault get secret vault-auth-token -o jsonpath='{.data.token}' 2>/dev/null || true)"
            [ -n "\$TOKEN_B64" ] && break
            echo "Waiting for vault-auth-token..."
            sleep 2
          done
          if [ -n "\$TOKEN_B64" ]; then
            if command -v base64 >/dev/null 2>&1; then
              TOKEN="\$(echo "\$TOKEN_B64" | base64 -d)"
            elif command -v openssl >/dev/null 2>&1; then
              TOKEN="\$(echo "\$TOKEN_B64" | openssl base64 -d)"
            else
              echo "No base64 decoder found; falling back to pod token"
              TOKEN=""
            fi
          else
            echo "vault-auth-token not ready; falling back to pod token"
            TOKEN=""
          fi
          if [ -z "\$TOKEN" ]; then
            TOKEN="\$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
          fi
          for i in \$(seq 1 30); do
            kubectl -n vault get cm kube-root-ca.crt >/dev/null 2>&1 && break
            echo "Waiting for kube-root-ca.crt..."
            sleep 2
          done
          kubectl -n vault get cm kube-root-ca.crt -o jsonpath='{.data.ca\.crt}' > /vault/data/k8s-ca.crt
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/config \
            token_reviewer_jwt="\$TOKEN" \
            kubernetes_host="https://\$KUBERNETES_SERVICE_HOST:\$KUBERNETES_SERVICE_PORT_HTTPS" \
            kubernetes_ca_cert=@/vault/data/k8s-ca.crt \
            disable_iss_validation=true

          # Enable KV v2 if not already mounted
          if VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault secrets list -format=json | jq -e '."secret/"' >/dev/null 2>&1; then
            echo "secret/ mount already exists; skipping enable."
          else
            VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault secrets enable -path=secret -version=2 kv
          fi

          # Seed the Teleport AVP path for the Proxmox bound_keypair bot so it
          # remains joinable after full cluster rebuilds.
          VAULT_ROOT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)"
          TELEPORT_REG_SECRET_B64="${TELEPORT_TERRAFORM_VAULT_BOT_REGISTRATION_SECRET_B64}"
          TELEPORT_REG_SECRET=""

          if [ -n "\$TELEPORT_REG_SECRET_B64" ]; then
            if command -v base64 >/dev/null 2>&1; then
              TELEPORT_REG_SECRET="\$(printf '%s' "\$TELEPORT_REG_SECRET_B64" | base64 -d 2>/dev/null || true)"
            elif command -v openssl >/dev/null 2>&1; then
              TELEPORT_REG_SECRET="\$(printf '%s' "\$TELEPORT_REG_SECRET_B64" | openssl base64 -d 2>/dev/null || true)"
            fi
          fi

          if [ -n "\$TELEPORT_REG_SECRET" ]; then
            VAULT_TOKEN="\$VAULT_ROOT_TOKEN" vault kv put -mount=secret \
              k8s-teleport-terraform-vault-bot-registration-secret value="\$TELEPORT_REG_SECRET" >/dev/null
            echo "Seeded Vault path secret/data/k8s-teleport-terraform-vault-bot-registration-secret."
          else
            echo "WARNING: TELEPORT_TERRAFORM_VAULT_BOT_REGISTRATION_SECRET is empty."
            echo "WARNING: bound_keypair bot token terraform-vault-bot-token-20260215b may fail to rejoin."
          fi

          # Policies
          cat <<EOF > /vault/data/avp-policy.hcl
          path "secret/data/*" { capabilities = ["read"] }
          EOF
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write vault-sync - <<EOF
          path "secret/data/*" { capabilities = ["create","read","update","delete"] }
          path "secret/metadata/*" { capabilities = ["read","delete","list"] }
          path "secret/*" { capabilities = ["list"] }
          EOF
          cat <<EOF | VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault policy write avp -
          path "secret/data/*" { capabilities = ["read"] }
          EOF

          # AppRole for AVP
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/approle/role/vault-sync \
            token_ttl=1h token_max_ttl=4h bind_secret_id=true secret_id_bound_cidrs=0.0.0.0/0 policies=vault-sync

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault read -field=role_id auth/approle/role/vault-sync/role-id > /vault/creds-data/role_id.txt
          echo >> /vault/creds-data/role_id.txt
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write -f -field=secret_id auth/approle/role/vault-sync/secret-id > /vault/creds-data/secret_id.txt
          echo >> /vault/creds-data/secret_id.txt

          # Store root token (idempotent)
          kubectl -n vault create secret generic vault-root-token \
            --from-literal=VAULT_TOKEN=\$(jq -r '.root_token' /vault/data/init.json) \
            --dry-run=client -o yaml | kubectl apply -f -

          # Push/update Vault root token into Terraform Cloud variable set for external app runs.
          if [ -n "\$TFC_API_TOKEN" ]; then
            VAULT_ROOT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)"
            TFC_VAR_KEY="\$TFC_VAULT_TOKEN_VAR_KEY"
            [ -n "\$TFC_VAR_KEY" ] || TFC_VAR_KEY="VAULT_TOKEN"
            TFC_API_URL="\$TFC_API_BASE_URL"
            [ -n "\$TFC_API_URL" ] || TFC_API_URL="https://app.terraform.io/api/v2"
            TFC_VARSET_ID="\$TFC_EXTERNAL_APPS_VARSET_ID"
            TFC_SYNC_OK="false"
            TFC_VARSET_NAME_RAW="\$TFC_EXTERNAL_APPS_VARSET_NAME"

            if [ -z "\$TFC_VARSET_ID" ] && [ -n "\$TFC_EXTERNAL_APPS_VARSET_NAME" ]; then
              if [ -z "\$TFC_ORGANIZATION" ]; then
                echo "ERROR: TFC_ORGANIZATION is required to resolve variable set by name."
              else
                echo "Resolving Terraform variable set ID for '\$TFC_EXTERNAL_APPS_VARSET_NAME' in organization '\$TFC_ORGANIZATION'..."
                TARGET_NAME_NORMALIZED="\$(printf '%s' "\$TFC_EXTERNAL_APPS_VARSET_NAME" | jq -Rr 'ascii_downcase | gsub(\"\\\\s+\";\" \") | gsub(\"^\\\\s+|\\\\s+$\";\"\")')"
                LOOKUP_ATTEMPT=1
                LOOKUP_MAX_ATTEMPTS=12
                while [ -z "\$TFC_VARSET_ID" ] && [ "\$LOOKUP_ATTEMPT" -le "\$LOOKUP_MAX_ATTEMPTS" ]; do
                  echo "Terraform variable-set lookup attempt \$LOOKUP_ATTEMPT/\$LOOKUP_MAX_ATTEMPTS..."
                  NEXT_URL="\$TFC_API_URL/organizations/\$TFC_ORGANIZATION/varsets?page%5Bsize%5D=100"
                  while [ -n "\$NEXT_URL" ]; do
                    RESP_FILE="/tmp/tfc-varsets-\$\$.json"
                    HTTP_CODE="\$(curl -sS \
                      -H "Authorization: Bearer \$TFC_API_TOKEN" \
                      -H "Content-Type: application/vnd.api+json" \
                      -o "\$RESP_FILE" \
                      -w "%%{http_code}" \
                      "\$NEXT_URL" || echo "000")"

                    if [ "\$HTTP_CODE" -ge 200 ] 2>/dev/null && [ "\$HTTP_CODE" -lt 300 ] 2>/dev/null; then
                      PAGE_JSON="\$(cat "\$RESP_FILE" 2>/dev/null || true)"
                      if [ -z "\$PAGE_JSON" ] || ! echo "\$PAGE_JSON" | jq -e . >/dev/null 2>&1; then
                        echo "WARNING: could not parse Terraform variable set response JSON."
                        NEXT_URL=""
                        break
                      fi

                      MATCH_IDS="\$(echo "\$PAGE_JSON" | jq -r --arg target "\$TARGET_NAME_NORMALIZED" '.data[]? | select((.attributes.name // "") | ascii_downcase | gsub("\\s+";" ") | gsub("^\\s+|\\s+$";"") == $target) | .id' 2>/dev/null || true)"
                      if [ -n "\$MATCH_IDS" ]; then
                        TFC_VARSET_ID="\$(echo "\$MATCH_IDS" | head -n1)"
                        MATCH_COUNT="\$(echo "\$MATCH_IDS" | wc -l | tr -d ' ')"
                        [ -n "\$MATCH_COUNT" ] || MATCH_COUNT=0
                        if [ "\$MATCH_COUNT" -gt 1 ]; then
                          echo "WARNING: multiple variable sets matched '\$TFC_EXTERNAL_APPS_VARSET_NAME'; using \$TFC_VARSET_ID."
                        fi
                        break
                      fi

                      NEXT_URL="\$(echo "\$PAGE_JSON" | jq -r '.links.next // empty')"
                      if [ -n "\$NEXT_URL" ] && ! echo "\$NEXT_URL" | grep -Eq '^https?://'; then
                        NEXT_URL="\$TFC_API_URL\$NEXT_URL"
                      fi
                    else
                      echo "WARNING: failed to list variable sets (HTTP \$HTTP_CODE) from \$NEXT_URL."
                      NEXT_URL=""
                      break
                    fi
                  done

                  if [ -n "\$TFC_VARSET_ID" ]; then
                    break
                  fi

                  if [ "\$LOOKUP_ATTEMPT" -lt "\$LOOKUP_MAX_ATTEMPTS" ]; then
                    sleep "\$((LOOKUP_ATTEMPT * 5))"
                  fi
                  LOOKUP_ATTEMPT="\$((LOOKUP_ATTEMPT + 1))"
                done
              fi
            fi

            if [ -n "\$TFC_VARSET_ID" ]; then
              echo "Syncing Vault token to Terraform variable set \$TFC_VARSET_ID (\$TFC_VAR_KEY)..."
              VARS_JSON=""
              VARS_ATTEMPT=1
              VARS_MAX_ATTEMPTS=8
              while [ "\$VARS_ATTEMPT" -le "\$VARS_MAX_ATTEMPTS" ]; do
                RESP_FILE="/tmp/tfc-vars-\$\$.json"
                HTTP_CODE="\$(curl -sS \
                  -H "Authorization: Bearer \$TFC_API_TOKEN" \
                  -H "Content-Type: application/vnd.api+json" \
                  -o "\$RESP_FILE" \
                  -w "%%{http_code}" \
                  "\$TFC_API_URL/varsets/\$TFC_VARSET_ID/relationships/vars?page%5Bsize%5D=100" || echo "000")"
                if [ "\$HTTP_CODE" -ge 200 ] 2>/dev/null && [ "\$HTTP_CODE" -lt 300 ] 2>/dev/null; then
                  VARS_JSON="\$(cat "\$RESP_FILE" 2>/dev/null || true)"
                  if [ -n "\$VARS_JSON" ] && echo "\$VARS_JSON" | jq -e . >/dev/null 2>&1; then
                    break
                  fi
                fi

                echo "WARNING: failed to list variables in Terraform variable set \$TFC_VARSET_ID (attempt \$VARS_ATTEMPT/\$VARS_MAX_ATTEMPTS, HTTP \$HTTP_CODE)."
                if [ "\$VARS_ATTEMPT" -lt "\$VARS_MAX_ATTEMPTS" ]; then
                  sleep "\$((VARS_ATTEMPT * 5))"
                fi
                VARS_ATTEMPT="\$((VARS_ATTEMPT + 1))"
              done

              if [ -n "\$VARS_JSON" ] && echo "\$VARS_JSON" | jq -e . >/dev/null 2>&1; then
                VAR_ID="\$(echo "\$VARS_JSON" | jq -r --arg key "\$TFC_VAR_KEY" '.data[]? | select(.attributes.key == $key and .attributes.category == "terraform") | .id' | head -n1)"

                if [ -n "\$VAR_ID" ]; then
                  PAYLOAD="\$(jq -cn --arg id "\$VAR_ID" --arg value "\$VAULT_ROOT_TOKEN" --arg description "Vault root token managed by srvr bootstrap." \
                    '{data:{id:$id,type:"vars",attributes:{value:$value,sensitive:true,hcl:false,description:$description}}}')"
                  PATCH_ATTEMPT=1
                  PATCH_MAX_ATTEMPTS=8
                  while [ "\$PATCH_ATTEMPT" -le "\$PATCH_MAX_ATTEMPTS" ]; do
                    HTTP_CODE="\$(curl -sS -X PATCH \
                      -H "Authorization: Bearer \$TFC_API_TOKEN" \
                      -H "Content-Type: application/vnd.api+json" \
                      -o /tmp/tfc-var-patch-\$\$.json \
                      -w "%%{http_code}" \
                      --data "\$PAYLOAD" \
                      "\$TFC_API_URL/varsets/\$TFC_VARSET_ID/relationships/vars/\$VAR_ID" || echo "000")"
                    if [ "\$HTTP_CODE" -ge 200 ] 2>/dev/null && [ "\$HTTP_CODE" -lt 300 ] 2>/dev/null; then
                      echo "Updated Terraform variable '\$TFC_VAR_KEY' in variable set \$TFC_VARSET_ID."
                      TFC_SYNC_OK="true"
                      break
                    fi
                    echo "WARNING: failed to update Terraform variable '\$TFC_VAR_KEY' in variable set \$TFC_VARSET_ID (attempt \$PATCH_ATTEMPT/\$PATCH_MAX_ATTEMPTS, HTTP \$HTTP_CODE)."
                    if [ "\$PATCH_ATTEMPT" -lt "\$PATCH_MAX_ATTEMPTS" ]; then
                      sleep "\$((PATCH_ATTEMPT * 5))"
                    fi
                    PATCH_ATTEMPT="\$((PATCH_ATTEMPT + 1))"
                  done
                else
                  PAYLOAD="\$(jq -cn --arg key "\$TFC_VAR_KEY" --arg value "\$VAULT_ROOT_TOKEN" --arg description "Vault root token managed by srvr bootstrap." \
                    '{data:{type:"vars",attributes:{key:$key,value:$value,category:"terraform",sensitive:true,hcl:false,description:$description}}}')"
                  CREATE_ATTEMPT=1
                  CREATE_MAX_ATTEMPTS=8
                  while [ "\$CREATE_ATTEMPT" -le "\$CREATE_MAX_ATTEMPTS" ]; do
                    HTTP_CODE="\$(curl -sS -X POST \
                      -H "Authorization: Bearer \$TFC_API_TOKEN" \
                      -H "Content-Type: application/vnd.api+json" \
                      -o /tmp/tfc-var-create-\$\$.json \
                      -w "%%{http_code}" \
                      --data "\$PAYLOAD" \
                      "\$TFC_API_URL/varsets/\$TFC_VARSET_ID/relationships/vars" || echo "000")"
                    if [ "\$HTTP_CODE" -ge 200 ] 2>/dev/null && [ "\$HTTP_CODE" -lt 300 ] 2>/dev/null; then
                      echo "Created Terraform variable '\$TFC_VAR_KEY' in variable set \$TFC_VARSET_ID."
                      TFC_SYNC_OK="true"
                      break
                    fi
                    echo "WARNING: failed to create Terraform variable '\$TFC_VAR_KEY' in variable set \$TFC_VARSET_ID (attempt \$CREATE_ATTEMPT/\$CREATE_MAX_ATTEMPTS, HTTP \$HTTP_CODE)."
                    if [ "\$CREATE_ATTEMPT" -lt "\$CREATE_MAX_ATTEMPTS" ]; then
                      sleep "\$((CREATE_ATTEMPT * 5))"
                    fi
                    CREATE_ATTEMPT="\$((CREATE_ATTEMPT + 1))"
                  done
                fi
              else
                echo "ERROR: failed to list variables in Terraform variable set \$TFC_VARSET_ID after retries."
              fi
            else
              echo "ERROR: Terraform variable-set sync failed: no variable set ID resolved for '\$TFC_VARSET_NAME_RAW'."
            fi

            if [ "\$TFC_SYNC_OK" != "true" ]; then
              echo "ERROR: Terraform variable-set sync did not complete successfully; forcing retry via pod restart."
              exit 1
            fi
          else
            echo "ERROR: Terraform variable-set sync skipped: missing TFC_API_TOKEN."
            exit 1
          fi

          # GCP identifiers for the follow-up job
          cat /config/gcp-project-id/PROJECT_ID > /vault/creds-data/project_id.txt
          cat /config/gcp-project-region/PROJECT_REGION > /vault/creds-data/region.txt
          echo "vault-sync-run-container" > /vault/creds-data/service_name.txt

          # ArgoCD role for AVP
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/kubernetes/role/argocd \
            bound_service_account_names=argocd-repo-server \
            bound_service_account_namespaces=argocd \
            policies=avp ttl=24h

          # OIDC config (LB should be up, but add a small wait for safety)
          DISC_URL="https://vault-dex.teleport.app.${RANCHER_DOMAIN}/.well-known/openid-configuration"
          for i in \$(seq 1 12); do
            wget -q --spider "\$DISC_URL" && break || true
            echo "Waiting for Dex discovery (\$i/12)..."; sleep 5
          done
          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/config \
            oidc_discovery_url="https://vault-dex.teleport.app.${RANCHER_DOMAIN}" \
            oidc_client_id="\$(cat /etc/vault-oidc/client_id)" \
            oidc_client_secret="\$(cat /etc/vault-oidc/client_secret)" \
            default_role="default" || true

          VAULT_TOKEN="\$(jq -r '.root_token' /vault/data/init.json)" vault write auth/oidc/role/default \
            bound_audiences="\$(cat /etc/vault-oidc/client_id)" \
            user_claim="email" \
            groups_claim="groups" \
            allowed_redirect_uris="https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/oidc/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth/oidc/default/callback,https://vault.teleport.app.${RANCHER_DOMAIN}/ui/vault/auth?with=oidc" \
            oidc_scopes="openid,email,groups" \
            policies="admin" \
            ttl="1h"

          # Follow-up Job (runs as vault-auth which is cluster-admin)
          cat <<'EOF' | kubectl apply -f -
          apiVersion: batch/v1
          kind: Job
          metadata:
            name: update-cloudrun-vault-cred
            namespace: vault
          spec:
            template:
              spec:
                serviceAccountName: vault-auth
                restartPolicy: Never
                initContainers:
                  - name: load-kubectl
                    image: alpine/k8s:${KUBECTL_IMAGE_VERSION}
                    command: ["sh","-c"]
                    args: ['cp /usr/bin/kubectl /kubectl-bin/kubectl && chmod +x /kubectl-bin/kubectl']
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /kubectl-bin
                containers:
                  - name: gcloud-update
                    image: google/cloud-sdk:slim
                    command: ["/bin/sh"]
                    args: ["-c", "cp /opt/configscript/run.sh /opt/scripts/run.sh && chmod +x /opt/scripts/run.sh && /opt/scripts/run.sh"]
                    volumeMounts:
                      - name: kubectl-bin
                        mountPath: /usr/local/bin
                      - name: gcp-creds
                        mountPath: /tmp
                        readOnly: true
                      - name: shared-creds
                        mountPath: /shared-creds
                      - name: script
                        mountPath: /opt/configscript
                        readOnly: true
                      - name: script-tmp
                        mountPath: /opt/scripts
                volumes:
                  - name: kubectl-bin
                    emptyDir: {}
                  - name: gcp-creds
                    secret:
                      secretName: gcp-service-account
                  - name: shared-creds
                    persistentVolumeClaim:
                      claimName: vault-creds-pvc
                  - name: script
                    configMap:
                      name: vault-sync-script
                  - name: script-tmp
                    emptyDir: {}
          EOF

          wait \$VAULT_PID
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-sync-script
        namespace: vault
      data:
        run.sh: |
          #!/bin/sh
          set -e

          echo "Waiting for Vault to write role_id and secret_id..."
          while [ ! -f /shared-creds/role_id.txt ] || [ ! -f /shared-creds/secret_id.txt ]; do
            sleep 2
          done

          ROLE_ID="\$(tr -d '\r\n' </shared-creds/role_id.txt)"
          SECRET_ID="\$(tr -d '\r\n' </shared-creds/secret_id.txt)"
          PROJECT_ID="\$(tr -d '\r\n' </shared-creds/project_id.txt)"
          REGION="\$(tr -d '\r\n' </shared-creds/region.txt)"
          SERVICE_NAME="\$(tr -d '\r\n' </shared-creds/service_name.txt)"

          [ -n "\$PROJECT_ID" ] && [ -n "\$REGION" ] && [ -n "\$SERVICE_NAME" ] || { echo "❌ Missing PROJECT_ID/REGION/SERVICE_NAME"; exit 1; }

          gcloud auth activate-service-account --key-file=/tmp/key.json
          gcloud config set project "\$PROJECT_ID"
          gcloud run services update "\$SERVICE_NAME" \
            --region="\$REGION" \
            --update-env-vars "VAULT_ROLE_ID=\$ROLE_ID,VAULT_SECRET_ID=\$SECRET_ID"

          SVC_URL=\$(gcloud run services describe "\$SERVICE_NAME" --region "\$REGION" --format="value(status.url)")
          [ -n "\$SVC_URL" ] || { echo "❌ Failed to get service URL"; exit 1; }

          curl -X POST -H "Authorization: Bearer \$(gcloud auth print-identity-token)" "\$SVC_URL/sync-all"

          echo "✅ Vault credentials updated successfully"

          echo "🚀 Applying App of Apps configuration..."
          kubectl apply -n argocd -f - <<EOF
          apiVersion: argoproj.io/v1alpha1
          kind: Application
          metadata:
            name: argocd-post-install-apps-repo-app
            namespace: argocd
          spec:
            project: default
            source:
              repoURL: https://github.com/dotcomrow/argocd-post-install.git
              targetRevision: prod
              path: apps
              directory:
                recurse: true
            destination:
              server: https://kubernetes.default.svc
              namespace: argocd
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
              syncOptions:
              - PrunePropagationPolicy=foreground
              - PruneLast=true
              - RespectResourceOrder=true
              retry:
                limit: 5
                backoff:
                  duration: 5s
                  factor: 2
                  maxDuration: 3m
          EOF

          echo "Removing APISIX access route to move access to Teleport"
          kubectl delete apisixroute vault-ui -n vault || true
          kubectl delete apisixroute dex-ui -n vault || true

          kubectl patch statefulset vault -n vault \
            --type='merge' \
            -p '{"spec": {"template": {"spec": {"dnsPolicy": "None", "dnsConfig": {"nameservers": ["10.43.0.10", "10.0.0.10"], "options": [{"name": "ndots", "value": "2"}]}}}}}'

          kubectl delete pod -l app=vault -n vault || true

          echo "✅ App of Apps applied."
      ---
      # Vault Service
      apiVersion: v1
      kind: Service
      metadata:
        name: vault
        namespace: vault
        annotations:
          teleport.dev/name: "vault"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "vault.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "Vault Service"
        labels:
          app: vault
          app.kubernetes.io/name: vault
          app.kubernetes.io/component: vault
          teleport.dev/enroll: "true"
      spec:
        selector:
          app: vault
        ports:
          - name: vault
            port: 8200
            targetPort: vault
      ---
      # APISIXRoute for Vault UI
      apiVersion: apisix.apache.org/v2
      kind: ApisixRoute
      metadata:
        name: vault-ui
        namespace: vault
      spec:
        ingressClassName: apisix
        http:
        - name: vault-ui
          match:
            hosts:
            - "vault.teleport.app.${RANCHER_DOMAIN}"
            paths:
            - /*
          backends:
          - serviceName: vault
            servicePort: vault
      ---
      # cert-manager Issuer and Certificate for the injector webhook
      apiVersion: cert-manager.io/v1
      kind: Issuer
      metadata:
        name: rancher-delegated
        namespace: vault
      spec:
        ca:
          secretName: tls-rancher
      ---
      apiVersion: cert-manager.io/v1
      kind: Certificate
      metadata:
        name: vault-agent-injector-tls
        namespace: vault
      spec:
        secretName: vault-agent-injector-tls
        issuerRef:
          name: rancher-delegated
          kind: Issuer
        commonName: vault-agent-injector.vault.svc
        dnsNames:
          - vault-agent-injector.vault.svc
          - vault-agent-injector.vault.svc.cluster.local
        usages:
          - digital signature
          - key encipherment
          - server auth
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: vault-agent-injector
        namespace: vault
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: vault-agent-injector-config
        namespace: vault
      data:
        config.hcl: |
          vault {
            address = "http://vault.vault.svc.cluster.local:8200"
          }
          injector {
            log_level = "info"
          }
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: vault-agent-injector-role
      rules:
        - apiGroups: ["admissionregistration.k8s.io"]
          resources: ["mutatingwebhookconfigurations"]
          verbs: ["get", "list", "watch", "patch"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: vault-agent-injector-binding
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: vault-agent-injector-role
      subjects:
        - kind: ServiceAccount
          name: vault-agent-injector
          namespace: vault
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: vault-agent-injector
        namespace: vault
        labels:
          app: vault-agent-injector
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: vault-agent-injector
        template:
          metadata:
            labels:
              app: vault-agent-injector
          spec:
            serviceAccountName: vault-agent-injector
            containers:
              - name: injector
                image: hashicorp/vault-k8s:1.3.0
                args:
                  - "agent-inject"
                  - "-log-level=info"
                  - "-vault-address=http://vault.vault.svc.cluster.local:8200"
                  - "-tls-cert-file=/tls/tls.crt"
                  - "-tls-key-file=/tls/tls.key"
                volumeMounts:
                  - name: config
                    mountPath: /etc/vault/config
                    readOnly: true
                  - name: tls
                    mountPath: /tls
                    readOnly: true
            volumes:
              - name: config
                configMap:
                  name: vault-agent-injector-config
              - name: tls
                secret:
                  secretName: vault-agent-injector-tls
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: vault-agent-injector
        namespace: vault
      spec:
        selector:
          app: vault-agent-injector
        ports:
          - name: https
            port: 443
            targetPort: 8080
      ---
      apiVersion: admissionregistration.k8s.io/v1
      kind: MutatingWebhookConfiguration
      metadata:
        name: vault-agent-injector-cfg
        labels:
          app: vault-agent-injector
        annotations:
          cert-manager.io/inject-ca-from: vault/vault-agent-injector-tls
      webhooks:
        - name: vault.hashicorp.com
          sideEffects: None
          admissionReviewVersions: ["v1"]
          clientConfig:
            service:
              name: vault-agent-injector
              namespace: vault
              path: "/mutate"
              port: 443
            caBundle: null  # Automatically populated
          rules:
            - operations: ["CREATE"]
              apiGroups: [""]
              apiVersions: ["v1"]
              resources: ["pods"]
          failurePolicy: Ignore
          namespaceSelector: {}
      EOF

      echo "🏗️ Installing Stakater Reloader..."
      RETRIES=5
      DELAY=3

      if sudo helm repo list | awk 'NR>1 {print $1}' | grep -qx "stakater"; then
        echo "Helm repo 'stakater' already exists; skipping add."
      else
        for i in $(seq 1 $RETRIES); do
          echo "Attempt $i to add Helm repo..."
          if sudo helm repo add stakater https://stakater.github.io/stakater-charts --kubeconfig=/etc/rancher/rke2/rke2.yaml; then
            break
          fi
          echo "Failed to add repo, retrying in $DELAY seconds..."
          sleep $DELAY
        done

        if ! sudo helm repo list | awk 'NR>1 {print $1}' | grep -qx "stakater"; then
          echo "Failed to add Helm repo after $RETRIES attempts" >&2
          exit 1
        fi
      fi

      sudo helm repo update stakater

      sudo helm --kubeconfig=/etc/rancher/rke2/rke2.yaml upgrade --install reloader stakater/reloader \
        --namespace reloader \
        --create-namespace \
        --set reloader.deployment.priorityClassName=platform-system-high \
        --wait \
        --timeout 300s

      sudo kubectl annotate namespace reloader field.cattle.io/projectId=local:infrastructure --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      sudo kubectl annotate namespace reloader scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}' --overwrite --kubeconfig=/etc/rancher/rke2/rke2.yaml
      
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: argocd
        annotations:
          field.cattle.io/projectId: local:infrastructure
          scheduler.alpha.kubernetes.io/affinity: '{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"dedicated","operator":"In","values":["srvr-node"]}]}}]}}'
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: argocd-github-oauth
        namespace: argocd
      type: Opaque
      stringData:
        dex.github.clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: github-scm-token
        namespace: argocd
      type: Opaque
      stringData:
        token: ${ARGOCD_GITHUB_SCM_TOKEN}
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: github-repo-creds
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repo-creds
      type: Opaque
      stringData:
        url: https://github.com/dotcomrow
        username: x-access-token
        password: ${ARGOCD_GITHUB_SCM_TOKEN}
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: argocd
        namespace: argocd
      spec:
        chart: argo-cd
        repo: https://argoproj.github.io/argo-helm
        version: 9.1.4      # matches Argo CD v3.2.0
        targetNamespace: argocd
        valuesContent: |-
          global:
            image:
              repository: quay.io/argoproj/argocd
              tag: v3.2.0          # applies to controller/server/appset/dex/redis-ha

          server:
            service:
              type: ClusterIP
              ports:
                - name: http
                  port: 80
                  targetPort: 8080
            extraArgs:
              - --insecure
            ingress:
              enabled: false
            resources:
              requests:
                cpu: 200m
                memory: 256Mi
              limits:
                cpu: "1"
                memory: 1Gi

          controller:
            resources:
              requests:
                cpu: "1"
                memory: 2Gi
              limits:
                cpu: "4"
                memory: 4Gi

          repoServer:
            image:
              repository: ghcr.io/dotcomrow/argocd-repo-server-avp
              tag: 32a8c86c334577dd7f296684d9c1aedbef023c4a

            automountServiceAccountToken: true

            podSecurityContext:
              fsGroup: 999
            resources:
              requests:
                cpu: 500m
                memory: 1Gi
              limits:
                cpu: "2"
                memory: 2Gi

            # 6) Vault-plugin ENV configuration
            env:
              - name: AVP_AUTH_TYPE
                value: "k8s"
              - name: AVP_K8S_ROLE
                value: "argocd"
              - name: AVP_K8S_MOUNT_PATH
                value: "auth/kubernetes"
              - name: AVP_VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: VAULT_ADDR
                value: "http://vault.vault.svc.cluster.local:8200"
              - name: AVP_KV_VERSION
                value: "2"
              - name: AVP_TYPE
                value: "vault"
              - name: AVP_MOUNT_PATH
                value: "secret"

          configs:
            params:
              server.insecure: true
            cm:
              timeout.reconciliation: 3m
              timeout.reconciliation.jitter: 30s
              admin.enabled: false
              url: https://argocd.teleport.app.${RANCHER_DOMAIN}
              dex.config: |
                connectors:
                  - type: github
                    id: github
                    name: GitHub
                    config:
                      clientID: ${ARGOCD_GITHUB_CLIENT_ID}
                      clientSecret: ${ARGOCD_GITHUB_CLIENT_SECRET}
                      orgs:
                        - name: ${GITHUB_ORG}
              application.namespaces: |
                - argocd
              application.namespaceResourceBlacklist: |
                - group: ""
                  kind: Namespace
              configManagementPlugins: |-
                - name: avp-v1
                  allowConcurrency: true
                  discover:
                    command: ["/bin/sh", "-c"]
                    args:
                      - |
                        repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
                        app_path="$${ARGOCD_APP_SOURCE_PATH:-.}"
                        test ! -f "$${repo_root}/.argocd-no-avp" && test ! -f "$${app_path}/.argocd-no-avp"
                  generate:
                    command:
                      - /usr/local/bin/argocd-vault-plugin
                    args:
                      - generate
                      - .
                  provideGitCreds: true
                  preserveFileMode: false
              resource.customizations.health.argoproj.io_Application: |
                hs = {}
                if obj.status == nil or obj.status.sync == nil or obj.status.health == nil then
                  hs.status = "Progressing"
                  hs.message = "Waiting for Application status"
                  return hs
                end
                if obj.status.sync.status ~= "Synced" then
                  hs.status = "Progressing"
                  hs.message = "Waiting for Application to be Synced"
                  return hs
                end
                hs.status = obj.status.health.status
                hs.message = obj.status.health.message
                return hs

            rbac:
              policy.csv: |
                p, role:admin, applications, *, *, allow
                p, role:admin, clusters, get, *, allow
                p, role:admin, repositories, *, *, allow
                p, role:admin, logs, get, *, allow
                p, role:admin, exec, create, *, allow
                p, role:admin, projects, *, *, allow
                g, ${GITHUB_ORG}:ARGOCD_ADMINS, role:admin
              policy.default: role:readonly
      EOF

      KUBECONFIG_PATH="/etc/rancher/rke2/rke2.yaml"
      ARGOCD_NAMESPACE="argocd"
      DEPLOYMENT_NAME="argocd-server"
      TIMEOUT_SECONDS=900

      echo "⏳ Waiting for Argo CD deployment '$DEPLOYMENT_NAME' to appear..."

      # Wait for deployment to appear (up to TIMEOUT_SECONDS)
      SECONDS_WAITED=0
      while ! sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n "$ARGOCD_NAMESPACE" get deployment "$DEPLOYMENT_NAME" &>/dev/null; do
        if (( SECONDS_WAITED >= TIMEOUT_SECONDS )); then
          echo "❌ Timeout waiting for deployment '$DEPLOYMENT_NAME' to appear."
          exit 1
        fi
        sleep 90
        (( SECONDS_WAITED += 5 ))
      done

      echo "✅ Deployment '$DEPLOYMENT_NAME' found. Waiting for it to be ready..."

      # Wait for deployment to be available
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" wait \
        --for=condition=available \
        --timeout=300s \
        deployment/"$DEPLOYMENT_NAME" \
        -n "$ARGOCD_NAMESPACE"

      echo "✅ Argo CD is ready."
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n cattle-system rollout status deploy rancher-webhook --timeout=120s
      
      sudo kubectl --kubeconfig="$KUBECONFIG_PATH" apply -f - <<EOF
      apiVersion: v1
      kind: Service
      metadata:
        name: argocd-ui-svc
        namespace: argocd
        annotations:
          teleport.dev/name: "argocd"
          teleport.dev/protocol: "http"
          teleport.dev/public-addr: "argocd.teleport.app.${RANCHER_DOMAIN}"
          teleport.dev/description: "ArgoCD Service"
        labels:
          app: argocd
          app.kubernetes.io/name: argocd
          app.kubernetes.io/component: argocd
          teleport.dev/enroll: "true"
      spec:
        selector:
          app.kubernetes.io/instance: argocd
          app.kubernetes.io/name: argocd-server
        ports:
          - name: http
            port: 80
            protocol: TCP
            targetPort: 8080
      EOF

      echo "Adding annotations to services that are installed through helm..."

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch svc openobserve-dex-external --type merge \
        -p '{"metadata":{"annotations":{"teleport.dev/name":"openobserve-dex","teleport.dev/protocol":"http","teleport.dev/public-addr":"openobserve-dex.teleport.app.suncoast.systems","teleport.dev/description":"OpenObserve Dex Service"},"labels":{"app":"openobserve-dex","app.kubernetes.io/name":"openobserve-dex","app.kubernetes.io/component":"openobserve-dex","teleport.dev/enroll":"true"}}}' \
        -n openobserve

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch svc policy-reporter-ui --type merge \
        -p '{"metadata":{"annotations":{"teleport.dev/name":"policy-reporter-ui","teleport.dev/protocol":"http","teleport.dev/public-addr":"policy-reporter-ui.teleport.app.suncoast.systems","teleport.dev/description":"Policy Reporter UI Service"},"labels":{"app":"policy-reporter-ui","app.kubernetes.io/name":"policy-reporter-ui","app.kubernetes.io/component":"policy-reporter-ui","teleport.dev/enroll":"true"}}}' \
        -n policy-reporter

      echo "Applying VPA exclusions to namespaces outside Applications/Infrastructure projects..."
      KUBECONFIG_PATH="/etc/rancher/rke2/rke2.yaml"
      projects_json=$(sudo kubectl --kubeconfig="$KUBECONFIG_PATH" get projects.management.cattle.io -A -o json 2>/dev/null || true)
      if [[ -z "$projects_json" ]]; then
        echo "WARN: Rancher projects not available; skipping VPA exclusion labeling."
      else
        declare -A allowed_project_ids
        while IFS="$(printf '\t')" read -r proj_ns proj_name proj_label proj_display
        do
          if [[ "$proj_display" != "Applications" && "$proj_display" != "Infrastructure" && "$proj_name" != "applications" && "$proj_name" != "infrastructure" ]]; then
            continue
          fi
          if [[ -n "$proj_ns" && -n "$proj_name" ]]; then
            allowed_project_ids["$${proj_ns}:$${proj_name}"]=1
          fi
          if [[ -n "$proj_name" ]]; then
            allowed_project_ids["$${proj_name}"]=1
          fi
          if [[ -n "$proj_label" ]]; then
            allowed_project_ids["$${proj_label}"]=1
          fi
        done < <(echo "$projects_json" | jq -r '.items[] | [.metadata.namespace, .metadata.name, (.metadata.labels["field.cattle.io/projectId"] // ""), (.spec.displayName // "")] | @tsv')

        if [[ $${#allowed_project_ids[@]} -eq 0 ]]; then
          echo "WARN: No Applications/Infrastructure project IDs found; skipping VPA exclusion labeling."
        else
          echo "Allowed Rancher project IDs for VPA: $${!allowed_project_ids[*]}"
          while IFS="$(printf '\t')" read -r ns proj_label proj_ann
          do
            project_id="$proj_label"
            if [[ -z "$project_id" ]]; then
              project_id="$proj_ann"
            fi
            if [[ "$ns" == "openobserve" ]]; then
              sudo kubectl --kubeconfig="$KUBECONFIG_PATH" label ns "$ns" platform.suncoast.systems/system=false --overwrite
              continue
            fi
            if [[ -z "$project_id" || -z "$${allowed_project_ids[$project_id]:-}" ]]; then
              sudo kubectl --kubeconfig="$KUBECONFIG_PATH" label ns "$ns" platform.suncoast.systems/vpa-exclude=true --overwrite
              sudo kubectl --kubeconfig="$KUBECONFIG_PATH" label ns "$ns" platform.suncoast.systems/system=true --overwrite
              sudo kubectl --kubeconfig="$KUBECONFIG_PATH" annotate ns "$ns" scheduler.alpha.kubernetes.io/affinity='{"nodeAffinity":{"preferredDuringSchedulingIgnoredDuringExecution":[{"weight":100,"preference":{"matchExpressions":[{"key":"system","operator":"In","values":["true"]}]}}]}}' --overwrite
            fi
          done < <(sudo kubectl --kubeconfig="$KUBECONFIG_PATH" get ns -o json | jq -r '.items[] | [.metadata.name, (.metadata.labels["field.cattle.io/projectId"] // ""), (.metadata.annotations["field.cattle.io/projectId"] // "")] | @tsv')
        fi
      fi

      echo "Assigning specific cattle-* namespaces to the Rancher System project (so they are not 'Not in a project')..."
      system_project_name=$(sudo kubectl --kubeconfig="$KUBECONFIG_PATH" -n local get projects.management.cattle.io -o json | \
        jq -r '.items[] | select(.spec.displayName=="System") | .metadata.name' | head -n1)
      if [[ -z "$system_project_name" ]]; then
        echo "WARN: Could not determine Rancher System project id; skipping explicit project assignment for cattle-* namespaces."
      else
        for ns in cattle-capi-system cattle-turtles-system cattle-ui-plugin-system; do
          if sudo kubectl --kubeconfig="$KUBECONFIG_PATH" get ns "$ns" >/dev/null 2>&1; then
            if sudo kubectl --kubeconfig="$KUBECONFIG_PATH" annotate ns "$ns" field.cattle.io/projectId="local:$system_project_name" --overwrite; then
              echo "✅ Assigned namespace '$ns' to System project (local:$system_project_name)"
            else
              echo "WARN: Failed assigning namespace '$ns' to System project (local:$system_project_name)"
            fi
          else
            echo "INFO: Namespace '$ns' not found; skipping"
          fi
        done
      fi

      echo "Cleaning up uneeded resources..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace applications
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete namespace infrastructure

  - path: /etc/systemd/system/post-install.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post Install Tasks
      After=gpu.service
      Requires=gpu.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/80-post-install.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/fix-dns-nfs.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Fix systemd-resolved DNS config for NFS
      After=network-online.target systemd-resolved.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/bash -c "systemctl restart systemd-resolved; rm -f /etc/resolv.conf; ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reexec
  - systemctl daemon-reload
  - systemctl enable initial-setup.service
  - systemctl start initial-setup.service
  - [ systemctl, unmask, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, enable, --now, apt-daily.timer, apt-daily-upgrade.timer ]
