  - path: /usr/local/bin/rke2-preload-images.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      IMAGE_DIR="/var/lib/rancher/rke2/agent/images"
      ARCH="amd64"

      mkdir -p "$IMAGE_DIR"

      RKE2_VERSION=$(/usr/local/bin/rke2 --version | awk '{print $3}' | head -n1)
      RKE2_VERSION_ENCODED=$(echo "${k8s_version}" | sed 's/+/%2B/g')
      IMAGE_NAME="rke2-images.linux-$ARCH.tar.zst"
      IMAGE_URL="https://github.com/rancher/rke2/releases/download/$RKE2_VERSION_ENCODED/$IMAGE_NAME"

      echo "📦 Downloading $IMAGE_URL..."
      curl -fSL "$IMAGE_URL" -o "/tmp/$IMAGE_NAME"

      echo "📦 Decompressing..."
      zstd -d "/tmp/$IMAGE_NAME" -o "/tmp/rke2-images.tar"

      echo "📂 Moving to $IMAGE_DIR..."
      mv /tmp/rke2-images.tar "$IMAGE_DIR/rke2-images.tar"

      echo "✅ Preload complete"

  - path: /etc/systemd/system/rke2-preload-images.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Preload RKE2 container images
      ConditionPathExists=/usr/local/bin/rke2
      After=network-online.target
      Before=rke2-server.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/rke2-preload-images.sh

      [Install]
      WantedBy=multi-user.target

  - path: /etc/rancher/rke2/registries.yaml
    permissions: '0755'
    content: |
      mirrors:
        docker.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/dockerhub"
        quay.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/quay"
        gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/gcr"
        k8s.gcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/k8s-gcr"
        registry.k8s.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/registry-k8s"
        ghcr.io:
          endpoint:
            - "http://utility-node.internal.lan/v2/ghcr"
        "nvidia":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "nvcr.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/nvidia"
        "cr.l5d.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/linkerd"
        "reg.kyverno.io":
          endpoint:
            - "http://utility-node.internal.lan/v2/kyverno"

      configs:
        utility-node.internal.lan:
          tls:
            insecure_skip_verify: true

  - path: /usr/local/bin/30-setup-runtime.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      echo "🐳 Installing Docker..."
      until curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -; do
        echo "Retrying Docker GPG key fetch..."; sleep 5;
      done
      sudo apt-key fingerprint 0EBFCD88
      sudo add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
      sudo apt update
      DEBIAN_FRONTEND=noninteractive sudo apt install -y docker-ce docker-ce-cli containerd.io

      # Generate containerd config and configure registry mirrors
      containerd config default > /etc/containerd/config.toml

      sudo apt install python3-pip -y
      sudo apt install python3-tomlkit
      sudo python3 /usr/local/bin/patch.py

      systemctl restart containerd
      systemctl enable containerd
      # sudo mkdir -p /etc/systemd/system/docker.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/docker.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      # sudo mkdir -p /etc/systemd/system/containerd.service.d
      # cat <<EOF | sudo tee /etc/systemd/system/containerd.service.d/10-http-proxy.conf
      # [Service]
      # Environment="HTTP_PROXY=http://10.0.0.10:3128" "HTTPS_PROXY=http://10.0.0.10:3128" "NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12"
      # EOF

      echo "☸️ Installing kubectl, RKE2, Helm..."

      # Retry with timeout and snapd recovery
      install_with_snap_retry() {
        local package="$1"
        local max_retries=5
        local retry_count=0

        until snap install "$package" --classic && "$package" version --client 2>/dev/null; do
          retry_count=$((retry_count + 1))
          echo "❌ Failed to install $package, attempt $retry_count..."

          if (( retry_count >= max_retries )); then
            echo "🔁 Restarting snapd and trying again..."
            systemctl restart snapd
            retry_count=0
          fi

          sleep 5
        done

        echo "✅ $package installed successfully."
      }

      install_with_snap_retry kubectl

      until which rke2 >/dev/null 2>&1; do
        curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION=${k8s_version} sh -;
        sleep 5
      done

      until which helm >/dev/null 2>&1; do
        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash;
        sleep 5
      done

      echo "🔌 Enabling QEMU guest agent..."
      systemctl start qemu-guest-agent
      systemctl enable qemu-guest-agent

  - path: /usr/local/bin/patch.py
    permissions: '0755'
    content: |
      from pathlib import Path
      from tomlkit import parse, dumps, table
      import re

      TOML_PATH = "/etc/containerd/config.toml"

      # Load TOML and parse
      doc = parse(Path(TOML_PATH).read_text())

      # Ensure registry section exists (containerd defaults may omit it)
      plugins = doc.get("plugins", table())
      cri_plugin = plugins.get("io.containerd.grpc.v1.cri", table())
      cri_registry = cri_plugin.get("registry", table())

      # Configs
      configs = cri_registry.get("configs", table())
      if "utility-node.internal.lan" not in configs:
          configs["utility-node.internal.lan"] = table()
      configs["utility-node.internal.lan"]["tls"] = {"insecure_skip_verify": True}
      cri_registry["configs"] = configs

      # Mirrors
      mirrors = cri_registry.get("mirrors", table())
      mirror_map = {
          "docker.io": "dockerhub",
          "quay.io": "quay",
          "gcr.io": "gcr",
          "k8s.gcr.io": "k8s-gcr",
          "registry.k8s.io": "registry-k8s",
          "ghcr.io": "ghcr",
          "nvidia": "nvidia",
          "nvcr.io": "nvidia"
      }
      for registry, mirror_name in mirror_map.items():
          mirrors[registry] = {
              "endpoint": [f"http://utility-node.internal.lan/v2/{mirror_name}"]
          }

      cri_registry["mirrors"] = mirrors
      cri_plugin["registry"] = cri_registry
      plugins["io.containerd.grpc.v1.cri"] = cri_plugin
      doc["plugins"] = plugins

      # Dump raw TOML
      raw_toml = dumps(doc)

      # Fix indentation: match just the affected lines and re-indent
      def indent_cri_registry_values(toml_str: str) -> str:
          output = []
          indent = None
          in_target_section = False

          for line in toml_str.splitlines():
              # Detect target section
              if re.match(r'\s*\[plugins\."io\.containerd\.grpc\.v1\.cri"\.registry\..*]', line):
                  in_target_section = True
                  output.append(line)
                  continue
              # Stop when out of section
              elif re.match(r'\s*\[.*]', line):
                  in_target_section = False
                  output.append(line)
                  continue

              # Indent values under the target section
              if in_target_section and "=" in line.strip():
                  output.append("      " + line.strip())
              else:
                  output.append(line)

          return "\n".join(output)

      # Write patched file
      Path(TOML_PATH).write_text(indent_cri_registry_values(raw_toml))
      print("✅ containerd config patched with consistent indentation.")

  - path: /etc/systemd/system/setup-runtime.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install Docker, Snapd, RKE2, Helm, kubectl
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/30-setup-runtime.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/40-bootstrap-rke2.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "⚙️ Bootstrapping RKE2 configuration..."
      mkdir -p /etc/rancher/rke2
      cp /mnt/shared-storage/config.yaml /etc/rancher/rke2/config.yaml

      sudo mkdir -p /etc/systemd/system/rke2-server.service.d/

      sudo tee -a /etc/rancher/rke2/config.yaml << 'EOF'
      # ────────────────────────────────────────────────────────────────────────
      # RKE2 Configuration: Admission Plugins + Kubelet NUMA-aware Settings
      # ────────────────────────────────────────────────────────────────────────

      kube-apiserver-arg:
        - "enable-admission-plugins=PodNodeSelector"

      kubelet-arg:
        - "--max-pods=${SRVR_NODE_MAX_PODS}"
        - "--topology-manager-policy=restricted"
        - "--kube-reserved=cpu=500m,memory=1Gi,ephemeral-storage=1Gi"
        - "--container-log-max-size=10Mi"
        - "--container-log-max-files=3"
        - "--system-reserved=cpu=500m,memory=2Gi,ephemeral-storage=2Gi"
      EOF

      systemctl enable rke2-server
      systemctl start rke2-server

      echo "🗑️ Cleaning previous RKE2 tokens..."
      rm -rf /mnt/shared-storage/*.token

      RKE2_TOKEN=$(cat /var/lib/rancher/rke2/server/node-token)
      echo $RKE2_TOKEN > /mnt/shared-storage/$(hostname -I | cut -d" " -f1).token

      until sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml version; do
        echo "Waiting for kube-apiserver to respond..."
        sleep 10
      done

      echo "⏳ Waiting for all 5 nodes to become Ready..."
      while [[ $(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --no-headers | awk '$2 != "Ready" {exit 1} END {print NR}') -ne 5 ]]; do
        echo "Waiting for all 5 nodes to be Ready..."
        sleep 60
      done
      echo "✅ All nodes are Ready!"
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node srvr-node dedicated=srvr-node system=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node etcd-node dedicated=etcd-node system=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-l4-gpu dedicated=work-node --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu dedicated=work-node-gpu --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-l4-gpu work-node=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu work-node=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node ctrl-node dedicated=ctrl-node system=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-l4-gpu node.longhorn.io/create-default-disk=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node work-node-t4-gpu node.longhorn.io/create-default-disk=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node srvr-node node.longhorn.io/create-default-disk=false --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node etcd-node node.longhorn.io/create-default-disk=false --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml label node ctrl-node node.longhorn.io/create-default-disk=false --overwrite

  - path: /etc/systemd/system/bootstrap-rke2.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Copy RKE2 config and expose node-token
      After=setup-runtime.service
      Requires=setup-runtime.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/40-bootstrap-rke2.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/99-set-nofile-limits.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Increasing open file limits to 1048576..."

      echo "📄 Updating PAM limits..."
      tee /etc/security/limits.d/99-nofile.conf > /dev/null <<EOF
      * soft nofile 1048576
      * hard nofile 1048576
      root soft nofile 1048576
      root hard nofile 1048576
      EOF

      echo "📄 Updating system.conf.d for global systemd limits..."
      mkdir -p /etc/systemd/system.conf.d
      tee /etc/systemd/system.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "📄 Updating user.conf.d..."
      mkdir -p /etc/systemd/user.conf.d
      tee /etc/systemd/user.conf.d/99-default-ulimits.conf > /dev/null <<EOF
      [Manager]
      DefaultLimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for rke2-server..."
      mkdir -p /etc/systemd/system/rke2-server.service.d
      tee /etc/systemd/system/rke2-server.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "⚙️  Setting LimitNOFILE for containerd..."
      mkdir -p /etc/systemd/system/containerd.service.d
      tee /etc/systemd/system/containerd.service.d/override.conf > /dev/null <<EOF
      [Service]
      LimitNOFILE=1048576
      EOF

      echo "🔁 Reloading systemd..."
      systemctl daemon-reload

      systemctl restart rke2-server || true
      systemctl restart containerd || true

      echo "✅ Verifying limits..."
      ulimit -n
      cat /proc/$(pgrep -f kubelet | head -n 1)/limits | grep "Max open files"

  - path: /etc/systemd/system/set-nofile-limits.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Raise nofile limit for rke2 and containerd
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/99-set-nofile-limits.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/50-k8s-addons.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      until sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/local/bin/yq; do
        echo "Retry on failed download of yq..."
        sleep 5
      done
      sudo chmod +x /usr/local/bin/yq

      # Detect RKE2 or K3s
      if [ -d "/etc/rancher/rke2/server/manifests" ]; then
        MANIFEST_DIR="/etc/rancher/rke2/server/manifests"
      elif [ -d "/var/lib/rancher/k3s/server/manifests" ]; then
        MANIFEST_DIR="/var/lib/rancher/k3s/server/manifests"
      elif [ -d "/var/lib/rancher/rke2/server/manifests" ]; then
        MANIFEST_DIR="/var/lib/rancher/rke2/server/manifests"
      else
        echo "❌ Could not detect RKE2 or K3s manifest directory."
        exit 1
      fi

      # 1) Ensure we’re on RKE2 and set the manifests dir
      [ -d "$MANIFEST_DIR" ] || { echo "❌ $MANIFEST_DIR not found (is rke2-server installed on this node?)"; exit 1; }

      # 2) Find the CoreDNS HelmChart name (typically rke2-coredns)
      CHART_NAME="$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get helmcharts.helm.cattle.io \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | grep -E '^rke2-coredns|^coredns$' | head -n1)"

      if [ -z "$CHART_NAME" ]; then
        echo "❌ Could not find CoreDNS HelmChart in kube-system. Run:
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get helmcharts.helm.cattle.io"
        exit 1
      fi
      echo "🔎 CoreDNS HelmChart name: $CHART_NAME"

      # 3) Set your internal DNS upstream(s)
      INTERNAL_DNS="10.0.0.10"

      # 4) Write the HelmChartConfig overlay
      sudo tee "$MANIFEST_DIR/coredns-config.yaml" >/dev/null <<EOF
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: $CHART_NAME
        namespace: kube-system
      spec:
        valuesContent: |-
          servers:
            - zones:
                - zone: .
              port: 53
              plugins:
                - name: errors
                - name: health
                - name: ready
                - name: kubernetes
                  parameters: cluster.local in-addr.arpa ip6.arpa
                  configBlock: |
                    pods insecure
                    fallthrough in-addr.arpa ip6.arpa
                - name: forward
                  parameters: . $INTERNAL_DNS
                - name: cache
                  parameters: 30
                - name: loop
                - name: reload
                - name: loadbalance
      EOF

      echo "✅ Wrote $MANIFEST_DIR/coredns-config.yaml"

      # 5) Give the controller a moment, then verify it applied
      sleep 15
      echo "🔍 Checking Corefile for your upstream(s)..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system get configmap rke2-coredns-rke2-coredns -o yaml | grep -A2 'forward \. ' || true

      # 6) (Optional) Nudge a rollout if you want it immediate:
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system rollout restart deploy/rke2-coredns-rke2-coredns

      echo "✅ CoreDNS is patched and ready with persistent DNS fallback."

      echo "🔧 Excluding rke2-metrics-server from VPA and restoring default resources..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system annotate deployment rke2-metrics-server platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system patch deployment rke2-metrics-server --type=merge \
        -p '{"spec":{"template":{"metadata":{"annotations":{"platform.suncoast.systems/vpa-exclude":"true"}}}}}'
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n kube-system patch deployment rke2-metrics-server --type='json' \
        -p='[{"op":"remove","path":"/spec/template/spec/containers/0/resources"}]' || true

      echo "📥 Installing Cert-Manager..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager -n cert-manager
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/cert-manager-webhook -n cert-manager

      echo "📥 Installing MetalLB..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/metallb/metallb/v0.13.10/config/manifests/metallb-native.yaml
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=600s deployment/controller -n metallb-system

      echo "🔧 Excluding MetalLB from VPA and restoring default resources..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system annotate deployment controller platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system patch deployment controller --type=merge \
        -p '{"spec":{"template":{"metadata":{"annotations":{"platform.suncoast.systems/vpa-exclude":"true"}}}}}'
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system patch deployment controller --type='json' \
        -p='[{"op":"remove","path":"/spec/template/spec/containers/0/resources"}]' || true

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system annotate daemonset speaker platform.suncoast.systems/vpa-exclude=true --overwrite
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system patch daemonset speaker --type=merge \
        -p '{"spec":{"template":{"metadata":{"annotations":{"platform.suncoast.systems/vpa-exclude":"true"}}}}}'
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n metallb-system patch daemonset speaker --type='json' \
        -p='[{"op":"remove","path":"/spec/template/spec/containers/0/resources"}]' || true

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
        name: default
        namespace: metallb-system
      spec:
        addresses:
          - 10.0.0.110-10.0.0.150
      ---
      apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
        name: default
        namespace: metallb-system
      EOF

      echo "📥 Installing Longhorn..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f https://raw.githubusercontent.com/longhorn/longhorn/${LONGHORN_VERSION}/deploy/longhorn.yaml

      echo "⏳ Waiting for Longhorn CRDs..."
      for i in {1..60}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd volumes.longhorn.io >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn CRDs to become available ($i/60)..."
        sleep 10
      done

      echo "⏳ Waiting for Longhorn configmaps..."
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get configmap longhorn-storageclass >/dev/null 2>&1 && \
           sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get configmap longhorn-default-setting >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn configmaps to become available ($i/30)..."
        sleep 10
      done

      echo "🔧 Setting Longhorn defaults/configmaps to 1 replica..."
      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: longhorn-default-setting
        namespace: longhorn-system
      data:
        default-setting.yaml: |-
          default-replica-count: "1"
          priority-class: "longhorn-critical"
          disable-revision-counter: "{\"v1\":\"true\"}"
          create-default-disk-labeled-nodes: "true"
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: longhorn-storageclass
        namespace: longhorn-system
      data:
        storageclass.yaml: |
          kind: StorageClass
          apiVersion: storage.k8s.io/v1
          metadata:
            name: longhorn
            annotations:
              storageclass.kubernetes.io/is-default-class: "true"
          provisioner: driver.longhorn.io
          allowVolumeExpansion: true
          reclaimPolicy: "Delete"
          volumeBindingMode: Immediate
          parameters:
            numberOfReplicas: "1"
            staleReplicaTimeout: "30"
            fromBackup: ""
            fsType: "ext4"
            dataLocality: "disabled"
            unmapMarkSnapChainRemoved: "ignored"
            disableRevisionCounter: "true"
            dataEngine: "v1"
            backupTargetName: "default"
      EOF

      # Wait for the Longhorn settings CRD before patching defaults
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get settings.longhorn.io default-replica-count >/dev/null 2>&1; then
          break
        fi
        echo "⏳ Waiting for Longhorn settings to become available ($i/30)..."
        sleep 10
      done

      echo "⏳ Waiting for Longhorn admission webhook endpoints..."
      longhorn_webhook_ready=false
      for i in {1..60}; do
        webhook_ips="$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get endpoints longhorn-admission-webhook -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null || true)"
        if [ -n "$webhook_ips" ]; then
          longhorn_webhook_ready=true
          break
        fi
        echo "⏳ Waiting for Longhorn admission webhook endpoints ($i/60)..."
        sleep 5
      done
      if [ "$longhorn_webhook_ready" != "true" ]; then
        echo "❌ Longhorn admission webhook endpoints are not ready; cannot patch Longhorn settings."
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get deploy longhorn-admission-webhook -o wide || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get svc longhorn-admission-webhook -o wide || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get endpoints longhorn-admission-webhook -o wide || true
        exit 1
      fi

      echo "🔧 Forcing Longhorn default replica count to 1..."
      default_replica_applied=false
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system patch settings.longhorn.io default-replica-count --type=merge -p '{"value":"1"}'; then
          default_replica_applied=true
          break
        fi
        echo "⏳ Retrying Longhorn default replica count patch ($i/30)..."
        sleep 5
      done
      if [ "$default_replica_applied" != "true" ]; then
        echo "❌ Failed to patch Longhorn default replica count after retries."
        exit 1
      fi

      desired_instance_manager_cpu_value="$(printf '{"v1":"%s","v2":"%s"}' "${LONGHORN_GUARANTEED_INSTANCE_MANAGER_CPU}" "${LONGHORN_GUARANTEED_INSTANCE_MANAGER_CPU}")"
      echo "🔧 Setting Longhorn guaranteed instance manager CPU to $${desired_instance_manager_cpu_value}..."
      cat <<EOT >/tmp/longhorn-guaranteed-instance-manager-cpu.yaml
      value: '$${desired_instance_manager_cpu_value}'
      EOT
      guaranteed_cpu_applied=false
      for i in {1..30}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system patch settings.longhorn.io guaranteed-instance-manager-cpu --type=merge --patch-file /tmp/longhorn-guaranteed-instance-manager-cpu.yaml; then
          guaranteed_cpu_applied=true
          break
        fi
        echo "⏳ Retrying Longhorn guaranteed instance manager CPU patch ($i/30)..."
        sleep 5
      done
      rm -f /tmp/longhorn-guaranteed-instance-manager-cpu.yaml
      if [ "$guaranteed_cpu_applied" != "true" ]; then
        echo "❌ Failed to patch Longhorn guaranteed instance manager CPU after retries."
        exit 1
      fi
      actual_instance_manager_cpu_value=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get settings.longhorn.io guaranteed-instance-manager-cpu -o jsonpath='{.value}')
      if [ "$${actual_instance_manager_cpu_value}" != "$${desired_instance_manager_cpu_value}" ]; then
        echo "❌ Longhorn guaranteed instance manager CPU not applied. Expected $${desired_instance_manager_cpu_value}, got $${actual_instance_manager_cpu_value}"
        exit 1
      fi

      echo "🔄 Recreating Longhorn StorageClasses with 1 replica..."
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete storageclass longhorn longhorn-rwx --ignore-not-found

      cat <<EOF | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn
        annotations:
          storageclass.kubernetes.io/is-default-class: 'true'
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
        archiveOnDelete: "false"
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: longhorn-rwx
      provisioner: driver.longhorn.io
      allowVolumeExpansion: true
      reclaimPolicy: Delete
      volumeBindingMode: Immediate
      parameters:
        numberOfReplicas: '1'
        staleReplicaTimeout: '30'
        fromBackup: ''
        archiveOnDelete: "false"
      ---
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: ephemeral-fast
      provisioner: kubernetes.io/no-provisioner
      volumeBindingMode: WaitForFirstConsumer
      reclaimPolicy: Delete
      parameters:
        archiveOnDelete: "false"
      EOF

      echo "⏳ Waiting for Longhorn core components to be Ready..."
      for deploy in longhorn-driver-deployer longhorn-ui longhorn-admission-webhook longhorn-conversion-webhook longhorn-recovery-backend; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get deploy "$deploy" >/dev/null 2>&1; then
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status deploy/"$deploy" --timeout=600s
        fi
      done
      for ds in longhorn-manager longhorn-csi-plugin; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get ds "$ds" >/dev/null 2>&1; then
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status ds/"$ds" --timeout=600s
        fi
      done

      echo "🚫 Disabling Longhorn scheduling on control/etcd/srvr nodes..."
      for NODE in ${CTRL_HOSTNAME} ${ETCD_HOSTNAME} ${SRVR_HOSTNAME}; do
        for i in {1..12}; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "$NODE" >/dev/null 2>&1; then
            if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system patch nodes.longhorn.io "$NODE" --type=merge -p '{"spec":{"allowScheduling":false,"disks":{}}}'; then
              echo "✅ Longhorn scheduling disabled and disks removed on $NODE"
              break
            fi
          fi
          echo "⏳ Waiting for Longhorn node $NODE to be ready ($i/12)..."
          sleep 10
        done
      done

      echo "⏳ Waiting for schedulable Longhorn nodes with available disks..."
      for i in {1..60}; do
        SCHED_READY=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o json | \
          jq '[.items[]
              | select(.spec.allowScheduling==true)
              | select((.status.conditions // []) | any(.type=="Ready" and .status=="True"))
              | select((.status.diskStatus // {} | to_entries | any(
                  ((.value.conditions // []) | any(.type=="Schedulable" and .status=="True"))
                  and ((.value.storageAvailable|tonumber)>0)
                )))
            ] | length')
        if [ "$SCHED_READY" -ge 1 ]; then
          echo "✅ Longhorn scheduling is ready on $SCHED_READY node(s)."
          break
        fi
        echo "⏳ Waiting for Longhorn schedulable nodes to be ready ($i/60)..."
        sleep 10
      done
      if [ "$SCHED_READY" -lt 1 ]; then
        echo "❌ No schedulable Longhorn nodes with available disk detected."
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o wide || true
        exit 1
      fi

  - path: /etc/systemd/system/k8s-addons.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Install K8s Add-ons (Cert-Manager, MetalLB, Longhorn)
      After=bootstrap-rke2.service
      Requires=bootstrap-rke2.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/50-k8s-addons.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/60-install-apisix-rancher.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      export KUBECONFIG=/etc/rancher/rke2/rke2.yaml

      cleanup_longhorn_smoke() {
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete pod longhorn-smoke-pod -n longhorn-smoke --ignore-not-found >/dev/null 2>&1 || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete pvc longhorn-smoke-pvc -n longhorn-smoke --ignore-not-found >/dev/null 2>&1 || true
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml delete ns longhorn-smoke --ignore-not-found --wait=false >/dev/null 2>&1 || true
      }

      wait_for_longhorn() {
        echo "⏳ Verifying Longhorn is fully ready before continuing..."

        for i in {1..60}; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get ns longhorn-system >/dev/null 2>&1; then
            break
          fi
          echo "⏳ Waiting for longhorn-system namespace ($i/60)..."
          sleep 10
        done

        if ! sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get ns longhorn-system >/dev/null 2>&1; then
          echo "❌ longhorn-system namespace not found."
          exit 1
        fi

        for crd in volumes.longhorn.io nodes.longhorn.io settings.longhorn.io; do
          for i in {1..60}; do
            if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd "$crd" >/dev/null 2>&1; then
              break
            fi
            echo "⏳ Waiting for Longhorn CRD $crd ($i/60)..."
            sleep 10
          done
          if ! sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd "$crd" >/dev/null 2>&1; then
            echo "❌ Longhorn CRD $crd not ready."
            exit 1
          fi
        done

        echo "⏳ Waiting for Longhorn core components to be Ready..."
        for deploy in longhorn-driver-deployer longhorn-ui longhorn-admission-webhook longhorn-conversion-webhook longhorn-recovery-backend; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get deploy "$deploy" >/dev/null 2>&1; then
            sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status deploy/"$deploy" --timeout=600s
          fi
        done
        for ds in longhorn-manager longhorn-csi-plugin; do
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get ds "$ds" >/dev/null 2>&1; then
            sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system rollout status ds/"$ds" --timeout=600s
          fi
        done

        echo "⏳ Waiting for schedulable Longhorn nodes with available disks..."
        local sched_ready
        for i in {1..60}; do
          sched_ready=$(sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o json | \
            jq '[.items[]
                | select(.spec.allowScheduling==true)
                | select((.status.conditions // []) | any(.type=="Ready" and .status=="True"))
                | select((.status.diskStatus // {} | to_entries | any(
                    ((.value.conditions // []) | any(.type=="Schedulable" and .status=="True"))
                    and ((.value.storageAvailable|tonumber)>0)
                  )))
              ] | length')
          if [ "$sched_ready" -ge 1 ]; then
            echo "✅ Longhorn scheduling is ready on $sched_ready node(s)."
            break
          fi
          echo "⏳ Waiting for Longhorn schedulable nodes to be ready ($i/60)..."
          sleep 10
        done
        if [ "$sched_ready" -lt 1 ]; then
          echo "❌ No schedulable Longhorn nodes with available disk detected."
          sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io -o wide || true
          exit 1
        fi

        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "${SRVR_HOSTNAME}" >/dev/null 2>&1; then
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-system get nodes.longhorn.io "${SRVR_HOSTNAME}" -o json | jq -e '.spec.allowScheduling==true' >/dev/null; then
            echo "❌ Longhorn scheduling is still enabled on ${SRVR_HOSTNAME}; refusing to proceed."
            exit 1
          fi
        fi

        echo "🔍 Running a Longhorn provisioning smoke test on work nodes..."
        cleanup_longhorn_smoke
        trap cleanup_longhorn_smoke EXIT
        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Namespace
      metadata:
        name: longhorn-smoke
      EOF

        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: longhorn-smoke-pvc
        namespace: longhorn-smoke
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: longhorn
        resources:
          requests:
            storage: 1Gi
      EOF

        cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: v1
      kind: Pod
      metadata:
        name: longhorn-smoke-pod
        namespace: longhorn-smoke
      spec:
        priorityClassName: ""
        nodeSelector:
          work-node: "true"
        containers:
          - name: smoke
            image: public.ecr.aws/docker/library/busybox:1.36.1
            command: ["sh","-c","echo ok > /data/ready && sleep 30"]
            volumeMounts:
              - name: data
                mountPath: /data
        volumes:
          - name: data
            persistentVolumeClaim:
              claimName: longhorn-smoke-pvc
        restartPolicy: Never
      EOF

        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-smoke wait --for=jsonpath='{.status.phase}'=Bound pvc/longhorn-smoke-pvc --timeout=300s
        sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n longhorn-smoke wait --for=condition=Ready pod/longhorn-smoke-pod --timeout=300s
        cleanup_longhorn_smoke
        trap - EXIT
        echo "✅ Longhorn provisioning smoke test passed."
      }

      wait_for_longhorn

      echo "📦 Installing NGINX Ingress Controller..."

      # 1. Create your values.yaml inline
      cat <<EOF > /tmp/ingress-values.yaml
      controller:
        allowSnippetAnnotations: true
        service:
          loadBalancerIP: "10.0.0.110"
        config:
          ssl-redirect: "false"
        deployment:
          minReadySeconds: 30
          # omit progressDeadlineSeconds so default is used (likely 600)
      EOF

      # 2. Render the chart locally to YAML
      # ─── Tunables ────────────────────────────────────────────────────────────
      MAX_ATTEMPTS=0          # 0 = retry forever ─ change to e.g. 30 to give up eventually
      SLEEP_SECONDS=10
      VALUES_FILE=/tmp/ingress-values.yaml
      RENDER_FILE=/tmp/ingress-rendered.yaml
      KUBECONFIG=/etc/rancher/rke2/rke2.yaml
      # ─────────────────────────────────────────────────────────────────────────

      attempt=0
      while :; do
        attempt=$(( attempt + 1 ))
        echo "▶️  [$attempt] Rendering ingress-nginx chart …"

        if sudo helm --kubeconfig "$KUBECONFIG" \
              template ingress-nginx ingress-nginx \
              --repo https://kubernetes.github.io/ingress-nginx \
              --namespace ingress-nginx \
              --values "$VALUES_FILE" > "$RENDER_FILE.tmp"; then
          mv "$RENDER_FILE.tmp" "$RENDER_FILE"
          echo "✅  Render succeeded on attempt #$attempt"
          break
        fi

        # Give up if we hit the hard limit (unless MAX_ATTEMPTS=0 → infinite)
        if [[ $MAX_ATTEMPTS -ne 0 && $attempt -ge $MAX_ATTEMPTS ]]; then
          echo "❌  Helm template failed after $attempt attempts"
          exit 1
        fi

        echo "🔄  Helm template failed — retrying in $SLEEP_SECONDS …"
        sleep "$SLEEP_SECONDS"
      done

      # 3. Fix invalid `progressDeadlineSeconds: 0` manually:
      sed -i 's/progressDeadlineSeconds: 0/progressDeadlineSeconds: 600/' /tmp/ingress-rendered.yaml

      # 4. Create namespace (if needed)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create namespace ingress-nginx --dry-run=client -o yaml | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -

      # 5. Apply manifests directly (bypass Helm install)
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f /tmp/ingress-rendered.yaml --validate=false

      # Wait for the NGINX ingress controller to be ready
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=800s deployment/ingress-nginx-controller -n ingress-nginx

      echo "🛠️ Assigning LoadBalancer IP 10.0.0.110 to ingress-nginx-controller..."
      sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml patch svc ingress-nginx-controller -n ingress-nginx \
        --type='merge' \
        -p '{"spec": {"type": "LoadBalancer", "loadBalancerIP": "10.0.0.110"}}'

      echo "🏗️ Installing Rancher..."
      echo "Using Rancher chart repo '${RANCHER_CHART_REPO}' version '${RANCHER_CHART_VERSION}'"
      RETRIES=5
      DELAY=3

      for i in $(seq 1 $RETRIES); do
        echo "Attempt $i to add Helm repo..."
        sudo helm repo add rancher-${RANCHER_CHART_REPO} https://releases.rancher.com/server-charts/${RANCHER_CHART_REPO} --kubeconfig=/etc/rancher/rke2/rke2.yaml && break
        echo "Failed to add repo, retrying in $DELAY seconds..."
        sleep $DELAY
      done

      # Optionally fail hard if all retries exhausted
      if [[ $i -eq $RETRIES ]]; then
        echo "Failed to add Helm repo after $RETRIES attempts" >&2
        exit 1
      fi

      sudo helm repo update
      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml create namespace cattle-system || true

      openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout tls.key -out tls.crt -subj "/CN=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}/O=Rancher Self-Signed"

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml -n cattle-system create secret tls tls-rancher-ingress \
        --cert=tls.crt --key=tls.key

      sudo helm upgrade --install rancher rancher-${RANCHER_CHART_REPO}/rancher \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml \
        --namespace cattle-system \
        --version ${RANCHER_CHART_VERSION} \
        --set hostname=${RANCHER_HOSTNAME}.${RANCHER_DOMAIN} \
        --set bootstrapPassword=$(openssl rand -base64 18) \
        --set ingress.tls.source=rancher \
        --set ingress.enabled=true \
        --set ingress.ingressClassName=nginx \
        --set ingress.extraAnnotations."kubernetes\.io/ingress\.class"=nginx

      sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=available --timeout=8000s deployment/rancher -n cattle-system

      echo "🌐 Patching Rancher server URL to https://k8s-platform.suncoast.systems ..."
      # Wait for the settings CRD to be registered, then patch with retries
      SETTINGS_READY=false
      for i in {1..60}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get crd settings.management.cattle.io >/dev/null 2>&1; then
          # Ensure the API is actually served and the Setting resource is reachable
          if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get --raw /apis/management.cattle.io/v3/settings/server-url >/dev/null 2>&1; then
            SETTINGS_READY=true
            break
          fi
        fi
        echo "⏳ Waiting for Rancher settings CRD/API to be ready ($i/60)..."
        sleep 10
      done

      if [[ "$SETTINGS_READY" != true ]]; then
        echo "❌ settings.management.cattle.io CRD/API not ready after waiting."
        exit 1
      fi

      PATCHED=false
      for i in {1..20}; do
        if sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml patch settings.management.cattle.io server-url \
          --type merge \
          -p '{"value":"https://k8s-platform.suncoast.systems"}'; then
          echo "✅ Rancher server URL patched"
          PATCHED=true
          break
        fi
        echo "🔄 Retry patching Rancher server URL ($i/20)..."
        sleep 10
      done

      if [[ "$PATCHED" != true ]]; then
        echo "❌ Failed to patch Rancher server URL after multiple attempts."
        exit 1
      fi

      cat <<EOF | sudo kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml apply -f -
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: infrastructure
        namespace: local
        labels:
          field.cattle.io/projectId: infrastructure
      spec:
        displayName: "Infrastructure"
        description: "Infrastructure Project for Rancher and Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: Project
      metadata:
        name: applications
        namespace: local
        labels:
          field.cattle.io/projectId: applications
      spec:
        displayName: "Applications"
        description: "Project for Application Resources"
        clusterName: local
      ---
      apiVersion: management.cattle.io/v3
      kind: GlobalRoleBinding
      metadata:
        name: github-k8s-cluster-admins
        labels:
          auth-provider: github
      globalRoleName: admin
      groupPrincipalName: 'github_team:${GITHUB_AUTH_VAL}'
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: github-team-cluster-admins
      subjects:
        - kind: Group
          name: 'github_team:${GITHUB_AUTH_VAL}'  # Replace with your team
          apiGroup: rbac.authorization.k8s.io
      roleRef:
        kind: ClusterRole
        name: cluster-admin
        apiGroup: rbac.authorization.k8s.io
      ---
      apiVersion: management.cattle.io/v3
      kind: ClusterRoleTemplateBinding
      metadata:
        name: github-team-cluster-owner
        namespace: local            # Adjust if your cluster name is different
      clusterName: local            # Adjust if your cluster name is different
      groupName: 'github_team:${GITHUB_AUTH_VAL}'
      roleTemplateName: cluster-owner
      ---
      accessMode: required
      apiVersion: management.cattle.io/v3
      kind: AuthConfig
      metadata:
        name: github
        namespace: cattle-system
      enabled: true
      displayName: GitHub Authentication
      clientId: '${GITHUB_CLIENT_ID}'
      clientSecret: '${GITHUB_CLIENT_SECRET}'
      hostname: 'github.com'
      tls: true
      type: githubConfig
      logoutAllSupported: false
      rancherUrl: 'https://${RANCHER_HOSTNAME}.${RANCHER_DOMAIN}'
      allowedPrincipalIds:
        - 'github_team:${GITHUB_AUTH_VAL}'
      scopes:
        - 'read:user'
        - 'user:email'
        - 'read:org'
      ---
      apiVersion: management.cattle.io/v3
      kind: Setting
      metadata:
        name: auth-provider
      value: github
      EOF

      echo "⏳ Waiting for Rancher webhook pod to be created..."

      # Wait until a pod with the correct label appears
      while ! sudo kubectl get pod -n cattle-system -l app=rancher-webhook --no-headers --kubeconfig=/etc/rancher/rke2/rke2.yaml | grep -q .; do
        echo "🔄 Pod not found yet..."
        sleep 60
      done

      echo "⏳ Pod found. Waiting for Rancher webhook pod to become Ready..."

      echo "⏳ Waiting for Rancher webhook pod to become Ready..."
      sudo kubectl wait \
        --for=condition=Ready pod -l app=rancher-webhook \
        -n cattle-system \
        --timeout=1800s \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml || {
          echo "❌ Rancher webhook pod did not become Ready in time"
          exit 1
      }

      echo "⏳ Waiting for Rancher webhook endpoint to become healthy..."

      while true; do
        if ! sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml &>/dev/null; then
          echo "🔄 Endpoint not found yet..."
        elif sudo kubectl -n cattle-system get endpoints rancher-webhook --kubeconfig=/etc/rancher/rke2/rke2.yaml \
                -o jsonpath="{.subsets[*].addresses[*].ip}" | grep -qE '([0-9]{1,3}\.){3}[0-9]{1,3}'; then
          echo "✅ Rancher webhook is ready"
          break
        else
          echo "🔄 Endpoint exists but has no ready IPs yet..."
        fi
        sleep 10
      done

      echo "🔧 Patching all Rancher webhooks with timeoutSeconds=30..."
      # Extract webhook indices and names using jq
      mapfile -t WEBHOOKS < <(
        sudo kubectl get validatingwebhookconfiguration rancher.cattle.io \
          -o=json \
          --kubeconfig=/etc/rancher/rke2/rke2.yaml |
          jq -r '.webhooks | to_entries[] | "[" + (.key|tostring) + "] " + .value.name'
      )

      # Build JSON patch
      PATCHES=""
      SEP=""
      for entry in "$WEBHOOKS[@]"; do
        index=$(echo "$entry" | grep -oP '^\[\K[0-9]+')
        name=$(echo "$entry" | cut -d' ' -f2-)
        echo "  → Patching webhook [$index]: $name"
        PATCHES="$PATCHES$SEP{\"op\": \"replace\", \"path\": \"/webhooks/$index/timeoutSeconds\", \"value\": 30}"
        SEP=","
      done

      PATCH_JSON="[$PATCHES]"

      # Apply the patch
      sudo kubectl patch validatingwebhookconfiguration rancher.cattle.io \
        --type=json \
        -p="$PATCH_JSON" \
        --kubeconfig=/etc/rancher/rke2/rke2.yaml

      (
      set -euo pipefail

      # ---------------------------------------------------------------------------
      # Resource management (VPA + Kyverno policies + Goldilocks)
      # Run immediately after Rancher projects exist so workloads land with defaults.
      # ---------------------------------------------------------------------------

      echo "📦 Bootstrapping resource management (VPA + Kyverno policies + Goldilocks)..."

      echo "📦 Applying VPA CRDs (required before Kyverno can validate VPA generate policies)..."
      cat <<'EOF' | sudo kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml apply -f -
      ---
      apiVersion: apiextensions.k8s.io/v1
      kind: CustomResourceDefinition
      metadata:
        annotations:
          api-approved.kubernetes.io: https://github.com/kubernetes/kubernetes/pull/63797
          controller-gen.kubebuilder.io/version: v0.16.5
        name: verticalpodautoscalercheckpoints.autoscaling.k8s.io
      spec:
        group: autoscaling.k8s.io
        names:
          kind: VerticalPodAutoscalerCheckpoint
          listKind: VerticalPodAutoscalerCheckpointList
          plural: verticalpodautoscalercheckpoints
          shortNames:
          - vpacheckpoint
          singular: verticalpodautoscalercheckpoint
        scope: Namespaced
        versions:
        - name: v1
          schema:
            openAPIV3Schema:
              description: |-
                VerticalPodAutoscalerCheckpoint is the checkpoint of the internal state of VPA that
                is used for recovery after recommender's restart.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    Specification of the checkpoint.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#spec-and-status.
                  properties:
                    containerName:
                      description: Name of the checkpointed container.
                      type: string
                    vpaObjectName:
                      description: Name of the VPA object that stored VerticalPodAutoscalerCheckpoint
                        object.
                      type: string
                  type: object
                status:
                  description: Data of the checkpoint.
                  properties:
                    cpuHistogram:
                      description: Checkpoint of histogram for consumption of CPU.
                      properties:
                        bucketWeights:
                          description: Map from bucket index to bucket weight.
                          type: object
                          x-kubernetes-preserve-unknown-fields: true
                        referenceTimestamp:
                          description: Reference timestamp for samples collected within
                            this histogram.
                          format: date-time
                          nullable: true
                          type: string
                        totalWeight:
                          description: Sum of samples to be used as denominator for weights
                            from BucketWeights.
                          type: number
                      type: object
                    firstSampleStart:
                      description: Timestamp of the first sample from the histograms.
                      format: date-time
                      nullable: true
                      type: string
                    lastSampleStart:
                      description: Timestamp of the last sample from the histograms.
                      format: date-time
                      nullable: true
                      type: string
                    lastUpdateTime:
                      description: The time when the status was last refreshed.
                      format: date-time
                      nullable: true
                      type: string
                    memoryHistogram:
                      description: Checkpoint of histogram for consumption of memory.
                      properties:
                        bucketWeights:
                          description: Map from bucket index to bucket weight.
                          type: object
                          x-kubernetes-preserve-unknown-fields: true
                        referenceTimestamp:
                          description: Reference timestamp for samples collected within
                            this histogram.
                          format: date-time
                          nullable: true
                          type: string
                        totalWeight:
                          description: Sum of samples to be used as denominator for weights
                            from BucketWeights.
                          type: number
                      type: object
                    totalSamplesCount:
                      description: Total number of samples in the histograms.
                      type: integer
                    version:
                      description: Version of the format of the stored data.
                      type: string
                  type: object
              type: object
          served: true
          storage: true
        - name: v1beta2
          schema:
            openAPIV3Schema:
              description: |-
                VerticalPodAutoscalerCheckpoint is the checkpoint of the internal state of VPA that
                is used for recovery after recommender's restart.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    Specification of the checkpoint.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#spec-and-status.
                  properties:
                    containerName:
                      description: Name of the checkpointed container.
                      type: string
                    vpaObjectName:
                      description: Name of the VPA object that stored VerticalPodAutoscalerCheckpoint
                        object.
                      type: string
                  type: object
                status:
                  description: Data of the checkpoint.
                  properties:
                    cpuHistogram:
                      description: Checkpoint of histogram for consumption of CPU.
                      properties:
                        bucketWeights:
                          description: Map from bucket index to bucket weight.
                          type: object
                          x-kubernetes-preserve-unknown-fields: true
                        referenceTimestamp:
                          description: Reference timestamp for samples collected within
                            this histogram.
                          format: date-time
                          nullable: true
                          type: string
                        totalWeight:
                          description: Sum of samples to be used as denominator for weights
                            from BucketWeights.
                          type: number
                      type: object
                    firstSampleStart:
                      description: Timestamp of the first sample from the histograms.
                      format: date-time
                      nullable: true
                      type: string
                    lastSampleStart:
                      description: Timestamp of the last sample from the histograms.
                      format: date-time
                      nullable: true
                      type: string
                    lastUpdateTime:
                      description: The time when the status was last refreshed.
                      format: date-time
                      nullable: true
                      type: string
                    memoryHistogram:
                      description: Checkpoint of histogram for consumption of memory.
                      properties:
                        bucketWeights:
                          description: Map from bucket index to bucket weight.
                          type: object
                          x-kubernetes-preserve-unknown-fields: true
                        referenceTimestamp:
                          description: Reference timestamp for samples collected within
                            this histogram.
                          format: date-time
                          nullable: true
                          type: string
                        totalWeight:
                          description: Sum of samples to be used as denominator for weights
                            from BucketWeights.
                          type: number
                      type: object
                    totalSamplesCount:
                      description: Total number of samples in the histograms.
                      type: integer
                    version:
                      description: Version of the format of the stored data.
                      type: string
                  type: object
              type: object
          served: false
          storage: false
      ---
      apiVersion: apiextensions.k8s.io/v1
      kind: CustomResourceDefinition
      metadata:
        annotations:
          api-approved.kubernetes.io: https://github.com/kubernetes/kubernetes/pull/63797
          controller-gen.kubebuilder.io/version: v0.16.5
        name: verticalpodautoscalers.autoscaling.k8s.io
      spec:
        group: autoscaling.k8s.io
        names:
          kind: VerticalPodAutoscaler
          listKind: VerticalPodAutoscalerList
          plural: verticalpodautoscalers
          shortNames:
          - vpa
          singular: verticalpodautoscaler
        scope: Namespaced
        versions:
        - additionalPrinterColumns:
          - jsonPath: .spec.updatePolicy.updateMode
            name: Mode
            type: string
          - jsonPath: .status.recommendation.containerRecommendations[0].target.cpu
            name: CPU
            type: string
          - jsonPath: .status.recommendation.containerRecommendations[0].target.memory
            name: Mem
            type: string
          - jsonPath: .status.conditions[?(@.type=='RecommendationProvided')].status
            name: Provided
            type: string
          - jsonPath: .metadata.creationTimestamp
            name: Age
            type: date
          name: v1
          schema:
            openAPIV3Schema:
              description: |-
                VerticalPodAutoscaler is the configuration for a vertical pod
                autoscaler, which automatically manages pod resources based on historical and
                real time resource utilization.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    Specification of the behavior of the autoscaler.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#spec-and-status.
                  properties:
                    recommenders:
                      description: |-
                        Recommender responsible for generating recommendation for this object.
                        List should be empty (then the default recommender will generate the
                        recommendation) or contain exactly one recommender.
                      items:
                        description: |-
                          VerticalPodAutoscalerRecommenderSelector points to a specific Vertical Pod Autoscaler recommender.
                          In the future it might pass parameters to the recommender.
                        properties:
                          name:
                            description: Name of the recommender responsible for generating
                              recommendation for this object.
                            type: string
                        required:
                        - name
                        type: object
                      type: array
                    resourcePolicy:
                      description: |-
                        Controls how the autoscaler computes recommended resources.
                        The resource policy may be used to set constraints on the recommendations
                        for individual containers.
                        If any individual containers need to be excluded from getting the VPA recommendations, then
                        it must be disabled explicitly by setting mode to "Off" under containerPolicies.
                        If not specified, the autoscaler computes recommended resources for all containers in the pod,
                        without additional constraints.
                      properties:
                        containerPolicies:
                          description: Per-container resource policies.
                          items:
                            description: |-
                              ContainerResourcePolicy controls how autoscaler computes the recommended
                              resources for a specific container.
                            properties:
                              containerName:
                                description: |-
                                  Name of the container or DefaultContainerResourcePolicy, in which
                                  case the policy is used by the containers that don't have their own
                                  policy specified.
                                type: string
                              controlledResources:
                                description: |-
                                  Specifies the type of recommendations that will be computed
                                  (and possibly applied) by VPA.
                                  If not specified, the default of [ResourceCPU, ResourceMemory] will be used.
                                items:
                                  description: ResourceName is the name identifying various
                                    resources in a ResourceList.
                                  type: string
                                type: array
                              controlledValues:
                                description: |-
                                  Specifies which resource values should be controlled.
                                  The default is "RequestsAndLimits".
                                enum:
                                - RequestsAndLimits
                                - RequestsOnly
                                type: string
                              maxAllowed:
                                additionalProperties:
                                  anyOf:
                                  - type: integer
                                  - type: string
                                  pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                  x-kubernetes-int-or-string: true
                                description: |-
                                  Specifies the maximum amount of resources that will be recommended
                                  for the container. The default is no maximum.
                                type: object
                              minAllowed:
                                additionalProperties:
                                  anyOf:
                                  - type: integer
                                  - type: string
                                  pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                  x-kubernetes-int-or-string: true
                                description: |-
                                  Specifies the minimal amount of resources that will be recommended
                                  for the container. The default is no minimum.
                                type: object
                              mode:
                                description: Whether autoscaler is enabled for the container.
                                  The default is "Auto".
                                enum:
                                - Auto
                                - "Off"
                                type: string
                              oomBumpUpRatio:
                                anyOf:
                                - type: integer
                                - type: string
                                description: oomBumpUpRatio is the ratio to increase memory
                                  when OOM is detected.
                                pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                x-kubernetes-int-or-string: true
                              oomMinBumpUp:
                                anyOf:
                                - type: integer
                                - type: string
                                description: oomMinBumpUp is the minimum increase in memory
                                  when OOM is detected.
                                pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                x-kubernetes-int-or-string: true
                            type: object
                          type: array
                      type: object
                    targetRef:
                      description: |-
                        TargetRef points to the controller managing the set of pods for the
                        autoscaler to control - e.g. Deployment, StatefulSet. VerticalPodAutoscaler
                        can be targeted at controller implementing scale subresource (the pod set is
                        retrieved from the controller's ScaleStatus) or some well known controllers
                        (e.g. for DaemonSet the pod set is read from the controller's spec).
                        If VerticalPodAutoscaler cannot use specified target it will report
