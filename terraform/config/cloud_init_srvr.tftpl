      systemctl restart systemd-networkd

  - path: /usr/local/bin/02-setup-ip-alias.sh
    permissions: '0755'
    content: |
        #!/bin/bash
        set -eu

        IFACE="${SRVR_IP_ALIAS_IFACE}"
        IP_ADDR="${SRVR_IP_ALIAS}"
        CIDR="${SRVR_IP_ALIAS_CIDR}"

        if [ -z "$IP_ADDR" ] || [ -z "$CIDR" ] || [ -z "$IFACE" ]; then
          echo "⚠️ SRVR_IP_ALIAS_IFACE/SRVR_IP_ALIAS/SRVR_IP_ALIAS_CIDR not set; skipping."
          exit 0
        fi

        ALIAS="$IP_ADDR/$CIDR"

        # If interface is down, don't fail hard—just exit so timer will try again later.
        if ! ip link show dev "$IFACE" >/dev/null 2>&1; then
          echo "⚠️ Interface $IFACE not found."
          exit 0
        fi

        # Re-add if missing
        if ip -4 -o addr show dev "$IFACE" | awk '{print $4}' | grep -Fxq "$ALIAS"; then
          echo "✅ IP alias $ALIAS already present on $IFACE"
          exit 0
        fi

        echo "🌐 Re-adding IP alias $ALIAS to $IFACE..."
        ip addr add "$ALIAS" dev "$IFACE"

