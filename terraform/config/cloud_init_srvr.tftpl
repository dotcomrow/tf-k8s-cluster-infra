#cloud-config
hostname: ${hostname}

users:
  - name: ubuntu
    sudo:
      - "ALL=(ALL) NOPASSWD:ALL"
    groups: users, admin
    shell: /bin/bash
    lock_passwd: ${VM_CONSOLE_LOCK_PASSWORD}
    ssh_authorized_keys:
      - ${ssh_keys}

chpasswd:
  expire: false
  list: |
    ubuntu:${VM_CONSOLE_PASSWORD}

bootcmd:
  - [ systemctl, stop, apt-daily.service, apt-daily-upgrade.service ]
  - [ systemctl, disable, apt-daily.timer, apt-daily-upgrade.timer ]
  - [ systemctl, mask, apt-daily.service, apt-daily-upgrade.service ]

ssh_pwauth: false
package_update: true
package_upgrade: true
apt:
  conf: |
    Acquire::Retries "10";
    Acquire::http::Timeout "15";
    Acquire::https::Timeout "15";
    Acquire::ForceIPv4 "true";
    DPkg::Lock::Timeout "600";

packages:
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg-agent
  - software-properties-common
  - zsh
  - nfs-common
  - gnupg
  - lsb-release
  - nftables
  - dnsmasq
  - ethtool
  - jq
  - cockpit
  - sscg

growpart:
  mode: auto
  devices: ["/"]

write_files:
  - path: /etc/systemd/system/initial-setup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Post-bootstrap setup for Kubernetes node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/environment
      ExecStart=/usr/local/bin/initial-setup.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/initial-setup.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # export HTTP_PROXY=http://10.0.0.10:3128
      # export HTTPS_PROXY=http://10.0.0.10:3128
      # export NO_PROXY=127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12

      # update-ca-certificates
      systemctl daemon-reload
      /usr/local/bin/performance-tuning.sh
      sysctl --system
      systemctl daemon-reload

      systemctl enable set-dhcp-hostname.service
      systemctl start set-dhcp-hostname.service

      systemctl enable setup-ip-alias.service
      systemctl start setup-ip-alias.service

      sudo systemctl daemon-reload
      sudo systemctl enable --now setup-ip-alias.service
      sudo systemctl enable --now setup-ip-alias.timer

      # Confirm it’s scheduled
      systemctl list-timers | grep setup-ip-alias

      systemctl enable fix-dns-nfs.service
      systemctl start fix-dns-nfs.service

      /usr/local/bin/setup-nfs-modules.sh
      systemctl start load-nfs-modules.service

      systemctl enable --now mount-shared-storage.service

      systemctl enable disable-swap.service
      systemctl start disable-swap.service

      systemctl restart systemd-journald || true

      systemctl enable setup-hosts-dns.service
      systemctl start setup-hosts-dns.service

      systemctl enable configure-logging.service
      systemctl start configure-logging.service

      systemctl enable setup-cockpit.service
      systemctl start setup-cockpit.service

      systemctl enable setup-cockpit-oauth2-proxy.service
      systemctl start setup-cockpit-oauth2-proxy.service

      systemctl enable setup-runtime.service
      systemctl start setup-runtime.service

      systemctl enable rke2-preload-images.service
      systemctl start rke2-preload-images.service

      systemctl enable bootstrap-rke2.service
      systemctl start bootstrap-rke2.service

      systemctl enable set-nofile-limits.service
      systemctl start set-nofile-limits.service

      systemctl enable k8s-addons.service
      systemctl start k8s-addons.service

      systemctl enable install-apisix-rancher.service
      systemctl start install-apisix-rancher.service

      systemctl enable gpu.service
      systemctl start gpu.service

      systemctl enable post-install.service
      systemctl start post-install.service
      /usr/local/bin/cleanup-install-services.sh

  - path: /root/oo-auth-bridge.py
    permissions: '0755'
    content: |
      import base64
      import hashlib
      import hmac
      import json
      import os
      import time
      import urllib.error
      import urllib.parse
      import urllib.request
      from datetime import timezone
      from email.utils import parsedate_to_datetime
      from http.server import BaseHTTPRequestHandler, HTTPServer

      OO_URL = os.getenv("OO_URL", "http://openobserve-router:5080").rstrip("/")
      OO_ORG = os.getenv("OO_ORG", "default")
      OO_ADMIN_USER = os.environ["OO_ADMIN_USER"]
      OO_ADMIN_PASS = os.environ["OO_ADMIN_PASS"]
      HMAC_SECRET = os.environ["OO_USER_PASSWORD_SECRET"].encode("utf-8")
      OO_EMAIL_HEADER = os.getenv("OO_EMAIL_HEADER", "X-Auth-Request-Email")
      OO_LOGIN_HEADER = os.getenv("OO_LOGIN_HEADER", "X-Auth-Request-User")
      OO_LISTEN_PORT = int(os.getenv("OO_LISTEN_PORT", "4181"))
      TOKEN_CACHE = {}
      TOKEN_CACHE_SKEW = 30

      _basic = base64.b64encode(f"{OO_ADMIN_USER}:{OO_ADMIN_PASS}".encode("utf-8")).decode("ascii")
      ADMIN_HEADERS = {
          "Authorization": f"Basic {_basic}",
          "Content-Type": "application/json",
          "Accept": "application/json",
          "organization": OO_ORG,
      }

      def log(msg: str) -> None:
          print(f"[oo-auth-bridge] {msg}", flush=True)

      def derive_password(email: str) -> str:
          email_norm = email.strip().lower()
          digest = hmac.new(HMAC_SECRET, email_norm.encode("utf-8"), hashlib.sha256).digest()
          pwd = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")
          return (pwd[:32] + "A!").replace("-", "A").replace("_", "B")

      def parse_cookie_expiry(attrs: list[str]) -> float:
          max_age = None
          expires_at = None
          for attr in attrs:
              lower = attr.lower()
              if lower.startswith("max-age="):
                  try:
                      max_age = int(attr.split("=", 1)[1])
                  except ValueError:
                      pass
              elif lower.startswith("expires="):
                  try:
                      dt = parsedate_to_datetime(attr.split("=", 1)[1].strip())
                      if dt.tzinfo is None:
                          expires_at = dt.replace(tzinfo=timezone.utc).timestamp()
                      else:
                          expires_at = dt.timestamp()
                  except Exception:
                      pass
          if max_age is not None:
              return time.time() + max_age
          if expires_at is not None:
              return expires_at
          return time.time() + 3600

      def extract_auth_token(cookies: list[str]) -> tuple[str | None, float | None]:
          for cookie in cookies:
              parts = [p.strip() for p in cookie.split(";") if p.strip()]
              if not parts:
                  continue
              if not parts[0].startswith("auth_tokens="):
                  continue
              token = parts[0].split("=", 1)[1]
              return token, parse_cookie_expiry(parts[1:])
          return None, None

      def cached_token(email: str) -> str | None:
          entry = TOKEN_CACHE.get(email)
          if not entry:
              return None
          token, expires_at = entry
          if expires_at - time.time() > TOKEN_CACHE_SKEW:
              return token
          TOKEN_CACHE.pop(email, None)
          return None

      def cache_token(email: str, token: str, expires_at: float | None) -> None:
          TOKEN_CACHE[email] = (token, expires_at or (time.time() + 3600))

      def http_json(url: str, method: str, *, body=None, headers=None, timeout: int = 20):
          data = None
          hdrs = dict(ADMIN_HEADERS)
          if headers:
              hdrs.update(headers)
          if body is not None:
              data = json.dumps(body).encode("utf-8")
          req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
          try:
              with urllib.request.urlopen(req, timeout=timeout) as res:
                  raw = res.read() or b""
                  txt = raw.decode("utf-8", "replace")
                  try:
                      obj = json.loads(txt) if txt else {}
                  except Exception:
                      obj = None
                  return res.status, obj, txt, res.headers
          except urllib.error.HTTPError as e:
              txt = (e.read() or b"").decode("utf-8", "replace")
              return e.code, None, txt, e.headers
          except Exception as e:
              log(f"http error url={url} method={method}: {e}")
              return 599, None, "", None

      def ensure_user(email: str, first_name: str, password: str) -> None:
          status, _, txt, _ = http_json(
              f"{OO_URL}/api/{OO_ORG}/users",
              "POST",
              body={
                  "email": email,
                  "password": password,
                  "role": "admin",
                  "first_name": first_name,
                  "last_name": "",
              },
          )
          if status == 200:
              log(f"created user email={email}")
          elif status == 400 and "already exists" in txt.lower():
              log(f"user already exists email={email}")
          elif status in (200,):
              pass
          else:
              log(f"user create failed email={email} status={status} body={txt[:200]}")

          encoded = urllib.parse.quote(email, safe="")
          status, _, txt, _ = http_json(
              f"{OO_URL}/api/{OO_ORG}/users/{encoded}",
              "PUT",
              body={
                  "change_password": True,
                  "new_password": password,
                  "first_name": first_name,
                  "last_name": "",
              },
          )
          if status == 200:
              log(f"password synced email={email}")
          else:
              log(f"user update failed email={email} status={status} body={txt[:200]}")

      def user_info_payload(email: str, login_name: str) -> dict:
          return {
              "email": email,
              "name": login_name,
              "family_name": login_name,
              "given_name": "",
          }

      def fetch_auth_cookies(email: str, password: str) -> list[str]:
          data = json.dumps({"name": email, "password": password}).encode("utf-8")
          req = urllib.request.Request(
              f"{OO_URL}/auth/login",
              data=data,
              method="POST",
              headers={"Content-Type": "application/json"},
          )
          try:
              with urllib.request.urlopen(req, timeout=20) as res:
                  return res.headers.get_all("Set-Cookie") or []
          except urllib.error.HTTPError as e:
              body = (e.read() or b"").decode("utf-8", "replace")
              log(f"login failed email={email} status={e.code} body={body[:200]}")
          except Exception as e:
              log(f"login error email={email}: {e}")
          return []

      class Handler(BaseHTTPRequestHandler):
          def do_GET(self):
              if self.path == "/health":
                  self.send_response(200)
                  self.end_headers()
                  self.wfile.write(b"ok")
                  return

              email = self.headers.get(OO_EMAIL_HEADER)
              login_name = self.headers.get(OO_LOGIN_HEADER)
              if not email:
                  for header in (
                      "X-Forwarded-Email",
                      "X-Auth-Request-Email",
                      "X-Auth-Request-User",
                      "X-Forwarded-User",
                  ):
                      value = self.headers.get(header)
                      if value and "@" in value:
                          email = value
                          break
              if not email:
                  debug_headers = {
                      k: self.headers.get(k)
                      for k in (
                          "X-Auth-Request-Email",
                          "X-Auth-Request-User",
                          "X-Auth-Request-Preferred-Username",
                          "X-Forwarded-Email",
                          "X-Forwarded-User",
                          "X-Forwarded-Proto",
                          "X-Forwarded-Host",
                      )
                      if self.headers.get(k)
                  }
                  log(f"missing email header headers={debug_headers}")
                  self.send_response(401)
                  self.send_header("Content-Type", "text/plain")
                  self.end_headers()
                  self.wfile.write(b"missing email header")
                  return

              if login_name and "/" in login_name:
                  login_name = login_name.split("/")[-1]
              if not login_name:
                  login_name = email.split("@", 1)[0]

              password = derive_password(email)
              log(f"request path={self.path} email={email} login={login_name}")

              if self.path == "/__oo_userinfo":
                  ensure_user(email, login_name, password)
                  payload = user_info_payload(email, login_name)
                  body = json.dumps(payload).encode("utf-8")
                  self.send_response(200)
                  self.send_header("Content-Type", "application/json")
                  self.send_header("Cache-Control", "no-store")
                  self.end_headers()
                  self.wfile.write(body)
                  return

              ensure_user(email, login_name, password)
              if self.path == "/__oo_token":
                  token = cached_token(email)
                  if not token:
                      cookies = fetch_auth_cookies(email, password)
                      token, expires_at = extract_auth_token(cookies)
                      if not token:
                          self.send_response(502)
                          self.end_headers()
                          self.wfile.write(b"failed to log in")
                          return
                      cache_token(email, token, expires_at)
                  self.send_response(204)
                  self.send_header("X-OO-Auth-Token", token)
                  self.send_header("Cache-Control", "no-store")
                  self.end_headers()
                  return

              cookies = fetch_auth_cookies(email, password)
              if not cookies:
                  self.send_response(502)
                  self.end_headers()
                  self.wfile.write(b"failed to log in")
                  return
              token, expires_at = extract_auth_token(cookies)
              if token:
                  cache_token(email, token, expires_at)

              rewritten = []
              for cookie in cookies:
                  try:
                      parts = [p.strip() for p in cookie.split(";") if p.strip()]
                      if not parts:
                          continue
                      attrs = [
                          p
                          for p in parts[1:]
                          if not p.lower().startswith("domain=") and not p.lower().startswith("path=")
                      ]
                      attrs.append("Path=/")
                      rewritten.append("; ".join([parts[0]] + attrs))
                  except Exception as e:
                      log(f"failed to rewrite cookie: {e}")
                      rewritten.append(cookie)

              self.send_response(302)
              for cookie in rewritten:
                  self.send_header("Set-Cookie", cookie)
              self.send_header("Location", "/web/")
              self.send_header("Cache-Control", "no-store")
              self.end_headers()

          def log_message(self, format, *args):
              return

      if __name__ == "__main__":
          log(
              f"start listen_port={OO_LISTEN_PORT} org={OO_ORG} email_header={OO_EMAIL_HEADER} login_header={OO_LOGIN_HEADER}"
          )
          HTTPServer(("0.0.0.0", OO_LISTEN_PORT), Handler).serve_forever()

  - path: /root/oo-auth-nginx.conf
    permissions: '0644'
    content: |
      worker_processes  1;
      events { worker_connections  1024; }
      http {
        upstream oo_router { server openobserve-router.openobserve.svc.cluster.local:5080; }
        upstream oauth2_proxy { server oo-oauth2-proxy.openobserve.svc.cluster.local:4180; }
        upstream oo_bridge { server oo-auth-bridge.openobserve.svc.cluster.local:4181; }
        map $http_cookie $has_auth_tokens {
          default 0;
          "~*auth_tokens=" 1;
        }
        server {
          listen 5080;
          set $public_host "openobserve.teleport.app.${RANCHER_DOMAIN}";

        location /oauth2/ {
          auth_request off;
          proxy_pass http://oauth2_proxy;
          proxy_set_header Host $public_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $public_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Cookie $http_cookie;
        }

        location = /oauth2/auth {
          auth_request off;
          proxy_pass http://oauth2_proxy;
          proxy_set_header Host $public_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $public_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Content-Length "";
          proxy_pass_request_body off;
          proxy_set_header Cookie $http_cookie;
        }

          error_page 401 = /oauth2/sign_in?rd=/__oo_login;

        location = /__oo_login {
          auth_request /oauth2/auth;
          auth_request_set $auth_user  $upstream_http_x_auth_request_user;
          auth_request_set $auth_email $upstream_http_x_auth_request_email;
          proxy_set_header X-Auth-Request-User $auth_user;
          proxy_set_header X-Auth-Request-Email $auth_email;
          proxy_set_header Host $host;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_pass http://oo_bridge/__oo_login;
        }

        location = /__oo_userinfo {
          auth_request /oauth2/auth;
          auth_request_set $auth_user  $upstream_http_x_auth_request_user;
          auth_request_set $auth_email $upstream_http_x_auth_request_email;
          proxy_set_header X-Auth-Request-User $auth_user;
          proxy_set_header X-Auth-Request-Email $auth_email;
          proxy_set_header Host $host;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_pass http://oo_bridge/__oo_userinfo;
        }

        location = / {
          return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
        }

        location = /web/ {
          if ($has_auth_tokens = 0) {
            return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
          }
          proxy_pass http://oo_router;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header Accept-Encoding "";
          sub_filter_once on;
          sub_filter_types text/html;
          sub_filter '</head>' '<script>try{if(!localStorage.getItem("userInfo")){fetch("/__oo_userinfo",{credentials:"include"}).then(function(r){return r.ok?r.json():null;}).then(function(data){if(!data||!data.email){return;}var json=JSON.stringify(data);var enc=btoa(encodeURIComponent(json).replace(/%([0-9A-F]{2})/g,function(m,p1){return String.fromCharCode(parseInt("0x"+p1));}));localStorage.setItem("userInfo",enc);if(window.location.pathname==="/web/login"){window.location.replace("/web/");}}).catch(function(){});}}catch(e){};</script></head>';
        }

        location = /web/login {
          if ($has_auth_tokens = 1) {
            return 302 /web/;
          }
          return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
          }

          location / {
            if ($has_auth_tokens = 0) {
              return 302 https://openobserve.teleport.app.${RANCHER_DOMAIN}/__oo_login;
            }
            proxy_pass http://oo_router;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          }
        }
      }

  - path: /root/oo-auth-proxy.yaml
    permissions: '0644'
    content: |
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oo-auth-bridge
        namespace: openobserve
        labels:
          app: oo-auth-bridge
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oo-auth-bridge
        template:
          metadata:
            labels:
              app: oo-auth-bridge
          spec:
            containers:
            - name: bridge
              image: python:3.12-slim
              imagePullPolicy: IfNotPresent
              env:
              - name: OO_URL
                value: http://openobserve-router:5080
              - name: OO_ORG
                value: default
              - name: OO_ADMIN_USER
                valueFrom:
                  secretKeyRef:
                    name: openobserve-root-creds
                    key: username
              - name: OO_ADMIN_PASS
                valueFrom:
                  secretKeyRef:
                    name: openobserve-root-creds
                    key: password
              - name: OO_USER_PASSWORD_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-auth-bridge
                    key: hmac_secret
              - name: OO_EMAIL_HEADER
                value: X-Auth-Request-Email
              - name: OO_LOGIN_HEADER
                value: X-Auth-Request-User
              ports:
              - name: http
                containerPort: 4181
              volumeMounts:
              - name: bridge-script
                mountPath: /app
              command: ["python"]
              args: ["/app/bridge.py"]
            volumes:
            - name: bridge-script
              configMap:
                name: oo-auth-bridge
                defaultMode: 0555
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oo-auth-bridge
        namespace: openobserve
      spec:
        selector:
          app: oo-auth-bridge
        ports:
        - name: http
          port: 4181
          targetPort: http
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: oo-oauth2-proxy
        namespace: openobserve
        labels:
          app: oo-oauth2-proxy
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: oo-oauth2-proxy
        template:
          metadata:
            labels:
              app: oo-oauth2-proxy
          spec:
            containers:
            - name: oauth2-proxy
              image: quay.io/oauth2-proxy/oauth2-proxy:v7.6.0-alpine
              imagePullPolicy: IfNotPresent
              command: ["/bin/sh", "-c"]
              args:
              - exec oauth2-proxy --http-address=0.0.0.0:4180 --provider=oidc --oidc-issuer-url=https://openobserve-dex.teleport.app.${RANCHER_DOMAIN}/dex --redirect-url=https://openobserve.teleport.app.${RANCHER_DOMAIN}/oauth2/callback --email-domain=* --scope="openid profile email groups" --upstream=http://openobserve-router.openobserve.svc.cluster.local:5080/ --reverse-proxy=true --set-xauthrequest=true --cookie-secret="${OAUTH2_PROXY_COOKIE_SECRET}" --cookie-secure=true --cookie-samesite=lax --cookie-refresh=1h --cookie-expire=8h --skip-provider-button=true
              env:
              - name: OAUTH2_PROXY_CLIENT_ID
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: client_id
              - name: OAUTH2_PROXY_CLIENT_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: client_secret
              - name: OAUTH2_PROXY_COOKIE_SECRET
                valueFrom:
                  secretKeyRef:
                    name: oo-oauth2-proxy
                    key: cookie_secret
              ports:
              - name: http
                containerPort: 4180
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: oo-oauth2-proxy
        namespace: openobserve
      spec:
        selector:
          app: oo-oauth2-proxy
        ports:
        - name: http
          port: 4180
          targetPort: http
      ---
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: openobserve-auth-proxy
        namespace: openobserve
        labels:
          app: openobserve-auth-proxy
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: openobserve-auth-proxy
        template:
          metadata:
            labels:
              app: openobserve-auth-proxy
          spec:
            containers:
            - name: nginx
              image: nginx:1.27-alpine
              imagePullPolicy: IfNotPresent
              ports:
              - name: http
                containerPort: 5080
              volumeMounts:
              - name: nginx-conf
                mountPath: /etc/nginx/nginx.conf
                subPath: nginx.conf
                readOnly: true
            volumes:
            - name: nginx-conf
              configMap:
                name: oo-auth-proxy-nginx
                defaultMode: 0444
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: openobserve-auth-proxy
        namespace: openobserve
      spec:
        selector:
          app: openobserve-auth-proxy
        ports:
        - name: http
          port: 5080
          targetPort: http

  - path: /usr/local/bin/cleanup-install-services.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      INSTALL_SERVICES=(
        initial-setup.service
        set-dhcp-hostname.service
        fix-dns-nfs.service
        disable-swap.service
        setup-hosts-dns.service
        configure-logging.service
        setup-cockpit.service
        setup-runtime.service
        rke2-preload-images.service
        bootstrap-rke2.service
        set-nofile-limits.service
        k8s-addons.service
        install-apisix-rancher.service
        gpu.service
        post-install.service
      )

      for svc in "$INSTALL_SERVICES[@]"; do
        if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
          systemctl disable "$svc" || true
          systemctl reset-failed "$svc" || true
        fi
      done

  - path: /usr/local/bin/performance-tuning.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Applying performance tuning..."
      
      # CPU Governor
      GOVERNOR_PATH="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
      if [ -f "$GOVERNOR_PATH" ]; then
        for CPU in /sys/devices/system/cpu/cpu[0-9]*; do
          echo performance > "$CPU/cpufreq/scaling_governor" 2>/dev/null || true
        done
        echo "✅ CPU governors set to performance"
      else
        echo "⚠️ CPU frequency scaling not available — skipping governor tuning"
      fi
      
      # Scheduler tuning for SSDs
      for dev in /sys/block/sd*/queue/scheduler; do
        echo mq-deadline > "$dev"
      done

      systemctl disable apt-daily.timer
      systemctl disable snapd
      systemctl disable motd-news.timer
      
      # Sysctl parameters
      cat <<EOF > /etc/sysctl.d/99-performance-tuning.conf
      fs.inotify.max_user_watches=524288
      vm.max_map_count=262144
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 65536 134217728
      net.ipv4.tcp_congestion_control=bbr
      vm.swappiness=10
      vm.dirty_ratio=15
      vm.dirty_background_ratio=5
      EOF
      
      sysctl --system

      # 2) Pick all “large-MTU” interfaces automatically
      #    (adjust the grep if your jumbo-MTU devices have a different naming scheme)
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        # bring MTU up before offloads
        ip link set dev $IF mtu 9000

        # enable big-packet offloads
        ethtool -K $IF gro on gso on tso on rx on tx on

        # increase the kernel TX queue length
        ip link set dev $IF txqueuelen 10000
      done

      # 3) Sysctls — bump backlog and buffers for all interfaces
      #    and enable TCP MTU probing (helps path-MTU discovery)
      sysctl -w net.core.netdev_max_backlog=250000
      sysctl -w net.core.rmem_max=134217728
      sysctl -w net.core.wmem_max=134217728
      sysctl -w net.ipv4.tcp_rmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_wmem="4096 87380 134217728"
      sysctl -w net.ipv4.tcp_mtu_probing=1

      # 4) Persist sysctls
      cat <<EOF >/etc/sysctl.d/99-network-opt.conf
      net.core.netdev_max_backlog=250000
      net.core.rmem_max=134217728
      net.core.wmem_max=134217728
      net.ipv4.tcp_rmem=4096 87380 134217728
      net.ipv4.tcp_wmem=4096 87380 134217728
      net.ipv4.tcp_mtu_probing=1
      EOF

      # 5) Persist ethtool + txqueuelen via a systemd service
      cat <<'EOF' >/etc/systemd/system/network-tweaks.service
      [Unit]
      Description=Apply ethtool offloads + txqueuelen
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/network-tweaks.sh

      [Install]
      WantedBy=multi-user.target
      EOF

      # Install the same script to /usr/local/bin and make it executable
            cat <<'EOF' >/usr/local/bin/network-tweaks.sh
      #!/bin/bash
      set -e
      for IF in $(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(eth|vtnet)'); do
        CURRENT_MTU=$(ip -o link show "$IF" | awk '{print $4}')
        if [ "$CURRENT_MTU" != "9000" ]; then
          ip link set dev "$IF" mtu 9000
        fi
        ethtool -K $IF gro on gso on tso on rx on tx on
        ip link set dev $IF txqueuelen 10000
      done
      EOF

      chmod +x /usr/local/bin/network-tweaks.sh

      systemctl daemon-reload
      systemctl enable network-tweaks

      echo "✅ Network tweaks applied and will persist across reboots."
      
      # Limit nofile
      cat <<EOF > /etc/security/limits.d/99-nofile.conf
      * soft nofile 1048576
      * hard nofile 1048576
      EOF
      
      # Systemd service overrides
      mkdir -p /etc/systemd/system/containerd.service.d
      mkdir -p /etc/systemd/system/rke2-server.service.d
      mkdir -p /etc/systemd/system/rke2-agent.service.d
      
      cat <<EOF > /etc/systemd/system/containerd.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-server.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF
      
      cat <<EOF > /etc/systemd/system/rke2-agent.service.d/override.conf
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity
      EOF

      # cat <<EOF | sudo tee /etc/profile.d/http_proxy.sh
      # export HTTP_PROXY="http://10.0.0.10:3128"
      # export HTTPS_PROXY="http://10.0.0.10:3128"
      # export NO_PROXY="127.0.0.1,localhost,10.0.0.0/24,10.96.0.0/12,192.168.0.0/16"
      # EOF

      # sudo chmod +x /etc/profile.d/http_proxy.sh

      # Skip aggressive kernel/workqueue boot tuning in guests.
      # It can reduce VM stability and is better handled on the Proxmox host.
      
      systemctl daemon-reload

  - path: /etc/sysctl.d/99-disable-ipv6.conf
    permissions: '0644'
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1

  - path: /etc/default/grub.d/99-disable-ipv6.cfg
    permissions: '0644'
    content: |
      GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX ipv6.disable=1"

  - path: /etc/systemd/system/mount-shared-storage.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount NFS shared storage
      After=network-online.target nfs-common.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'mkdir -p /mnt/shared-storage && /bin/mount -t nfs -o rw,_netdev,hard,intr,noatime,nolock,bg,retry=10 ${proxmox_host_ip}:/mnt/shared-storage /mnt/shared-storage'
      RemainAfterExit=true
      TimeoutSec=60
      Restart=no

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/10-disable-swap.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "🔧 Disabling swap and modifying fstab..."
      swapoff -a || { echo "❌ Failed to disable swap"; exit 1; }
      cp /etc/fstab /etc/fstab.bak || { echo "❌ Failed to backup fstab"; exit 1; }
      sed -i '/^[^#].*\bswap\b/s/^/#/' /etc/fstab

  - path: /etc/systemd/system/disable-swap.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Disable swap and update fstab
      After=network.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/10-disable-swap.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/15-setup-cockpit.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "Enabling Cockpit..."
      mkdir -p /etc/cockpit
      cat <<EOF >/etc/cockpit/cockpit.conf
      [WebService]
      AllowUnencrypted = true
      Origins = https://${COCKPIT_HOSTNAME}
      EOF

      mkdir -p /etc/systemd/system/cockpit.socket.d
      cat <<'EOF' >/etc/systemd/system/cockpit.socket.d/override.conf
      [Socket]
      ListenStream=
      ListenStream=127.0.0.1:9090
      EOF

      mkdir -p /etc/systemd/system/cockpit-wsinstance-http.service.d
      cat <<'EOF' >/etc/systemd/system/cockpit-wsinstance-http.service.d/override.conf
      [Service]
      ExecStart=
      ExecStart=/usr/lib/cockpit/cockpit-ws --no-tls --local-session=/usr/bin/cockpit-bridge --port=0
      User=ubuntu
      Group=ubuntu
      EOF

      mkdir -p /etc/systemd/system/cockpit-wsinstance-https@.service.d
      cat <<'EOF' >/etc/systemd/system/cockpit-wsinstance-https@.service.d/override.conf
      [Service]
      ExecStart=
      ExecStart=/usr/lib/cockpit/cockpit-ws --for-tls-proxy --local-session=/usr/bin/cockpit-bridge --port=0
      User=ubuntu
      Group=ubuntu
      EOF

      systemctl daemon-reload

      if systemctl list-unit-files cockpit.socket >/dev/null 2>&1; then
        systemctl enable cockpit.socket
        systemctl restart cockpit.socket
        echo "Cockpit enabled on port 9090."
      else
        echo "cockpit.socket not found; is the cockpit package installed?"
      fi

  - path: /etc/oauth2-proxy/cockpit.env
    permissions: '0640'
    content: |
      COCKPIT_HOSTNAME="${COCKPIT_HOSTNAME}"
      COCKPIT_GITHUB_CLIENT_ID="${COCKPIT_GITHUB_CLIENT_ID}"
      COCKPIT_GITHUB_CLIENT_SECRET="${COCKPIT_GITHUB_CLIENT_SECRET}"
      COCKPIT_GITHUB_TEAM="${COCKPIT_GITHUB_TEAM}"
      GITHUB_ORG="${GITHUB_ORG}"
      OAUTH2_PROXY_COOKIE_SECRET="${OAUTH2_PROXY_COOKIE_SECRET}"

  - path: /usr/local/bin/16-setup-cockpit-oauth2-proxy.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      VERSION="7.13.0"
      ARCH="amd64"
      OS="linux"
      TMP_DIR="$(mktemp -d)"

      cleanup() {
        rm -rf "$TMP_DIR"
      }
      trap cleanup EXIT

      if ! id -u oauth2-proxy >/dev/null 2>&1; then
        useradd --system --no-create-home --shell /usr/sbin/nologin oauth2-proxy
      fi

      mkdir -p /etc/oauth2-proxy
      chown root:oauth2-proxy /etc/oauth2-proxy
      chmod 0750 /etc/oauth2-proxy
      chown root:oauth2-proxy /etc/oauth2-proxy/cockpit.env
      chmod 0640 /etc/oauth2-proxy/cockpit.env

      echo "Installing oauth2-proxy v$VERSION..."
      curl -fsSL "https://github.com/oauth2-proxy/oauth2-proxy/releases/download/v$VERSION/oauth2-proxy-v$VERSION.$OS-$ARCH.tar.gz" -o "$TMP_DIR/oauth2-proxy.tgz"
      tar -xzf "$TMP_DIR/oauth2-proxy.tgz" -C "$TMP_DIR"
      install -m 0755 "$TMP_DIR/oauth2-proxy-v$VERSION.$OS-$ARCH/oauth2-proxy" /usr/local/bin/oauth2-proxy

      systemctl daemon-reload
      systemctl enable --now oauth2-proxy-cockpit.service

  - path: /usr/local/bin/cockpit-oauth2-proxy.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      exec /usr/local/bin/oauth2-proxy \
        --provider=github \
        --http-address=0.0.0.0:4180 \
        --upstream=http://127.0.0.1:9090/ \
        --email-domain=* \
        --cookie-secret="${OAUTH2_PROXY_COOKIE_SECRET}" \
        --client-id="${COCKPIT_GITHUB_CLIENT_ID}" \
        --client-secret="${COCKPIT_GITHUB_CLIENT_SECRET}" \
        --redirect-url="https://${COCKPIT_HOSTNAME}/oauth2/callback" \
        --scope="user:email,read:org" \
        --allowed-group="${GITHUB_ORG}:${COCKPIT_GITHUB_TEAM}" \
        --cookie-secure=true \
        --cookie-samesite=lax \
        --cookie-refresh=1h \
        --cookie-expire=8h \
        --cookie-csrf-per-request=true \
        --cookie-csrf-expire=5m \
        --cookie-name=_oauth2_proxy_cockpit \
        --whitelist-domain="${COCKPIT_HOSTNAME}" \
        --reverse-proxy=true \
        --proxy-websockets=true \
        --pass-host-header=true

  - path: /usr/local/bin/20-configure-logging.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      echo "📦 Configuring Fluent Bit for GCP logging..."

      mkdir -p /etc/google-cloud-ops-agent
      echo "${GCP_LOGGING_KEY}" | base64 -d > /etc/google-cloud-ops-agent/logging-key.json

      DISTRO=$(lsb_release -cs)
      if [ "$DISTRO" = "${UBUNTU_RELEASE_CODE_NAME}" ]; then
        echo "Detected codename $DISTRO unsupported, falling back to jammy"
        DISTRO="jammy"
      fi

      mkdir -p /usr/share/keyrings
      KEYRING_PATH="/usr/share/keyrings/fluent-bit-archive-keyring.gpg"
      FLUENTBIT_REPO_BASE=""
      FLUENTBIT_REPO_CANDIDATES=("https://packages.fluentbit.io" "https://s3.amazonaws.com/packages.fluentbit.io")

      # Clean up any broken or partial key
      rm -f "$KEYRING_PATH"

      for candidate in "$${FLUENTBIT_REPO_CANDIDATES[@]}"; do
        key_url="$candidate/fluentbit.key"
        release_url="$candidate/ubuntu/$DISTRO/dists/$DISTRO/Release"

        for i in $(seq 1 8); do
          if curl -fsSL "$key_url" | gpg --dearmor --no-tty --batch -o "$KEYRING_PATH" && curl -fsSI "$release_url" >/dev/null; then
            FLUENTBIT_REPO_BASE="$candidate"
            break 2
          fi
          echo "Waiting for Fluent Bit repo candidate $candidate ($i/8)..."
          sleep 5
          rm -f "$KEYRING_PATH"
        done
      done

      if [ -z "$FLUENTBIT_REPO_BASE" ]; then
        echo "❌ Fluent Bit repo and fallback are unreachable; failing provisioning."
        exit 1
      fi

      echo "Using Fluent Bit repo: $FLUENTBIT_REPO_BASE"
      echo "deb [signed-by=/usr/share/keyrings/fluent-bit-archive-keyring.gpg] $FLUENTBIT_REPO_BASE/ubuntu/$DISTRO $DISTRO main" > /etc/apt/sources.list.d/fluent-bit.list
      if ! command -v td-agent-bit >/dev/null 2>&1; then
        if ! sudo apt-get update; then
          echo "❌ apt-get update failed for Fluent Bit repo; failing provisioning."
          exit 1
        fi
        if ! sudo apt-get install -y td-agent-bit; then
          echo "❌ td-agent-bit install failed; failing provisioning."
          exit 1
        fi
      fi

      mkdir -p /etc/td-agent-bit/conf.d

      cat <<EOF > /etc/td-agent-bit/td-agent-bit.conf
      [SERVICE]
          flush         1
          daemon        Off
          log_level     info
          plugins_file  plugins.conf
          parsers_file  parsers.conf
          http_server   Off
          http_listen   0.0.0.0
          http_port     2020
          storage.metrics on

      @INCLUDE /etc/td-agent-bit/conf.d/*.conf
      EOF

      # cloud-init logs
      cat <<EOF > /etc/td-agent-bit/conf.d/cloudinit.conf
      [INPUT]
          Name               tail
          Mem_Buf_Limit     10MB
          Path               /var/log/cloud-init*.log
          Tag                cloudinit
          Read_from_Head     Off
          DB                 /var/log/flb_cloudinit.db
          DB.Sync            normal
          Skip_Long_Lines    On

      [FILTER]
          Name      parser
          Match     cloudinit
          Key_Name  log
          Parser    cloudinit_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match cloudinit
          Add logName cloudinit

      [FILTER]
          Name    nest
          Match   cloudinit
          Operation nest
          Wildcard process
          Wildcard pid
          Wildcard timestamp
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match cloudinit
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key cloudinit
      EOF

      # journal logs (systemd, rke2, etc.)
      cat <<EOF > /etc/td-agent-bit/conf.d/journald.conf
      [INPUT]
          Name    systemd
          Tag     journal.*
          Mem_Buf_Limit     10MB
          DB      /var/log/flb_journal.db
          Systemd_Filter  _SYSTEMD_UNIT=bootstrap-rke2.service
          Systemd_Filter  _SYSTEMD_UNIT=rke2-server.service
          Systemd_Filter  _SYSTEMD_UNIT=cloud-final.service
          Read_From_Tail  On

      [FILTER]
          Name      parser
          Match     journal.*
          Key_Name  MESSAGE
          Parser    journald_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name modify
          Match journal.*
          Add logName systemd-journal

      [FILTER]
          Name   modify
          Match  journal.*
          Rename message textPayload

      [FILTER]
          Name    nest
          Match   journal.*
          Operation nest
          Wildcard identifier
          Wildcard pid
          Wildcard hostname
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match journal.*
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key systemd-journal
      EOF

      # Optional: catch all syslog (if rsyslog is enabled)
      cat <<EOF > /etc/td-agent-bit/conf.d/syslog.conf
      [INPUT]
          Name              tail
          Mem_Buf_Limit     10MB
          Path              /var/log/syslog
          Tag               syslog
          Read_from_Head    Off
          DB                /var/log/flb_syslog.db
          Skip_Long_Lines   On

      [FILTER]
          Name   parser
          Match  syslog
          Key_Name log
          Parser syslog_parser
          Reserve_Data true
          Preserve_Key true

      [FILTER]
          Name   modify
          Match  syslog
          Rename message textPayload

      [FILTER]
          Name modify
          Match syslog
          Add logName syslog

      [FILTER]
          Name    nest
          Match   syslog
          Operation nest
          Wildcard hostname
          Wildcard identifier
          Wildcard pid
          Nested_under logging.googleapis.com/labels

      [OUTPUT]
          Name  stackdriver
          Match syslog
          google_service_credentials /etc/google-cloud-ops-agent/logging-key.json
          resource ${MONITORED_RESOURCE_TYPE}
          location ${MONITORED_RESOURCE_LOCATION}
          namespace ${MONITORED_RESOURCE_NAMESPACE}
          node_id ${MONITORED_RESOURCE_NODE_ID}
          log_name_key syslog
      EOF

      # cloudinit_parser
      cat <<EOF >> /etc/td-agent-bit/parsers.conf

      [PARSER]
          Name        cloudinit_parser
          Format      regex
          Regex       ^(?<timestamp>[^ ]+\s[^ ]+) (?<process>[^\[]+)\[(?<pid>\d+)\]:(?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%d %H:%M:%S

      [PARSER]
          Name        syslog_parser
          Format      regex
          Regex       ^(?<timestamp>\w{3} +\d{1,2} \d{2}:\d{2}:\d{2}) (?<hostname>[^\s]+) (?<identifier>[^:]+): (?<message>.*)
          Time_Key    timestamp
          Time_Format %b %d %H:%M:%S

      [PARSER]
          Name        journald_parser
          Format      regex
          Regex       ^(?<timestamp>\d{4}-\d{2}-\d{2}T[0-9:.+\-Z]+) (?<hostname>[^\s]+) (?<identifier>[^\[]+)\[(?<pid>\d+)\]: (?<message>.*)
          Time_Key    timestamp
          Time_Format %Y-%m-%dT%H:%M:%S.%L%z
      EOF

      systemctl daemon-reload
      systemctl enable td-agent-bit
      systemctl restart td-agent-bit

  - path: /etc/security/limits.d/99-nofile.conf
    permissions: '0644'
    content: |
      * soft nofile 1048576
      * hard nofile 1048576

  - path: /etc/systemd/system/containerd.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/journald.conf.d/99-retention.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=2G
      RuntimeMaxUse=500M
      MaxRetentionSec=259200
      SystemMaxFileSize=200M
      SystemKeepFree=2G
      RuntimeKeepFree=250M
      RuntimeMaxFileSize=100M

  - path: /etc/logrotate.d/rsyslog
    permissions: '0644'
    content: |
      /var/log/syslog
      /var/log/messages
      /var/log/kern.log
      /var/log/auth.log
      /var/log/mail.log
      /var/log/user.log
      /var/log/daemon.log
      /var/log/debug
      {
        daily
        rotate 7
        maxsize 50M
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
          systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
        endscript
      }

  - path: /etc/logrotate.d/nginx
    permissions: '0644'
    content: |
      /var/log/nginx/*.log {
        daily
        rotate 14
        maxsize 100M
        missingok
        notifempty
        compress
        delaycompress
        create 0640 root adm
        sharedscripts
        postrotate
          [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
        endscript
      }

  - path: /etc/logrotate.d/cloud-init
    permissions: '0644'
    content: |
      /var/log/cloud-init.log
      /var/log/cloud-init-output.log
      {
        daily
        rotate 7
        maxsize 25M
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
      }

  - path: /etc/systemd/system/rke2-server.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /etc/systemd/system/rke2-agent.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      LimitNOFILE=1048576
      LimitNPROC=65536
      TasksMax=infinity

  - path: /usr/local/bin/setup-nfs-modules.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Load immediately
      modprobe nfs || true
      modprobe nfsd || true

      # Persist via /etc/modules if not already present
      grep -qxF nfs /etc/modules || echo nfs >> /etc/modules
      grep -qxF nfsd /etc/modules || echo nfsd >> /etc/modules

      # Create systemd service to load modules early
      cat <<EOF > /etc/systemd/system/load-nfs-modules.service
      [Unit]
      Description=Load NFS kernel modules
      DefaultDependencies=no
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/env modprobe nfs
      ExecStart=/usr/bin/env modprobe nfsd
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      systemctl enable load-nfs-modules.service

  - path: /usr/local/bin/setup-hosts-dns.sh
    permissions: '0755'
    content: |
      #!/bin/bash

      echo "Hostname=$(hostname)" >> /run/systemd/network/10-netplan-eth0.network || true
      sudo systemctl restart systemd-networkd || true

      HOSTNAME=$(hostname)
      grep -q "127.0.1.1 $HOSTNAME" /etc/hosts || echo "127.0.1.1 $HOSTNAME" >> /etc/hosts

      # ---------------------------------------------
      # 🧹 Disable systemd-resolved to free port 53
      # ---------------------------------------------
      echo "🧹 Disabling systemd-resolved..."
      sudo systemctl stop systemd-resolved || true
      sudo systemctl disable systemd-resolved || true
      sudo rm -f /etc/resolv.conf
      echo "nameserver 127.0.0.1" | sudo tee /etc/resolv.conf > /dev/null

      # ---------------------------------------------
      # ⚙️ Configure dnsmasq split-DNS
      # ---------------------------------------------
      sudo tee /etc/dnsmasq.d/k8s-split-dns.conf > /dev/null <<EOF
      # Forward Kubernetes service lookups to CoreDNS
      server=/svc.cluster.local/10.43.0.10

      # Forward internal LAN lookups to LAN DNS
      server=/internal.lan/10.0.0.10

      # Forward everything else to LAN DNS
      server=10.0.0.10

      # Listen locally
      listen-address=127.0.0.1

      # Don't use /etc/resolv.conf
      no-resolv
      EOF

      # Ensure dnsmasq global config allows localhost
      sudo sed -i 's/^#\?listen-address=.*/listen-address=127.0.0.1/' /etc/dnsmasq.conf || echo 'listen-address=127.0.0.1' | sudo tee -a /etc/dnsmasq.conf

      sudo systemctl enable dnsmasq
      sudo systemctl restart dnsmasq

      # Confirm DNS server
      echo "✅ dnsmasq is resolving:"
      echo "  - *.svc.cluster.local → 10.43.0.10"
      echo "  - *.internal.lan      → 10.0.0.10"
      echo "  - all others          → 10.0.0.10"

      # ---------------------------------------------
      # 🛡 IPv6 Hard Disable (Optional)
      # ---------------------------------------------
      sudo modprobe -r ip6_tables || true
      sudo modprobe -r nf_defrag_ipv6 || true
      sudo modprobe -r nf_conntrack_ipv6 || true
      sudo modprobe -r ipv6 || true

      echo "install ipv6 /bin/true" | sudo tee /etc/modprobe.d/force-disable-ipv6.conf
      echo "install ip6_tables /bin/true" | sudo tee -a /etc/modprobe.d/force-disable-ipv6.conf

      if [ -e /usr/sbin/ip6tables ]; then
        sudo mv /usr/sbin/ip6tables /usr/sbin/ip6tables.disabled
      fi

      sudo tee /etc/modprobe.d/disable-ipv6.conf > /dev/null <<EOF
      blacklist ipv6
      blacklist nf_conntrack_ipv6
      blacklist nf_defrag_ipv6
      blacklist ip6_tables
      EOF

      sudo update-initramfs -u

      # ---------------------------------------------
      # 🔁 Force sysctl re-apply on boot
      # ---------------------------------------------
      sudo tee /etc/systemd/system/sysctl-ensure.service > /dev/null <<EOF
      [Unit]
      Description=Force re-apply sysctl settings
      After=network.target
      Wants=network.target

      [Service]
      Type=oneshot
      ExecStart=/sbin/sysctl --system

      [Install]
      WantedBy=multi-user.target
      EOF

      sudo systemctl daemon-reexec
      sudo systemctl enable sysctl-ensure.service

